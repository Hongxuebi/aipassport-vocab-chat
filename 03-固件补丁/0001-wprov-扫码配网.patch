diff --git a/main/ev_sync.c b/main/ev_sync.c
new file mode 100644
index 0000000..503878a
--- /dev/null
+++ b/main/ev_sync.c
@@ -0,0 +1,245 @@
+// main/ev_sync.c —— 复习事件的"记账 + 补传"（C2-b）
+//
+// 为什么要单独一层：卡片页只管"按了什么、多快按的"，补传是后台的事。
+// 三条硬规矩（都是踩过的）：
+//   ① 网络不进 LVGL 上下文（K4）：补传永远在独立任务里
+//   ② 启动类任务互斥（N2）：s_busy 先占标志再 xTaskCreate，在跑就拒绝
+//   ③ 失败不许拦住用户：事件先落盘，传不上去就下次再传（幂等：seq 是键，服务端机按它去重）
+#include <string.h>
+#include <stdlib.h>
+
+#include "esp_log.h"
+#include "esp_heap_caps.h"
+#include "esp_system.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "freertos/semphr.h"
+
+#include "evlog.h"
+#include "evlog_esp.h"
+#include "net_client.h"
+#include "ev_sync.h"
+
+static const char *TAG = "evsync";
+
+#define BATCH       32      /* 一次 POST 最多 32 条（约 2.5KB JSON） */
+#define MAX_ROUNDS  8       /* 一次最多跑 256 条：后台任务别霸着网络 */
+
+static bool          s_mounted;
+static volatile int  s_busy;
+static volatile int  s_state;     /* 0 没跑过 / 1 在跑 / 2 传完 / 3 失败或还有残留 */
+
+/* 卡片状态回传：卡片页退出时把拼好的 JSON 挂这里（所有权转移）。
+   为什么要挂这儿：以前卡片页自己起 6KB 栈的任务回传，和"事件补传"撞在一起时
+   两个 6KB 并存 ⇒ 真机首页显示"堆 0 KB"（2026-10-27）。合并成一个后台线程串行做。 */
+static char             *s_state_json;
+static SemaphoreHandle_t s_state_mtx;
+
+static void state_mtx_init(void)
+{
+    if (!s_state_mtx) s_state_mtx = xSemaphoreCreateMutex();
+    if (!s_state_mtx) ESP_LOGW(TAG, "卡片状态互斥锁创建失败：挂状态/取状态可能撞车");
+}
+
+bool ev_sync_state_queued(void)
+{
+    bool q = false;
+    if (s_state_mtx) xSemaphoreTake(s_state_mtx, portMAX_DELAY);
+    q = (s_state_json != NULL);
+    if (s_state_mtx) xSemaphoreGive(s_state_mtx);
+    return q;
+}
+
+void ev_sync_attach_state(char *json)
+{
+    if (!json) return;
+    ev_sync_init();
+    state_mtx_init();
+    char *old = NULL;
+    if (s_state_mtx) xSemaphoreTake(s_state_mtx, portMAX_DELAY);
+    old = s_state_json;
+    s_state_json = json;
+    if (s_state_mtx) xSemaphoreGive(s_state_mtx);
+    if (old) {
+        ESP_LOGW(TAG, "上一份卡片状态还没发出去，被新的一份取代（旧的不再发）");
+        free(old);
+    }
+    ESP_LOGI(TAG, "卡片状态已挂到补传线程（%u B，待传事件 %u 条）",
+             (unsigned)strlen(json), (unsigned)(s_mounted ? evlog_pending() : 0));
+}
+
+/* 取走一份（调用方负责 free） */
+static char *state_take(void)
+{
+    char *j = NULL;
+    if (s_state_mtx) xSemaphoreTake(s_state_mtx, portMAX_DELAY);
+    j = s_state_json;
+    s_state_json = NULL;
+    if (s_state_mtx) xSemaphoreGive(s_state_mtx);
+    return j;
+}
+
+/* 把挂着的卡片状态都发掉。返回 false = 有一次失败（不重试，进度在本机 PGB2 里，不丢） */
+static bool pump_state(void)
+{
+    for (int guard = 0; guard < 4; guard++) {
+        char *j = state_take();
+        if (!j) return true;
+        const size_t len = strlen(j);
+        const net_err_t e = net_client_post_state_json(j);
+        free(j);
+        if (e == NET_OK) ESP_LOGI(TAG, "卡片状态回传 OK（%u B）", (unsigned)len);
+        if (e != NET_OK) {
+            ESP_LOGW(TAG, "卡片状态回传失败（net_err=%d）—— 进度在本机 PGB2，不丢；下次进卡片页再回传",
+                     (int)e);
+            return false;
+        }
+        s_state = 2;
+    }
+    return true;
+}
+
+/* ---------------------------------------------------------------- 初始化 */
+void ev_sync_init(void)
+{
+    if (s_mounted) return;
+    s_mounted = (evlog_esp_mount() == EVLOG_OK);
+}
+
+/* ---------------------------------------------------------------- 记一条 */
+bool ev_sync_note(const evlog_rec_t *r)
+{
+    if (!r) return false;
+    ev_sync_init();
+    if (!s_mounted) return false;
+
+    uint32_t seq = 0;
+    const evlog_err_t e = evlog_append(r, &seq);
+    if (e != EVLOG_OK) {
+        ESP_LOGW(TAG, "事件没记上（%s）—— 背单词继续，丢的这一条不可补", evlog_err_str(e));
+        return false;
+    }
+    ESP_LOGI(TAG, "事件 #%u：词 %u 评 %u 反应 %ums 第 %u 天%s%s（待传 %u）",
+             (unsigned)seq, (unsigned)r->card_id, (unsigned)r->grade, (unsigned)r->rt_ms,
+             (unsigned)r->day, (r->flags & EV_FLAG_OFFLINE) ? " 离线" : "",
+             (r->flags & EV_FLAG_REPEAT) ? " 重来" : "", (unsigned)evlog_pending());
+    return true;
+}
+
+/* ---------------------------------------------------------------- 补传 */
+/* 一个后台线程干两件事，**串行**：
+     ① 卡片状态回传（卡片页退出时挂上来的 JSON）
+     ② 复习事件补传（按 seq 幂等）
+   为什么要合：2026-10-27 真机，退页那一瞬间"回传"和"补传"两个 6KB 栈任务并存，
+   首页显示「堆 0 KB」。合完峰值只有一个 6KB。 */
+static void upload_task(void *arg)
+{
+    (void)arg;
+    static net_event_t ev[BATCH];
+    static evlog_rec_t rec[BATCH];
+    static uint32_t    seqs[BATCH];
+
+    int sent = 0;
+    int rounds = 0;
+
+    /* ① 先回传卡片状态（作者退出来第一眼就看首页的"待传"和堆） */
+    if (!pump_state()) {
+        ESP_LOGW(TAG, "卡片状态没发出去，本次只补传事件");
+    }
+
+    /* ② 再补传事件（事件日志没挂上就跳过这一段，卡片状态照样发） */
+    for (; s_mounted && rounds < MAX_ROUNDS; rounds++) {
+        const uint32_t next = evlog_ack() + 1;
+        const uint32_t oldest = evlog_oldest();
+
+        /* 要传的这段已经被环形覆盖（离线太久）——按"丢了多少"如实推进水位，别卡死 */
+        if (next < oldest) {
+            const uint32_t lost = oldest - next;
+            ESP_LOGW(TAG, "有 %u 条事件被环形覆盖（离线太久），水位直接推到 %u",
+                     (unsigned)lost, (unsigned)(oldest - 1));
+            evlog_ack_set(oldest - 1);
+            continue;
+        }
+
+        const int n = evlog_read(next, rec, seqs, BATCH);
+        if (n <= 0) break;                      /* 没有待传的了 */
+
+        for (int i = 0; i < n; i++) {
+            ev[i].seq = seqs[i];
+            ev[i].id = rec[i].card_id;
+            ev[i].grade = rec[i].grade;
+            ev[i].flags = rec[i].flags;
+            ev[i].rt_ms = rec[i].rt_ms;
+            ev[i].flip_ms = rec[i].flip_ms;
+            ev[i].day = rec[i].day;
+            ev[i].t_ms = rec[i].t_ms;
+        }
+
+        uint32_t srv_ack = 0;
+        const net_err_t pe = net_client_post_events(ev, n, &srv_ack);
+        if (pe != NET_OK) {
+            s_state = 3;
+            ESP_LOGW(TAG, "补传失败：net_err=%d（%d 条留在盘上，下次再传）", (int)pe, (int)evlog_pending());
+            break;
+        }
+        /* 水位只认"真交出去的"最大序号；服务端机回 0 不许越界。
+           **但服务端机水位比本机还高时，必须对齐它**（2026-10-31 踩：evlog 升 VER 重建后本机 seq 回到 86，
+           服务端机已是 130 ⇒ 本地 10 条全被判重复、水位卡在 95 永远推不动） */
+        if (srv_ack == 0) {
+            srv_ack = seqs[n - 1];
+        } else if (srv_ack > seqs[n - 1]) {
+            ESP_LOGW(TAG, "服务端机水位 %u 高于本次最大 %u —— 本机序号落后（旧日志重建过），直接对齐",
+                     (unsigned)srv_ack, (unsigned)seqs[n - 1]);
+        }
+        if (evlog_ack_set(srv_ack) != EVLOG_OK) {
+            ESP_LOGW(TAG, "水位落 NVS 失败（内存里已经推了，下次会重复传 → 服务端机按 seq 去重）");
+        }
+        sent += n;
+        if (n < BATCH) break;
+    }
+
+    /* ③ 跑这段期间卡片页可能又退了一次 → 顺路发掉（不重试失败的，只发新挂的） */
+    (void)pump_state();
+
+    if (sent > 0) {
+        ESP_LOGI(TAG, "补传完成：本次 %d 条，水位 %u，剩 %u 条",
+                 sent, (unsigned)evlog_ack(), (unsigned)evlog_pending());
+    }
+    s_state = (evlog_pending() == 0 && !ev_sync_state_queued()) ? 2 : 3;
+    s_busy = 0;
+    /* 收工后堆应该回到基线 —— 这一行就是"退出页面后堆 ≥8KB"的证据 */
+    ESP_LOGI(TAG, "补传线程收工：空闲堆 %u B，最大连续块 %u B",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    if (ev_sync_state_queued()) ev_sync_request();   /* 收工前又挂上的新状态 */
+    vTaskDelete(NULL);
+}
+
+void ev_sync_request(void)
+{
+    if (s_busy) return;                         /* 在跑就拒绝：别开第二个（N2） */
+    ev_sync_init();
+    state_mtx_init();
+    const bool have_state = ev_sync_state_queued();
+    /* 只有卡片状态、没有待传事件时也要跑（退出卡片页的常见情形） */
+    if (evlog_pending() == 0 && !have_state) { s_state = 2; return; }
+
+    s_busy = 1;
+    s_state = 1;
+    if (xTaskCreate(upload_task, "ev_up", 4096, NULL, 2, NULL) != pdPASS) {
+        s_busy = 0;
+        s_state = 3;
+        ESP_LOGW(TAG, "补传任务起不来（空闲堆 %u，最大连续块 %u）—— %u 条事件%s留到下次",
+                 (unsigned)esp_get_free_heap_size(),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT),
+                 (unsigned)evlog_pending(), have_state ? " + 一份卡片状态" : "");
+    }
+}
+
+uint32_t ev_sync_pending(void)
+{
+    return s_mounted ? evlog_pending() : 0;
+}
+
+bool ev_sync_busy(void) { return s_busy != 0; }
+int  ev_sync_state(void) { return s_state; }
diff --git a/main/ev_sync.h b/main/ev_sync.h
new file mode 100644
index 0000000..584acf2
--- /dev/null
+++ b/main/ev_sync.h
@@ -0,0 +1,41 @@
+// main/ev_sync.h —— 复习事件：写一条 / 后台补传（C2-b）
+//
+// 分工（别混）：
+//   · 记事件 = 界面上下文里**只写 Flash**（几微秒），绝不发网络
+//   · 补传  = 独立任务里发 HTTP，界面用 ev_sync_pending() 读数字显示"待传 N"
+//   · 网络失败不打断背单词：事件留在盘上，下次进页面再补
+#pragma once
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#include "evlog.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 挂载事件日志（开机/进卡片页都可以调；成功后才算启用） */
+void ev_sync_init(void);
+
+/* 记一条复习事件。返回 false = 没写进去（已打日志，调用方照常继续）。 */
+bool ev_sync_note(const evlog_rec_t *r);
+
+/* 请求后台补传。**幂等**：已经在跑就直接返回（N2：启动类任务必须互斥）。 */
+void ev_sync_request(void);
+
+/* 把一份**已拼好**的 /state JSON 交给补传线程（**所有权转移**：发完/丢弃都由这里 free）。
+   卡片页退出现在不自己 xTaskCreate 了 —— 2026-10-27 真机：退页那一刻"回传"和"事件补传"
+   两个 6KB 栈的任务并存，首页显示"堆 0 KB"。现在合并成一个后台线程串行做。
+   json == NULL 时什么也不做。 */
+void ev_sync_attach_state(char *json);
+
+bool     ev_sync_state_queued(void);   /* 有没有还没发出去的卡片状态 */
+
+uint32_t ev_sync_pending(void);   /* 待上传条数（界面显示） */
+bool     ev_sync_busy(void);      /* 补传任务在跑？ */
+int      ev_sync_state(void);     /* 0 没跑过 / 1 在跑 / 2 全部传完 / 3 失败或有残留 */
+
+#ifdef __cplusplus
+}
+#endif
