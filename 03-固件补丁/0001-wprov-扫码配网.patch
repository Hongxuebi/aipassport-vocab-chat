+
+/* 把状态机的结论落到屏上（调用方须持锁） */
+static void apply_pm_locked(int id, const char *why)
+{
+    if (id < 0) return;                   /* -1 = 状态机说"不用动" */
+    face_set_locked(id, why);
+}
+
+/* 给别的任务用（会自己拿锁） */
+static void face_set(int id, const char *why)
+{
+    if (bsp_lvgl_lock(300)) {
+        face_set_locked(id, why);
+        bsp_lvgl_unlock();
+    }
+}
+
+static void step_face(int dir)
+{
+    const int n = faces_count();
+    if (n <= 0) return;
+    int id = (s_face + dir + n) % n;
+    face_set_locked(id, dir > 0 ? "下一张" : "上一张");
+}
