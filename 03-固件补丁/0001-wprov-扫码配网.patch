+ * 全部 ≤2 fps（每帧 = 一次 140×130 重绘，2 fps 才 1.3% 占空）；
+ * 说话中 / 睡着 / 演升级提示 时**一律停**（别跟 I2S 和状态机抢）。
+ */
+#define MICRO_BREATH_MS      550u   /* 呼吸一拍；4 拍 = 2.2 s 一个来回（≈1.8 fps） */
+#define MICRO_THINK_MS      4500u   /* 思考：这么久抖一下 */
+#define MICRO_THINK_DUR      250u   /* 抖一下持续多久 */
+#define PET_BOOST_MS        1200u   /* 升到 L1/L2：拿里层脸演一下 */
+
+static volatile uint32_t s_audio_mean;      /* 最近一块的 mean(|s16|) */
+static volatile uint32_t s_last_chunk_ms;   /* 最近一块的时刻 */
+static volatile bool     s_her_voice;       /* 她正在出声 */
+static int      s_mouth_tier;               /* 0 闭 / 1 半 / 2 大 */
+static uint32_t s_tier_since;               /* 本档起始时刻 */
+static uint32_t s_quiet_blocks;             /* 连续静音块数 */
+/* 校准统计（每轮回复清一次；第一次上机就靠这一行定阈值） */
+static uint32_t s_cal_blocks, s_cal_sum, s_cal_max;
+static uint32_t s_cal_tier[3];
+static uint32_t s_cal_bin[17];              /* mean 直方图：每 1000 一格，16=溢出 */
+
+/* 微动与升级提示 */
+static int8_t   s_dx, s_dy;                 /* 当前微动偏移（px） */
+static int      s_micro_face = -1;          /* 上次微动对应的脸（换脸就归零重来） */
