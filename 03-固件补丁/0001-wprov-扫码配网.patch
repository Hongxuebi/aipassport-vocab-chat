+    lv_obj_set_style_text_color(s_prog, lv_color_hex(UI_CY_DIM), 0);   /* 深色底 */
+    lv_obj_align(s_prog, LV_ALIGN_TOP_RIGHT, -10, 8);
+    lv_label_set_text(s_prog, "");
+
+    s_word = lv_label_create(s_scr);
+    lv_obj_set_width(s_word, 226);
+    lv_obj_set_style_text_align(s_word, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(s_word, &latin28, 0);
+    lv_obj_set_style_text_color(s_word, lv_color_hex(UI_SC_INK), 0);
+    lv_obj_align(s_word, LV_ALIGN_TOP_MID, 0, 52);
+    lv_label_set_long_mode(s_word, LV_LABEL_LONG_WRAP);
+
+    s_ipa = lv_label_create(s_scr);
+    lv_obj_set_width(s_ipa, 226);
+    lv_obj_set_style_text_align(s_ipa, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(s_ipa, &latin16, 0);
+    lv_obj_set_style_text_color(s_ipa, lv_color_hex(0x6B757D), 0);
+    lv_obj_align(s_ipa, LV_ALIGN_TOP_MID, 0, 130);
+    lv_label_set_long_mode(s_ipa, LV_LABEL_LONG_WRAP);
+
+    s_cn = lv_label_create(s_scr);
+    lv_obj_set_width(s_cn, 226);
+    lv_obj_set_style_text_align(s_cn, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(s_cn, &fusion_ui24, 0);
+    lv_obj_set_style_text_color(s_cn, lv_color_hex(UI_SC_INK), 0);
+    lv_obj_align(s_cn, LV_ALIGN_TOP_MID, 0, 168);
+    lv_label_set_long_mode(s_cn, LV_LABEL_LONG_WRAP);
+
+    s_chunk = lv_label_create(s_scr);          /* v0.124：词块（答案面才显示） */
+    lv_obj_set_width(s_chunk, 226);
+    lv_obj_set_style_text_align(s_chunk, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(s_chunk, &latin20, 0);      /* 词块是英文：用 DejaVu 20px（比 16 大一号） */
+    lv_obj_set_style_text_color(s_chunk, lv_color_hex(UI_SC_MUTE), 0);
+    lv_label_set_long_mode(s_chunk, LV_LABEL_LONG_WRAP);
+    lv_obj_add_flag(s_chunk, LV_OBJ_FLAG_HIDDEN);
+
+    s_hint = lv_label_create(s_scr);
+    lv_obj_set_width(s_hint, 230);
+    lv_obj_set_style_text_font(s_hint, &fusion_ui12, 0);
+    lv_obj_set_style_text_color(s_hint, lv_color_hex(0x6B757D), 0);
+    lv_obj_align(s_hint, LV_ALIGN_TOP_MID, 0, 250);
+    /* 一行显示（作者 2026-10-25 要求）：实测 fusion_ui12 下宽 192px，屏内可用 224px，放得下。
+       换文案前先量宽度 —— 4 个动作挤一行，多一个字就折行。 */
+    lv_label_set_text(s_hint, "●认识  ▲熟知  ●●模糊  ▼忘记");
+
+    s_dbg = lv_label_create(s_scr);
+    lv_obj_set_style_text_font(s_dbg, &fusion_ui12, 0);
