+bool app_prov_boot_pending(void)
+{
+    nvs_handle_t h;
+    uint8_t v = 0;
+    if (nvs_open(PROV_BOOT_NS, NVS_READONLY, &h) != ESP_OK) return false;
+    esp_err_t e = nvs_get_u8(h, "boot", &v);
+    nvs_close(h);
+    return e == ESP_OK && v == 1;
+}
