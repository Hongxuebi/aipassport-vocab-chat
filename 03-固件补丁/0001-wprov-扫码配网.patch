+// components/wprov/wprov.c
+// 短时配网（SoftAP+手机网页+二维码）。设计依据 docs/reference/phoenixzhc/softap-provisioning-and-resource-budget.zh_CN.md：
+//   · APSTA 收凭据 → 先验证 STA 能连上 → 成功后才写 NVS（保留上一组可用凭据）
+//   · max_connection = 1
+//   · 区分 AP_STACONNECTED 与 AP_STAIPASSIGNED（后者才算"手机能开网页"）
+//   · 配网完成后彻底停掉 DNS + HTTP
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/event_groups.h"
+#include "freertos/task.h"
+#include "freertos/semphr.h"
+#include "esp_wifi.h"
+#include "esp_event.h"
+#include "esp_netif.h"
+#include "esp_mac.h"
+#include "esp_random.h"
+#include "esp_timer.h"
+#include "esp_log.h"
+#include "esp_heap_caps.h"
+#include "nvs.h"
+#include "nvs_flash.h"
+
+#include "esp_check.h"
+#include "wprov.h"
+
+static const char *TAG = "wprov";
+
+/* 不 abort 的错误检查：失败就记日志 + 设 s_err + 返回错误码（调用方降级）。
+   IDF 自带的那个错误检查宏会直接 abort —— 现场崩机等于用户失联，这里一律不用。 */
+static char s_err[64];
+static void set_err(const char *fmt, const char *a, const char *b);
+#define WPROV_TRY(expr) do { \
+        esp_err_t _e = (expr); \
+        if (_e != ESP_OK) { \
+            ESP_LOGE(TAG, "%s -> %s", #expr, esp_err_to_name(_e)); \
+            set_err(#expr " failed", NULL, NULL); \
+            return _e; \
+        } \
+    } while (0)
+
+#define AP_PASS          "12345678"
+#define NVS_NS           "wprov"
+#define NVS_K_SSID       "ssid"      /* 兼容旧版：= 最近一个 */
+#define NVS_K_PASS       "pass"
+#define NVS_K_COUNT      "n"
+#define MAX_SAVED        3
+#define BIT_STA_GOT_IP   BIT0
+#define BIT_AP_STARTED   BIT1
+#define BIT_CLIENT_IP    BIT2
+
+static EventGroupHandle_t s_eg;
+static SemaphoreHandle_t  s_req;
+static portMUX_TYPE s_mux = portMUX_INITIALIZER_UNLOCKED;
+static bool     s_wifi_inited, s_netif_inited, s_ap_on, s_sta_netif_made;
+static bool     s_handlers_done;   /* 事件处理器只注册一次：instance=NULL 注册进去是不可反注册的 */
+static bool     s_sync_made;       /* 事件组/信号量只建一次：每轮重建 = 每轮漏一个小对象 */
+static volatile int s_sta_count;   /* 现在有几个手机连着热点（用来决定"要不要扫描"） */
+static bool     s_worker_on;       /* 连接 worker 只建一次：它永不退出，多建一个就永久多一个栈 */
+static char     s_ap_base[28];   /* AIPassport-XXXX（固定部分） */
+static esp_netif_t *s_ap_netif, *s_sta_netif;
+
+static char       s_ap_ssid[33];
+static wprov_ap_t s_list[WPROV_MAX_AP];
+static int        s_list_n;
+static volatile wprov_state_t s_state = WPROV_IDLE;
+static int        s_retry;
+static bool       s_connecting;
+static char       s_pend_ssid[33], s_pend_pass[65];
+static char       s_last_ip[16];
+static volatile int s_last_reason = -1;
+static bool s_keep_failed;
+static int  s_connect_timeout_ms = 25000;
+static int  s_fail_streak;                   /* 连续失败次数（成功清零） */
+static bool s_fail_locked;                   /* 到 3 次就封顶，不再自动重试 */
+static uint8_t s_fast_bssid[6];
+static uint8_t s_fast_chan;
+static bool    s_fast;                       /* true = 用记住的 BSSID/信道直连，跳过扫描 */
+static int64_t s_connect_t0;   /* 失败后回热点：状态要留在 FAILED，屏上才看得到原因 */
+static char       s_connected_ssid[33];
+/* 2026-10-30：httpd 的 3072B 任务栈要的是**一整块连续内存**。AP 一起来，最大连续块
+   经常只剩 2.9~3.5KB（真机三次：3,584 / 2,944 / 4,608，每次不一样），httpd 就时起时不起。
+   所以趁内存还宽（扫描前）先占一块 4KB，等真要建 httpd 任务时再还回去 ——
+   tlsf 会优先把刚释放的块给下一个同尺寸请求，连续块就一定够。 */
+static void      *s_http_res;
+
+const char *wprov_state_text(void)
+{
+    switch (s_state) {
+    case WPROV_AP_UP:      return "AP ready";
+    case WPROV_SCANNING:   return "Scanning...";
+    case WPROV_CONNECTING: return "Connecting...";
+    case WPROV_CONNECTED:  return "Connected";
+    case WPROV_FAILED:     return "FAILED";
+    default:               return "Idle";
+    }
+}
+wprov_state_t wprov_state(void) { return s_state; }
+
+void wprov_clear_result(void)
+{
+    s_state = WPROV_IDLE;
+    s_last_ip[0] = 0;
+    s_connected_ssid[0] = 0;
+    s_err[0] = 0;
+    s_last_reason = -1;
+}
+
+int wprov_last_reason(void) { return s_last_reason; }
+
+void wprov_last_ssid(char *out, size_t n)
+{
+    if (out && n) snprintf(out, n, "%s", s_pend_ssid);
+}
+
+void wprov_last_ip(char *out, size_t n)
+{
+    if (out && n) snprintf(out, n, "%s", s_last_ip);
+}
+
+void wprov_connected_ssid(char *out, size_t n)
+{
+    if (out && n) snprintf(out, n, "%s", s_state == WPROV_CONNECTED ? s_connected_ssid : "");
+}
+const char   *wprov_last_error(void) { return s_err[0] ? s_err : "-"; }
+
+static void set_err(const char *fmt, const char *a, const char *b)
+{
+    snprintf(s_err, sizeof(s_err), fmt, a ? a : "", b ? b : "");
+}
+
+/* ------------------------------------------------------------------ 事件 */
+static void on_wifi(void *arg, esp_event_base_t base, int32_t id, void *data)
+{
+    if (base == WIFI_EVENT && id == WIFI_EVENT_AP_START) {
+        xEventGroupSetBits(s_eg, BIT_AP_STARTED);
+    } else if (base == WIFI_EVENT && id == WIFI_EVENT_AP_STACONNECTED) {
+        wifi_event_ap_staconnected_t *e = (wifi_event_ap_staconnected_t *)data;
+        s_sta_count++;
+        ESP_LOGI(TAG, "手机已连上热点 (aid=%d)，等 DHCP（当前 %d 个客户端）", e->aid, s_sta_count);
+    } else if (base == WIFI_EVENT && id == WIFI_EVENT_AP_STADISCONNECTED) {
+        wifi_event_ap_stadisconnected_t *e = (wifi_event_ap_stadisconnected_t *)data;
+        if (s_sta_count > 0) s_sta_count--;
+        ESP_LOGW(TAG, "手机离开热点 (aid=%d reason=%d)，剩 %d 个客户端",
+                 e ? e->aid : -1, e ? e->reason : -1, s_sta_count);
+    } else if (base == WIFI_EVENT && id == WIFI_EVENT_STA_DISCONNECTED) {
+        wifi_event_sta_disconnected_t *d = (wifi_event_sta_disconnected_t *)data;
+        if (s_connecting) {
+            s_retry++;
+            ESP_LOGW(TAG, "STA 断开，第 %d 次，reason=%d", s_retry, d ? d->reason : -1);
+            if (d) {
+                s_last_reason = d->reason;
+                snprintf(s_err, sizeof(s_err), "cannot join %s (reason=%d)", s_pend_ssid, d->reason);
+            }
+            if (s_retry <= 2) esp_wifi_connect();
+            else { s_connecting = false; s_state = WPROV_FAILED; set_err("连不上 %s", s_pend_ssid, NULL); }
+        }
+    } else if (base == IP_EVENT && id == IP_EVENT_STA_GOT_IP) {
+        ip_event_got_ip_t *e = (ip_event_got_ip_t *)data;
+        snprintf(s_last_ip, sizeof(s_last_ip), IPSTR, IP2STR(&e->ip_info.ip));
+        int64_t used = (esp_timer_get_time() - s_connect_t0) / 1000;
+        ESP_LOGI(TAG, "STA 拿到 IP %s（连接耗时 %lld ms%s）", s_last_ip, (long long)used,
+                 s_fast ? "，BSSID 快连" : "");
+        /* 语音机要的是**低延迟**，不是省电（2026-10-28 21:1x：局域网 ping 这台 95–417 ms，
+           语音上行只有 0.6–1.7 倍实时，大回包还会把链路堵死）。配网时本来就是 PS_NONE，
+           这里把"平时"也改成 PS_NONE —— 代价是待机电流大一档。 */
+        esp_wifi_set_ps(WIFI_PS_NONE);
+        wifi_ap_record_t ap;
+        if (esp_wifi_sta_get_ap_info(&ap) == ESP_OK) {
+            nvs_handle_t h;
+            if (nvs_open(NVS_NS, NVS_READWRITE, &h) == ESP_OK) {
+                nvs_set_blob(h, "bssid0", ap.bssid, 6);
+                nvs_set_u8(h, "chan0", ap.primary);
+                nvs_commit(h);
+                nvs_close(h);
+            }
+            ESP_LOGI(TAG, "记住这个 AP：%02x:%02x:%02x:%02x:%02x:%02x ch%d rssi%d",
+                     ap.bssid[0], ap.bssid[1], ap.bssid[2], ap.bssid[3], ap.bssid[4], ap.bssid[5],
+                     ap.primary, ap.rssi);
+        }
+        s_connecting = false;
+        s_state = WPROV_CONNECTED;
+        s_fast = false;
+        s_fail_streak = 0;
+        s_fail_locked = false;
+        xEventGroupSetBits(s_eg, BIT_STA_GOT_IP);
+    } else if (base == IP_EVENT && id == IP_EVENT_AP_STAIPASSIGNED) {
+        ip_event_ap_staipassigned_t *e = (ip_event_ap_staipassigned_t *)data;
+        ESP_LOGI(TAG, "DHCP 已分配 " IPSTR " → 手机可以开网页了", IP2STR(&e->ip));
+        xEventGroupSetBits(s_eg, BIT_CLIENT_IP);
+    }
+}
+
+/* ------------------------------------------------------------------ 初始化 */
+esp_err_t wprov_init(void)
+{
+    if (s_wifi_inited) return ESP_OK;
+
+    {
+        esp_err_t ne = nvs_flash_init();
+        if (ne == ESP_ERR_NVS_NO_FREE_PAGES || ne == ESP_ERR_NVS_NEW_VERSION_FOUND) {
+            nvs_flash_erase();
+            nvs_flash_init();
+        }
+    }
+    if (!s_netif_inited) {
+        WPROV_TRY(esp_netif_init());
+        esp_err_t e = esp_event_loop_create_default();
+        if (e != ESP_OK && e != ESP_ERR_INVALID_STATE) return e;
+        s_netif_inited = true;
+    }
+    /* 同步对象只建一次。原来每次 init 都重建一遍、旧的不释放 ——
+       进出配网页 20 轮的实测里，这就是稳定段"每轮 −256 B"的来源之一。 */
+    if (!s_sync_made) {
+        s_eg  = xEventGroupCreate();
+        s_req = xSemaphoreCreateBinary();
+        if (!s_eg || !s_req) { set_err("event group alloc failed", NULL, NULL); return ESP_ERR_NO_MEM; }
+        s_sync_made = true;
+    }
+    if (!s_ap_netif) s_ap_netif = esp_netif_create_default_wifi_ap();
+
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    cfg.nvs_enable = 0;                     /* 凭据自己管，不跟 demo_radio 抢 NVS */
+    WPROV_TRY(esp_wifi_init(&cfg));
+    WPROV_TRY(esp_wifi_set_storage(WIFI_STORAGE_RAM));
+    /* 处理器只在第一次注册；deinit 后驱动重来但回调还挂在默认 loop 上，重复注册会越积越多 */
+    if (!s_handlers_done) {
+        WPROV_TRY(esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, on_wifi, NULL, NULL));
+        WPROV_TRY(esp_event_handler_instance_register(IP_EVENT, ESP_EVENT_ANY_ID, on_wifi, NULL, NULL));
+        s_handlers_done = true;
+    }
+
+    uint8_t mac[6] = {0};
+    esp_read_mac(mac, ESP_MAC_WIFI_SOFTAP);
+    snprintf(s_ap_base, sizeof(s_ap_base), "AIPassport-%02X%02X", mac[4], mac[5]);
+    snprintf(s_ap_ssid, sizeof(s_ap_ssid), "%s", s_ap_base);
+
+    s_wifi_inited = true;
+    ESP_LOGI(TAG, "init 完：8bit %u/%u ｜DMA %u/%u",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_DMA),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_DMA));
+    ESP_LOGI(TAG, "init 完，空闲堆 %u B，最大连续块 %u B",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    return ESP_OK;
+}
+
+void wprov_get_ap(char *ssid, size_t n, char *pass, size_t m)
+{
+    if (ssid && n) snprintf(ssid, n, "%s", s_ap_ssid[0] ? s_ap_ssid : "AIPassport");
+    if (pass && m) snprintf(pass, m, "%s", AP_PASS);
+}
+
+/* ------------------------------------------------------------------ AP */
+esp_err_t wprov_start_ap(void)
+{
+    ESP_RETURN_ON_FALSE(s_wifi_inited, ESP_ERR_INVALID_STATE, TAG, "call wprov_init first");
+    if (s_ap_on) return ESP_OK;
+
+    /* SSID 固定不变（换名字会让二维码对不上，手机扫了也加不进去） */
+    snprintf(s_ap_ssid, sizeof(s_ap_ssid), "%s", s_ap_base);
+
+    /* 起热点前先把 STA 的连接压住：STA 正在连的时候 set_config 会 ESP_ERR_WIFI_STATE，
+       热点的 netif 就只起了一半（真机 2026-10-25 见到 `sta is connecting, cannot set config`）。
+       ⚠️ 但如果 STA **已经连着**，不要断它 —— 2026-10-26 改了：保持 STA 连着，
+       这样"和手机在同一个 WiFi"时可以直接用 http://<设备IP>/ 打开配网页（不用连热点，也不受
+       手机热点加入失败影响）；热点照样起，两条路并存。 */
+    /* 🔴 2026-10-26 改（原逻辑是"STA 正在连就 disconnect"）：
+       真机日志把两个坑都摊出来了 ——
+       ① `wprov_start_ap` 里 `esp_wifi_sta_get_ap_info()` 拿不到信道（STA 还在 connecting）
+          ⇒ ap_ch 退回默认 6；而 STA 最终连上的是 **ch1**。AP 在 6、STA 在 1 时，
+          IDF 会强制把 AP 挪到 STA 的信道，这一挪就把刚加入的手机踢了
+          （`deauth` / `reason=15` ⇒ 手机显示"网络连接失败"）。
+       ② STA 连接过程中把 DMA 吃到只剩 **2488 B**（实测 `起 AP 前 DMA 2488/2048`），
+          新手机加入要的缓冲分不出来。
+       所以：**先等 STA 出结果（最多 5 秒），再起 AP** —— 信道和内存两本账同时对上。
+       在别人家（没存过网络）这条最多多等 5 秒，一次就够。 */
+    if (s_connecting) {
+        ESP_LOGW(TAG, "STA 还在连 —— 等它出结果再起热点（最多 5 秒）");
+        for (int i = 0; i < 50 && s_connecting; i++) vTaskDelay(pdMS_TO_TICKS(100));
+        ESP_LOGW(TAG, "STA 有结果了（connecting=%d）—— 起热点", (int)s_connecting);
+    }
+    esp_wifi_scan_stop();
+
+    /* 🔴🔴 2026-10-26 改**纯 AP**（原来是 APSTA）—— 真机三本账一起指到这里：
+       ① 内存：APSTA 共存 + httpd(4 socket) 之后 `空闲堆 128 B / 最大连续块 88 B`，
+          手机一连上来连 EAPOL 都分不到缓冲（实测日志 `热点+扫描就绪，空闲堆 128 B`）。
+       ② 信道：STA 在 ch1、AP 若在 ch6，IDF 会强制把 AP 挪到 STA 信道，这一挪就把刚加入的手机踢了。
+       ③ 射频：共用一个电台，STA 的心跳/扫描会插进手机的四次握手（reason=15 = 握手超时）。
+       配网期间 STA 让位：`esp_wifi_stop()` 把 STA 侧缓冲真正还给堆，电台只留给 AP。
+       出页（wprov_stop）之后再按记住的网络连回去，用户感觉不到。 */
+    /* 🔴 2026-10-26 加：**扫描必须在切纯 AP 之前做**。
+       纯 AP 模式下 STA 接口不存在，`esp_wifi_scan_start()` 直接返回 ESP_ERR_WIFI_MODE
+       （实测 `已扫=0`，而且原代码扫描失败/calloc 失败都是静默 return，日志上根本看不出来）。
+       放在这里扫：此时驱动还开着、堆也最大（22KB），扫完把列表缓存下来，页面和屏都用这份。 */
+    /* 🔴 2026-10-28 加：**没存过网络时 WiFi 驱动根本没 start**，此时 scan_start 直接
+       返回 ESP_ERR_WIFI_NOT_STARTED（真机 `已扫=0`、屏上列表空、手机页面也没得选）。
+       先把驱动拉起来（已经起着就返回 ESP_ERR_WIFI_STATE，忽略）再扫。 */
+    {
+        /* 扫一次全信道要 STA 接口活着：模式必须是 STA/APSTA，纯 AP 下 scan_start 直接 ESP_FAIL */
+        esp_err_t m = esp_wifi_set_mode(WIFI_MODE_APSTA);
+        if (m != ESP_OK && m != ESP_ERR_WIFI_MODE) {
+            ESP_LOGW(TAG, "置 APSTA（为了扫描）-> %s", esp_err_to_name(m));
+        }
+        esp_err_t st = esp_wifi_start();
+        if (st != ESP_OK && st != ESP_ERR_WIFI_STATE) {
+            ESP_LOGW(TAG, "为了扫描先起驱动 -> %s", esp_err_to_name(st));
+        }
+        vTaskDelay(pdMS_TO_TICKS(150));      /* 驱动起来到能扫，给它一点点时间 */
+    }
+    /* 扫一次拿不到东西很常见（刚起射频的第一次扫描经常是 0 个），最多试 3 次 */
+    for (int attempt = 1; attempt <= 3; attempt++) {
+        esp_err_t se = wprov_scan_now();
+        ESP_LOGW(TAG, "扫描第 %d 次：%s，拿到 %d 个网络", attempt, esp_err_to_name(se), wprov_ap_count());
+        if (se == ESP_OK && wprov_ap_count() > 0) break;
+        vTaskDelay(pdMS_TO_TICKS(400));
+    }
+
+    esp_wifi_disconnect();
+    vTaskDelay(pdMS_TO_TICKS(150));
+    {
+        esp_err_t se0 = esp_wifi_stop();
+        if (se0 != ESP_OK && se0 != ESP_ERR_WIFI_NOT_STARTED) {
+            ESP_LOGW(TAG, "停驱动（为了把电台让给热点）-> %s", esp_err_to_name(se0));
+        }
+    }
+    WPROV_TRY(esp_wifi_set_mode(WIFI_MODE_AP));
+
+    /* 趁现在内存还宽（真机 16.9KB / 最大块 6.4KB），先给 httpd 的任务栈占一块 4KB；
+       起 AP 会再吃掉 6~7KB，那时候再去凑一整块 3KB 就全看运气了（真机时好时坏）。
+       占不到不是错误 —— 只是回到"看运气"，打一行日志便于事后对账。 */
+    if (!s_http_res) {
+        s_http_res = heap_caps_malloc(4096, MALLOC_CAP_8BIT);
+        ESP_LOGW(TAG, "给 httpd 预留 4KB：%s（空闲 %u，最大块 %u）",
+                 s_http_res ? "成功" : "没抢到，照常往下走",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    }
+    /* 🔴 2026-10-26 加（作者："手机一直显示网络连接失败"）：
+       ESP32 默认 WIFI_PS_MIN_MODEM（省电）。配网页期间关掉省电 ——
+       省电模式下 AP 的 beacon 与 EAPOL 回帧会被射频调度推迟，手机那侧的四次握手
+       窗口只有几毫秒（日志里的 reason=15 就是 4-way handshake timeout），
+       一等就超时 ⇒ 手机报"网络连接失败"。出配网页时 wprov_stop() 会恢复省电。 */
+    esp_err_t ps = esp_wifi_set_ps(WIFI_PS_NONE);
+    if (ps != ESP_OK) ESP_LOGW(TAG, "关省电没成功（%s）—— 热点可能握手偏慢", esp_err_to_name(ps));
+
+    wifi_config_t ap = {0};
+    strncpy((char *)ap.ap.ssid, s_ap_ssid, sizeof(ap.ap.ssid) - 1);
+    ap.ap.ssid_len = strlen((char *)ap.ap.ssid);
+    strncpy((char *)ap.ap.password, AP_PASS, sizeof(ap.ap.password) - 1);
+    /* 热点信道：**STA 连着时用 STA 的信道**。
+       2026-10-26 真机证据：STA 在 ch1、AP 写死 ch6 时，手机一 associate 就收到
+       `m f deauth reason:1`，紧接着 `new:<6,0>`（信道配置被打回）——AP+STA 只能共用一条射频，
+       IDF 会把 AP 强行挪到 STA 的信道，这一挪就把刚加入的手机踢了。 */
+    uint8_t ap_ch = 6;
+    wifi_ap_record_t sta_rec = {0};
+    if (esp_wifi_sta_get_ap_info(&sta_rec) == ESP_OK && sta_rec.primary >= 1 && sta_rec.primary <= 13) {
+        ap_ch = sta_rec.primary;
+        ESP_LOGI(TAG, "热点跟着 STA 用信道 %u（避免 AP/STA 不同信道来回切）", ap_ch);
+    } else {
+        /* STA 没连/还在连：用**上次连上时记住的信道**（NVS chan0），别再瞎猜 6。
+           2026-10-26 真机：家里路由器在 ch1，盲开 6 就是"手机一连就被踢"的那个坑。 */
+        nvs_handle_t h;
+        uint8_t ch = 0;
+        if (nvs_open(NVS_NS, NVS_READONLY, &h) == ESP_OK) {
+            if (nvs_get_u8(h, "chan0", &ch) == ESP_OK && ch >= 1 && ch <= 13) ap_ch = ch;
+            nvs_close(h);
+        }
+        ESP_LOGW(TAG, "STA 没连上 —— 热点用记住的信道 %u（没有记录就用 6）", ap_ch);
+    }
+    ap.ap.channel = ap_ch;
+    ap.ap.max_connection = 2;               /* 2026-10-26 12:2x 按小迪复盘改回 2（每连接都吃缓冲；4 时堆更紧）
+                                               （页面 + favicon + 联网探测 + 预连接），上限 2 会被拒/被 LRU 踢 */
+    ap.ap.beacon_interval = 100;            /* 显式写死 100ms（默认值，但别靠默认） */
+    ap.ap.authmode = WIFI_AUTH_WPA2_PSK;
+    ap.ap.pmf_cfg.required = false;
+    WPROV_TRY(esp_wifi_set_config(WIFI_IF_AP, &ap));
+
+    wifi_config_t sta = {0};
+    sta.sta.scan_method = WIFI_ALL_CHANNEL_SCAN;
+    /* 🔴 2026-10-26 真机：设备**已经记住一个网络、开机正在连**的时候进「配网」页，
+       这一行会返回 ESP_ERR_WIFI_STATE，原来的 WPROV_TRY 直接让 start_ap 失败 ⇒
+       热点没起来 ⇒ **屏上连二维码都没有**（用户看到的就是"二维码不显示了"）。
+       这一步只是为了给以后的扫描定个 scan_method，失败不该毁掉整页 —— 重试一次，仍失败就带着默认参数继续。 */
+    esp_err_t sta_cfg_err = esp_wifi_set_config(WIFI_IF_STA, &sta);
+    if (sta_cfg_err != ESP_OK) {
+        ESP_LOGW(TAG, "STA 配置没设上（%s）—— 忽略，热点照起", esp_err_to_name(sta_cfg_err));
+        vTaskDelay(pdMS_TO_TICKS(120));
+        sta_cfg_err = esp_wifi_set_config(WIFI_IF_STA, &sta);
+        if (sta_cfg_err != ESP_OK) {
+            ESP_LOGW(TAG, "STA 配置第二次也没设上（%s）—— 继续用默认扫描参数", esp_err_to_name(sta_cfg_err));
+        }
+    }
+
+    ESP_LOGW(TAG, "起 AP 前：8bit %u/%u ｜内部 %u/%u ｜DMA %u/%u",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_DMA),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_DMA));
+    xEventGroupClearBits(s_eg, BIT_AP_STARTED);
+    /* 起不来必须让上层看见：原来的 WPROV_TRY 只记一句日志就 return，
+       demo_provision 又不看返回值 → 屏上照旧打"热点+扫描就绪"，功能其实已经死了
+       （2026-10-25 20 轮实测：第 4 轮起就是这样骗自己的）。 */
+    esp_err_t se = esp_wifi_start();
+    if (se != ESP_OK) {
+        set_err("wifi_start failed", NULL, NULL);
+        s_state = WPROV_FAILED;
+        ESP_LOGE(TAG, "热点起不来：%s（空闲堆 %u B，最大连续块 %u B）", esp_err_to_name(se),
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        return se;
+    }
+    /* 🔴 2026-10-26 真机：`esp_wifi_start()` 返回 OK、AP 也确实起来了（httpd 正常、DHCP 起了），
+       但 `WIFI_EVENT_AP_START` 这一位**没等到** ⇒ 每进一次配网页白等满 8 秒，
+       屏上 13 秒才出二维码（作者的体感就是按了没反应）。改成 1.2 秒兜底：
+       真有事件就立刻过，没事件也不再等满 8 秒；AP 到底起没起，由下面的**参数回读**判定。 */
+    xEventGroupWaitBits(s_eg, BIT_AP_STARTED, pdFALSE, pdTRUE, pdMS_TO_TICKS(1200));
+
+    s_ap_on = true;
+    s_state = s_keep_failed ? WPROV_FAILED : WPROV_AP_UP;
+    s_keep_failed = false;
+    ESP_LOGI(TAG, "SoftAP %s / %s 已开；空闲堆 %u B，最大连续块 %u B", s_ap_ssid, AP_PASS,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+
+    /* 🔴 2026-10-26 加：**回读**真正生效的 AP 参数（不是"我以为设了什么"）。
+       作者要求"完全确认了再让我测试"—— 这几行就是给使用者看的事实：
+       手机连不上的时候，先看这里 ssid/ch/auth/maxconn/ps 是不是期望值。 */
+    {
+        wifi_config_t chk = {0};
+        wifi_ps_type_t psv = WIFI_PS_MIN_MODEM;
+        esp_wifi_get_ps(&psv);
+        if (esp_wifi_get_config(WIFI_IF_AP, &chk) == ESP_OK) {
+            ESP_LOGW(TAG, "AP 回读：ssid=%s ch=%u auth=%d maxconn=%u beacon=%u 省电=%d",
+                     (char *)chk.ap.ssid, (unsigned)chk.ap.channel, (int)chk.ap.authmode,
+                     (unsigned)chk.ap.max_connection, (unsigned)chk.ap.beacon_interval, (int)psv);
+            if (chk.ap.authmode == WIFI_AUTH_OPEN) {
+                ESP_LOGE(TAG, "AP 回读：加密方式居然是 OPEN —— 手机可能按开放网络连，握手必失败");
+            }
+            if (strncmp((char *)chk.ap.ssid, s_ap_ssid, sizeof(chk.ap.ssid)) != 0) {
+                ESP_LOGE(TAG, "AP 回读：SSID 与二维码里的不一致（二维码=%s，实际=%s）",
+                         s_ap_ssid, (char *)chk.ap.ssid);
+            }
+        } else {
+            ESP_LOGE(TAG, "AP 参数回读失败 —— 下面这些判据不可信");
+        }
+    }
+
+    /* 把预留的 4KB 还回去再建 httpd 任务：刚释放的块会优先被这次 xTaskCreate 拿走 */
+    if (s_http_res) { heap_caps_free(s_http_res); s_http_res = NULL; }
+    wprov_http_start();                     /* 网页 + 通配 DNS（失败不致命，屏上还有二维码） */
+    return ESP_OK;
+}
+
+void wprov_stop(void)
+{
+    if (!s_wifi_inited) { s_state = WPROV_IDLE; return; }
+
+    const uint32_t h0 = heap_caps_get_free_size(MALLOC_CAP_8BIT);
+
+    /* 顺序：先让网页把话说完 → 停扫描 → 断 STA → 停驱动 → 模式清空。
+       只"关"不 deinit：每轮 deinit/init 一次会把堆打碎（20 轮实测最大连续块 49152→6656），
+       而且 AP/扫描还在跑时 deinit 根本失败（Failed to deinit Wi-Fi driver 0x3001）。 */
+    wprov_http_stop();
+    /* 起 AP 半路失败时会给 httpd 预留过 4KB（见 wprov_start_ap），这里兜住别漏 */
+    if (s_http_res) { heap_caps_free(s_http_res); s_http_res = NULL; }
+    s_fast = false;
+    s_connecting = false;
+    esp_wifi_scan_stop();
+    esp_wifi_disconnect();
+    esp_err_t e = esp_wifi_stop();
+    if (e != ESP_OK && e != ESP_ERR_WIFI_NOT_STARTED) {
+        ESP_LOGW(TAG, "wifi_stop -> %s（继续往下收）", esp_err_to_name(e));
+    }
+    esp_wifi_set_mode(WIFI_MODE_NULL);      /* 让下一次 set_mode 从干净状态开始 */
+    /* 出配网页就把省电还给系统（配网期间是 WIFI_PS_NONE，见 wprov_start_ap） */
+    esp_wifi_set_ps(WIFI_PS_MIN_MODEM);
+
+    s_ap_on = false;
+    s_sta_count = 0;
+    s_state = WPROV_IDLE;
+    ESP_LOGI(TAG, "网已安静（驱动保留）：空闲堆 %u→%u B，最大连续块 %u B",
+             (unsigned)h0, (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+}
+
+/* ------------------------------------------------------------------ 扫描 */
+static int cmp_rssi(const void *a, const void *b)
+{
+    return ((const wprov_ap_t *)b)->rssi - ((const wprov_ap_t *)a)->rssi;
+}
+
+esp_err_t wprov_scan_now(void)
+{
+    if (!s_wifi_inited) return ESP_ERR_INVALID_STATE;
+    /* 🔴 2026-10-26 加：已经有手机连着热点时**不许扫描**。
+       APSTA 下扫一次全信道 = 射频离开 AP 的信道几百毫秒；正在四次握手的手机直接被踢
+       （真机日志：`GET /` 正常、随后 `deauth`/`reason=15`，人看到的就是"网络连接失败"）。
+       列表用上一次扫的结果就够（进页面时已经扫过一遍）。 */
+    if (s_sta_count > 0) {
+        ESP_LOGW(TAG, "已有 %d 个手机连着热点 —— 跳过扫描（扫一次会把它踢下线）", s_sta_count);
+        return ESP_ERR_INVALID_STATE;
+    }
+    s_state = WPROV_SCANNING;
+
+    wifi_scan_config_t sc = { .show_hidden = false, .scan_type = WIFI_SCAN_TYPE_ACTIVE };
+    esp_err_t err = esp_wifi_scan_start(&sc, true);
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "扫描起不来（%s）—— STA 接口没开时扫不了，列表只能靠页面手打名字",
+                 esp_err_to_name(err));
+        s_state = WPROV_AP_UP;
+        return err;
+    }
+
+    uint16_t num = WPROV_MAX_AP;
+    wifi_ap_record_t *recs = calloc(WPROV_MAX_AP, sizeof(wifi_ap_record_t));
+    if (!recs) {
+        /* 2026-10-25 的教训：静默 return 是排查毒药 —— 这里必须留一行 */
+        ESP_LOGE(TAG, "扫描记录缓冲申请失败（要 %u B，空闲堆 %u，最大连续块 %u）",
+                 (unsigned)(WPROV_MAX_AP * sizeof(wifi_ap_record_t)),
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        s_state = WPROV_AP_UP;
+        return ESP_ERR_NO_MEM;
+    }
+
+    err = esp_wifi_scan_get_ap_records(&num, recs);
+    s_list_n = 0;
+    if (err == ESP_OK) {
+        for (int i = 0; i < num && s_list_n < WPROV_MAX_AP; i++) {
+            if (recs[i].ssid[0] == 0) continue;
+            snprintf(s_list[s_list_n].ssid, sizeof(s_list[s_list_n].ssid), "%s", (const char *)recs[i].ssid);
+            s_list[s_list_n].rssi = recs[i].rssi;
+            s_list[s_list_n].channel = recs[i].primary;
+            s_list[s_list_n].secure = recs[i].authmode != WIFI_AUTH_OPEN;
+            s_list_n++;
+        }
+        qsort(s_list, s_list_n, sizeof(wprov_ap_t), cmp_rssi);
+    }
+    free(recs);
+    s_state = WPROV_AP_UP;
+    ESP_LOGI(TAG, "扫到 %d 个 WiFi", s_list_n);
+    return err;
+}
+int wprov_ap_count(void) { return s_list_n; }
+const wprov_ap_t *wprov_ap_list(void) { return s_list; }
+
+/* ------------------------------------------------------------------ NVS（多网络） */
+static esp_err_t nvs_put(const char *k, const char *v)
+{
+    nvs_handle_t h;
+    esp_err_t e = nvs_open(NVS_NS, NVS_READWRITE, &h);
+    if (e != ESP_OK) return e;
+    e = nvs_set_str(h, k, v);
+    if (e == ESP_OK) e = nvs_commit(h);
+    nvs_close(h);
+    return e;
+}
+static esp_err_t nvs_get(const char *k, char *out, size_t n)
+{
+    nvs_handle_t h;
+    esp_err_t e = nvs_open(NVS_NS, NVS_READONLY, &h);
+    if (e != ESP_OK) return e;
+    size_t len = n;
+    e = nvs_get_str(h, k, out, &len);
+    nvs_close(h);
+    return e;
+}
+
+static int saved_count(void)
+{
+    nvs_handle_t h;
+    uint8_t n = 0;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) return 0;
+    if (nvs_get_u8(h, NVS_K_COUNT, &n) != ESP_OK) n = 0;
+    nvs_close(h);
+    return n > MAX_SAVED ? MAX_SAVED : n;
+}
+
+static esp_err_t saved_set_count(int n)
+{
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return ESP_FAIL;
+    esp_err_t e = nvs_set_u8(h, NVS_K_COUNT, (uint8_t)n);
+    if (e == ESP_OK) e = nvs_commit(h);
+    nvs_close(h);
+    return e;
+}
+
+/* 读第 i 个（0 = 最近用过的） */
+static esp_err_t saved_get(int i, char *ssid, size_t sn, char *pass, size_t pn)
+{
+    char k[12];
+    snprintf(k, sizeof(k), "s%d", i);
+    if (nvs_get(k, ssid, sn) != ESP_OK) return ESP_ERR_NOT_FOUND;
+    snprintf(k, sizeof(k), "p%d", i);
+    if (nvs_get(k, pass, pn) != ESP_OK) pass[0] = 0;
+    return ESP_OK;
+}
+
+static void saved_del(int i)
+{
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return;
+    char k[12];
+    snprintf(k, sizeof(k), "s%d", i); nvs_erase_key(h, k);
+    snprintf(k, sizeof(k), "p%d", i); nvs_erase_key(h, k);
+    nvs_commit(h);
+    nvs_close(h);
+}
+
+/* 成功后记住这个网络：新的放第 0 位，去重，最多 3 个（用临时数组，避免自重叠） */
+static void saved_push(const char *ssid, const char *pass)
+{
+    char old_s[MAX_SAVED][33] = {{0}}, old_p[MAX_SAVED][65] = {{0}};
+    int n = 0, cnt = saved_count();
+
+    for (int i = 0; i < cnt && n < MAX_SAVED - 1; i++) {
+        char ts[33] = {0}, tp[65] = {0};
+        if (saved_get(i, ts, sizeof(ts), tp, sizeof(tp)) != ESP_OK) continue;
+        if (strcmp(ts, ssid) == 0) continue;
+        memcpy(old_s[n], ts, sizeof(ts));
+        memcpy(old_p[n], tp, sizeof(tp));
+        n++;
+    }
+
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return;
+    char k[12];
+    snprintf(k, sizeof(k), "s0"); nvs_set_str(h, k, ssid);
+    snprintf(k, sizeof(k), "p0"); nvs_set_str(h, k, pass ? pass : "");
+    for (int i = 0; i < n; i++) {
+        snprintf(k, sizeof(k), "s%d", i + 1); nvs_set_str(h, k, old_s[i]);
+        snprintf(k, sizeof(k), "p%d", i + 1); nvs_set_str(h, k, old_p[i]);
+    }
+    nvs_set_u8(h, NVS_K_COUNT, (uint8_t)(n + 1));
+    nvs_set_str(h, NVS_K_SSID, ssid);
+    nvs_set_str(h, NVS_K_PASS, pass ? pass : "");
+    nvs_commit(h);
+    nvs_close(h);
+    ESP_LOGI(TAG, "已记住 %d 个网络（最近：%s）", n + 1, ssid);
+}
+
+esp_err_t wprov_load_saved(char *ssid, size_t n, char *pass, size_t m)
+{
+    esp_err_t e = nvs_flash_init();
+    if (e != ESP_OK && e != ESP_ERR_INVALID_STATE) return e;
+    if (saved_count() == 0) return ESP_ERR_NOT_FOUND;
+    return saved_get(0, ssid, n, pass, m);
+}
+
+int wprov_saved_count(void) { return saved_count(); }
+
+esp_err_t wprov_find_saved(const char *ssid, char *pass, size_t n)
+{
+    if (!ssid || !ssid[0]) return ESP_ERR_INVALID_ARG;
+    int cnt = saved_count();
+    for (int i = 0; i < cnt; i++) {
+        char ts[33] = {0}, tp[65] = {0};
+        if (saved_get(i, ts, sizeof(ts), tp, sizeof(tp)) != ESP_OK) continue;
+        if (strcmp(ts, ssid) == 0) {
+            if (pass && n) snprintf(pass, n, "%s", tp);
+            return ESP_OK;
+        }
+    }
+    return ESP_ERR_NOT_FOUND;
+}
+
+int  wprov_fail_streak(void) { return s_fail_streak; }
+bool wprov_fail_locked(void) { return s_fail_locked; }
+
+void wprov_reset_fail(void)
+{
+    s_fail_streak = 0;
+    s_fail_locked = false;
+    s_err[0] = 0;
+    ESP_LOGI(TAG, "失败计数已清零");
+}
+
+void wprov_last_used_ssid(char *out, size_t n)
+{
+    if (!out || !n) return;
+    out[0] = 0;
+    char ts[33] = {0}, tp[65] = {0};
+    if (saved_get(0, ts, sizeof(ts), tp, sizeof(tp)) == ESP_OK) {
+        snprintf(out, n, "%s", ts);
+    }
+}
+
+/* 老固件只存了 ssid/pass 两个键：升级后自动搬进第 0 个槽，别让用户重配 */
+static void saved_migrate_legacy(void)
+{
+    if (saved_count() > 0) return;
+    char ts[33] = {0}, tp[65] = {0};
+    if (nvs_get(NVS_K_SSID, ts, sizeof(ts)) != ESP_OK || !ts[0]) return;
+    nvs_get(NVS_K_PASS, tp, sizeof(tp));
+    ESP_LOGI(TAG, "迁移旧凭据 %s → 第 0 个网络", ts);
+    saved_push(ts, tp);
+}
+
+esp_err_t wprov_forget_all(void)
+{
+    for (int i = 0; i < MAX_SAVED; i++) saved_del(i);
+    saved_set_count(0);
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) == ESP_OK) {
+        nvs_erase_key(h, NVS_K_SSID); nvs_erase_key(h, NVS_K_PASS);
+        nvs_commit(h); nvs_close(h);
+    }
+    return ESP_OK;
+}
+
+/* ------------------------------------------------------------------ 连真 AP（先连上，再落盘） */
+static esp_err_t do_connect(char *ssid, char *pass, bool allow_ap_fallback)
+{
+    ESP_LOGI(TAG, "开始连 %s（动网前空闲堆 %u B）", ssid,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT));
+    s_state = WPROV_CONNECTING;
+    s_err[0] = 0;
+    s_retry = 0;
+
+    /* 先把 /api/connect 的响应发完，别在 httpd 正在回包时拆它的台（上一版就是这么 panic 的） */
+    vTaskDelay(pdMS_TO_TICKS(400));
+
+    /* 彻底停掉 APSTA，再以干净的 STA 状态重来（APSTA→STA 直接切会留下半挂的 netif） */
+    esp_wifi_scan_stop();
+    esp_wifi_stop();
+    s_ap_on = false;
+
+    /* STA 的默认 netif 必须在 set_mode/start 之前建好，否则 DHCP client 挂不上 */
+    if (!s_sta_netif_made) {
+        s_sta_netif = esp_netif_create_default_wifi_sta();
+        s_sta_netif_made = s_sta_netif != NULL;
+    }
+    if (!s_sta_netif_made) {
+        set_err("STA netif alloc failed", NULL, NULL);
+        s_state = WPROV_FAILED;
+        if (allow_ap_fallback) wprov_start_ap();
+        return ESP_ERR_NO_MEM;
+    }
+
+    esp_err_t e = esp_wifi_set_mode(WIFI_MODE_STA);
+    if (e != ESP_OK) { set_err("set_mode failed", NULL, NULL); goto fail; }
+
+    wifi_config_t sta = {0};
+    strncpy((char *)sta.sta.ssid, ssid, sizeof(sta.sta.ssid) - 1);
+    strncpy((char *)sta.sta.password, pass, sizeof(sta.sta.password) - 1);
+    sta.sta.threshold.authmode = WIFI_AUTH_OPEN;
+    if (s_fast) {
+        memcpy(sta.sta.bssid, s_fast_bssid, 6);
+        sta.sta.bssid_set = true;
+        sta.sta.channel = s_fast_chan;
+        ESP_LOGI(TAG, "快连模式：跳过扫描，直连 %02x:%02x:%02x:%02x:%02x:%02x ch%d",
+                 s_fast_bssid[0], s_fast_bssid[1], s_fast_bssid[2],
+                 s_fast_bssid[3], s_fast_bssid[4], s_fast_bssid[5], s_fast_chan);
+    }
+    s_connect_t0 = esp_timer_get_time();
+    e = esp_wifi_set_config(WIFI_IF_STA, &sta);
+    if (e != ESP_OK) { set_err("set_config failed", NULL, NULL); goto fail; }
+
+    s_connecting = true;
+    xEventGroupClearBits(s_eg, BIT_STA_GOT_IP);
+    e = esp_wifi_start();                 /* 这一步才会让 esp_netif 起 DHCP client */
+    if (e != ESP_OK) { set_err("wifi_start failed", NULL, NULL); goto fail; }
+
+    e = esp_wifi_connect();
+    if (e != ESP_OK) { set_err("connect() failed", NULL, NULL); goto fail; }
+
+    if (xEventGroupWaitBits(s_eg, BIT_STA_GOT_IP, pdTRUE, pdTRUE, pdMS_TO_TICKS(s_connect_timeout_ms)) & BIT_STA_GOT_IP) {
+        /* 只有真连上才覆盖旧凭据 */
+        esp_err_t nv = nvs_flash_init();
+        if (nv == ESP_OK || nv == ESP_ERR_INVALID_STATE) saved_push(ssid, pass);
+        s_connecting = false;
+        s_state = WPROV_CONNECTED;
+        s_fast = false;
+        s_fail_streak = 0;
+        s_fail_locked = false;
+        snprintf(s_connected_ssid, sizeof(s_connected_ssid), "%s", ssid);
+        wprov_http_stop();                /* 成功了，网页/DNS 收摊 */
+        ESP_LOGI(TAG, "连上 %s，凭据已保存；空闲堆 %u B", ssid,
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT));
+        return ESP_OK;
+    }
+    set_err("cannot join %s", ssid, NULL);
+
+fail:
+    s_connecting = false;
+    s_fast = false;
+    s_fail_streak++;
+    if (s_fail_streak >= 3) {
+        s_fail_locked = true;
+        ESP_LOGE(TAG, "连续失败 %d 次，封顶：不再自动重试（按 ● 重置）", s_fail_streak);
+        snprintf(s_err, sizeof(s_err), "%d fails - stopped", s_fail_streak);
+    }
+    s_state = WPROV_FAILED;
+    esp_wifi_disconnect();
+    s_last_ip[0] = 0;
+    if (allow_ap_fallback) {
+        /* 失败不要拆 httpd/DNS（拆了再建会把最大连续块砍半，而且手机得等 8 秒）。
+           直接把 AP 重新抬起来，页面立刻还能用；状态留在 FAILED。 */
+        s_ap_on = false;
+        s_keep_failed = true;
+        wprov_start_ap();
+        s_state = WPROV_FAILED;
+    }
+    return ESP_FAIL;
+}
+
+esp_err_t wprov_connect_new(const char *ssid, const char *pass)
+{
+    if (!ssid || !ssid[0]) return ESP_ERR_INVALID_ARG;
+    return do_connect((char *)ssid, (char *)pass ? (char *)pass : "", true);
+}
+
+/* 网页线程只投递请求，连接在 worker 里做（避免堵住 httpd） */
+esp_err_t wprov_request_connect(const char *ssid, const char *pass)
+{
+    if (!ssid || !ssid[0]) return ESP_ERR_INVALID_ARG;
+    if (s_fail_locked) {
+        ESP_LOGW(TAG, "已封顶（连续失败 %d 次），先 wprov_reset_fail()", s_fail_streak);
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (strlen(ssid) > 32 || (pass && strlen(pass) > 64)) return ESP_ERR_INVALID_SIZE;
+    taskENTER_CRITICAL(&s_mux);
+    snprintf(s_pend_ssid, sizeof(s_pend_ssid), "%s", ssid);
+    snprintf(s_pend_pass, sizeof(s_pend_pass), "%s", pass ? pass : "");
+    taskEXIT_CRITICAL(&s_mux);
+    xSemaphoreGive(s_req);
+    s_state = WPROV_CONNECTING;
+    return ESP_OK;
+}
+
+esp_err_t wprov_autoconnect(void)
+{
+    esp_err_t e = wprov_init();
+    if (e != ESP_OK) return e;
+    saved_migrate_legacy();
+    int n = saved_count();
+    if (n == 0) {
+        ESP_LOGI(TAG, "没有保存过 WiFi，跳过自动连接");
+        return ESP_ERR_NOT_FOUND;
+    }
+    ESP_LOGI(TAG, "开机自动连：共记住 %d 个网络，依次尝试", n);
+    for (int i = 0; i < n; i++) {
+        char ssid[33] = {0}, pass[65] = {0};
+        if (saved_get(i, ssid, sizeof(ssid), pass, sizeof(pass)) != ESP_OK) continue;
+        ESP_LOGI(TAG, "[%d/%d] 试 %s …", i + 1, n, ssid);
+        s_connect_timeout_ms = 12000;             /* 其余网络：12s */
+        s_fast = false;
+        if (i == 0) {                             /* 上次用的那个：先快连，8s 足够 */
+            nvs_handle_t h;
+            size_t bl = 6;
+            uint8_t ch = 0;
+            if (nvs_open(NVS_NS, NVS_READONLY, &h) == ESP_OK) {
+                if (nvs_get_blob(h, "bssid0", s_fast_bssid, &bl) == ESP_OK && bl == 6 &&
+                    nvs_get_u8(h, "chan0", &ch) == ESP_OK && ch >= 1 && ch <= 14) {
+                    s_fast_chan = ch;
+                    s_fast = true;
+                }
+                nvs_close(h);
+            }
+            s_connect_timeout_ms = 8000;
+        }
+        esp_err_t r = do_connect(ssid, pass, false);
+        s_connect_timeout_ms = 25000;
+        if (r == ESP_OK) {
+            ESP_LOGI(TAG, "自动连接结果: 成功 %s (%s)", ssid, s_last_ip);
+            return ESP_OK;
+        }
+        ESP_LOGW(TAG, "[%d/%d] %s 没连上（%s），换下一个", i + 1, n, ssid, wprov_last_error());
+    }
+
+    /* 第二遍：全部按"普通扫描"再来一次。
+       为什么要这遍：第一遍第 0 个用的是记住的 BSSID/信道；万一路由器换了信道或换了 AP 节点，
+       快连会失败——但那个网其实还在，不走第二遍就等于把它跳过了。 */
+    ESP_LOGW(TAG, "第一遍全部失败，改用普通扫描重试 %d 个网络", n);
+    for (int i = 0; i < n; i++) {
+        char ssid[33] = {0}, pass[65] = {0};
+        if (saved_get(i, ssid, sizeof(ssid), pass, sizeof(pass)) != ESP_OK) continue;
+        ESP_LOGI(TAG, "[重试 %d/%d] %s …", i + 1, n, ssid);
+        s_fast = false;
+        s_connect_timeout_ms = 12000;
+        if (do_connect(ssid, pass, false) == ESP_OK) {
+            ESP_LOGI(TAG, "自动连接结果: 第二遍成功 %s (%s)", ssid, s_last_ip);
+            return ESP_OK;
+        }
+    }
+
+    ESP_LOGE(TAG, "自动连接结果: 全部失败（%d 个网络，两遍都试过）", n);
+    return ESP_FAIL;
+}
+
+static void worker(void *arg)
+{
+    while (1) {
+        if (xSemaphoreTake(s_req, portMAX_DELAY) == pdTRUE) {
+            do_connect(s_pend_ssid, s_pend_pass, true);
+        }
+    }
+}
+
+esp_err_t wprov_start_worker(void)
+{
+    /* 🔴 只建一次。worker 是常驻 while(1) 循环、永不退出；原来每进一次配网页就再建一个，
+       等于每轮永久吃掉一个 5120 B 的栈 + TCB —— B2 报告里"每轮漏 5.6KB"的真身就是它，
+       不是 WiFi 驱动（2026-10-25 20 轮实测：heap 69772→33412、第 4 轮起配网直接失效）。 */
+    if (s_worker_on) return ESP_OK;
+    if (xTaskCreate(worker, "wprov", 5120, NULL, 5, NULL) != pdPASS) return ESP_ERR_NO_MEM;
+    s_worker_on = true;
+    return ESP_OK;
+}
