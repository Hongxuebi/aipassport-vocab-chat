diff --git a/components/pet_mood/include/pet_mood.h b/components/pet_mood/include/pet_mood.h
new file mode 100644
index 0000000..9b62af9
--- /dev/null
+++ b/components/pet_mood/include/pet_mood.h
@@ -0,0 +1,115 @@
+// components/pet_mood/include/pet_mood.h —— 桌宠性格状态机（纯逻辑，不碰 LVGL/esp，可 host 测）
+//
+// 核心口径（项目 `65` §5）：**脸是死的，"什么时候翻到背面"才是性格**。
+//   · 每个事件先给一张**表层**脸（她在你面前的反应）
+//   · 1.8 s 内没有新输入，才允许翻**里层**（她一个人的时候）—— 被看见就躲
+//   · 里层停留 2.8 s 后回待机；两次破功之间**冷却 12 s**（不然一直翻，就不稀罕了）
+//   · 亲密度 L0/L1/L2 决定哪些里层脸解锁；L0 只到"开心"为止
+//
+// 表驱动，逐条对应 `65` §5 的迁移表；`test/host_test.c` 把那张表当断言跑。
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 脸位编号 = 表情包里 face_id（见 65 §3） */
+enum {
+    PM_NEUTRAL = 0, PM_SNARK, PM_SMUG, PM_GUILTY, PM_THINK, PM_SLEEP,
+    PM_HAPPY, PM_SOFT, PM_SHY, PM_DONTGO, PM_CRY, PM_DAZED,
+    /* 12/13 = 摸鱼这一档的说话嘴型；每个情绪的 {闭/半/大} 见 demo_pet.c 的 `k_face3[12][3]`
+       （**嘴型不是情绪**，是她出声时的一层显示覆盖，由音量驱动，不进迁移表） */
+    PM_TALK_HALF = 12, PM_TALK_OPEN = 13,
+    /* 36 = 道别微笑（L0/L1 走时露一张，无嘴型；PRD §4.7 的收尾张） */
+    PM_FAREWELL   = 36,
+    PM_NONE = 0xFF,
+};
+
+typedef enum {
+    PM_EV_TAP = 0,        /* ● 短按 */
+    PM_EV_TALK_START,     /* 按住 ● */
+    PM_EV_TALK_END,       /* 松手、开始上传 */
+    PM_EV_REPLY_START,    /* 收到第一个音频字节 */
+    PM_EV_REPLY_END,      /* 播完（演得意→1.8s→里层） */
+    PM_EV_REPLY_DONE,     /* 说完·直接回中性（2026-10-29 定：说完默认回第 0 张摸鱼） */
+    PM_EV_FAIL,           /* 超时/断链/0 字节 */
+    PM_EV_TOMATO,         /* 番茄完成 */
+    PM_EV_LEAVE,          /* 长按▲ 返回 */
+    PM_EV_REUNION_6H,     /* 6–24 h 没见 */
+    PM_EV_REUNION_24H,    /* >24 h 没见 */
+    PM_EV_WAKE,           /* 睡着被叫醒 */
+    PM_EV_TICK,           /* 节拍（调用方按 100 ms 喂） */
+    PM_EV_COUNT
+} pm_event_t;
+
+#define PM_BREAK_MS     1800u    /* 表层 → 破功 的延迟 */
+#define PM_HOLD_MS      2800u    /* 里层停留 */
+#define PM_COOLDOWN_MS  12000u   /* 破功冷却 */
+#define PM_NAG_MS       1500u    /* 松手 1.5 s 还没回话 = 催你 */
+#define PM_SHY_HOLD_MS  4000u    /* 害羞说完再挂 4 s 才化开（作者 19:5x 定的"半衰"） */
+#define PM_TAP_HOLD_MS  1200u    /* 单戳：嫌弃 1.2 s */
+#define PM_DAZED_MS      800u    /* 刚醒：迷糊 0.8 s */
+#define PM_MULTI_TAP_GAP 1500u   /* 连戳窗口 */
+#define PM_TAP_BREAK     3u      /* 戳几下算戳穿 */
+#define PM_IDLE_MS      30000u   /* 30 s 没动静 → 困倦 */
+#define PM_SLEEP_MS    240000u   /* 4 min → 睡着 */
+
+typedef struct {
+    uint8_t  level;        /* 0/1/2 */
+    uint8_t  face;         /* 当前脸 */
+    uint8_t  next;         /* 到点换成哪张（PM_NONE = 不变） */
+    uint32_t until;        /* 换脸时刻（0 = 常驻） */
+    uint32_t last_break;   /* 上次破功时刻（冷却用） */
+    uint8_t  have_break;   /* 破功过没有 —— 第一次不许被冷却吃掉 */
+    uint32_t last_input;   /* 上次交互（待机衰减用） */
+    uint32_t tap_t0;       /* 连戳窗口起点 */
+    uint8_t  tap_n;        /* 本窗口内戳了几下 */
+    uint8_t  sleeping;     /* 已进入睡眠态 */
+} pm_t;
+
+/* 初始化；level 0..2（越界会夹） */
+void pm_init(pm_t *m, uint8_t level, uint32_t now_ms);
+
+/* 喂一个事件；返回**立刻要显示的脸**，-1 = 不用动 */
+int pm_event(pm_t *m, pm_event_t ev, uint32_t now_ms);
+
+/* 每 100 ms 喂一次；到点该换脸就返回新脸，否则 -1 */
+int pm_tick(pm_t *m, uint32_t now_ms);
+
+/* 说完·保持情绪（2026-10-29 M1，PRD §4.4）：
+   把内部脸设为**开口那一刻的情绪**（调用方传闭档那张），并在 PM_BREAK_MS 后按亲密度回落。
+   不是"一律回摸鱼"——13:4x 定下来的。 */
+int pm_hold(pm_t *m, uint8_t face, uint32_t now_ms);
+
+/* 亲密度（调试用：+1/-1，会夹在 0..2） */
+void pm_shift_level(pm_t *m, int delta);
+
+/* ---- 亲密度 → 等级（纯函数，好测）---- */
+#define PM_INTIMACY_L1   20u   /* 聊满 20 次到 L1 */
+#define PM_INTIMACY_L2   80u   /* 80 次到 L2 */
+#define PM_INTIMACY_MAX 999u
+uint8_t pm_level_of(uint16_t int家用电脑y);
+
+/* ---- 隔了多久没见 → 该发哪个重逢事件 ---- */
+#define PM_REUNION_6H_S   (6u * 3600u)
+#define PM_REUNION_24H_S  (24u * 3600u)
+/* 返回：1 = 有事件（写进 *ev）；0 = 不算重逢（首次用没记录 / 刚见过） */
+int pm_reunion(uint32_t now_s, uint32_t last_seen_s, pm_event_t *ev);
+
+static inline uint8_t pm_face(const pm_t *m) { return m->face; }
+
+/* 直接摆一张脸（戳的反应、连戳随机）：只改"当前脸"，不排后续衰减 ——
+   调用方自己管节奏（demo_pet 的 s_tap_back_until）。
+   ⚠️ 必须同步内部脸，否则下一次开口的骨架是旧的（2026-10-29 真机踩过）。 */
+static inline void pm_face_show(pm_t *m, uint8_t f)
+{
+    m->face  = f;
+    m->until = 0;
+    m->next  = PM_NONE;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/pet_mood/pet_mood.c b/components/pet_mood/pet_mood.c
new file mode 100644
index 0000000..2fa0ce2
--- /dev/null
+++ b/components/pet_mood/pet_mood.c
@@ -0,0 +1,228 @@
+// components/pet_mood/pet_mood.c —— 性格状态机（表驱动，纯 C）
+//
+// 迁移表就在 `65` §5；这里一条一条照着写。**改这里 = 改性格**，别在 UI 层再写第二份。
+#include "pet_mood.h"
+
+#include <stdbool.h>
+#include <string.h>
+
+/* 里层脸：6..10 是"背面"，11 迷糊是短暂的过渡态 */
+#define IS_INNER(f)   ((f) >= PM_HAPPY && (f) <= PM_CRY)
+/* 需要冷却的"真破功"：心软/害羞/求别走/大哭。开心(6) 是常态里的里层，不挡。 */
+#define IS_REVEAL(f)  ((f) >= PM_SOFT && (f) <= PM_CRY)
+
+static void clamp_level(pm_t *m)
+{
+    if (m->level > 2) m->level = 2;
+}
+
+/* 安排"到点换脸" */
+static void schedule(pm_t *m, uint32_t delay_ms, uint8_t next, uint32_t now)
+{
+    m->until = now + delay_ms;
+    m->next  = next;
+}
+
+void pm_init(pm_t *m, uint8_t level, uint32_t now_ms)
+{
+    memset(m, 0, sizeof(*m));
+    m->level   = level;
+    clamp_level(m);
+    m->face    = PM_NEUTRAL;
+    m->next    = PM_NONE;
+    m->last_input = now_ms;
+}
+
+uint8_t pm_level_of(uint16_t int家用电脑y)
+{
+    if (int家用电脑y >= PM_INTIMACY_L2) return 2;
+    if (int家用电脑y >= PM_INTIMACY_L1) return 1;
+    return 0;
+}
+
+int pm_reunion(uint32_t now_s, uint32_t last_seen_s, pm_event_t *ev)
+{
+    if (ev) *ev = PM_EV_COUNT;
+    if (last_seen_s == 0 || now_s <= last_seen_s) return 0;   /* 首次用 / 钟没对 */
+    const uint32_t dt = now_s - last_seen_s;
+    if (dt >= PM_REUNION_24H_S) { if (ev) *ev = PM_EV_REUNION_24H; return 1; }
+    if (dt >= PM_REUNION_6H_S)  { if (ev) *ev = PM_EV_REUNION_6H;  return 1; }
+    return 0;
+}
+
+void pm_shift_level(pm_t *m, int delta)
+{
+    int v = (int)m->level + delta;
+    if (v < 0) v = 0;
+    if (v > 2) v = 2;
+    m->level = (uint8_t)v;
+}
+
+int pm_event(pm_t *m, pm_event_t ev, uint32_t now_ms)
+{
+    m->last_input = now_ms;
+    if (ev != PM_EV_TICK) {
+        m->sleeping = 0;
+        /* 除 TICK 外的任何输入都取消"待破功"：被看见就躲 */
+        m->until = 0;
+        m->next  = PM_NONE;
+    }
+
+    switch (ev) {
+        case PM_EV_TALK_START:
+            m->face = PM_THINK;
+            return m->face;
+
+        case PM_EV_TALK_END:              /* 松手：先等回复，1.5 s 没回就催 */
+            m->face = PM_THINK;
+            schedule(m, PM_NAG_MS, PM_SNARK, now_ms);
+            return m->face;
+
+        case PM_EV_REPLY_START:
+            m->face = PM_SMUG;            /* 她张嘴的那一下：得意的 */
+            return m->face;
+
+        case PM_EV_REPLY_END:             /* 说完了：得意 → 1.8 s → 里层 */
+            m->face = PM_SMUG;
+            schedule(m, PM_BREAK_MS, m->level >= 1 ? PM_HAPPY : PM_NEUTRAL, now_ms);
+            return m->face;
+
+        case PM_EV_REPLY_DONE:            /* 说完·回中性：不演得意，直接就是第 0 张摸鱼 */
+            m->face = PM_NEUTRAL;
+            return m->face;
+
+        case PM_EV_FAIL:                  /* 没接上：心虚 → 心软 */
+            m->face = PM_GUILTY;
+            schedule(m, PM_BREAK_MS, m->level >= 1 ? PM_SOFT : PM_NEUTRAL, now_ms);
+            return m->face;
+
+        case PM_EV_TOMATO:                /* 番茄完成：得意 → 开心（不设门槛） */
+            m->face = PM_SMUG;
+            schedule(m, PM_BREAK_MS, PM_HAPPY, now_ms);
+            return m->face;
+
+        case PM_EV_TAP: {
+            if (m->tap_n == 0 || (uint32_t)(now_ms - m->tap_t0) > PM_MULTI_TAP_GAP) {
+                m->tap_n  = 0;
+                m->tap_t0 = now_ms;
+            }
+            m->tap_n++;
+            m->face = PM_SNARK;
+            if (m->tap_n >= PM_TAP_BREAK) {          /* 戳穿了 */
+                m->tap_n = 0;
+                schedule(m, PM_BREAK_MS, m->level >= 2 ? PM_SHY : PM_NEUTRAL, now_ms);
+            } else {
+                schedule(m, PM_TAP_HOLD_MS, PM_NEUTRAL, now_ms);
+            }
+            return m->face;
+        }
+
+        case PM_EV_LEAVE:                 /* 要求走：嘴硬；L2 才拽，L0/L1 给一张道别微笑 */
+            m->face = PM_SNARK;
+            schedule(m, PM_BREAK_MS, m->level >= 2 ? PM_DONTGO : PM_FAREWELL, now_ms);
+            return m->face;
+
+        case PM_EV_REUNION_6H:
+            m->face = PM_NEUTRAL;
+            schedule(m, PM_BREAK_MS, m->level >= 1 ? PM_HAPPY : PM_NEUTRAL, now_ms);
+            return m->face;
+
+        case PM_EV_REUNION_24H:           /* 一天多没见：L2 直接哭 */
+            m->face = PM_NEUTRAL;
+            schedule(m, PM_BREAK_MS,
+                     m->level >= 2 ? PM_CRY : (m->level >= 1 ? PM_HAPPY : PM_NEUTRAL), now_ms);
+            return m->face;
+
+        case PM_EV_WAKE:                  /* 被叫醒：迷糊一下 */
+            m->face = PM_DAZED;
+            schedule(m, PM_DAZED_MS, PM_NEUTRAL, now_ms);
+            return m->face;
+
+        case PM_EV_TICK:
+        default:
+            return -1;
+    }
+}
+
+int pm_hold(pm_t *m, uint8_t face, uint32_t now_ms)
+{
+    m->last_input = now_ms;
+    m->sleeping   = 0;
+    m->until      = 0;
+    m->next       = PM_NONE;
+    m->face       = face;
+
+    /* 说完之后这张脸"赖不赖住"分三类（2026-10-29 晚按玩家视角改过一版）：
+       · **防御性表层**（嫌弃 1 / 得意 2 / 思考 4）：1.8 s 后**破功** —— L1+ 翻开心、L0 回摸鱼。
+         这是"高攻低防"的表演，必须会掉；嘴硬一直挂着就变成真生气了。
+       · **心虚**（3）：1.8 s 后**心软**（L1+）—— 同一条破功链，愧疚化开。
+       · **开心 6 / 心软 7**：**赖住**，不自己掉。这是"哄到她"的成果，1.8 s 就收走等于把奖励吞了。
+       · **害羞 8**：说完**再挂 4 s**（PM_SHY_HOLD_MS，作者 19:5x 要的"半衰"）→ 化开成开心（L1+）/ 摸鱼（L0）。
+         4 s 之后再夸才有"又被夸到"的落差，赖太久会腻。
+         兜底：待机 30 s 仍会被 pm_tick 推成困倦。
+       · 摸鱼/困倦/迷糊：本来就不用动。 */
+    uint8_t nxt = PM_NONE;
+    switch (face) {
+        case PM_SNARK:
+        case PM_SMUG:
+        case PM_THINK:
+            nxt = (m->level >= 1) ? PM_HAPPY : PM_NEUTRAL;
+            break;
+        case PM_GUILTY:
+            nxt = (m->level >= 1) ? PM_SOFT : PM_NEUTRAL;
+            break;
+        case PM_SHY:                   /* 害羞：先挂 4 s 再化开（比开心短一截） */
+            nxt = (m->level >= 1) ? PM_HAPPY : PM_NEUTRAL;
+            if (nxt != face) { schedule(m, PM_SHY_HOLD_MS, nxt, now_ms); return m->face; }
+            break;
+        default:                       /* 6/7 赖住；0/5/11 不动（8 害羞在上面） */
+            nxt = PM_NONE;
+            break;
+    }
+    if (nxt != PM_NONE && nxt != face) schedule(m, PM_BREAK_MS, nxt, now_ms);
+    return m->face;
+}
+
+int pm_tick(pm_t *m, uint32_t now_ms)
+{
+    if (m->until && (int32_t)(now_ms - m->until) >= 0) {
+        int target = m->next;
+        m->next  = PM_NONE;
+        m->until = 0;
+
+        if (target != PM_NONE) {
+            /* 只有"真里层（6..10）"才按破功算停留/冷却；36 道别微笑是道具，落到就直接显示 */
+            if (IS_REVEAL((uint8_t)target) && m->have_break &&
+                (uint32_t)(now_ms - m->last_break) < PM_COOLDOWN_MS) {
+                target = PM_NEUTRAL;
+            }
+            if (IS_INNER((uint8_t)target)) {
+                m->last_break = now_ms;       /* 里层从现在开始计时 */
+                m->have_break = 1;
+                m->face = (uint8_t)target;
+                schedule(m, PM_HOLD_MS, PM_NEUTRAL, now_ms);   /* 停 2.8 s 回待机 */
+            } else {
+                m->face = (uint8_t)target;
+            }
+            return m->face;
+        }
+    }
+
+    /* 待机衰减：只用 TICK 推，别跟进行中的动作抢 */
+    if (m->until == 0) {
+        const uint32_t idle = (uint32_t)(now_ms - m->last_input);
+        if (idle >= PM_SLEEP_MS) {
+            if (!m->sleeping || m->face != PM_SLEEP) {
+                m->sleeping = 1;
+                m->face = PM_SLEEP;
+                return m->face;
+            }
+        } else if (idle >= PM_IDLE_MS) {
+            if (m->face != PM_SLEEP) {
+                m->face = PM_SLEEP;
+                return m->face;
+            }
+        }
+    }
+    return -1;
+}
diff --git a/components/pet_mood/test/host_test.c b/components/pet_mood/test/host_test.c
new file mode 100644
index 0000000..dfd35d5
--- /dev/null
+++ b/components/pet_mood/test/host_test.c
@@ -0,0 +1,173 @@
+// components/pet_mood/test/host_test.c —— 把 `65` §5 的迁移表当断言跑
+#include <stdio.h>
+#include <string.h>
+
+#include "pet_mood.h"
+
+static int fails;
+#define CHECK(cond, msg) do { \
+    if (!(cond)) { printf("  ❌ %s (line %d)\n", msg, __LINE__); fails++; } \
+} while (0)
+
+static pm_t m;
+
+/* 推到某个时刻，返回期间 pm_tick 给出的脸（没有就 -1） */
+static int tick_until(uint32_t now)
+{
+    int f = pm_tick(&m, now);
+    return f;
+}
+
+int main(void)
+{
+    /* 1) 聊完：得意 → 1.8 s → 开心(L1) → 2.8 s → 中性 */
+    pm_init(&m, 1, 0);
+    CHECK(pm_event(&m, PM_EV_REPLY_END, 1000) == PM_SMUG, "说完先给得意");
+    CHECK(tick_until(2799) == -1, "1.8 s 之前不许破功");
+    CHECK(tick_until(2800) == PM_HAPPY, "L1 到点翻开心");
+    CHECK(tick_until(5599) == -1, "里层该停一会");
+    CHECK(tick_until(5600) == PM_NEUTRAL, "2.8 s 后回待机");
+
+    /* 2) L0 不翻里层 */
+    pm_init(&m, 0, 0);
+    pm_event(&m, PM_EV_REPLY_END, 1000);
+    CHECK(tick_until(2800) == PM_NEUTRAL, "L0 只回中性");
+
+    /* 3) 中途有新输入 ⇒ 取消破功 */
+    pm_init(&m, 2, 0);
+    pm_event(&m, PM_EV_REPLY_END, 1000);
+    CHECK(pm_event(&m, PM_EV_TALK_START, 1500) == PM_THINK, "再开口就重新思考");
+    CHECK(tick_until(4000) == -1, "被打断后不许偷偷破功");
+
+    /* 4) 松手后 1.5 s 没回话 ⇒ 催（嫌弃） */
+    pm_init(&m, 1, 0);
+    pm_event(&m, PM_EV_TALK_END, 1000);
+    CHECK(tick_until(2499) == -1, "1.5 s 前还是思考");
+    CHECK(tick_until(2500) == PM_SNARK, "1.5 s 后催你");
+
+    /* 5) 连戳 3 下：L2 害羞；L1 只回中性 */
+    pm_init(&m, 2, 0);
+    CHECK(pm_event(&m, PM_EV_TAP, 5000) == PM_SNARK, "戳一下嫌弃");
+    CHECK(tick_until(6200) == PM_NEUTRAL, "单戳 1.2 s 回待机");
+    CHECK(pm_event(&m, PM_EV_TAP, 7000) == PM_SNARK, "第 1 下（新窗口）");
+    CHECK(pm_event(&m, PM_EV_TAP, 7100) == PM_SNARK, "第 2 下");
+    CHECK(pm_event(&m, PM_EV_TAP, 7300) == PM_SNARK, "第 3 下（1.5 s 内）");
+    CHECK(tick_until(9100) == PM_SHY, "连戳 3 下 L2 露馅");
+
+    pm_init(&m, 1, 0);
+    pm_event(&m, PM_EV_TAP, 1000);
+    pm_event(&m, PM_EV_TAP, 1100);
+    pm_event(&m, PM_EV_TAP, 1200);
+    CHECK(tick_until(3000) == PM_NEUTRAL, "L1 连戳也只回中性");
+
+    /* 6) 冷却：12 s 内第二次破功要压回中性 */
+    pm_init(&m, 2, 0);
+    pm_event(&m, PM_EV_TAP, 1000);
+    pm_event(&m, PM_EV_TAP, 1100);
+    pm_event(&m, PM_EV_TAP, 1200);
+    CHECK(tick_until(3000) == PM_SHY, "第一次害羞");
+    CHECK(tick_until(5800) == PM_NEUTRAL, "停 2.8 s 回待机");
+    pm_event(&m, PM_EV_TAP, 6000);
+    pm_event(&m, PM_EV_TAP, 6100);
+    pm_event(&m, PM_EV_TAP, 6200);
+    CHECK(tick_until(8000) == PM_NEUTRAL, "12 s 冷却内不许再害羞");
+
+    /* 7) 要求走：L2 求别走，L0/L1 给一张道别微笑（PRD §4.6，2026-10-29 M1 改） */
+    pm_init(&m, 2, 0);
+    CHECK(pm_event(&m, PM_EV_LEAVE, 1000) == PM_SNARK, "走之前先嘴硬");
+    CHECK(tick_until(2800) == PM_DONTGO, "L2 才拽");
+    pm_init(&m, 0, 0);
+    pm_event(&m, PM_EV_LEAVE, 1000);
+    CHECK(tick_until(2800) == PM_FAREWELL, "L0 走时是道别微笑（不黏人）");
+    pm_init(&m, 1, 0);
+    pm_event(&m, PM_EV_LEAVE, 1000);
+    CHECK(tick_until(2800) == PM_FAREWELL, "L1 也是道别微笑");
+
+    /* 7b) 说完保持情绪（pm_hold）：停在开口时的表情，1.8 s 后按亲密度衰减 */
+    pm_init(&m, 1, 0);
+    CHECK(pm_hold(&m, PM_SNARK, 1000) == PM_SNARK, "说完停在嫌弃（不一律回摸鱼）");
+    CHECK(tick_until(2800) == PM_HAPPY, "L1 的防御性表层 1.8 s 后破功成开心");
+    pm_init(&m, 0, 0);
+    pm_hold(&m, PM_SNARK, 1000);
+    CHECK(tick_until(2800) == PM_NEUTRAL, "L0 破功只回摸鱼");
+    /* 里层正面（开心/心软/害羞）**赖住**：1.8 s 后不许自己掉（作者 19:3x：奖励不能被吞） */
+    pm_init(&m, 2, 0);
+    CHECK(pm_hold(&m, PM_SHY, 1000) == PM_SHY, "害羞说完就停在害羞");
+    CHECK(tick_until(2800) == -1, "1.8 s 那一下不许掉（不是破功链）");
+    CHECK(tick_until(4999) == -1, "4 s 之内还挂着");
+    CHECK(tick_until(5000) == PM_HAPPY, "4 s 到点化开成开心（L2）");
+    pm_init(&m, 0, 0);
+    pm_hold(&m, PM_SHY, 1000);
+    CHECK(tick_until(5000) == PM_NEUTRAL, "L0 害羞 4 s 后回摸鱼");
+    pm_init(&m, 1, 0);
+    pm_hold(&m, PM_HAPPY, 1000);
+    CHECK(tick_until(5000) == -1, "开心一直挂着");
+    pm_init(&m, 2, 0);
+    pm_hold(&m, PM_SOFT, 1000);
+    CHECK(tick_until(5000) == -1, "心软也挂着");
+    /* 心虚 → 心软（同一条破功链，愧疚化开） */
+    pm_init(&m, 1, 0);
+    pm_hold(&m, PM_GUILTY, 1000);
+    CHECK(tick_until(2800) == PM_SOFT, "L1 心虚 1.8 s 后心软");
+    pm_init(&m, 0, 0);
+    pm_hold(&m, PM_GUILTY, 1000);
+    CHECK(tick_until(2800) == PM_NEUTRAL, "L0 心虚只回摸鱼");
+    pm_init(&m, 1, 0);
+    CHECK(pm_hold(&m, PM_NEUTRAL, 1000) == PM_NEUTRAL, "本来就是摸鱼：说完还是摸鱼");
+    CHECK(tick_until(2800) == -1, "摸鱼不安排多余的换脸（别每句话都闪一下）");
+
+    /* 8) 重逢：>24 h 且 L2 ⇒ 大哭 */
+    pm_init(&m, 2, 0);
+    pm_event(&m, PM_EV_REUNION_24H, 1000);
+    CHECK(tick_until(2800) == PM_CRY, "一天多没见，L2 直接哭");
+
+    /* 9) 被叫醒：迷糊 0.8 s */
+    pm_init(&m, 1, 0);
+    CHECK(pm_event(&m, PM_EV_WAKE, 1000) == PM_DAZED, "刚醒是迷糊");
+    CHECK(tick_until(1800) == PM_NEUTRAL, "0.8 s 后清醒");
+
+    /* 10) 待机衰减：30 s 困倦、240 s 睡着 */
+    pm_init(&m, 1, 0);
+    CHECK(tick_until(30000) == PM_SLEEP, "30 s 没动静就困");
+    CHECK(tick_until(240000) == PM_SLEEP, "4 min 睡着（脸一样，但不重复刷）");
+    CHECK(pm_event(&m, PM_EV_TAP, 240100) == PM_SNARK, "睡着被戳也会醒");
+
+    /* 11) 番茄：全员开心 */
+    pm_init(&m, 0, 0);
+    pm_event(&m, PM_EV_TOMATO, 1000);
+    CHECK(tick_until(2800) == PM_HAPPY, "番茄是正反馈，L0 也给开心");
+
+    /* 12) 亲密度夹紧 */
+    pm_init(&m, 0, 0);
+    pm_shift_level(&m, -5);
+    CHECK(m.level == 0, "夹到 0");
+    pm_shift_level(&m, +9);
+    CHECK(m.level == 2, "夹到 2");
+
+    /* 13) 亲密度 → 等级 */
+    CHECK(pm_level_of(0) == 0 && pm_level_of(19) == 0, "0–19 = L0");
+    CHECK(pm_level_of(20) == 1 && pm_level_of(79) == 1, "20–79 = L1");
+    CHECK(pm_level_of(80) == 2 && pm_level_of(999) == 2, "80+ = L2");
+
+    /* 14) 重逢判定 */
+    {
+        const uint32_t now = 1793243272u;      /* 真实的 epoch 量级，别用 1000 会下溢 */
+        pm_event_t ev;
+        CHECK(pm_reunion(now, 0, &ev) == 0, "首次用（没记录）不算重逢");
+        CHECK(pm_reunion(now, now, &ev) == 0, "刚见过不算");
+        CHECK(pm_reunion(now, now - 3 * 3600, &ev) == 0, "3 h 不算");
+        CHECK(pm_reunion(now, now - 7 * 3600, &ev) == 1 && ev == PM_EV_REUNION_6H, "7 h = 6h 档");
+        CHECK(pm_reunion(now, now - 30 * 3600, &ev) == 1 && ev == PM_EV_REUNION_24H, "30 h = 24h 档");
+        CHECK(pm_reunion(now, now + 100, &ev) == 0, "钟往回跳不算（防乱哭）");
+    }
+
+    /* 15) 说完·回中性（2026-10-29 定：说完不演得意，直接回第 0 张摸鱼） */
+    pm_init(&m, 2, 0);
+    CHECK(pm_event(&m, PM_EV_REPLY_START, 1000) == PM_SMUG, "开场那句仍是得意（内部记账）");
+    CHECK(pm_event(&m, PM_EV_REPLY_DONE, 3000) == PM_NEUTRAL, "说完直接回中性");
+    CHECK(tick_until(9000) == -1, "回中性后不许再偷偷破功");
+
+    if (fails) { printf("FAIL %d 项\n", fails); return 1; }
+    printf("pet_mood: 15 组 / 全部通过\n");
+    return 0;
+}
