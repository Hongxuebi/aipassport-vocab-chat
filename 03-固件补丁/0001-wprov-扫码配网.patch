+++ b/main/demo_device_info.c
@@ -0,0 +1,92 @@
+// main/demo_device_info.c —— 本机信息页（C3）：固件/槽位/资源占用/待传事件/网络/堆
+//
+// 目的：不用接串口也能一眼看出"这台的固件是哪一版、跑在哪个槽、
+// 资源用了多少、还有多少事件没传"。这些数都是产品壳（D）"同步状态"页要显示的同一批。
+#include <string.h>
+#include <stdio.h>
+
+#include "demo.h"
+
+#include "ui_pixel.h"
+
+LV_FONT_DECLARE(fusion_ui16);
+#include "lvgl.h"
+#include "esp_app_desc.h"
+#include "esp_ota_ops.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+
+#include "assets_fs.h"
+#include "evlog.h"
+#include "esp_netif.h"
+
+static const char *TAG = "info";
+static lv_obj_t *s_scr, *s_v1, *s_v2, *s_v3, *s_v4, *s_v5;
+
+/* 把这一页的内容也打到串口：真机证据要看日志，不靠截图 */
+static void dump_and_render(void)
+{
+    const esp_app_desc_t *d = esp_app_get_description();
+    const esp_partition_t *run = esp_ota_get_running_partition();
+    const uint32_t head = evlog_head(), ack = evlog_ack();
+    const unsigned pend = (head > ack + 1) ? (unsigned)(head - 1 - ack) : 0u;
+    char ip[20] = "无";
+    esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t pi = {0};
+    if (nf && esp_netif_get_ip_info(nf, &pi) == ESP_OK && pi.ip.addr) {
+        snprintf(ip, sizeof(ip), IPSTR, IP2STR(&pi.ip));
+    }
+    size_t at = assets_total(), au = assets_used();
+    unsigned heap = (unsigned)(heap_caps_get_free_size(MALLOC_CAP_8BIT) / 1024);
+
+    ESP_LOGI(TAG, "本机信息：固件 %s ｜ 槽 %s ｜ 事件 待传%u/已确认%u ｜ 资源 %u/%u KB ｜ 堆 %u KB ｜ IP %s",
+             d ? d->version : "?", run ? run->label : "?",
+             pend, (unsigned)ack,
+             (unsigned)(au / 1024), (unsigned)(at / 1024), heap, ip);
+
+    if (s_v1) lv_label_set_text_fmt(s_v1, "固件 %s", d ? d->version : "?");
+    if (s_v2) lv_label_set_text_fmt(s_v2, "槽 %s", run ? run->label : "?");
+    if (s_v3) lv_label_set_text(s_v3, "更新 USB 刷机");
+    if (s_v4) lv_label_set_text_fmt(s_v4, "事件 待传%u/确认%u", pend, (unsigned)ack);
+    if (s_v5) lv_label_set_text_fmt(s_v5, "资源 %u/%uKB 堆%uKB", (unsigned)(au / 1024), (unsigned)(at / 1024), heap);
+}
+
+void demo_device_info_enter(void)
+{
+    s_scr = ui_pixel_screen_create("本机信息");
+    lv_obj_t *panel = ui_pixel_panel_create(s_scr, 16, 60, 208, 176, UI_YELLOW);
+
+    s_v1 = lv_label_create(panel);
+    lv_obj_set_style_text_font(s_v1, &fusion_ui16, 0);   /* 中文必须用 CJK 字库 */ lv_obj_set_style_text_color(s_v1, lv_color_hex(UI_INK), 0);
+    lv_obj_align(s_v1, LV_ALIGN_TOP_MID, 0, 8);
+    s_v2 = lv_label_create(panel);
+    lv_obj_set_style_text_font(s_v2, &fusion_ui16, 0);   /* 中文必须用 CJK 字库 */ lv_obj_set_style_text_color(s_v2, lv_color_hex(UI_INK), 0);
+    lv_obj_align(s_v2, LV_ALIGN_TOP_MID, 0, 36);
+    s_v3 = lv_label_create(panel);
+    lv_obj_set_style_text_font(s_v3, &fusion_ui16, 0);   /* 中文必须用 CJK 字库 */ lv_obj_set_style_text_color(s_v3, lv_color_hex(UI_INK), 0);
+    lv_obj_align(s_v3, LV_ALIGN_TOP_MID, 0, 64);
+    s_v4 = lv_label_create(panel);
+    lv_obj_set_style_text_font(s_v4, &fusion_ui16, 0);   /* 中文必须用 CJK 字库 */ lv_obj_set_style_text_color(s_v4, lv_color_hex(UI_INK), 0);
+    lv_obj_align(s_v4, LV_ALIGN_TOP_MID, 0, 92);
+    s_v5 = lv_label_create(panel);
+    lv_obj_set_style_text_font(s_v5, &fusion_ui16, 0);   /* 中文必须用 CJK 字库 */ lv_obj_set_style_text_color(s_v5, lv_color_hex(UI_INK), 0);
+    lv_obj_align(s_v5, LV_ALIGN_TOP_MID, 0, 120);
+
+    ui_pixel_mascot_create(s_scr, 101, 250);
+    dump_and_render();
+    lv_screen_load(s_scr);
+}
+
+void demo_device_info_exit(void)
+{
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; s_v1 = s_v2 = s_v3 = s_v4 = s_v5 = NULL; }
+}
+
+/* OK 短按 = 刷新（不重新进页面） */
+void demo_device_info_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    if (btn == BSP_BTN_OK && ev == BSP_BTN_CLICK) dump_and_render();
+}
+
+esp_err_t demo_device_info_start(void) { return ESP_OK; }
+esp_err_t demo_device_info_stop(void)  { return ESP_OK; }
diff --git a/main/demo_diary.c b/main/demo_diary.c
new file mode 100644
index 0000000..b858d60
--- /dev/null
+++ b/main/demo_diary.c
@@ -0,0 +1,646 @@
+// main/demo_diary.c —— 「她的日记」（P2，2026-10-30）
+//
+// 口径（使用侧 23:5x + 75/77 号页定的）：
+//   · 数据只从服务端机来：`GET /diary?n=7` → `YYYY-MM-DD|正文` 一行一篇（≤120 字/篇）
+//   · **先显缓存再联网**：进页同步读 flash 索引（120 B），立刻有字；联网拿到新的再换
+//   · **断网照翻**：拉失败就保留缓存 + 顶栏标「离线」
+//   · 翻页：▲▼ 一路往下翻（**跨天自动接上**，像翻书），● 回主页
+//   · 版面：8 行 × 13 字（一位标点可挤到 14 字 = 224 px）；卡片 2,42 236×240
+//
+// 🔴 这一版改过两次结构，账记在这儿（2026-10-30 真机，别再踩）：
+//   ① 开机就 malloc 4 KB 缓冲 + 建 4 KB 栈任务 ⇒ **I2S DMA 初始化失败（Audio=0，语音全哑）**
+//      —— 任何早于 BSP 音频的内存占用都要不得（08:00 之前 audio 起来，之后才安全）。
+//   ② 进页再 malloc 4 KB 正文 + 3 KB 栈任务 ⇒ 进页时只剩 **2–8 KB**（音频吃掉 ~40 KB），建不出来。
+//   ⇒ 定案：**正文不进 RAM**。取数时把「索引 + 原文」一起写进 flash 缓存（storage 0x30000），
+//      上屏时按屏读 ≤300 字节出来画。常驻 RAM 只有索引（<200 B）+ 一个 400 B 的读缓冲。
+//
+// 🔴 三条纪律：① 联网只在后台任务里（N1/N18，绝不进 enter/key）
+//              ② 对象一次建好，翻页只改文字（N13）
+//              ③ 进页先读缓存，绝不"等网"才出字
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "app_config.h"
+#include "bsp_display.h"
+#include "demo.h"
+#include "voice_talk.h"
+#include "esp_log.h"
+#include "esp_partition.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include "lvgl.h"
+#include "lwip/netdb.h"
+#include <errno.h>
+#include <fcntl.h>
+#include "lwip/sockets.h"
+#include "net_auth.h"
+#include "net_client.h"
+#include "ui_pixel.h"
+
+LV_FONT_DECLARE(fusion_ui16);
+LV_FONT_DECLARE(fusion_ui12);
+
+#define TAG "diary"
+
+/* 缓存：storage 分区里 EVLOG 之后那块空区（EVLOG 占 0x10000..0x30000） */
+#define CACHE_OFF    0x30000u
+#define CACHE_SIZE   0x2000u          /* 8 KB = 2 个扇区 */
+#define CACHE_MAGIC  0x31444944u      /* "DID1" */
+#define RX_MAX       3072u            /* /diary?n=7 最大约 2.7 KB */
+
+#define MAX_DAYS     8
+#define MAX_SCREENS  24
+#define PAGE_CHARS   100              /* 每屏字数（留 4 个余量给避头尾的挤） */
+
+/* 版面 */
+#define CARD_X      2
+#define CARD_Y      42
+#define CARD_W      236
+#define CARD_H      240
+#define BODY_X      6
+#define BODY_Y      52
+#define BODY_W      224
+#define LINES       8
+#define CPL         13
+#define LINE_H      18
+
+/* ---- flash 里的格式（小端）：
+       0..3   magic "DID1"
+       4..5   payload 长度
+       6      篇数 nd
+       7      保留
+       8..    索引 nd × 14 B = {date[10], off u16, len u16}（off 相对 payload 起点）
+       8+14n.. payload（服务端原文那 7 行）
+   进页只读 8 + 14×8 = 120 B 就能把目录建起来，正文按屏读。 */
+#define IDX_BASE    8u
+#define IDX_SIZE    14u
+
+static lv_obj_t *s_scr, *s_card, *s_body, *s_pnum, *s_date, *s_hint;
+
+/* 目录（常驻 RAM，<200 B） */
+static char     s_day[MAX_DAYS][11];
+static uint16_t s_day_off[MAX_DAYS];      /* payload 内字节偏移 */
+static uint16_t s_day_len[MAX_DAYS];
+static int      s_nday;
+static uint32_t s_pay_off;                /* payload 在 flash 里的起始（⚠️ 必须 32 位：0x30016 > 65535） */
+
+/* 屏（一屏 = 一篇的一页） */
+static uint16_t s_scr_off[MAX_SCREENS], s_scr_len[MAX_SCREENS];
+static uint8_t  s_scr_day[MAX_SCREENS], s_scr_page[MAX_SCREENS], s_scr_pages[MAX_SCREENS];
+static int      s_nscr, s_cur;
+static bool     s_offline;
+
+static char      s_disp[PAGE_CHARS * 3 + LINES + 8];
+static char      s_dayraw[PAGE_CHARS * 3 + 64];       /* 读一篇原文用（≤360 B） */
+
+static volatile bool s_stop;   /* 留着：stop() 会置位，将来若改成异步取数要用 */
+
+/* ---------------------------------------------------------------- 折行 */
+static int utf8_len(unsigned char c)
+{
+    return (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 : (c >= 0xC0) ? 2 : 1;
+}
+
+static bool is_tail_punct(const char *p)
+{
+    const unsigned char a = (unsigned char)p[0], b = (unsigned char)p[1], c = (unsigned char)p[2];
+    if (a == 0xEF && b == 0xBC) return c == 0x8C || c == 0x81 || c == 0x9F || c == 0x89 || c == 0x9B;
+    if (a == 0xE3 && b == 0x80) return c == 0x82 || c == 0x81 || c == 0x8D || c == 0x8F || c == 0x91;
+    if (a == 0xE2 && b == 0x80) return c == 0xA6;
+    return false;
+}
+
+/* 行首禁则（中文标点不许打头） */
+static bool dy_no_head(uint32_t cp)
+{
+    switch (cp) {
+    case 0xFF0C: case 0xFF01: case 0xFF1F: case 0xFF09: case 0xFF1B: case 0xFF1A:
+    case 0x3002: case 0x3001: case 0x300D: case 0x300F: case 0x3011: case 0x300B:
+    case 0x2026:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static int dy_u8_len(const char *p)
+{
+    const unsigned char c = (unsigned char)*p;
+    int n = (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 : (c >= 0xC0) ? 2 : 1;
+    for (int k = 1; k < n; k++) if (!p[k]) { n = k; break; }
+    return n;
+}
+
+static uint32_t dy_u8_cp(const char *p, int len)
+{
+    const unsigned char c = (unsigned char)p[0];
+    if (len == 1) return c;
+    if (len == 2) return ((uint32_t)(c & 0x1F) << 6) | (uint32_t)(p[1] & 0x3F);
+    if (len == 3) return ((uint32_t)(c & 0x0F) << 12) | ((uint32_t)(p[1] & 0x3F) << 6) | (uint32_t)(p[2] & 0x3F);
+    return ((uint32_t)(c & 0x07) << 18) | ((uint32_t)(p[1] & 0x3F) << 12) |
+           ((uint32_t)(p[2] & 0x3F) << 6) | (uint32_t)(p[3] & 0x3F);
+}
+
+/* 一个字的像素宽：正文是 fusion_ui16 比例字（i=5.3px / a=8px / W=13px / 汉字=16px） */
+static int dy_adv(const char *p, int len)
+{
+    return (int)lv_font_get_glyph_width(&fusion_ui16, dy_u8_cp(p, len), 0);
+}
+
+/* 把一段 UTF-8 折成 LINES 行写进 out（纯计算）。
+   🔴 v0.126（使用侧 2026-11-01 11:5x）：「对话的汉字和英语单词排列昨天解决了，但**日记里的英文仍然没排满**」。
+   老代码按**字数**切（CPL=13 字/行）—— 英文一个字母才 5~13px，13 个字母只填到 ~110/224px，
+   右边缘留一大条空。现在改成和气泡同一套：**按像素宽度**填、英文在空格后折、中文避头尾。
+   100 字的最坏宽度 100×16=1600px < 8 行×224=1792px ⇒ 一屏 8 行一定装得下，不会丢字。 */
+static void wrap_screen(const char *src, int bytes, char *out, size_t outsz)
+{
+    char *o = out;
+    char *end = out + outsz - 2;
+    const int target = BODY_W - 4;            /* 留 4px，别贴着卡片边 */
+    int line = 0;
+    const char *p = src, *stop = src + bytes;
+
+    while (p < stop && o < end && line < LINES) {
+        const char *ls = p, *last_space = NULL;
+        int width = 0;
+        while (p < stop) {                    /* ① 先量一行能装到哪儿 */
+            if (p + dy_u8_len(p) > stop) break;
+            const int w = dy_adv(p, dy_u8_len(p));
+            if (width + w > target) break;
+            width += w;
+            if (*p == ' ') last_space = p;
+            p += dy_u8_len(p);
+        }
+        const char *e = p;                    /* ② 这一行的收尾位置 */
+        if (e == ls) {                        /* 单字比整行宽：硬放一个 */
+            e = ls + dy_u8_len(ls);
+        } else if (e < stop) {
+            /* 只有"空格后面整段都是英文"才按空格折；后面是中文就按溢出点断
+               （中文哪两个字之间都能断，硬退到空格会剩半行空 —— 2026-11-01 11:4x 模拟抓到）。 */
+            if (last_space) {
+                bool tail_latin = true;
+                for (const char *q = last_space + 1; q < e; q += dy_u8_len(q)) {
+                    if (dy_u8_cp(q, dy_u8_len(q)) >= 0x2E80) { tail_latin = false; break; }
+                }
+                if (tail_latin) e = last_space + 1;
+            }
+            while (e < stop && *e == ' ') e++;          /* 新行不以空格打头 */
+            if (e <= ls) e = ls + 1;
+            if (e < stop) {                              /* 避头尾：标点不打头，挤进本行 */
+                const int n2 = dy_u8_len(e);
+                if (dy_no_head(dy_u8_cp(e, n2)) && e > ls + 1 && width + dy_adv(e, n2) <= target + 16) e += n2;
+            }
+        }
+        for (const char *q = ls; q < e && o < end; q++) *o++ = *q;   /* ③ 真正写进 out */
+        p = e;
+        if (p >= stop) break;
+        if (line + 1 >= LINES) break;                 /* 已经最后一行：剩下的下一屏再说 */
+        if (o >= end) break;
+        *o++ = '\n';
+        line++;
+    }
+    *o = '\0';
+}
+
+static int chars_in(const char *s, int bytes)
+{
+    int n = 0;
+    for (const char *p = s; p < s + bytes; p += utf8_len((unsigned char)*p)) n++;
+    return n;
+}
+
+/* 第 k 个字符的字节偏移 */
+static int char_off(const char *s, int bytes, int k)
+{
+    int off = 0, seen = 0;
+    while (off < bytes && seen < k) { off += utf8_len((unsigned char)s[off]); seen++; }
+    return off;
+}
+
+/* ---------------------------------------------------------------- 缓存 I/O */
+static const esp_partition_t *cache_part(void)
+{
+    static const esp_partition_t *p;
+    if (!p) p = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "storage");
+    return p;
+}
+
+/* 进页：只读头 + 索引（≤128 B），建目录。返回篇数。 */
+static int cache_load_index(void)
+{
+    const esp_partition_t *p = cache_part();
+    s_nday = 0;
+    if (!p) return 0;
+    uint8_t hdr[IDX_BASE + IDX_SIZE * MAX_DAYS];
+    if (esp_partition_read(p, CACHE_OFF, hdr, sizeof(hdr)) != ESP_OK) return 0;
+    const uint32_t magic = (uint32_t)hdr[0] | ((uint32_t)hdr[1] << 8) |
+                           ((uint32_t)hdr[2] << 16) | ((uint32_t)hdr[3] << 24);
+    if (magic != CACHE_MAGIC) return 0;
+    const int nd = hdr[6];
+    if (nd <= 0 || nd > MAX_DAYS) return 0;
+    s_pay_off = (uint32_t)(CACHE_OFF + IDX_BASE + IDX_SIZE * nd);
+    for (int i = 0; i < nd; i++) {
+        const uint8_t *e = hdr + IDX_BASE + IDX_SIZE * i;
+        memcpy(s_day[i], e, 10);
+        s_day[i][10] = '\0';
+        s_day_off[i] = (uint16_t)(e[10] | (e[11] << 8));
+        s_day_len[i] = (uint16_t)(e[12] | (e[13] << 8));
+    }
+    s_nday = nd;
+    return nd;
+}
+
+/* 分屏：按"字数"切（每天读一次原文 ≤360 B，数准了再切，避免 ASCII 把页撑爆） */
+static void build_screens(void)
+{
+    const esp_partition_t *p = cache_part();
+    s_nscr = 0;
+    if (!p) return;
+    for (int d = 0; d < s_nday && s_nscr < MAX_SCREENS; d++) {
+        int len = s_day_len[d];
+        if (len <= 0) continue;
+        if (len > (int)sizeof(s_dayraw) - 1) len = (int)sizeof(s_dayraw) - 1;
+        if (esp_partition_read(p, s_pay_off + s_day_off[d], s_dayraw, len) != ESP_OK) continue;
+        s_dayraw[len] = '\0';
+        const int total = chars_in(s_dayraw, len);
+        int pages = (total + PAGE_CHARS - 1) / PAGE_CHARS;
+        if (pages < 1) pages = 1;
+        for (int pg = 0; pg < pages && s_nscr < MAX_SCREENS; pg++) {
+            const int c0 = pg * PAGE_CHARS;
+            const int c1 = (c0 + PAGE_CHARS > total) ? total : c0 + PAGE_CHARS;
+            const int b0 = char_off(s_dayraw, len, c0);
+            const int b1 = char_off(s_dayraw, len, c1);
+            s_scr_day[s_nscr] = (uint8_t)d;
+            s_scr_page[s_nscr] = (uint8_t)(pg + 1);
+            s_scr_pages[s_nscr] = (uint8_t)pages;
+            s_scr_off[s_nscr] = (uint16_t)(s_day_off[d] + b0);
+            s_scr_len[s_nscr] = (uint16_t)(b1 - b0);
+            s_nscr++;
+        }
+    }
+    if (s_cur >= s_nscr) s_cur = s_nscr ? s_nscr - 1 : 0;
+}
+
+/* 读一屏原文到 s_dayraw（复用，≤300 B） */
+static int cache_read_screen(int idx)
+{
+    const esp_partition_t *p = cache_part();
+    if (!p || idx < 0 || idx >= s_nscr) return 0;
+    int n = s_scr_len[idx];
+    if (n <= 0 || n >= (int)sizeof(s_dayraw)) n = (int)sizeof(s_dayraw) - 1;
+    if (esp_partition_read(p, s_pay_off + s_scr_off[idx], s_dayraw, n) != ESP_OK) return 0;
+    s_dayraw[n] = '\0';
+    return n;
+}
+
+/* ---------------------------------------------------------------- 上屏（调用方持锁） */
+static void paint_locked(void)
+{
+    if (!s_body) return;
+    if (s_nscr <= 0) {
+        lv_label_set_text(s_body, s_offline
+            ? "她这会儿不在。\n连上就给你看。"
+            : "她还没写过日记。\n今晚 23:50 会写第一篇。");
+        lv_label_set_text(s_pnum, "");
+        lv_label_set_text(s_date, s_offline ? "离线" : "");
+        return;
+    }
+    if (s_cur < 0) s_cur = 0;
+    const int n = cache_read_screen(s_cur);
+    wrap_screen(s_dayraw, n, s_disp, sizeof(s_disp));
+    lv_label_set_text(s_body, s_disp);
+    char buf[16];
+    snprintf(buf, sizeof(buf), "%d/%d", s_scr_page[s_cur], s_scr_pages[s_cur]);
+    lv_label_set_text(s_pnum, buf);
+    const char *d = s_day[s_scr_day[s_cur]];
+    snprintf(buf, sizeof(buf), "%c%c-%c%c", d[5], d[6], d[8], d[9]);
+    lv_label_set_text(s_date, buf);
+}
+
+static void diary_apply_payload(char *body, size_t len)
+{
+    if (len > RX_MAX) len = RX_MAX;
+    uint8_t hdr[IDX_BASE + IDX_SIZE * MAX_DAYS];
+    memset(hdr, 0, sizeof(hdr));
+    const uint32_t magic = CACHE_MAGIC;
+    memcpy(hdr, &magic, 4);
+    hdr[4] = (uint8_t)(len & 0xFF);
+    hdr[5] = (uint8_t)(len >> 8);
+
+    int nd = 0;
+    uint16_t off = 0;
+    for (char *line = body; *line && nd < MAX_DAYS; ) {
+        char *nl = strchr(line, '\n');
+        const int llen = nl ? (int)(nl - line) : (int)strlen(line);
+        char *bar = memchr(line, '|', llen);
+        if (bar && (int)(bar - line) == 10 && llen > 11) {
+            uint8_t *ent = hdr + IDX_BASE + IDX_SIZE * nd;
+            memcpy(ent, line, 10);
+            const uint16_t o = (uint16_t)off;
+            const uint16_t l = (uint16_t)(llen - 11);
+            ent[10] = (uint8_t)(o & 0xFF);  ent[11] = (uint8_t)(o >> 8);
+            ent[12] = (uint8_t)(l & 0xFF);  ent[13] = (uint8_t)(l >> 8);
+            nd++;
+            off = (uint16_t)(off + l);
+        }
+        if (!nl) break;
+        line = nl + 1;
+    }
+    if (nd <= 0) { s_nday = s_nscr = 0; return; }
+    /* 🔴 2026-10-31 真机抓到的真 bug：头部第 6 字节是**篇数**，`cache_load_index()` 读的就是它
+       （`nd = hdr[6]`），但这里一直没写 ⇒ 缓存写成功、读回来永远 0 篇 ⇒ 日记页一辈子空着。
+       证据：串口 `缓存已写：2 篇 / 405 B` 紧跟着 `拉到 393 B（走 8802 网关），0 篇 / 0 屏`。 */
+    hdr[6] = (uint8_t)nd;
+
+    const size_t hlen = IDX_BASE + IDX_SIZE * (size_t)nd;
+    uint8_t *blob = malloc(hlen + off);
+    if (!blob) {
+        ESP_LOGW(TAG, "缓存没写成：堆不够（%u B）", (unsigned)(hlen + off));
+        return;
+    }
+    memcpy(blob, hdr, hlen);
+    uint16_t w = 0;
+    for (char *line = body; *line && w < off; ) {
+        char *nl = strchr(line, '\n');
+        const int llen = nl ? (int)(nl - line) : (int)strlen(line);
+        char *bar = memchr(line, '|', llen);
+        if (bar && (int)(bar - line) == 10 && llen > 11) {
+            const int l = llen - 11;
+            memcpy(blob + hlen + w, bar + 1, (size_t)l);
+            w = (uint16_t)(w + l);
+        }
+        if (!nl) break;
+        line = nl + 1;
+    }
+    const esp_partition_t *p = cache_part();
+    if (p && esp_partition_erase_range(p, CACHE_OFF, CACHE_SIZE) == ESP_OK &&
+        esp_partition_write(p, CACHE_OFF, blob, hlen + off) == ESP_OK)
+        ESP_LOGI(TAG, "缓存已写：%d 篇 / %u B", nd, (unsigned)(hlen + off));
+    free(blob);
+
+    if (bsp_lvgl_lock(500)) {
+        if (cache_load_index() > 0) build_screens();
+        paint_locked();
+        bsp_lvgl_unlock();
+    }
+}
+
+/* ---------------------------------------------------------------- 联网取数（同步 socket GET）
+ * 🔴 为什么不用 esp_http_client + 任务：2026-10-30 真机三次验证 —— 这台机器的 DMA 余量只够音频，
+ *    在**任何时点**多占 3 KB（动态或静态）都会让 I2S 初始化失败（Audio=0）。而进页时堆只剩 5.6 KB，
+ *    也开不出 3.5 KB 的栈。所以：**自己发一个 HTTP GET**，栈只要几百字节，缓冲区临时 malloc 3 KB。
+ */
+static void fetch_sync(void)
+{
+    char *buf = malloc(RX_MAX);
+    if (!buf) {
+        ESP_LOGW(TAG, "取数缓冲没拿到（堆 %u / 最大块 %u）",
+                 (unsigned)esp_get_free_heap_size(),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        return;
+    }
+    int n = -1;
+    /* 2026-10-30 23:5x：**先走语音口网关**（联网即可用；设备与服务端机不同网也能拉）。
+       网关不通才走下面这条本地 HTTP（只有同网能到，纯兜底）。 */
+    if (voice_talk_get("/diary?n=7", buf, RX_MAX) == 0) {
+        const int n0 = (int)strlen(buf);
+        if (n0 > 0) diary_apply_payload(buf, (size_t)n0);
+        s_offline = false;
+        if (n0 == 0) {
+            s_nday = s_nscr = 0;
+            if (bsp_lvgl_lock(300)) { paint_locked(); bsp_lvgl_unlock(); }
+        }
+        ESP_LOGI(TAG, "拉到 %d B（走 8802 网关），%d 篇 / %d 屏", n0, s_nday, s_nscr);
+        free(buf);
+        return;
+    }
+    /* 解析 AIP_SERVER_BASE（"http://host:port"），不另设宏，改地址只改一处 */
+    const char *u = strstr(AIP_SERVER_BASE, "://");
+    u = u ? u + 3 : AIP_SERVER_BASE;
+    char host[64];
+    int hi = 0;
+    while (*u && *u != ':' && *u != '/' && hi < (int)sizeof(host) - 1) host[hi++] = *u++;
+    host[hi] = '\0';
+    int port = (*u == ':') ? atoi(u + 1) : 80;
+
+    struct sockaddr_in sa = {0};
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons((uint16_t)port);
+    if (inet_pton(AF_INET, host, &sa.sin_addr) != 1) {
+        ESP_LOGW(TAG, "地址解析失败：%s", host);
+        free(buf);
+        return;
+    }
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) {
+        ESP_LOGW(TAG, "socket 没建起来");
+        free(buf);
+        return;
+    }
+    struct timeval tv = { .tv_sec = 1, .tv_usec = 500000 };
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+
+    /* 🔴 非阻塞 connect + 1.2 s 超时：2026-10-30 真机 —— 用阻塞 connect 时，服务器不可达会把
+       **输入任务卡 19 秒**（按键全部排队，退页都退不出来）。这里最长只占 1.2 s。 */
+    int fl = fcntl(fd, F_GETFL, 0);
+    fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+    bool linked = false;
+    if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) == 0) {
+        linked = true;
+    } else if (errno == EINPROGRESS) {
+        fd_set wf, ef;
+        FD_ZERO(&wf); FD_ZERO(&ef);
+        FD_SET(fd, &wf); FD_SET(fd, &ef);
+        struct timeval ct = { .tv_sec = 1, .tv_usec = 200000 };
+        if (select(fd + 1, NULL, &wf, &ef, &ct) > 0) {
+            int soerr = 0;
+            socklen_t sl = sizeof(soerr);
+            getsockopt(fd, SOL_SOCKET, SO_ERROR, &soerr, &sl);
+            linked = (soerr == 0);
+        }
+    }
+    fcntl(fd, F_SETFL, fl);          /* 回到阻塞，recv 用 SO_RCVTIMEO */
+    if (linked) {
+        char req[256];
+        const int rl = snprintf(req, sizeof(req),
+            "GET /diary?n=7 HTTP/1.1\r\nHost: %s:%d\r\nX-Dev-Token: %s\r\n"
+            "Connection: close\r\n\r\n", host, port, aip_dev_token());
+        if (send(fd, req, rl, 0) == rl) {
+            int got = 0;
+            for (;;) {
+                const int r = recv(fd, buf + got, RX_MAX - 1 - got, 0);
+                if (r <= 0) break;
+                got += r;
+                if (got >= (int)RX_MAX - 1) break;
+            }
+            buf[got] = '\0';
+            const int code = (strncmp(buf, "HTTP/1.", 7) == 0) ? atoi(buf + 9) : 0;
+            char *body = strstr(buf, "\r\n\r\n");
+            if (body) {
+                body += 4;
+                const int blen = (int)strlen(body);
+                if (code == 200) {
+                    n = blen;                       /* 200 + 0 B = 她还没写过（不是离线） */
+                    if (blen > 0) memmove(buf, body, (size_t)blen + 1);
+                } else {
+                    ESP_LOGW(TAG, "服务端回 %d（令牌不对？）", code);
+                }
+            }
+        }
+    } else {
+        ESP_LOGW(TAG, "连不上 %s:%d", host, port);
+    }
+    close(fd);
+
+    if (n >= 0) {
+        if (n > 0) diary_apply_payload(buf, (size_t)n);   /* 解析 + 写 flash 缓存 + 重画 */
+        s_offline = false;
+        if (n == 0) { s_nday = s_nscr = 0; if (bsp_lvgl_lock(300)) { paint_locked(); bsp_lvgl_unlock(); } }
+        ESP_LOGI(TAG, "拉到 %d B，%d 篇 / %d 屏", n, s_nday, s_nscr);
+    } else {
+        s_offline = true;
+        if (bsp_lvgl_lock(300)) { paint_locked(); bsp_lvgl_unlock(); }
+        ESP_LOGW(TAG, "拉日记失败 —— 继续用缓存");
+    }
+    free(buf);
+}
+
+void demo_diary_init(void)
+{
+    /* 现在不需要开机预分配：取数是同步 socket GET（栈几百字节、缓冲进页才 malloc 3 KB）。
+       留着空函数是给 main.c 的调用点占位；将来要"开机预热缓存"再往这里写。 */
+}
+
+esp_err_t demo_diary_start(void)
+{
+    fetch_sync();          /* 同步：局域网 100 ms 级；超时 1.5 s。**不持 LVGL 锁**（start 的约定） */
+    return ESP_OK;
+}
+
+esp_err_t demo_diary_stop(void)
+{
+    s_stop = true;
+    return ESP_OK;
+}
