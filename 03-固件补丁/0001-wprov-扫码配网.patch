+    vTaskDelay(pdMS_TO_TICKS(9000));
+
+    ESP_LOGW(TAG, "VOICE_DIAG 长按 ▲ 退出");
+    app_sim_key(BSP_BTN_UP, BSP_BTN_LONG);
