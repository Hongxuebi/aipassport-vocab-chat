+// components/srs/include/srs.h —— 间隔重复内核（FSRS-6 精简版）
+// 公式与默认权重来自 py-fsrs（MIT）：https://github.com/open-spaced-repetition/py-fsrs
+// 只做"给评分 → 更新 S/D → 算下次间隔"，不含存储、不含 UI，可单独在电脑上做 host 测试。
+#pragma once
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    SRS_AGAIN = 1,   /* 忘记 */
+    SRS_HARD  = 2,   /* 模糊 */
+    SRS_GOOD  = 3,   /* 认识 */
+    SRS_EASY  = 4,   /* 熟知 */
+} srs_grade_t;
+
+typedef struct {
+    float    stability;   /* S，天 */
+    float    difficulty;  /* D，1..10 */
+    uint16_t reps;
+    uint8_t  lapses;
+} srs_card_t;
+
+/* 首次见到这个词（还没复习过） */
+void  srs_init(srs_card_t *c, srs_grade_t g);
+
+/* 复习后更新。elapsed_days = 距上次复习的天数（首次复习忽略） */
+void  srs_review(srs_card_t *c, srs_grade_t g, float elapsed_days);
+
+/* 当前可回忆概率 R(t) */
+float srs_retrievability(float stability, float elapsed_days);
+
+/* 按目标保留率算下次间隔（天，≥1） */
+int   srs_interval_days(float stability, float desired_retention);
+
+/* 是否到期（R 已降到目标保留率以下） */
+bool  srs_is_due(const srs_card_t *c, float elapsed_days, float desired_retention);
+
+/* 调参用：读/写权重（21 个，最后一个是 decay 的正值） */
+const float *srs_default_weights(void);
+void         srs_set_weights(const float w[21]);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/srs/srs.c b/components/srs/srs.c
new file mode 100644
index 0000000..c04408c
--- /dev/null
+++ b/components/srs/srs.c
@@ -0,0 +1,98 @@
+// components/srs/srs.c —— FSRS-6 精简实现（公式逐条对应 py-fsrs/fsrs/scheduler.py）
+#include <math.h>
+#include <string.h>
+
+#include "srs.h"
+
+#define S_MIN 0.001f
+#define S_MAX 36500.0f
+#define D_MIN 1.0f
+#define D_MAX 10.0f
+
+/* py-fsrs DEFAULT_PARAMETERS（w1..w19，w20=DECAY） */
+static float s_w[21] = {
+    0.212f, 1.2931f, 2.3065f, 8.2956f, 6.4133f, 0.8334f, 3.0194f,
+    0.001f, 1.8722f, 0.1666f, 0.796f, 1.4835f, 0.0614f, 0.2629f,
+    1.6483f, 0.6014f, 1.8729f, 0.5425f, 0.0912f, 0.0658f, 0.1542f,
+};
+
+const float *srs_default_weights(void) { return s_w; }
+void srs_set_weights(const float w[21]) { memcpy(s_w, w, sizeof(s_w)); }
+
+static float clampf(float v, float lo, float hi)
+{
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+/* DECAY = -w20；FACTOR = 0.9^(1/DECAY) - 1 */
+static float decay(void)  { return -s_w[20]; }
+static float factor(void) { return powf(0.9f, 1.0f / decay()) - 1.0f; }
+
+float srs_retrievability(float stability, float elapsed_days)
+{
+    if (stability <= 0) return 0.0f;
+    if (elapsed_days < 0) elapsed_days = 0;
+    return powf(1.0f + factor() * elapsed_days / stability, decay());
+}
+
+int srs_interval_days(float stability, float desired_retention)
+{
+    float ivl = (stability / factor()) *
+                (powf(desired_retention, 1.0f / decay()) - 1.0f);
+    int d = (int)(ivl + 0.5f);            /* round */
+    if (d < 1) d = 1;
+    if (d > (int)S_MAX) d = (int)S_MAX;
+    return d;
+}
+
+bool srs_is_due(const srs_card_t *c, float elapsed_days, float desired_retention)
+{
+    return srs_retrievability(c->stability, elapsed_days) <= desired_retention + 1e-6f;
+}
+
+void srs_init(srs_card_t *c, srs_grade_t g)
+{
+    if (!c) return;
+    if (g < SRS_AGAIN) g = SRS_AGAIN;
+    if (g > SRS_EASY)  g = SRS_EASY;
+    c->stability  = clampf(s_w[g - 1], S_MIN, S_MAX);              /* S0 = w[G-1] */
+    c->difficulty = clampf(s_w[4] - expf(s_w[5] * (g - 1)) + 1.0f, D_MIN, D_MAX);
+    c->reps       = 0;
+    c->lapses     = 0;
+}
+
+void srs_review(srs_card_t *c, srs_grade_t g, float t)
+{
+    if (!c) return;
+    if (g < SRS_AGAIN) g = SRS_AGAIN;
+    if (g > SRS_EASY)  g = SRS_EASY;
+    if (t < 0) t = 0;
+
+    const float S = c->stability;
+    const float D = c->difficulty;
+    const float R = srs_retrievability(S, t);
+    float ns, nd;
+
+    if (g == SRS_AGAIN) {
+        /* S' = min( 长时遗忘式 , S / e^(w17*w18) ) */
+        float long_term = s_w[11] * powf(D, -s_w[12]) *
+                          (powf(S + 1.0f, s_w[13]) - 1.0f) *
+                          expf((1.0f - R) * s_w[14]);
+        float short_term = S / expf(s_w[17] * s_w[18]);
+        ns = long_term < short_term ? long_term : short_term;
+        c->lapses++;
+    } else {
+        /* S' = S * (1 + e^w8*(11-D)*S^-w9*(e^(w10*(1-R))-1)*hard*easy) */
+        float hard_penalty = (g == SRS_HARD) ? s_w[15] : 1.0f;
+        float easy_bonus   = (g == SRS_EASY) ? s_w[16] : 1.0f;
+        ns = S * (1.0f + expf(s_w[8]) * (11.0f - D) * powf(S, -s_w[9]) *
+                        (expf((1.0f - R) * s_w[10]) - 1.0f) * hard_penalty * easy_bonus);
+    }
+
+    /* D' = D - w6*(G-3)，夹到 1..10（G=4 会让 D 略升 → 天然防刷"熟知"） */
+    nd = D - s_w[6] * ((float)g - 3.0f);
+
+    c->stability  = clampf(ns, S_MIN, S_MAX);
+    c->difficulty = clampf(nd, D_MIN, D_MAX);
+    c->reps++;
+}
diff --git a/components/srs/test/host_test.c b/components/srs/test/host_test.c
new file mode 100644
index 0000000..4773150
--- /dev/null
+++ b/components/srs/test/host_test.c
@@ -0,0 +1,83 @@
+// host 测试：在电脑上跑，不烧设备。验证 FSRS-6 实现的三类性质。
+#include <stdio.h>
+#include <math.h>
+#include <string.h>
+#include "srs.h"
+
+static int fails = 0;
+#define CHECK(cond, fmt, ...) do { \
+    if (!(cond)) { fails++; printf("  ❌ " fmt "\n", ##__VA_ARGS__); } \
+    else printf("  ✅ " fmt "\n", ##__VA_ARGS__); } while (0)
+
+int main(void)
+{
+    printf("== 1) R 的自洽性：t=S 时 R 应 ≈ 0.9 ==\n");
+    float S = 10.0f;
+    float r = srs_retrievability(S, S);
+    printf("  R(10,10) = %.6f\n", r);
+    CHECK(fabsf(r - 0.9f) < 2e-3f, "R(t=S)=%.4f ≈ 0.9", r);
+
+    printf("\n== 2) 间隔 I(S) 应让 R 回到 0.9 ==\n");
+    for (float s0 = 0.5f; s0 <= 200.0f; s0 *= 4.0f) {
+        int ivl = srs_interval_days(s0, 0.9f);
+        float rr = srs_retrievability(s0, (float)ivl);
+        printf("  S=%-7.2f → I=%-4d 天, R(I)=%.4f\n", s0, ivl, rr);
+        if (ivl == 1) CHECK(rr > 0.5f, "S=%.2f 被最少 1 天夹住（R=%.3f，允许）", s0, rr);
+        else          CHECK(rr > 0.85f && rr <= 0.95f, "S=%.2f 的间隔回到 0.9 附近", s0);
+    }
+
+    printf("\n== 3) 单调性：同状态下 EASY 的间隔 > GOOD > HARD ==\n");
+    srs_card_t a, b, c;
+    srs_init(&a, SRS_GOOD); a.stability = 5.0f; a.difficulty = 5.0f;
+    b = a; c = a;
+    srs_review(&a, SRS_HARD, 5.0f);
+    srs_review(&b, SRS_GOOD, 5.0f);
+    srs_review(&c, SRS_EASY, 5.0f);
+    int ia = srs_interval_days(a.stability, 0.9f);
+    int ib = srs_interval_days(b.stability, 0.9f);
+    int ic = srs_interval_days(c.stability, 0.9f);
+    printf("  HARD S=%.2f I=%d ｜ GOOD S=%.2f I=%d ｜ EASY S=%.2f I=%d\n",
+           a.stability, ia, b.stability, ib, c.stability, ic);
+    CHECK(ia <= ib && ib <= ic, "间隔单调不减");
+
+    printf("\n== 4) 遗忘应让 S 变小，且 lapses+1 ==\n");
+    srs_card_t d; srs_init(&d, SRS_GOOD); d.stability = 20.0f; d.difficulty = 5.0f;
+    float before = d.stability;
+    srs_review(&d, SRS_AGAIN, 20.0f);
+    printf("  S: %.2f → %.2f, lapses=%d\n", before, d.stability, d.lapses);
+    CHECK(d.stability < before, "答错后 S 变小");
+    CHECK(d.lapses == 1, "lapses 计数 +1");
+
+    printf("\n== 5) 防刷：刚复习完就再刷（R≈1），S 几乎不涨 ==\n");
+    srs_card_t e1, e2;
+    srs_init(&e1, SRS_GOOD); srs_init(&e2, SRS_GOOD);
+    /* e1：隔 0 天连刷 5 次（R≈1） */
+    for (int i = 0; i < 5; i++) srs_review(&e1, SRS_EASY, 0.0f);
+    /* e2：每次等"该忘的时候"再复习一次（t = S） */
+    for (int i = 0; i < 5; i++) srs_review(&e2, SRS_EASY, e2.stability);
+    printf("  连刷 S=%.2f ｜ 到期才刷 S=%.2f\n", e1.stability, e2.stability);
+    CHECK(e1.stability < e2.stability, "同样 5 次，'到期才刷' 的 S 明显更大（刷不动）");
+    CHECK(e1.difficulty <= 1.01f, "连点熟知把 D 压到下限 1.0（不是上升）");
+
+    printf("\n== 6) 首评四档的 S0/D0（应与 w 表一致）==\n");
+    for (int g = 1; g <= 4; g++) {
+        srs_card_t f; srs_init(&f, (srs_grade_t)g);
+        printf("  G=%d  S0=%.4f  D0=%.4f\n", g, f.stability, f.difficulty);
+    }
+
+    printf("\n== 7) 一次 30 轮的真实序列（模拟用心学 60 天）==\n");
+    srs_card_t h; srs_init(&h, SRS_GOOD);
+    int grades[30] = {3,3,2,4,1,3,3,4,3,2,3,1,3,4,3,3,2,3,4,3,3,1,4,3,3,2,3,3,4,3};
+    for (int i = 0; i < 30; i++) {
+        int ivl = srs_interval_days(h.stability, 0.9f);
+        srs_review(&h, (srs_grade_t)grades[i], (float)ivl);
+        if (i % 5 == 0 || i == 29)
+            printf("  第%2d次 评分%d  S=%8.2f D=%5.2f 下次%4d天\n",
+                   i + 1, grades[i], h.stability, h.difficulty,
+                   srs_interval_days(h.stability, 0.9f));
+    }
+    CHECK(h.stability > 60.0f, "30 次复习后 S=%.1f > 60 天（合格）", h.stability);
+
+    printf("\n%s（%d 项失败）\n", fails ? "❌ 有失败项" : "✅ 全部通过", fails);
+    return fails ? 1 : 0;
+}
diff --git a/components/srs/test/sim_load.c b/components/srs/test/sim_load.c
new file mode 100644
index 0000000..ef5ef93
--- /dev/null
+++ b/components/srs/test/sim_load.c
@@ -0,0 +1,70 @@
+// 每日新词量 → 复习压力 的模拟（用设备同一份 srs.c，最接近真机）
+// 学生模型：按 R 概率答对；答对按 R 给 3（很熟了偶尔给 4），答错给 1。
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+#include <string.h>
+#include "srs.h"
+
+#define MAXW 4000
+#define DESIRED 0.9f
+#define MAX_IVL 180          /* 间隔上限（16 号文档 §2.6） */
+
+typedef struct { srs_card_t c; int seen; int due_day; int id; } word_t;
+
+static word_t ws[MAXW];
+static int nwords = 0, next_new = 0;
+static int rng_state = 12345;
+static int rnd(int n) { rng_state = rng_state * 1103515245 + 12345; return ((rng_state >> 16) & 0x7fff) % n; }
+
+static int ivl_of(const srs_card_t *c)
+{
+    int d = srs_interval_days(c->stability, DESIRED);
+    return d > MAX_IVL ? MAX_IVL : d;
+}
+
+int main(int argc, char **argv)
+{
+    int new_per_day = argc > 1 ? atoi(argv[1]) : 20;
+    int days        = argc > 2 ? atoi(argv[2]) : 365;
+    int cap         = argc > 3 ? atoi(argv[3]) : 70;      /* 每天最多 70 张（15 分钟预算） */
+
+    for (int d = 0; d < days; d++) {
+        int cards = 0, reviews = 0, news = 0;
+        /* ① 到期复习：R ≤ 0.9，按 R 升序（最该忘的先） */
+        for (int pass = 0; pass < 3 && cards < cap; pass++) {
+            for (int i = 0; i < nwords && cards < cap; i++) {
+                word_t *w = &ws[i];
+                if (!w->seen) continue;
+                float R = srs_retrievability(w->c.stability, (float)(d - w->due_day + 1));
+                if (R > DESIRED) continue;
+                int g = (rnd(100) < (int)(R * 100.0f)) ? 3 : 1;
+                if (g == 3 && R > 0.97f && rnd(4) == 0) g = 4;   /* 很熟 → 偶尔点"熟知" */
+                srs_review(&w->c, (srs_grade_t)g, (float)(d - w->due_day + 1));
+                w->due_day = d + ivl_of(&w->c);
+                cards++; reviews++;
+            }
+        }
+        /* ② 新词 */
+        while (news < new_per_day && cards < cap && nwords < MAXW) {
+            word_t *w = &ws[nwords++];
+            memset(w, 0, sizeof(*w));
+            w->id = nwords;
+            srs_init(&w->c, SRS_GOOD);
+            w->seen = 1;
+            w->due_day = d + ivl_of(&w->c);
+            cards++; news++;
+            next_new++;
+        }
+        if (d >= days - 30)
+            printf("  day %3d: 卡片 %2d（复习 %2d + 新词 %2d）累计词 %d\n",
+                   d + 1, cards, reviews, news, nwords);
+        if (d == days - 1) {
+            double min = cards * 5.0 / 60.0;
+            printf("\n  【新词 %d/天 · 上限 %d 张】第 %d 天：%d 张 ≈ %.0f 分钟；已引入 %d 词\n",
+                   new_per_day, cap, days, cards, min, nwords);
+            if (cards >= cap) printf("  ⚠️ 顶到了 %d 张上限 —— 说明新词配额在被复习挤掉\n", cap);
+        }
+    }
+    return 0;
+}
