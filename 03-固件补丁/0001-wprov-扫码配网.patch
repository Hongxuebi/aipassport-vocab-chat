+/* ---------------------------------------------------------------- 打分 */
+static void grade(srs_grade_t g)
+{
+    if (s_qi >= s_qn) return;
+    const qitem_t *q = &s_q[s_qi];
+    pgb2_card_t c;
+    bool have = (pgb2_get(q->id, &c) == PGB2_OK);
+
+    if (!have || q->is_new) {
+        memset(&c, 0, sizeof(c));
+        c.id = q->id;
+        srs_card_t sc;
+        srs_init(&sc, g);
+        c.S = sc.stability; c.D = sc.difficulty;
+        c.reps = sc.reps; c.lapses = sc.lapses;
+        c.flags = PGB2_FLAG_INTRODUCED;
+    } else {
+        srs_card_t sc = { .stability = c.S, .difficulty = c.D, .reps = c.reps, .lapses = c.lapses };
+        int since = (int)s_day - (int)c.due_day;
+        srs_review(&sc, g, (float)(since < 0 ? 0 : since));
+        c.S = sc.stability; c.D = sc.difficulty;
+        c.reps = sc.reps; c.lapses = sc.lapses;
+    }
+    c.due_day = (uint16_t)s_day;          /* 这个字段=上次复习日 */
+
+    pgb2_err_t pe = pgb2_put(&c);
+
+    /* C2-b：记一条复习事件（评分 + 反应时 + 当时在不在线 + 是不是重来）。
+       只写 Flash，不发网络；传不上去有 ev_sync 在后台补，失败也不打断背单词。 */
+    {
+        const uint32_t now = now_ms();
+        uint32_t rt = (now >= s_card_t0) ? (now - s_card_t0) : 0;
+        uint32_t flip = (s_flip_t0 && now >= s_flip_t0) ? (now - s_flip_t0) : 0;   /* 回忆段（出现→翻面） */
+        evlog_rec_t ev;
+        memset(&ev, 0, sizeof(ev));
+        ev.card_id = q->id;
+        ev.grade   = (uint8_t)g;
+        ev.flags   = (uint8_t)((s_online ? 0 : EV_FLAG_OFFLINE) |
+                               (q->is_repeat ? EV_FLAG_REPEAT : 0) |
+                               (pgb2_readonly() ? EV_FLAG_READONLY : 0));
+        if (rt > 0xFFFFu) { rt = 0xFFFFu; ev.flags |= EV_FLAG_RT_CAP; }
+        ev.rt_ms = (uint16_t)rt;
+        if (flip > 0xFFFFu) flip = 0xFFFFu;
+        ev.flip_ms = (uint16_t)flip;
+        ev.day   = (uint16_t)s_day;
+        ev.t_ms  = (uint32_t)(now - s_sess_t0);
+        ev_sync_note(&ev);
+    }
+
+    if (s_touch_n < CARD_CAP) s_touched[s_touch_n++] = q->id;
+    s_grade_cnt++;
+    s_since_sync++;
+    if (s_since_sync >= SYNC_EVERY) {
+        pgb2_err_t se = pgb2_sync();
+        s_since_sync = 0;
+        if (se != PGB2_OK) ESP_LOGE(TAG, "落盘失败：%s", pgb2_err_str(se));
+        else ESP_LOGI(TAG, "落盘 seq=%u（已打 %d 张）", (unsigned)pgb2_seq(), s_grade_cnt);
+    }
+    if (pe != PGB2_OK) ESP_LOGW(TAG, "写内存失败：%s", pgb2_err_str(pe));
+
+    s_qi++;
+
+    /* 墨墨的做法：忘记/模糊 当天再巩固一次（这里用"隔 8 张插回队列"，不是等明天）。
+       上限 MAX_REPEAT 次，避免一张卡死循环把整场卡住。 */
+    if ((g == SRS_AGAIN || g == SRS_HARD) && q->id < PGB2_MAX_CARDS && s_rep[q->id] < MAX_REPEAT) {
+        s_rep[q->id]++;
+        if (s_qn < QCAP) {
+            int pos = s_qi + REPEAT_GAP;
+            if (pos > s_qn) pos = s_qn;
+            for (int i = s_qn; i > pos; i--) s_q[i] = s_q[i - 1];
+            s_q[pos].id = q->id;
+            s_q[pos].is_new = 0;
+            s_q[pos].is_repeat = 1;      /* 这张是"当日重来"，事件里要能分出来 */
+            s_qn++;
+            ESP_LOGI(TAG, "「%s」当日重来一次（第 %d 次），插在第 %d 张",
+                     safe_word(q->id), s_rep[q->id], pos + 1);
+        }
+    }
+    show_current();
+}
