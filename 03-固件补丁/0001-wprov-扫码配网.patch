+#include <arpa/inet.h>
+
+#include "app_config.h"
+#include "app_volume.h"
+#include "bsp_battery.h"      /* 电量自报（v0.121）：soc/mv 塞进鉴权头 */
+#include "net_auth.h"          /* AIP_DEV_TOKEN：公网口自报身份用 */
+#include "wprov.h"             /* wprov_last_ip：判断"在不在家" —— **外面从公网端点起，家里才走局域网** */
+#include "bsp_audio.h"
