diff --git a/components/faces/esp/faces_esp.c b/components/faces/esp/faces_esp.c
new file mode 100644
index 0000000..1ae1b54
--- /dev/null
+++ b/components/faces/esp/faces_esp.c
@@ -0,0 +1,86 @@
+// components/faces/esp/faces_esp.c —— esp 胶水：mmap `pet` 分区 → 解析 FAC1 → 预建 12 个 lv_image_dsc_t
+//
+// 为什么不 copy：140×130×2 = 36,400 B/张，12 张就 436,800 B —— C3 上根本没有这块堆。
+// mmap 之后每张只占 **0 字节 RAM**（描述符本身 32 B），换图 = 换一个指针。
+// 这也是 2026-10-29 取舍的依据：85 段动图（4.73MB + 18KB 解码缓冲）→ 12 张静态脸（437KB + 0）。
+#include "faces.h"
+
+#include <string.h>
+
+#include "esp_log.h"
+#include "esp_partition.h"
+
+#define FACE_PART_SUBTYPE 0x40      /* 与 partitions.csv 的 pet 分区一致 */
+
+static const char *TAG = "faces";
+
+static face_pack_t   s_pack;
+static face_ent_t    s_ent[FACE_MAX];
+static lv_image_dsc_t s_dsc[FACE_MAX];
+static bool          s_mounted;
+
+esp_err_t faces_mount(void)
+{
+    if (s_mounted) return ESP_OK;
+
+    const esp_partition_t *part = esp_partition_find_first(
+        ESP_PARTITION_TYPE_DATA, FACE_PART_SUBTYPE, "pet");
+    if (!part) {
+        ESP_LOGE(TAG, "找不到 pet 分区（subtype 0x40）。检查 partitions.csv 与烧录。");
+        return ESP_ERR_NOT_FOUND;
+    }
+
+    const void *map = NULL;
+    esp_partition_mmap_handle_t handle;
+    esp_err_t err = esp_partition_mmap(part, 0, part->size, ESP_PARTITION_MMAP_DATA,
+                                       &map, &handle);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "mmap 失败：%s", esp_err_to_name(err));
+        return err;
+    }
+
+    const int rc = face_pack_parse(map, part->size, &s_pack);
+    if (rc != 0) {
+        ESP_LOGE(TAG, "pet 分区里不是表情包（rc=%d）。先跑 _工具/装表情.py 重烧 face 区。", rc);
+        return ESP_ERR_INVALID_RESPONSE;
+    }
+
+    for (int i = 0; i < (int)s_pack.count; i++) {
+        if (face_pack_at(&s_pack, i, &s_ent[i]) != 0) {
+            ESP_LOGE(TAG, "第 %d 项目录坏了（off/len 不对）", i);
+            return ESP_ERR_INVALID_RESPONSE;
+        }
+        const uint8_t *px = face_pack_px(&s_pack, &s_ent[i]);
+        if (!px) return ESP_ERR_INVALID_RESPONSE;
+
+        lv_image_dsc_t *d = &s_dsc[i];
+        memset(d, 0, sizeof(*d));
+        d->header.cf    = LV_COLOR_FORMAT_RGB565;   /* 0x12：R 高 5 位、小端（与包内一致） */
+        d->header.w     = s_pack.w;
+        d->header.h     = s_pack.h;
+        d->header.stride = (uint32_t)s_pack.w * 2u;
+        d->data_size    = s_ent[i].len;
+        d->data         = (const void *)px;         /* ← 指进 flash 的 mmap，不占堆 */
+    }
+
+    s_mounted = true;
+    ESP_LOGI(TAG, "表情包已挂载：%u 张 %ux%u，分区 %u KB，堆 0 字节",
+             (unsigned)s_pack.count, s_pack.w, s_pack.h, (unsigned)(part->size / 1024));
+    return ESP_OK;
+}
+
+bool faces_ready(void) { return s_mounted; }
+
+int faces_count(void) { return s_mounted ? (int)s_pack.count : 0; }
+
+const face_ent_t *faces_ent(int i)
+{
+    if (!s_mounted || i < 0 || i >= (int)s_pack.count) return NULL;
+    return &s_ent[i];
+}
+
+const lv_image_dsc_t *faces_dsc(int i)
+{
+    if (!s_mounted || i < 0 || i >= (int)s_pack.count) return NULL;
+    return &s_dsc[i];
+}
diff --git a/components/faces/faces_pack.c b/components/faces/faces_pack.c
new file mode 100644
index 0000000..cfae6c9
--- /dev/null
+++ b/components/faces/faces_pack.c
@@ -0,0 +1,69 @@
+// components/faces/faces_pack.c —— FAC1 解析（纯 C，无 esp/lvgl，可在电脑上跑 host 测试）
+#include "faces_pack.h"
+
+#include <string.h>
+
+/* mmap 指针不能假设对齐：统一 memcpy 读（跟 pet_anim.c 同一个教训） */
+static inline uint16_t rd16(const uint8_t *p) { uint16_t v; memcpy(&v, p, 2); return v; }
+static inline uint32_t rd32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+
+int face_pack_parse(const void *blob, size_t size, face_pack_t *out)
+{
+    if (!blob || !out) return -1;
+    if (size < 16) return -4;
+
+    const uint8_t *b = (const uint8_t *)blob;
+    if (b[0] != 'F' || b[1] != 'A' || b[2] != 'C' || b[3] != '1') return -2;
+    if (b[4] != 1) return -2;                     /* ver */
+
+    const uint8_t  n   = b[5];
+    const uint16_t w   = rd16(b + 6);
+    const uint16_t h   = rd16(b + 8);
+    const uint8_t  cf  = b[10];
+    const uint16_t dsz = rd16(b + 12);
+
+    if (n == 0 || n > FACE_MAX) return -3;
+    if (w != FACE_W || h != FACE_H) return -3;
+    if (cf != FACE_CF_RGB565) return -3;
+    if (dsz != FACE_DIR_ENTRY) return -3;
+
+    const size_t need = 16u + (size_t)dsz * n + (size_t)FACE_PX_BYTES * n;
+    if (size < need) return -4;
+
+    out->count = n;
+    out->w     = w;
+    out->h     = h;
+    out->dir   = b + 16;
+    out->base  = b;
+    out->size  = size;
+    return 0;
+}
+
+int face_pack_at(const face_pack_t *p, int i, face_ent_t *out)
+{
+    if (!p || !out) return -1;
+    if (i < 0 || i >= (int)p->count) return -1;
+
+    const uint8_t *e = p->dir + (size_t)FACE_DIR_ENTRY * (size_t)i;
+    memset(out, 0, sizeof(*out));
+    /* 名字：目录里是 NUL 填充；若打包器没补 NUL，也只抄到第一个 NUL（别把后面的 off 当名字） */
+    size_t nl = 0;
+    while (nl < FACE_NAME_CAP - 1 && e[nl] != 0) nl++;
+    memcpy(out->name, e, nl);
+    out->off   = rd32(e + 28);
+    out->len   = rd32(e + 32);
+    out->layer = e[36];
+    out->lvl   = e[37];
+
+    if (out->len != FACE_PX_BYTES) return -3;     /* 一张就是 140×130×2，差一个字节都不行 */
+    if ((out->off % 8u) != 0) return -3;          /* LVGL 直读，8 字节对齐 */
+    if ((size_t)out->off + (size_t)out->len > p->size) return -4;
+    return 0;
+}
+
+const uint8_t *face_pack_px(const face_pack_t *p, const face_ent_t *e)
+{
+    if (!p || !e) return NULL;
+    if ((size_t)e->off + (size_t)e->len > p->size) return NULL;
+    return p->base + e->off;
+}
diff --git a/components/faces/include/faces.h b/components/faces/include/faces.h
new file mode 100644
index 0000000..bca3440
--- /dev/null
+++ b/components/faces/include/faces.h
@@ -0,0 +1,30 @@
+// components/faces/include/faces.h —— 表情包挂载（esp 侧：mmap pet 分区 + 建 LVGL 描述符）
+//
+// 关键：**图不 copy 到 RAM**。`pet` 分区用 esp_partition_mmap 映射进地址空间，
+// lv_image_dsc_t.data 直接指向那块 flash —— LVGL 画的时候从缓存里读，
+// 所以 12 张脸 **0 字节堆**、0 次 decode（对比旧桌宠：18,432 B 解码缓冲）。
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "esp_err.h"
+#include "lvgl.h"
+
+#include "faces_pack.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 挂载 + 校验。失败必须打日志（N4），调用方负责显示"没有表情包"而不是黑屏。 */
+esp_err_t faces_mount(void);
+
+bool           faces_ready(void);
+int            faces_count(void);
+const face_ent_t      *faces_ent(int i);        /* 名字/层/门槛 */
+const lv_image_dsc_t  *faces_dsc(int i);        /* 直接喂 lv_image_set_src() */
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/faces/include/faces_pack.h b/components/faces/include/faces_pack.h
new file mode 100644
index 0000000..29b2780
--- /dev/null
+++ b/components/faces/include/faces_pack.h
@@ -0,0 +1,56 @@
+// components/faces/include/faces_pack.h —— 表情包 FAC1 的**纯解析层**（不碰 esp/lvgl，可 host 测）
+//
+// 包结构（跟项目 `65` §8.1 一致）：
+//   0   4  'F' 'A' 'C' '1'
+//   4   1  ver = 1
+//   5   1  count
+//   6   2  w (140)      8  2  h (130)
+//   10  1  cf (0x12 = RGB565，**R 在高 5 位**，跟 pack_pet.py 同一套)
+//   11  1  flags
+//   12  2  dir_size (40)   14  2  reserved
+//   16  n*40 目录：name[28] | off u32 | size u32 | layer u8 | lvl u8 | pad u16
+//   16+n*40  像素：每张 36,400 B 紧排（off % 8 == 0）
+//
+// 为什么拆成"纯解析 + esp 胶水"：`_工具/gate.sh` 第 3 项会把 components/*/test/host_test.c
+// 和组件根目录的 *.c 一起编到电脑上跑 —— esp/lvgl 头文件在那边不存在，所以胶水必须放 esp/ 子目录。
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FACE_W          140
+#define FACE_H          130
+#define FACE_PX_BYTES   (FACE_W * FACE_H * 2)     /* 36,400 */
+#define FACE_DIR_ENTRY  40
+#define FACE_NAME_CAP   28
+#define FACE_MAX        48
+#define FACE_CF_RGB565  0x12
+
+typedef struct {
+    uint8_t        count;
+    uint16_t       w, h;
+    const uint8_t *dir;      /* 目录区起点 */
+    const uint8_t *base;     /* 包起点（off 相对它） */
+    size_t         size;
+} face_pack_t;
+
+typedef struct {
+    char     name[FACE_NAME_CAP];
+    uint32_t off;
+    uint32_t len;
+    uint8_t  layer;          /* 0 表层 / 1 里层 */
+    uint8_t  lvl;            /* 需要的亲密度等级 0/1/2 */
+} face_ent_t;
+
+/* 返回 0 = 成功；<0 = 失败（-1 参数、-2 magic/版本、-3 字段/尺寸不对、-4 越界） */
+int face_pack_parse(const void *blob, size_t size, face_pack_t *out);
+int face_pack_at(const face_pack_t *p, int i, face_ent_t *out);
+const uint8_t *face_pack_px(const face_pack_t *p, const face_ent_t *e);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/faces/test/host_test.c b/components/faces/test/host_test.c
new file mode 100644
index 0000000..1bee25a
--- /dev/null
+++ b/components/faces/test/host_test.c
@@ -0,0 +1,100 @@
+// components/faces/test/host_test.c —— FAC1 解析的电脑端单测（gate.sh 第 3 项自动跑）
+//
+// 只测纯解析层（faces_pack.c）：magic/版本/尺寸/对齐/越界。
+// esp 侧（mmap、lv_image_dsc_t）编不进电脑，靠真机日志验。
+#include <stdio.h>
+#include <string.h>
+
+#include "faces_pack.h"
+
+#define N 3
+static unsigned char blob[16 + FACE_DIR_ENTRY * N + FACE_PX_BYTES * N];
+
+static int fails;
+#define CHECK(cond, msg) do { \
+    if (!(cond)) { printf("  ❌ %s\n", msg); fails++; } \
+} while (0)
+
+static void put16(unsigned char *p, unsigned v) { p[0] = (unsigned char)(v & 0xFF); p[1] = (unsigned char)((v >> 8) & 0xFF); }
+static void put32(unsigned char *p, unsigned v) { for (int i = 0; i < 4; i++) p[i] = (unsigned char)((v >> (8 * i)) & 0xFF); }
+
+static void build(int n, int dir_size, int px_len, int align_bad)
+{
+    memset(blob, 0x5A, sizeof(blob));
+    memcpy(blob, "FAC1", 4);
+    blob[4] = 1;
+    blob[5] = (unsigned char)n;
+    put16(blob + 6, FACE_W);
+    put16(blob + 8, FACE_H);
+    blob[10] = 0x12;
+    blob[11] = 0;
+    put16(blob + 12, (unsigned)dir_size);
+
+    const unsigned base = 16u + (unsigned)dir_size * (unsigned)n;
+    for (int i = 0; i < n; i++) {
+        unsigned char *e = blob + 16 + dir_size * i;
+        memset(e, 0, (size_t)dir_size);          /* 真打包器就是 NUL 填充的 */
+        char nm[FACE_NAME_CAP];
+        snprintf(nm, sizeof(nm), "%d号脸", i);
+        memcpy(e, nm, strlen(nm));
+        unsigned off = base + (unsigned)i * (unsigned)px_len + (align_bad ? 1u : 0u);
+        put32(e + 28, off);
+        put32(e + 32, (unsigned)px_len);
+        e[36] = (unsigned char)(i < 2 ? 0 : 1);
+        e[37] = (unsigned char)(i == 2 ? 2 : 0);
+    }
+}
+
+int main(void)
+{
+    face_pack_t p;
+    face_ent_t  e;
+
+    /* 1) 正常包 */
+    build(N, FACE_DIR_ENTRY, FACE_PX_BYTES, 0);
+    CHECK(face_pack_parse(blob, sizeof(blob), &p) == 0, "正常包应解析成功");
+    CHECK(p.count == N && p.w == FACE_W && p.h == FACE_H, "count/w/h");
+    CHECK(face_pack_at(&p, 0, &e) == 0, "第 0 项应取到");
+    CHECK(strcmp(e.name, "0号脸") == 0, "名字抄对了");
+    CHECK(e.len == FACE_PX_BYTES, "len = 36400");
+    CHECK(face_pack_px(&p, &e) == p.base + e.off, "像素指针 = base+off");
+    CHECK(face_pack_at(&p, 2, &e) == 0 && e.layer == 1 && e.lvl == 2, "层/门槛读对了");
+    CHECK(face_pack_at(&p, -1, &e) < 0, "负下标要拒绝");
+    CHECK(face_pack_at(&p, N, &e) < 0, "越界下标要拒绝");
+
+    /* 2) magic 不对 */
+    build(N, FACE_DIR_ENTRY, FACE_PX_BYTES, 0);
+    blob[0] = 'X';
+    CHECK(face_pack_parse(blob, sizeof(blob), &p) < 0, "错 magic 要拒绝");
+
+    /* 3) 尺寸不是 140×130 */
+    build(N, FACE_DIR_ENTRY, FACE_PX_BYTES, 0);
+    put16(blob + 6, 210);
+    CHECK(face_pack_parse(blob, sizeof(blob), &p) < 0, "错尺寸要拒绝");
+
+    /* 4) 目录项大小不对 */
+    build(N, 32, FACE_PX_BYTES, 0);
+    CHECK(face_pack_parse(blob, sizeof(blob), &p) < 0, "dir_size!=40 要拒绝");
+
+    /* 5) 包被截断 */
+    build(N, FACE_DIR_ENTRY, FACE_PX_BYTES, 0);
+    CHECK(face_pack_parse(blob, sizeof(blob) - 1, &p) < 0, "截断要拒绝");
+
+    /* 6) 一帧字节数不对 */
+    build(N, FACE_DIR_ENTRY, FACE_PX_BYTES - 2, 0);
+    CHECK(face_pack_parse(blob, sizeof(blob), &p) == 0, "整包长度够就允许解析");
+    CHECK(face_pack_at(&p, 0, &e) < 0, "len != 36400 要拒绝");
+
+    /* 7) off 没 8 字节对齐 */
+    build(N, FACE_DIR_ENTRY, FACE_PX_BYTES, 1);
+    CHECK(face_pack_parse(blob, sizeof(blob), &p) == 0, "包本身能解析");
+    CHECK(face_pack_at(&p, 0, &e) < 0, "未对齐的 off 要拒绝");
+
+    /* 8) 空指针 */
+    CHECK(face_pack_parse(NULL, sizeof(blob), &p) < 0, "NULL blob 要拒绝");
+    CHECK(face_pack_parse(blob, sizeof(blob), NULL) < 0, "NULL out 要拒绝");
+
+    if (fails) { printf("FAIL %d 项\n", fails); return 1; }
+    printf("faces_pack: 8 组 / 全部通过\n");
+    return 0;
+}
