+    /* 直接 app_menu_enter() 换屏，**不能用 app_request_enter_name()**：
+       后者只是"点单"（s_pending_enter），要等下一次按键的回调跑完才真正换页 ——
+       于是第一颗 ▼ 会被上一页吃掉，● 直接落在「配网」上（2026-10-28 15:0x 实测两次）。 */
+    int target = -1;
+    for (int i = 0; i < demo_count(); i++) {
+        const struct demo_entry *e = demo_at(i);
+        if (e && e->name && strcmp(e->name, "设置") == 0) { target = i; break; }
+    }
+    ESP_LOGW(TAG, "VOL_PROBE 进「设置」（下标 %d）", target);
+    if (target >= 0) app_menu_enter(target);
+    vTaskDelay(pdMS_TO_TICKS(1500));
+
+    app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK);          /* 配网 → 音量 */
+    vTaskDelay(pdMS_TO_TICKS(500));
+    app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);            /* 进调节态 */
+    vTaskDelay(pdMS_TO_TICKS(600));
+    for (int i = 0; i < 3; i++) {                      /* +5 ×3 = +15 */
+        app_sim_key(BSP_BTN_UP, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(700));
+    }
+    ESP_LOGW(TAG, "VOL_PROBE 调完 = %u%%", (unsigned)app_volume_get());
+    app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);            /* 保存 */
+    vTaskDelay(pdMS_TO_TICKS(500));
+
+    app_sim_key(BSP_BTN_OK, BSP_BTN_LONG);             /* 长按 ● 回主页 */
+    vTaskDelay(pdMS_TO_TICKS(1000));
+    ESP_LOGW(TAG, "VOL_PROBE 退出后（内存里）= %u%%", (unsigned)app_volume_get());
+
+    if (target >= 0) app_menu_enter(target);            /* 重进：看它有没有读回保存值 */
+    vTaskDelay(pdMS_TO_TICKS(1500));
+    ESP_LOGW(TAG, "VOL_PROBE 重进设置页，页面显示应该是 %u%%", (unsigned)app_volume_get());
+    vTaskDelay(pdMS_TO_TICKS(600));
+    ESP_LOGW(TAG, "VOL_PROBE 结束（期望：开机 80 → 调完 95 → 重进 95；重启后仍是 95）");
+    vTaskDelete(NULL);
 }
+#endif
diff --git a/main/net_auth.c b/main/net_auth.c
new file mode 100644
index 0000000..b79322b
--- /dev/null
+++ b/main/net_auth.c
@@ -0,0 +1,50 @@
+// main/net_auth.c —— 令牌取用 + 一次性自检日志
+#include <string.h>
+#include <stdint.h>
+#include "esp_log.h"
+#include "net_auth.h"
+
+static const char *TAG = "auth";
+static int s_warned;
+
+/* 🔴 必须 __attribute__((used))：否则编译器发现"只用到前 8 个字符"，
+   会把整串令牌折掉，只留前缀 —— 实测固件里只剩 "a3b71565"，后面全没了。 */
+static const char s_tok[] __attribute__((used)) = AIP_DEV_TOKEN;
+
+const char *aip_dev_token(void)
+{
+    return s_tok;
+}
+
+int aip_dev_token_ok(void)
+{
+    const size_t n = strlen(s_tok);
+    /* 正常是 64 位 hex；占位符/空值都算"没配好" */
+    const int ok = (n >= 32 && AIP_HAS_TOKEN);
+    if (!ok && !s_warned) {
+        s_warned = 1;
+        ESP_LOGE(TAG, "设备令牌没配置（长度 %u）—— 联网接口会被服务端机拒绝。"
+                      "先跑 _工具/生成设备令牌.sh 再编译。", (unsigned)n);
+    }
+    return ok;
+}
+
+void net_auth_log_once(void)
+{
+    if (s_warned) return;
+    s_warned = 1;
+    if (!AIP_HAS_TOKEN) {
+        ESP_LOGE(TAG, "设备令牌未编入（缺 main/secrets.h）");
+        return;
+    }
+    /* 用 volatile 真的把整串读一遍，算个校验和。
+       为什么非这么写：只"打印前 8 位"的话，编译器/链接器会发现后面的字符没人用，
+       直接把令牌尾巴折掉（实测固件里只剩 "a3b71565"）。volatile 读取挡不住优化，
+       能保证整串令牌真的留在镜像里，后面发 HTTP 头才有得用。 */
+    const volatile char *p = aip_dev_token();
+    uint32_t sum = 0;
+    size_t n = 0;
+    for (; *p; ++p, ++n) sum = sum * 131u + (uint32_t)(unsigned char)*p;
+    ESP_LOGI(TAG, "设备令牌已编入（前 8 位 %.8s…，共 %u 位，校验 %08x）",
+             aip_dev_token(), (unsigned)n, (unsigned)sum);
+}
diff --git a/main/net_auth.h b/main/net_auth.h
new file mode 100644
index 0000000..fb2a234
--- /dev/null
+++ b/main/net_auth.h
@@ -0,0 +1,21 @@
+// main/net_auth.h —— 设备访问令牌的取用口（令牌本身在 main/secrets.h，不进 git）
+//
+// 为什么单独一层：令牌由构建时生成（_工具/生成设备令牌.sh），源码里不留明文；
+// 没生成时编译也能过（用占位符 + 运行时报错），免得别人 clone 后编不动。
+#pragma once
+
+/* 令牌由 CMakeLists 在构建时从 main/secrets.h 读出来，用 -DAIP_DEV_TOKEN="..." 注入。
+   不用 __has_include：实测那条路在 IDF 的编译参数下没生效（固件里连占位符都没有）。 */
+#ifndef AIP_DEV_TOKEN
+#define AIP_DEV_TOKEN "NO-TOKEN-BUILD-WITHOUT-SECRETS-H"
+#define AIP_HAS_TOKEN 0
+#else
+#define AIP_HAS_TOKEN 1
+#endif
+
+/* 发给服务端机/中继的鉴权头值；返回是否已配置（false = 忘生成令牌了） */
+const char *aip_dev_token(void);
+int         aip_dev_token_ok(void);
+
+/* 启动时打一行自检（只打前 8 位，不泄露完整令牌） */
+void        net_auth_log_once(void);
diff --git a/main/net_client.c b/main/net_client.c
new file mode 100644
index 0000000..4183888
--- /dev/null
+++ b/main/net_client.c
@@ -0,0 +1,422 @@
+// main/net_client.c —— 设备侧 HTTP 客户端（C2-a）
+//
+// 只做三件事，全都有超时和降级：
+//   ① GET /queue   拿今日队列（词表在服务端机，**换书/改词不用刷固件**）
+//   ② POST /state  把本次改动回传
+//   ③ GET /time    对时（C2-b 才用，现在先把通道打通）
+//
+// 铁律：**任何失败都必须让背单词照常进行** —— 调用方拿不到数据就退回本地队列。
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "esp_log.h"
+#include "esp_system.h"
+#include "esp_heap_caps.h"
+#include "esp_http_client.h"
+#include "esp_timer.h"
+#include "cJSON.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+
+#include "net_client.h"
+#include "voice_talk.h"   /* 2026-10-30 23:4x：取数/回传优先走语音口网关（联网即可用） */
+#include "net_auth.h"
+#include "app_config.h"
+
+static const char *TAG = "net";
+
+/* 服务端机地址统一定义在 app_config.h 的 AIP_SERVER_BASE */
+
+void net_client_release_rx(void);
+
+/* ---------------------------------------------------------------- 收包缓冲 */
+/* 2026-10-27 实测账，记下来免得再踩：
+   · 起屏 + 连 WiFi 之后可用的堆只有 ~13KB（不常驻任何收包缓冲时 ~24KB）；
+   · 以前常驻 16KB 收包缓冲 ⇒ 堆只剩 7KB、最大连续块 5.1KB ⇒ 4~6KB 的后台任务栈分不到，
+     于是"待传一直不减"；HTTP 客户端要 4KB 缓冲也分不到 ⇒ 每个请求都报
+     ESP_ERR_HTTP_CONNECT（看着像连不上服务端机，其实设备 TCP 是通的，netprobe 三条全 ✅）。
+   · 现在：**不常驻**。谁发请求谁按需要多少就 malloc 多少，发完立刻还。
+     大响应只有 /queue（90 张 ≈ 8.4KB，实测 24 张 2,231 B → ~93 B/张）。
+   ⚠️ 配网页要把收包缓冲还回堆（起热点要 DMA 内存，见 27 K7）—— 现在天然就是还着的。 */
+#define RX_QUEUE   (16 * 1024)   /* /queue 一次最多这么多。
+                                    v0.124 加词块后 90 张 ≈ 10.2 KB（服务端已砍掉固件不用的 pos/unit），
+                                    再留 6 KB 余量 —— 贴着 12 KB 时一旦词块变长就会截断、整页退成离线。 */
+#define RX_SMALL   512           /* /state /events /time 这类小响应的起始缓冲 */
+
+static char  *s_rx;              /* 当前请求的收包缓冲（本次请求内有效） */
+static size_t s_rx_cap;
+static size_t s_rx_len;
+static bool   s_rx_truncated;    /* 一次响应超过缓冲：必须报出来，别静默截断 */
+
+/* 收包缓冲按请求分配，但"卡片状态回传"和"事件补传"分属两个任务 —— 仍要串行，
+   否则两份缓冲互相踩。HTTP 最长 4 秒，串行只影响后台，不碰界面。 */
+static SemaphoreHandle_t s_http_mtx;
+
+void net_client_init(void)
+{
+    if (!s_http_mtx) s_http_mtx = xSemaphoreCreateMutex();
+    if (!s_http_mtx) ESP_LOGW(TAG, "HTTP 互斥锁创建失败：多任务同时请求可能串包");
+    ESP_LOGI(TAG, "HTTP 就绪：收包缓冲改为**按请求分配**（空闲堆 %u，最大块 %u）",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+}
+
+/* 兼容老调用点（v0.73 的"预取前归还 16KB"）：现在本来就是还着的，做成空操作。 */
+void net_client_release_rx(void)
+{
+    ESP_LOGD(TAG, "收包缓冲不再常驻，release 是空操作（空闲堆 %u）", (unsigned)esp_get_free_heap_size());
+}
+void net_client_reserve_rx(void)
+{
+    ESP_LOGD(TAG, "收包缓冲不再常驻，reserve 是空操作（空闲堆 %u）", (unsigned)esp_get_free_heap_size());
+}
+
+static esp_err_t on_http(esp_http_client_event_t *e)
+{
+    if (e->event_id == HTTP_EVENT_ON_DATA && s_rx) {
+        const size_t room = s_rx_cap - s_rx_len - 1;
+        if (e->data_len > 0 && (size_t)e->data_len >= room) s_rx_truncated = true;   /* 别静默丢 */
+        const size_t n = (e->data_len > 0 && (size_t)e->data_len < room) ? (size_t)e->data_len : room;
+        if (n) {
+            memcpy(s_rx + s_rx_len, e->data, n);
+            s_rx_len += n;
+            s_rx[s_rx_len] = 0;
+        }
+    }
+    return ESP_OK;
+}
+
+/* 发一个请求。cap = 本次收包缓冲大小（按需要给，用完即还）；
+   成功时 *body 指向 malloc 出来的正文（调用方负责 free），失败时 *body = NULL。 */
+static esp_err_t http_do(esp_http_client_method_t method, const char *path,
+                         const char *post_body, size_t cap, char **body)
+{
+    if (body) *body = NULL;
+    if (s_http_mtx) xSemaphoreTake(s_http_mtx, portMAX_DELAY);
+
+    s_rx = malloc(cap);
+    s_rx_cap = cap;
+    s_rx_len = 0;
+    s_rx_truncated = false;
+    if (!s_rx) {
+        ESP_LOGE(TAG, "%s 没发出去：收包缓冲分配失败（%u B，空闲堆 %u，最大块 %u）",
+                 path, (unsigned)cap, (unsigned)esp_get_free_heap_size(),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        if (s_http_mtx) xSemaphoreGive(s_http_mtx);
+        return ESP_ERR_NO_MEM;
+    }
+    s_rx[0] = 0;
+
+    char url[160];
+    snprintf(url, sizeof(url), "%s%s", AIP_SERVER_BASE, path);
+
+    esp_http_client_config_t cfg = {
+        .url = url,
+        .method = method,
+        .timeout_ms = 4000,                 /* 家里局域网；失败就降级 */
+        .event_handler = on_http,
+        .disable_auto_redirect = true,
+        /* 2026-10-27：默认 4KB 的收发缓冲在这台机器上常常分不到（实测最大连续块 3.5~4KB），
+           于是每个请求都报 ESP_ERR_HTTP_CONNECT（其实不是网络，是缓冲没申请到）。
+           我们只发/收几百到几 KB 的 JSON，1KB 缓冲够用，代价是多读几次。 */
+        .buffer_size = 1024,
+    };
+    esp_http_client_handle_t c = esp_http_client_init(&cfg);
+    if (!c) {
+        ESP_LOGE(TAG, "%s 没发出去：esp_http_client_init 失败（空闲堆 %u）",
+                 path, (unsigned)esp_get_free_heap_size());
+        free(s_rx); s_rx = NULL; s_rx_cap = 0;
+        if (s_http_mtx) xSemaphoreGive(s_http_mtx);
+        return ESP_FAIL;
+    }
+
+    esp_http_client_set_header(c, "X-Dev-Token", aip_dev_token());
+    esp_http_client_set_header(c, "Content-Type", "application/json");
+    if (post_body) esp_http_client_set_post_field(c, post_body, (int)strlen(post_body));
+
+    const esp_err_t err = esp_http_client_perform(c);
+    const int code = esp_http_client_get_status_code(c);
+    esp_http_client_cleanup(c);
+
+    if (s_http_mtx) xSemaphoreGive(s_http_mtx);
+
+    esp_err_t rc = ESP_OK;
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "%s 失败：%s（空闲堆 %u，最大块 %u）", path, esp_err_to_name(err),
+                 (unsigned)esp_get_free_heap_size(),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        rc = err;
+    } else if (s_rx_truncated) {
+        ESP_LOGE(TAG, "%s 响应超过收包缓冲 %u B，已截断 —— 请求方会解析失败并走降级",
+                 path, (unsigned)cap);
+        rc = ESP_ERR_INVALID_SIZE;
+    } else if (code != 200) {
+        ESP_LOGW(TAG, "%s 返回 %d（令牌不对？服务没起？）", path, code);
+        rc = ESP_ERR_INVALID_RESPONSE;
+    }
+
+    if (rc == ESP_OK && body) { *body = s_rx; s_rx = NULL; s_rx_cap = 0; }
+    else { free(s_rx); s_rx = NULL; s_rx_cap = 0; }
+    return rc;
+}
+
+/* ---------------------------------------------------------------- 语音口数据网关（2026-10-30 23:4x）
+ * 定的硬规矩：**联网即可用**，不许「只有局域网才做得了」。设备唯一可靠的通道是 8802。
+ * 顺序：先走 8802（家里/外面都通）→ 失败才退 HTTP（只有同网通，纯调试兜底）。 */
+static char *gw_get(const char *path, size_t cap)
+{
+    /* 🔴 2026-10-30 23:5x 真机（词卡页，手机热点）：12 KB 一次性 malloc 在词卡页里**拿不到**
+       （进页后最大连续块只剩 12,288 B，要 12 KB + 块头就失败），而失败是静默的 ⇒
+       界面只显示"离线"，日志一个字没有。所以这里退两档再放弃，并把退档/失败都打出来。 */
+    static const size_t LADDER[] = { 8192, 6144, 4096 };
+    size_t c = cap;
+    char *buf = malloc(c);
+    for (size_t k = 0; !buf && k < sizeof(LADDER) / sizeof(LADDER[0]); k++) {
+        c = LADDER[k];
+        if (c >= cap) continue;
+        buf = malloc(c);
+    }
+    if (!buf) {
+        ESP_LOGW(TAG, "%s：数据网关缓冲分配失败（要 %u B；空闲堆 %u，最大块 %u）", path,
+                 (unsigned)cap, (unsigned)esp_get_free_heap_size(),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        return NULL;
+    }
+    if (c != cap) {
+        ESP_LOGW(TAG, "%s：缓冲退到 %u B（%u B 连续块拿不到；空闲堆 %u，最大块 %u）", path,
+                 (unsigned)c, (unsigned)cap, (unsigned)esp_get_free_heap_size(),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    }
+    const int rc = voice_talk_get(path, buf, c);
+    if (rc == 0) return buf;
+    free(buf);
+    ESP_LOGW(TAG, "%s：走 8802 网关失败 rc=%d（空闲堆 %u）", path, rc,
+             (unsigned)esp_get_free_heap_size());
+    return NULL;
+}
+
+static bool gw_post(const char *path, const char *body)
+{
+    char reply[128];
+    return voice_talk_post(path, body, body ? strlen(body) : 0, reply, sizeof(reply)) == 0;
+}
+
+/* ---------------------------------------------------------------- 纯文本（日记） */
+net_err_t net_client_get_text(const char *path, char **out)
+{
+    if (!out) return NET_ERR_PARSE;
+    *out = NULL;
+    if (!path) return NET_ERR_PARSE;
+    char *body = gw_get(path, 4096);      /* 只走网关（2026-11-01：没有局域网这回事） */
+    if (!body) return NET_ERR_HTTP;
+    if (!body) return NET_ERR_EMPTY;
+    *out = body;
+    return NET_OK;
+}
+
+/* ---------------------------------------------------------------- 对时 */
+int64_t net_client_time(void)
+{
+    char tbuf[256];
+    char *body = NULL;
+    if (voice_talk_get("/time", tbuf, sizeof(tbuf)) == 0) {
+        body = strdup(tbuf);
+    }
+    /* 对时也只走网关（同上） */
+    if (!body) return 0;
+    cJSON *j = cJSON_Parse(body);
+    free(body);
+    if (!j) return 0;
+    const cJSON *e = cJSON_GetObjectItem(j, "epoch");
+    const int64_t v = (e && cJSON_IsNumber(e)) ? (int64_t)e->valuedouble : 0;
+    cJSON_Delete(j);
+    return v;
+}
+
+/* ---------------------------------------------------------------- 队列 */
+static void free_items(net_queue_t *q)
+{
+    if (!q->items) return;
+    for (int i = 0; i < q->n; i++) {
+        free(q->items[i].word);
+        free(q->items[i].ipa);
+        free(q->items[i].cn);
+        free(q->items[i].chunk);
+    }
+    free(q->items);
+    q->items = NULL;
+    q->n = 0;
+}
+
+void net_queue_free(net_queue_t *q)
+{
+    if (!q) return;
+    free_items(q);
+}
+
+char *net_client_queue(int day, int *due_out, int *words_out)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/queue?day=%d", day);
+    char *body = gw_get(path, RX_QUEUE);
+    /* 2026-11-01 定：**没有局域网这回事** —— 删掉「网关失败就直连 LAN_HOST:8792」这条
+       （那条只有在家里才通，外面纯属白等 4 秒，出问题还看不出是哪条路挂的）。只走 8802 网关。 */
+    if (!body) return NULL;
+
+    cJSON *j = cJSON_Parse(body);          /* 只为了拿 due / count */
+    if (!j) {
+        ESP_LOGW(TAG, "队列 JSON 解析失败（%u B）", (unsigned)strlen(body));
+        free(body);
+        return NULL;
+    }
+    if (due_out) { const cJSON *d = cJSON_GetObjectItem(j, "due"); *due_out = (d && cJSON_IsNumber(d)) ? d->valueint : 0; }
+    if (words_out) { const cJSON *c = cJSON_GetObjectItem(j, "count"); *words_out = (c && cJSON_IsNumber(c)) ? c->valueint : 0; }
+    cJSON_Delete(j);
+    /* 🔴 交回的是**正文**（调用方 free 之后交给 net_queue_parse 再解析一次）。
+       以前这里 `return (char *)j` 把 cJSON 对象指针当正文字符串交回去 ——
+       net_queue_parse 再 cJSON_Parse 那个指针，第一字节就是 NULL(根节点的 next) ⇒ 永远
+       NET_ERR_PARSE、界面悄悄显示"离线"，**日志一个字都没有**。
+       2026-10-30 23:5x 真机会话（词卡页、手机热点、8802 网关）就是这么抓到的：
+       服务端机那边明明 `GET1 /queue?day=5` 已回 2249 B，设备侧却一直拿本地队列。 */
+    return body;
+}
+
+/* 把 /queue 的 JSON 解析成队列项（字符串 strdup，调用方用 net_queue_free 释放） */
+net_err_t net_queue_parse(const char *json, net_queue_t *q)
+{
+    memset(q, 0, sizeof(*q));
+    cJSON *j = cJSON_Parse(json);
+    if (!j) return NET_ERR_PARSE;
+    const cJSON *dayj = cJSON_GetObjectItem(j, "day");
+    q->day = (dayj && cJSON_IsNumber(dayj)) ? dayj->valueint : 0;
+    const cJSON *items = cJSON_GetObjectItem(j, "items");
+    if (!items || !cJSON_IsArray(items)) { cJSON_Delete(j); return NET_ERR_PARSE; }
+
+    const int n = cJSON_GetArraySize(items);
+    q->items = calloc((size_t)n, sizeof(net_item_t));
+    if (!q->items) { cJSON_Delete(j); return NET_ERR_NOMEM; }
+
+    /* v0.124.1：每张卡压成一个字符串 "id|n/r|word|ipa|cn|chunk"。
+       为的是**节点数**：一个字段一个 cJSON 节点，90 张 × 6 字段 ≈ 540 个节点要 35 KB，
+       设备进页面时正好只剩 35 KB ⇒ 解析失败（2026-11-01 11:21 真机日志「队列 JSON 解析失败」）。
+       压成字符串后只有 90 个节点。**两边改必须同时改**（服务端 items 的拼法）。 */
+    for (int i = 0; i < n; i++) {
+        const cJSON *it = cJSON_GetArrayItem(items, i);
+        if (!cJSON_IsString(it) || !it->valuestring) continue;
+        char f[6][96];
+        int fi = 0;
+        const char *sp = it->valuestring;
+        while (fi < 6 && sp) {
+            const char *bar = strchr(sp, '|');
+            const size_t len = bar ? (size_t)(bar - sp) : strlen(sp);
+            const size_t cpn = (len < sizeof(f[0]) - 1) ? len : sizeof(f[0]) - 1;
+            memcpy(f[fi], sp, cpn);
+            f[fi][cpn] = 0;
+            fi++;
+            sp = bar ? (bar + 1) : NULL;
+        }
+        while (fi < 6) { f[fi][0] = 0; fi++; }
+        const int idv = atoi(f[0]);
+        if (idv < 0 || idv > 65535) continue;
+        net_item_t *d = &q->items[q->n++];
+        d->id = (uint16_t)idv;
+        d->is_new = (f[1][0] == 'n');
+        d->word  = strdup(f[2]);
+        d->ipa   = strdup(f[3]);
+        d->cn    = strdup(f[4]);
+        d->chunk = strdup(f[5]);
+    }
+    cJSON_Delete(j);
+    return (q->n > 0) ? NET_OK : NET_ERR_EMPTY;
+}
+
+/* ---------------------------------------------------------------- 回传 */
+/* 一张卡最多 ~75 字节，按 96 B/张 留余量；拼的时候还是逐次检查，别让 snprintf 的
+   "返回本来要写多少"把 off 顶到 cap 之外（那样 cap-off 会下溢成天文数字 ⇒ 写坏堆）。 */
+char *net_client_build_state_json(int day, const net_state_t *cards, int n)
+{
+    if (n <= 0) return NULL;
+    const size_t cap = 128 + (size_t)n * 96;
+    char *buf = malloc(cap);
+    if (!buf) {
+        ESP_LOGE(TAG, "状态 JSON 分配失败（%u B，空闲堆 %u）", (unsigned)cap,
+                 (unsigned)esp_get_free_heap_size());
+        return NULL;
+    }
+    int off = snprintf(buf, cap, "{\"day\":%d,\"cards\":[", day);
+    for (int i = 0; i < n && off > 0 && (size_t)off + 96 < cap; i++) {
+        const int k = snprintf(buf + off, cap - (size_t)off,
+                               "%s{\"id\":%u,\"S\":%.4f,\"D\":%.4f,\"reps\":%u,\"lapses\":%u,\"last_day\":%d}",
+                               i ? "," : "", cards[i].id, cards[i].S, cards[i].D,
+                               cards[i].reps, cards[i].lapses, cards[i].last_day);
+        if (k < 0) break;
+        off += k;
+    }
+    if ((size_t)off >= cap - 2) off = (int)cap - 3;      /* 保险：留出 "]}"; 必须自洽 */
+    snprintf(buf + off, cap - (size_t)off, "]}");
+    return buf;
+}
+
+net_err_t net_client_post_state_json(const char *json)
+{
+    if (!json) return NET_OK;
+    if (gw_post("/state", json)) return NET_OK;
+    return NET_ERR_HTTP;                 /* 只走网关；失败就如实上报，让上层留着下次补 */
+}
+
+net_err_t net_client_post_state(int day, const net_state_t *cards, int n)
+{
+    if (n <= 0) return NET_OK;
+    char *buf = net_client_build_state_json(day, cards, n);
+    if (!buf) return NET_ERR_NOMEM;
+    const net_err_t r = net_client_post_state_json(buf);
+    free(buf);
+    if (r != NET_OK) return r;
+    ESP_LOGI(TAG, "回传 %d 张卡片状态 OK", n);
+    return NET_OK;
+}
+
+/* ---------------------------------------------------------------- 复习事件补传 */
+/* 一条事件的 JSON 约 70 字节；32 条 < 3KB —— 比让设备分多次握手便宜得多。 */
+net_err_t net_client_post_events(const net_event_t *ev, int n, uint32_t *ack_out)
+{
+    if (ack_out) *ack_out = 0;
+    if (n <= 0) return NET_OK;
+
+    const size_t cap = 32 + (size_t)n * 96;
+    char *buf = malloc(cap);
+    if (!buf) return NET_ERR_NOMEM;
+
+    int off = snprintf(buf, cap, "{\"events\":[");
+    for (int i = 0; i < n; i++) {
+        off += snprintf(buf + off, cap - (size_t)off,
+                        "%s{\"seq\":%u,\"id\":%u,\"g\":%u,\"f\":%u,\"rt\":%u,\"flip\":%u,\"day\":%u,\"t\":%u}",
+                        i ? "," : "", (unsigned)ev[i].seq, (unsigned)ev[i].id,
+                        (unsigned)ev[i].grade, (unsigned)ev[i].flags,
+                        (unsigned)ev[i].rt_ms, (unsigned)ev[i].flip_ms, (unsigned)ev[i].day, (unsigned)ev[i].t_ms);
+    }
+    snprintf(buf + off, cap - (size_t)off, "]}");
+
+    char *body = NULL;
+    char reply[128];
+    if (voice_talk_post("/events", buf, strlen(buf), reply, sizeof(reply)) == 0) {
+        body = strdup(reply);           /* 网关成功：ack 从回包里拿 */
+        free(buf);
+    } else {
+        free(buf);
+        return NET_ERR_HTTP;            /* 只走网关；失败就留着重传 */
+    }
+
+    cJSON *j = cJSON_Parse(body);
+    free(body);
+    if (!j) return NET_ERR_PARSE;
+    uint32_t ack = 0;
+    const cJSON *a = cJSON_GetObjectItem(j, "ack");
+    if (a && cJSON_IsNumber(a) && a->valuedouble > 0) ack = (uint32_t)a->valuedouble;
+    cJSON_Delete(j);
+
+    if (ack_out) *ack_out = ack;
+    ESP_LOGI(TAG, "补传 %d 条事件 OK，服务端机水位 %u", n, (unsigned)ack);
+    return NET_OK;
+}
diff --git a/main/net_client.h b/main/net_client.h
new file mode 100644
index 0000000..a8800ff
--- /dev/null
+++ b/main/net_client.h
@@ -0,0 +1,87 @@
+// main/net_client.h —— 设备侧"服务端机客户端"（C2-a：队列下发 + 状态回传）
+#pragma once
+
+#include <stdint.h>
+#include <stdbool.h>
+
+typedef enum {
+    NET_OK = 0,
+    NET_ERR_HTTP = -1,
+    NET_ERR_PARSE = -2,
+    NET_ERR_EMPTY = -3,
+    NET_ERR_NOMEM = -4,
+} net_err_t;
+
+typedef struct {
+    uint16_t id;
+    bool     is_new;
+    char    *word;      /* strdup 出来的，net_queue_free 释放 */
+    char    *ipa;
+    char    *cn;
+    char    *chunk;     /* v0.124：词块/搭配（如 have breakfast → had breakfast），答案面第二行 */
+} net_item_t;
+
+typedef struct {
+    net_item_t *items;
+    int         n;
+    int         day;        /* v0.124.1：服务端按**日历**发的学习日；设备用它，别再自己数（K48）*/
+} net_queue_t;
+
+typedef struct {
+    uint16_t id;
+    float    S, D;
+    uint16_t reps;
+    uint8_t  lapses;
+    int      last_day;
+} net_state_t;
+
+/* 复习事件（C2-b）：seq 是幂等键，服务端机按它去重；重复传同一条不会重复计 */
+typedef struct {
+    uint32_t seq;
+    uint16_t id;
+    uint8_t  grade;     /* 1..4 */
+    uint8_t  flags;     /* EV_FLAG_*（evlog.h） */
+    uint16_t rt_ms;     /* 反应时（出现→打分） */
+    uint16_t flip_ms;   /* 翻面时（出现→第一次翻面） */
+    uint16_t day;
+    uint32_t t_ms;      /* 本场会话内相对时刻 */
+} net_event_t;
+
+/* 建 HTTP 互斥锁 + 预分配 16KB 收包缓冲。开机调一次。 */
+void net_client_init(void);
+
+/* 把收包缓冲还回堆（配网页 2/3 的失败都栽在"堆不够"：二维码画布 1682B 拿不到、
+   手机加入时驱动分不出缓冲 → deauth reason=1）。配网页进入时调，下次真要发请求会自动再分配。 */
+void net_client_release_rx(void);
+
+/* 出配网页时把 16KB 收包缓冲**回填**（配网页进来时用 net_client_release_rx 还回堆了）。
+   不回填的后果：下一次补传要现场 malloc，那时 LVGL/WiFi 已经把堆啃掉，
+   大概率分不到连续 16KB ⇒ 事件补传静默失败（屏上"待传 N"一直不减）。 */
+void net_client_reserve_rx(void);
+
+/* 拉今日队列。成功返回 0，json 由调用方 cJSON_Delete；失败返回非 0（调用方走本地降级） */
+char     *net_client_queue(int day, int *due_out, int *count_out);
+net_err_t net_queue_parse(const char *json, net_queue_t *q);
+void      net_queue_free(net_queue_t *q);
+
+/* 回传卡片状态（批量，幂等：同样的值重复传结果一样） */
+net_err_t net_client_post_state(int day, const net_state_t *cards, int n);
+
+/* 只**拼**一份 /state 的 JSON 正文（不联网；调用方 free）。
+   卡片页退出走这条：拼完交给 ev_sync_attach_state()，由补传线程顺路发掉，
+   自己不再起一个 6KB 栈的任务（2026-10-27 内存债）。JSON 格式只此一份，别在别处再拼。 */
+char     *net_client_build_state_json(int day, const net_state_t *cards, int n);
+
+/* 发一份**已经拼好**的 /state JSON（不重建；调用方自己释放那个缓冲） */
+net_err_t net_client_post_state_json(const char *json);
+
+/* 补传复习事件（批量，**按 seq 幂等**：同一批重传不会重复计）。
+   成功时 *ack_out = 服务端机已收下的最大 seq（水位只升不降）。 */
+net_err_t net_client_post_events(const net_event_t *ev, int n, uint32_t *ack_out);
+
+/* 拉一段**纯文本**（日记）：成功时 *out = malloc 出来的正文（调用方 free）、返回 NET_OK。
+   2026-10-30 P2 加：日记页只读盘、不生成，所以超时沿用 http_do 的 4 s。 */
+net_err_t net_client_get_text(const char *path, char **out);
+
+/* 服务器时间（C2-b 用它替换"一次会话=一天"） */
+int64_t   net_client_time(void);
diff --git a/main/pet_store.c b/main/pet_store.c
new file mode 100644
index 0000000..4e18a6d
--- /dev/null
+++ b/main/pet_store.c
@@ -0,0 +1,69 @@
+// main/pet_store.c —— 亲密度/上次见面 存 NVS（读不出来就当第一次用，绝不挡开机）
+#include "pet_store.h"
+
+#include <string.h>
+
+#include "esp_log.h"
+#include "nvs.h"
+
+static const char *TAG = "pet_store";
+
+/* 跨页的一次性事件（RAM，不进 NVS）：番茄页置位，桌宠页取走 */
+static volatile bool s_tomato_pending;
+
+void pet_store_pending_tomato(void)
+{
+    s_tomato_pending = true;
+    ESP_LOGI(TAG, "记一笔：番茄完成，等桌宠页补发（+2 亲密度）");
+}
+
+bool pet_store_take_tomato(void)
+{
+    const bool v = s_tomato_pending;
+    s_tomato_pending = false;
+    return v;
+}
+#define NS   "pet"
+#define K_INT "intim"
+#define K_SEEN "seen"
+
+esp_err_t pet_store_load(pet_store_t *st)
+{
+    if (!st) return ESP_ERR_INVALID_ARG;
+    memset(st, 0, sizeof(*st));
+
+    nvs_handle_t h;
+    esp_err_t e = nvs_open(NS, NVS_READONLY, &h);
+    if (e == ESP_ERR_NVS_NOT_FOUND) return ESP_OK;      /* 第一次用，正常 */
+    if (e != ESP_OK) {
+        ESP_LOGW(TAG, "nvs_open 失败：%s（当第一次用）", esp_err_to_name(e));
+        return e;
+    }
+    uint16_t intim = 0;
+    uint32_t seen = 0;
+    if (nvs_get_u16(h, K_INT, &intim) != ESP_OK) intim = 0;
+    if (nvs_get_u32(h, K_SEEN, &seen) != ESP_OK) seen = 0;
+    nvs_close(h);
+
+    st->int家用电脑y  = intim;
+    st->last_seen = seen;
+    return ESP_OK;
+}
+
+esp_err_t pet_store_save(const pet_store_t *st)
+{
+    if (!st) return ESP_ERR_INVALID_ARG;
+
+    nvs_handle_t h;
+    esp_err_t e = nvs_open(NS, NVS_READWRITE, &h);
+    if (e != ESP_OK) {
+        ESP_LOGW(TAG, "nvs_open 写失败：%s", esp_err_to_name(e));
+        return e;
+    }
+    e = nvs_set_u16(h, K_INT, st->int家用电脑y);
+    if (e == ESP_OK) e = nvs_set_u32(h, K_SEEN, st->last_seen);
+    if (e == ESP_OK) e = nvs_commit(h);
+    nvs_close(h);
+    if (e != ESP_OK) ESP_LOGW(TAG, "存失败：%s", esp_err_to_name(e));
+    return e;
+}
diff --git a/main/pet_store.h b/main/pet_store.h
new file mode 100644
index 0000000..5223a0c
--- /dev/null
+++ b/main/pet_store.h
@@ -0,0 +1,24 @@
+// main/pet_store.h —— 桌宠的"关系账"存 NVS：亲密度 + 上次见面时间
+//
+// 为什么单独一个文件：这层是 **esp 胶水**（nvs_flash），逻辑（等级换算、重逢判定）在
+// `components/pet_mood` 里，那边能 host 测；这边只负责读写，读不出来就当"第一次用"。
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "esp_err.h"
+
+typedef struct {
+    uint16_t int家用电脑y;    /* 累计亲密度（0..999）：聊一次 +1，番茄 +2 */
+    uint32_t last_seen;   /* 上次离开的时刻（epoch 秒），0 = 没记录 */
+} pet_store_t;
+
+/* 番茄到点 → 桌宠页进页时补发（只活到本次上电：重启就没了，这是故意的——
+   番茄奖励只该在她"在场"时兑现；真要跨重启，得进 NVS，不值当） */
+void pet_store_pending_tomato(void);
+bool pet_store_take_tomato(void);          /* 取走并清零：只有第一个调用者拿到 true */
+
+/* 没有记录也返回 ESP_OK（并给 0）；真出错才非 OK */
+esp_err_t pet_store_load(pet_store_t *st);
+esp_err_t pet_store_save(const pet_store_t *st);
diff --git a/main/pgb2_probe.c b/main/pgb2_probe.c
new file mode 100644
index 0000000..6d5f915
--- /dev/null
+++ b/main/pgb2_probe.c
@@ -0,0 +1,112 @@
+// main/pgb2_probe.c —— 启动时的一次性存储探针（真机验证用）
+//
+// 目的：在**真 Flash** 上证明三件事，且重启后还能自证：
+//   ① 能挂载（分区表对、找得到 storage 区）
+//   ② 能落盘（写好回读校验通过）
+//   ③ 重启后数据还在（seq/内容都对得上 —— 这才是"落盘"而不是"写在内存里假装")
+//
+// 只在 APP_PGB2_PROBE=1 时被调用；默认 0，测完改回。
+#include <string.h>
+#include "esp_log.h"
+#include "pgb2.h"
+#include "pgb2_esp.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+static const char *TAG = "probe";
+
+#define PROBE_BASE  9000          /* 探针用的卡号段，避开真词表 0..452 */
+#define PROBE_N     3
+
+/* 探针卡的"期望内容"完全由序号推出来 —— 不依赖任何外部状态 */
+static void expect_card(int i, pgb2_card_t *c)
+{
+    memset(c, 0, sizeof(*c));
+    c->id      = (uint16_t)(PROBE_BASE + i);
+    c->S       = 10.0f + (float)i;          /* 10/11/12 天 */
+    c->D       = 5.0f + (float)i * 0.5f;    /* 5 / 5.5 / 6 */
+    c->reps    = (uint16_t)(i + 1);
+    c->lapses  = (uint8_t)i;
+    c->flags   = PGB2_FLAG_INTRODUCED;
+    c->due_day = (uint16_t)(i * 2);
+}
+
+/* 真机掉电试验：连续改数据 + sync，随机时刻被复位打断。
+   每次上电先由 pgb2_esp_mount() 核对确认槽（盘上 seq 不许比确认槽旧、内容不许不符），
+   这一行就是判据；本函数只负责制造"写到一半"的机会。 */
+void pgb2_powercut_boot(int syncs)
+{
+    pgb2_err_t e = pgb2_esp_mount();
+    if (e == PGB2_ERR_IO || e == PGB2_ERR_NOSPACE) {
+        ESP_LOGE(TAG, "CUTTEST 存储不可用（%s）", pgb2_err_str(e));
+        return;
+    }
+    pgb2_ring_reset();
+    ESP_LOGI(TAG, "CUTTEST 上电：seq=%u 卡数=%u 确认槽=%s → 开始连写 %d 次",
+             (unsigned)pgb2_seq(), (unsigned)pgb2_count(),
+             pgb2_err_str(pgb2_meta_verify()), syncs);
+
+    for (int i = 0; i < syncs; i++) {
+        pgb2_card_t c = {0};
+        c.id      = 9999;
+        c.S       = 1000.0f + (float)i;
+        c.D       = 5.5f;
+        c.reps    = (uint16_t)(i & 0xFFFF);
+        c.flags   = PGB2_FLAG_INTRODUCED;
+        c.due_day = (uint16_t)(i % 90);
+        pgb2_put(&c);
+        pgb2_err_t se = pgb2_sync();
+        if (se != PGB2_OK) {
+            ESP_LOGE(TAG, "CUTTEST 第 %d 次落盘失败：%s", i, pgb2_err_str(se));
+            break;
+        }
+        ESP_LOGI(TAG, "CUTTEST 落盘 seq=%u S=%.0f", (unsigned)pgb2_seq(), c.S);
+        vTaskDelay(pdMS_TO_TICKS(2));
+    }
+    ESP_LOGI(TAG, "CUTTEST 本轮写满 %d 次（没被复位打断）", syncs);
+}
+
+void pgb2_probe_boot(void)
+{
+    pgb2_err_t e = pgb2_esp_mount();
+    if (e == PGB2_ERR_IO || e == PGB2_ERR_NOSPACE) {
+        ESP_LOGE(TAG, "存储不可用（%s），跳过探针", pgb2_err_str(e));
+        return;
+    }
+
+    /* 上一轮留下的探针卡还在不在？在 = 上次真的落盘了 */
+    int found = 0, bad = 0;
+    for (int i = 0; i < PROBE_N; i++) {
+        pgb2_card_t want, got;
+        expect_card(i, &want);
+        if (pgb2_get(want.id, &got) == PGB2_OK) {
+            found++;
+            if (got.S != want.S || got.D != want.D || got.reps != want.reps || got.due_day != want.due_day) {
+                bad++;
+                ESP_LOGE(TAG, "探针 %u 内容不符：盘上 S=%.1f D=%.1f reps=%u due=%u ｜ 期望 S=%.1f D=%.1f reps=%u due=%u",
+                         want.id, got.S, got.D, got.reps, got.due_day,
+                         want.S, want.D, want.reps, want.due_day);
+            }
+        }
+    }
+
+    if (found == PROBE_N && bad == 0) {
+        ESP_LOGI(TAG, "✅ 重启读回：3 张探针卡都在且内容一致（seq=%u，全表 %u 张）",
+                 (unsigned)pgb2_seq(), (unsigned)pgb2_count());
+        return;
+    }
+
+    /* 第一次（或上次没写成）：把探针卡写进去并落盘 */
+    for (int i = 0; i < PROBE_N; i++) {
+        pgb2_card_t want;
+        expect_card(i, &want);
+        pgb2_put(&want);
+    }
+    pgb2_err_t se = pgb2_sync();
+    if (se == PGB2_OK) {
+        ESP_LOGI(TAG, "✅ 首次落盘：写入 3 张探针卡，seq=%u，全表 %u 张（重启后再看这一行会变成「重启读回」）",
+                 (unsigned)pgb2_seq(), (unsigned)pgb2_count());
+    } else {
+        ESP_LOGE(TAG, "❌ 落盘失败：%s", pgb2_err_str(se));
+    }
+}
diff --git a/main/selftest.c b/main/selftest.c
new file mode 100644
index 0000000..dd7f236
--- /dev/null
+++ b/main/selftest.c
@@ -0,0 +1,167 @@
+// main/selftest.c —— LVGL 页面生命周期自检
+//
+// 为什么要有：LVGL 切页只是换 active screen，旧对象树和定时器不会自己消失。
+// "每道闸都绿、但某天页面打不开" 的典型原因就是 enter/exit 不对称。
+//
+// 做法：每页 enter → 等 200ms（让定时器跑一轮）→ exit，重复 5 轮，
+// 每轮记 LVGL 池的 free / biggest / frag；任一轮 free 掉超过 5% 或 frag 涨超过 10 个点就 FAIL。
+#include "lvgl.h"
+#include "bsp_display.h"
+#include "demo.h"
+#include "esp_log.h"
+#include "esp_heap_caps.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#include "app_config.h"
+
+static const char *TAG = "ST";
+
+typedef struct { uint32_t free_size, biggest, frag_pct, used_pct; } mem_t;
+
+static mem_t mem_now(void)
+{
+    lv_mem_monitor_t m;
+    lv_mem_monitor(&m);
+    mem_t r = { (uint32_t)m.free_size, (uint32_t)m.free_biggest_size,
+                (uint32_t)m.frag_pct, (uint32_t)m.used_pct };
+    return r;
+}
+
+/* 系统堆：B2（配网页反复进出漏堆）看的是这个，不是 LVGL 池。
+   pool 与 heap 是两本账，混着看就永远查不出漏在哪。 */
+static uint32_t heap_free(void)  { return (uint32_t)heap_caps_get_free_size(MALLOC_CAP_8BIT); }
+static uint32_t heap_blocks(void){ return (uint32_t)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT); }
+
+/* 有副作用/耗时/会起网络的页面，默认不进自检（否则自检本身就把设备搅乱） */
+/* 白名单：只测"纯界面、无网络/音频/射频副作用"的页。
+   理由：自检不能把设备搅乱（配网页会起热点、音频页会起 I2S）。 */
+static bool page_safe(const char *name)
+{
+#if APP_SELFTEST_INCLUDE_SIDE_EFFECT_PAGES
+    (void)name; return true;
+#else
+    /* 🔴 「自检」绝不能进白名单：它 enter() 会再起一轮 selftest_run()，等于递归。
+       2026-10-25 真机首跑抓到：一次自检跑出 3 个 baseline、全程没有 RESULT。 */
+    return (!strcmp(name, "显示") || !strcmp(name, "按键") ||
+            !strcmp(name, "电量") || !strcmp(name, "字体"));
+#endif
+}
+
+/* ------------------------------------------------------------------ 导航 */
+/* 用真按键路径移动选中项（不直接调 d->enter()：那会和框架导航/LVGL 锁打架，踩过） */
+static int s_sel = 0;
+
+static void nav_to(int i)
+{
+    while (s_sel != i) {
+        app_sim_key((s_sel < i) ? BSP_BTN_DOWN : BSP_BTN_UP, BSP_BTN_CLICK);
+        s_sel += (s_sel < i) ? 1 : -1;
+        vTaskDelay(pdMS_TO_TICKS(120));
+    }
+}
+
+/* ------------------------------------------------------------------ B2 专项 */
+/* B2：反复进出「配网」页 N 轮，看**系统堆**是否回到基线。
+   为什么单开一个：配网页每轮起 AP+DNS+httpd 再 wprov_stop() 拆掉，
+   拆不干净就每轮漏几 KB —— 31K→3K 那个 bug 就是这样，而 LVGL 池一点都看不出来。
+   走真按键路径，进/出都让框架自己走（不直接调 enter/exit）。 */
+void selftest_prov_rounds(int rounds)
+{
+    int idx = -1;
+    for (int i = 0; i < demo_count(); i++) {
+        const demo_entry_t *d = demo_at(i);
+        if (d && !strcmp(d->name, "配网")) { idx = i; break; }
+    }
+    if (idx < 0) { ESP_LOGE(TAG, "PROVRESULT FAIL 菜单里没有「配网」页"); return; }
+
+    nav_to(idx);
+    const uint32_t h0 = heap_free(), l0 = heap_blocks();
+    ESP_LOGI(TAG, "PROVBASE 进配网页之前 heap free=%u largest=%u", h0, l0);
+
+    /* 判据说明（2026-10-25 第二次改，改对为止）：
+       ① 跟"从没起过热点的基线"比不公平 —— 第一轮起 AP 就会永久占掉 DHCP/AP netif 那几 KB；
+       ② 跟"第 5 轮"这种单点比也不对 —— 设备本身是**4 轮一个周期**的振荡
+          （失败计数封顶/重置 与自动重连叠出来的：实测 53276 → 55064 → 55064 → 61672 循环）。
+          拿周期峰当参照，末轮恰好落在谷底，就会凭空算出 −6.6KB 的"泄漏"。
+       ⇒ 抓泄漏要跟**同相位的谷值**比：早期窗口的谷 vs 最后 4 轮的谷。
+          · 谷值掉超 4KB → FAIL（真泄漏）
+          · 页内最低值 < 8KB → FAIL（网页会起不来） */
+    const int    early_round = 3, early_end = 6, late_n = 4;
+    uint32_t early_min = UINT32_MAX, late_min = UINT32_MAX, in_min = UINT32_MAX;
+    uint32_t out = h0, blk = l0;
+    for (int r = 1; r <= rounds; r++) {
+        app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);          /* 进入 */
+        vTaskDelay(pdMS_TO_TICKS(4000));                 /* 起热点 + 扫一轮 */
+        const uint32_t in = heap_free();
+        if (in < in_min) in_min = in;
+        app_sim_key(BSP_BTN_OK, BSP_BTN_LONG);           /* 长按返回 */
+        vTaskDelay(pdMS_TO_TICKS(2500));                 /* 拆网 + 自动重连任务 */
+        out = heap_free();
+        blk = heap_blocks();
+        if (r >= early_round && r <= early_end && out < early_min) early_min = out;
+        if (r > rounds - late_n && out < late_min) late_min = out;
+        ESP_LOGI(TAG, "PROV round %2d: in=%u back=%u largest=%u (相对基线 %+d B)",
+                 r, in, out, blk, (int)out - (int)h0);
+    }
+    if (early_min == UINT32_MAX) early_min = h0;
+    if (late_min == UINT32_MAX) late_min = out;
+
+    const bool no_drift = ((int)late_min + 4096 >= (int)early_min);  /* 同相位谷值不再往下掉 */
+    const bool has_room = (in_min >= 8192);                          /* 页内还剩得下一张网页 */
+    const bool pass = no_drift && has_room;
+    ESP_LOGI(TAG, "PROVRESULT %s  (进出 %d 轮, 早期谷 %u → 末段谷 %u, 页内最低 %u, 最大连续块 %u→%u)",
+             pass ? "PASS" : "FAIL", rounds, early_min, late_min, in_min, l0, blk);
+    if (!no_drift) ESP_LOGE(TAG, "  泄漏：同相位谷值掉了 %d B（>4KB）", (int)early_min - (int)late_min);
+    if (!has_room) ESP_LOGE(TAG, "  余量不足：页内最低只剩 %u B（<8KB）", in_min);
+}
+
+void selftest_run(void)
+{
+    mem_t base = mem_now();
+    ESP_LOGI(TAG, "baseline pool free=%u biggest=%u frag=%u%% | heap free=%u largest=%u",
+             base.free_size, base.biggest, base.frag_pct, heap_free(), heap_blocks());
+
+    int tested = 0, fail = 0;
+    s_sel = 0;                                     /* 菜单选中项：从第 0 项开始 */
+
+    for (int round = 1; round <= 5; round++) {
+        for (int i = 0; i < demo_count(); i++) {
+            const demo_entry_t *d = demo_at(i);
+            if (!d) continue;
+
+            nav_to(i);                                   /* 真按键路径移到第 i 项 */
+            if (!page_safe(d->name)) continue;           /* 只测安全页 */
+
+            mem_t before = mem_now();
+            ESP_LOGI(TAG, "enter %s (pool free=%u biggest=%u)", d->name, before.free_size, before.biggest);
+            app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);      /* 进入 */
+            vTaskDelay(pdMS_TO_TICKS(700));              /* 让页内定时器跑一两轮 */
+            mem_t inside = mem_now();
+            app_sim_key(BSP_BTN_OK, BSP_BTN_LONG);       /* 长按返回 */
+            vTaskDelay(pdMS_TO_TICKS(500));
+            mem_t after = mem_now();
+            ESP_LOGI(TAG, "  %s: in-page free=%u → back free=%u", d->name, inside.free_size, after.free_size);
+            tested++;
+        }
+        mem_t m = mem_now();
+        ESP_LOGI(TAG, "round %d: free=%u biggest=%u frag=%u%% | heap free=%u largest=%u",
+                 round, m.free_size, m.biggest, m.frag_pct, heap_free(), heap_blocks());
+    }
+
+    mem_t end = mem_now();
+    if (tested == 0) { fail |= 8; ESP_LOGE(TAG, "一个页面都没测到"); }
+    if (end.free_size + (base.free_size / 20) < base.free_size) fail |= 1;
+    if (end.frag_pct > base.frag_pct + 10) fail |= 2;
+    if (end.biggest + (base.biggest / 4) < base.biggest) fail |= 4;
+
+    ESP_LOGI(TAG, "RESULT %s  (测 %d 次进出, free %u→%u, biggest %u→%u, frag %u%%→%u%%)",
+             fail ? "FAIL" : "PASS", tested,
+             base.free_size, end.free_size, base.biggest, end.biggest,
+             base.frag_pct, end.frag_pct);
+
+#if APP_SELFTEST_PROV_ROUNDS > 0
+    selftest_prov_rounds(APP_SELFTEST_PROV_ROUNDS);
+#endif
+}
diff --git a/main/time_sync.c b/main/time_sync.c
new file mode 100644
index 0000000..a582b63
--- /dev/null
+++ b/main/time_sync.c
@@ -0,0 +1,184 @@
+// main/time_sync.c —— 设备时间：NVS 缓存 + SNTP + 服务端机 /time 兜底
+//
+// 为什么不是简单"联网就 SNTP"：开机到连上 WiFi 有 2–5 秒，这段时间主页已经画出来了；
+// 如果没有 NVS 缓存，钟面就是 --:--（用户第一眼看到的就是没时间）。
+// 所以先把上次的时间放上去，联网后悄悄校准。
+#include "time_sync.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+
+#include "esp_log.h"
+#include "esp_netif.h"
+#include "esp_sntp.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "nvs.h"
+#include "nvs_flash.h"
+
+#include "app_config.h"          /* 🔴 不 include 它，APP_* 宏恒 0，整段自测不编（踩过） */
+#include "net_client.h"
+
+static const char *TAG = "tsync";
+
+#define NVS_NS        "tsync"
+#define NVS_KEY       "epoch"
+#define TZ_STR        "CST-8"            // 中国标准时间（UTC+8，无夏令时）
+#define TS_MIN_VALID  1735689600LL       // 2025-01-01 之前的时间都当"没对过"
+#define SAVE_EVERY_S  600                // 每 10 分钟写一次 NVS
+#define RESYNC_EVERY_S 1800              // 每 30 分钟再校一次
+#define RETRY_EVERY_S  30                // 还没对上时每 30 秒重试（配网后就靠它）
+
+static volatile bool    s_valid;         // 有过可信时间（NVS 或本次联网）
+static volatile bool    s_synced;        // 本次运行联网校过
+static volatile bool    s_req;           // 外部请求立刻校一次
+static int64_t          s_last_save;     // 上次写 NVS 的 epoch
+static TaskHandle_t     s_task;
+
+static void apply_epoch(int64_t epoch)
+{
+    struct timeval tv = { .tv_sec = (time_t)epoch, .tv_usec = 0 };
+    settimeofday(&tv, NULL);
+}
+
+static void load_from_nvs(void)
+{
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) return;
+    int64_t v = 0;
+    esp_err_t e = nvs_get_i64(h, NVS_KEY, &v);
+    nvs_close(h);
+    if (e != ESP_OK || v < TS_MIN_VALID) return;
+    apply_epoch(v);
+    s_valid = true;
+    s_last_save = v;
+    ESP_LOGI(TAG, "从 NVS 恢复时间：%lld（未联网，钟面标 ≈）", (long long)v);
+}
+
+static void save_to_nvs(int64_t epoch)
+{
+    if (epoch < TS_MIN_VALID) return;
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return;
+    (void)nvs_set_i64(h, NVS_KEY, epoch);
+    (void)nvs_commit(h);
+    nvs_close(h);
+    s_last_save = epoch;
+}
+
+static bool wifi_has_ip(void)
+{
+    esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t pi = {0};
+    return nf && esp_netif_get_ip_info(nf, &pi) == ESP_OK && pi.ip.addr != 0;
+}
+
+// 返回 true = 校时成功
+static bool sync_once(int wait_s)
+{
+#if APP_GW_DIAG
+    /* 【临时验证用，交付版必须 0】跳过 SNTP，**专验 ② 那条路**：
+       设备的 /time 到底会不会经 8802 网关拿到（2026-10-30 夜，手机热点上，屋里没有局域网）。
+       判据：这里一行 `DIAG 跳过 SNTP` ＋ 服务端机日志 `TCP 数据请求 GET1 /time`。 */
+    {
+        const int64_t t0 = net_client_time();
+        if (t0 >= TS_MIN_VALID) {
+            apply_epoch(t0);
+            s_valid = true;
+            s_synced = true;
+            save_to_nvs(t0);
+            ESP_LOGI(TAG, "DIAG 跳过 SNTP，服务端机 /time（走 8802 网关）对时成功：%lld", (long long)t0);
+            return true;
+        }
+        ESP_LOGW(TAG, "DIAG 服务端机 /time 也不通（网关/端点都不通？）");
+        return false;
+    }
+#endif
+    // ① SNTP：连上 WiFi 就能对，不依赖服务端机在线（esp_sntp_init 只调一次）
+    static bool s_sntp_inited;
+    if (!s_sntp_inited) {
+        esp_sntp_setoperatingmode(ESP_SNTP_OPMODE_POLL);
+        esp_sntp_setservername(0, "ntp.aliyun.com");
+        esp_sntp_init();
+        s_sntp_inited = true;
+    }
+    for (int i = 0; i < wait_s * 4; i++) {
+        if (esp_sntp_get_sync_status() == SNTP_SYNC_STATUS_COMPLETED) {
+            const time_t now = time(NULL);
+            ESP_LOGI(TAG, "SNTP 对时成功：%lld", (long long)now);
+            s_valid = true;
+            s_synced = true;
+            save_to_nvs((int64_t)now);
+            return true;
+        }
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+
+    // ② 服务端机 /time 兜底（局域网，SNTP 被墙/路由器挡的时候还能用）
+    const int64_t t = net_client_time();
+    if (t >= TS_MIN_VALID) {
+        apply_epoch(t);
+        s_valid = true;
+        s_synced = true;
+        save_to_nvs(t);
+        ESP_LOGI(TAG, "SNTP 不通，用服务端机 /time 对时：%lld", (long long)t);
+        return true;
+    }
+    ESP_LOGW(TAG, "这次没对上时（无网或 SNTP/服务端机都不通），钟面继续走 ≈");
+    return false;
+}
+
+static void tsync_task(void *arg)
+{
+    (void)arg;
+    // 等 IP：最多 60 秒（开机 WiFi 一般 2–5 秒）
+    for (int i = 0; i < 120 && !wifi_has_ip(); i++) vTaskDelay(pdMS_TO_TICKS(500));
+    if (wifi_has_ip()) (void)sync_once(8);
+
+    int64_t last_sync = (int64_t)time(NULL);
+    int64_t last_try  = last_sync - RETRY_EVERY_S;   /* 没对上时每 30 秒重试一次 */
+    for (;;) {
+        vTaskDelay(pdMS_TO_TICKS(5000));
+        const int64_t now = (int64_t)time(NULL);
+
+        if (s_req) {
+            s_req = false;
+            if (wifi_has_ip()) { (void)sync_once(5); last_sync = last_try = (int64_t)time(NULL); }
+        }
+
+        // 还没对上（开机没网 / 刚用配网页连上）→ 每 30 秒重试，直到成功
+        if (!s_synced && wifi_has_ip() && now - last_try >= RETRY_EVERY_S) {
+            last_try = now;
+            if (sync_once(5)) last_sync = (int64_t)time(NULL);
+        }
+
+        // 已经对上的：每 30 分钟再校一次（断网就只走内部计时）
+        if (s_synced && now - last_sync >= RESYNC_EVERY_S && wifi_has_ip()) {
+            if (sync_once(5)) last_sync = (int64_t)time(NULL);
+            else last_sync = now;          /* 失败也往后推，别每 5 秒试一次 */
+        }
+
+        // 每 10 分钟落一次盘（拔电重上电时用它顶上）
+        if (s_valid && now - s_last_save >= SAVE_EVERY_S) save_to_nvs(now);
+    }
+}
+
+void time_sync_start(void)
+{
+    setenv("TZ", TZ_STR, 1);
+    tzset();
+    load_from_nvs();
+    if (!s_task) {
+        if (xTaskCreate(tsync_task, "tsync", 4096, NULL, 3, &s_task) != pdPASS) {
+            s_task = NULL;
+            s_synced = false;
+            ESP_LOGE(TAG, "对时任务起不来（内存不够），时间只能靠 NVS 缓存");
+        }
+    }
+}
+
+bool time_sync_valid(void)  { return s_valid; }
+bool time_sync_synced(void) { return s_synced; }
+time_t time_sync_now(void)  { return s_valid ? time(NULL) : (time_t)0; }
+void time_sync_request_sync(void) { s_req = true; }
diff --git a/main/time_sync.h b/main/time_sync.h
new file mode 100644
index 0000000..6a51424
--- /dev/null
+++ b/main/time_sync.h
@@ -0,0 +1,28 @@
+// main/time_sync.h —— 设备"现在几点"的唯一来源
+//
+// 这台 C3 **没有 RTC 电池**：断电就不知道时间。所以时间分三段：
+//   ① 开机：从 NVS 读回上次对时的时间戳先顶上（屏上立刻有时间，不空着）
+//   ② 联网：SNTP（ntp.aliyun.com）校一次；SNTP 不通就用服务端机 GET /time 兜底
+//   ③ 之后：每 10 分钟把时间写回 NVS（不是每分钟写，护 Flash）；每 30 分钟再校一次
+//
+// 断网时：时钟继续走内部计时，调用方用 time_sync_synced() 判断要不要在钟面标 "≈"。
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <time.h>
+
+// 开机调一次：设时区(TZ=CST-8)、读 NVS、起对时任务。可重复调用。
+void time_sync_start(void);
+
+// 有没有"可信的时间起点"（NVS 里有，或本次已联网校过）。false = 钟面只能显示 --:--
+bool time_sync_valid(void);
+
+// 本次运行是否联网校准过。false = 时间在走但不保证准（钟面标 ≈）
+bool time_sync_synced(void);
+
+// 当前本地时间（epoch 秒，已按 TZ 偏移可直接 localtime_r）
+time_t time_sync_now(void);
+
+// 请求立刻再校一次（设置页"立即对时"用）。后台任务执行一次，不阻塞调用方。
+void time_sync_request_sync(void);
diff --git a/main/tomato_up.c b/main/tomato_up.c
new file mode 100644
index 0000000..ec2608d
--- /dev/null
+++ b/main/tomato_up.c
@@ -0,0 +1,189 @@
+// main/tomato_up.c —— 番茄上报（PRD §5.4，2026-10-31）
+//
+// 为什么单独一层：番茄完成发生在**每秒 tick 的回调里**（持 LVGL 锁），
+// 那里绝对不能碰网络（N18 的教训）。所以这里只做两件事：
+//   ① 把这一条塞进 NVS 小队列（最多 16 条，够断网一整天）
+//   ② 起一个一次性任务，把队列里的往服务端机送
+//
+// 通道：**8802 语音口网关** `PST1 /tomato`（设备与服务端机永远不同网，HTTP 到不了），
+//       起点按「在不在家」选（外面先走公网网关，家里那个永远排最后）。
+//
+// 字段（PRD §5.4，一个都不许改）：
+//   ts=完成时刻(UTC 秒，没对时填 0) dur=分钟 mode=档位 round=当天第几个
+//   dev/date/at 由服务端机填（dev = 令牌前 8 位，date 由 ts 换算，at = 收到时刻）
+#include "tomato_up.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_log.h"
+#include "esp_netif.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "nvs.h"
+
+#include "voice_talk.h"
+#include "time_sync.h"
+
+static const char *TAG = "tomatoup";
+
+#define TUP_NS          "tomat"
+#define TUP_MAX         16          /* 16 条 × 11 B = 176 B 静态，够断网一整天 */
+#define TUP_PER_RUN     6           /* 一次最多送 6 条：后台任务别霸着网络 */
+#define TUP_STACK       4096
+#define TUP_WAIT_MS     30000       /* 等联网最多 30 s（开机 2–5 s 一般就连上了） */
+
+/* 一条记录 11 字节，**打包**（NVS 里就是这 11 字节的流水，别改顺序，改了老数据读不出来）：
+   0..7 ts(i64 LE) ｜ 8 dur ｜ 9 mode ｜ 10 round */
+typedef struct __attribute__((packed)) {
+    int64_t ts;
+    uint8_t dur;
+    uint8_t mode;
+    uint8_t round;
+} tup_rec_t;
+
+static tup_rec_t       s_q[TUP_MAX];
+static int             s_n;
+static volatile bool   s_running;   /* 启动类任务互斥（N2）：在跑就不重复起 */
+static volatile bool   s_inited;
+
+static bool ip_ok(void)
+{
+    esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t pi;
+    return nf && esp_netif_get_ip_info(nf, &pi) == ESP_OK && pi.ip.addr != 0;
+}
+
+/* NVS：一次把整条队列写回去（16 条才 176 B，比逐条改省事也不心疼 Flash） */
+static void queue_save(void)
+{
+    nvs_handle_t h;
+    if (nvs_open(TUP_NS, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "打不开 NVS，这条番茄只留在内存里（重启就丢）");
+        return;
+    }
+    (void)nvs_set_u8(h, "n", (uint8_t)s_n);
+    if (s_n > 0) (void)nvs_set_blob(h, "q", s_q, (size_t)s_n * sizeof(tup_rec_t));
+    (void)nvs_commit(h);
+    nvs_close(h);
+}
+
+static void queue_load(void)
+{
+    s_n = 0;
+    nvs_handle_t h;
+    if (nvs_open(TUP_NS, NVS_READONLY, &h) != ESP_OK) return;
+    uint8_t n = 0;
+    (void)nvs_get_u8(h, "n", &n);
+    if (n > 0 && n <= TUP_MAX) {
+        size_t len = sizeof(s_q);
+        if (nvs_get_blob(h, "q", s_q, &len) == ESP_OK &&
+            len == (size_t)n * sizeof(tup_rec_t)) {
+            s_n = n;
+        } else {
+            ESP_LOGW(TAG, "队列残了（n=%u，blob %u B）——清空重来", (unsigned)n, (unsigned)len);
+            s_n = 0;
+        }
+    }
+    nvs_close(h);
+}
+
+/* ---------------------------------------------------------------- 上传 */
+static void flush_task(void *arg)
+{
+    (void)arg;
+    if (s_n <= 0) {
+        s_running = false;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    for (int i = 0; i < TUP_WAIT_MS / 500 && !ip_ok(); i++) vTaskDelay(pdMS_TO_TICKS(500));
+    if (!ip_ok()) {
+        ESP_LOGW(TAG, "没网：%d 条番茄先存着，下次开机/联网再送", s_n);
+        s_running = false;
+        vTaskDelete(NULL);
+        return;
+    }
+
+    int ok = 0;
+    for (int k = 0; k < TUP_PER_RUN && s_n > 0; k++) {
+        char js[128];
+        snprintf(js, sizeof(js), "{\"ts\":%lld,\"dur\":%u,\"mode\":%u,\"round\":%u}",
+                 (long long)s_q[0].ts, (unsigned)s_q[0].dur,
+                 (unsigned)s_q[0].mode, (unsigned)s_q[0].round);
+
+        char reply[96];
+        const int rc = voice_talk_post("/tomato", js, strlen(js), reply, sizeof(reply));
+        if (rc != 0) {
+            ESP_LOGW(TAG, "上传失败 rc=%d（还剩 %d 条）—— 下次再传，不丢", rc, s_n);
+            break;
+        }
+        if (!strstr(reply, "\"ok\":1")) {
+            /* 服务端明确说这条不合契约（比如 dur 不是 15/25/45）：别死循环重传，记一笔丢掉 */
+            ESP_LOGW(TAG, "服务端不收这条：%s ｜ 送的是 %s", reply, js);
+        } else {
+            ok++;
+        }
+        memmove(&s_q[0], &s_q[1], (size_t)(s_n - 1) * sizeof(tup_rec_t));
+        s_n--;
+        queue_save();
+    }
+
+    if (ok > 0) ESP_LOGI(TAG, "番茄上报 %d 条 OK，还剩 %d 条", ok, s_n);
+    s_running = false;
+    vTaskDelete(NULL);
+}
+
+static void flush_kick(void)
+{
+    if (s_running) return;
+    s_running = true;
+    if (xTaskCreate(flush_task, "tomatoup", TUP_STACK, NULL, 3, NULL) != pdPASS) {
+        s_running = false;
+        ESP_LOGW(TAG, "任务起不来（堆不够？）—— 番茄先存着");
+    }
+}
+
+/* ---------------------------------------------------------------- 对外 */
+void tomato_up_init(void)
+{
+    if (s_inited) return;
+    s_inited = true;
+    queue_load();
+    if (s_n > 0) {
+        ESP_LOGI(TAG, "开机：上次还有 %d 个番茄没送出去，接着送", s_n);
+        flush_kick();
+    }
+}
+
+void tomato_up_note(int dur, int mode, int round)
+{
+    if (!s_inited) tomato_up_init();
+    if (dur <= 0 || mode < 0 || mode > 2) {
+        ESP_LOGW(TAG, "参数不合法（dur=%d mode=%d），这条不记", dur, mode);
+        return;
+    }
+
+    if (s_n >= TUP_MAX) {                 /* 满了两条路：丢掉最老的，但**打出来**（不静默） */
+        ESP_LOGW(TAG, "队列满了（%d 条），丢掉最早那条（ts=%lld）", TUP_MAX, (long long)s_q[0].ts);
+        memmove(&s_q[0], &s_q[1], (size_t)(TUP_MAX - 1) * sizeof(tup_rec_t));
+        s_n = TUP_MAX - 1;
+    }
+
+    const time_t now = time_sync_valid() ? time_sync_now() : 0;
+    s_q[s_n].ts = (int64_t)now;           /* 没对时就是 0，契约允许（服务端机会把 date 记 null） */
+    s_q[s_n].dur = (uint8_t)(dur > 255 ? 255 : dur);
+    s_q[s_n].mode = (uint8_t)mode;
+    s_q[s_n].round = (uint8_t)(round < 0 ? 0 : (round > 255 ? 255 : round));
+    s_n++;
+    queue_save();
+
+    ESP_LOGI(TAG, "记账：%d 分钟（档 %d，今天第 %d 个），待传 %d 条", dur, mode, round, s_n);
+    flush_kick();
+}
+
+int tomato_up_pending(void)
+{
+    return s_n;
+}
