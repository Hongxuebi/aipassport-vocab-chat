+void demo_pet_exit(void)
+{
+    s_armed = false;
+    s_leave_pending = false;
+    voice_talk_set_level_cb(NULL);
+    voice_talk_set_meta_cb(NULL);
+
+    s_talk_stop = true;                       /* 正在说话就让它收尾 */
+    voice_talk_abort();                       /* 退页时她要是在出声：立刻闭嘴，别让声音跟到菜单 */
+    for (int i = 0; i < 200 && s_talk_busy; i++) vTaskDelay(pdMS_TO_TICKS(10));
+    /* 走之前记下"上次见面"，下次回来才知道隔了多久 */
+    s_store.last_seen = (uint32_t)time(NULL);
+    pet_store_save(&s_store);
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; s_img = NULL; s_lvl = NULL; s_echo = NULL; s_bubble = NULL; s_bubble_box = NULL; }
+}
+
+/* 开机建一次（main 在 LVGL/桌面起来之前调）：那时堆是整的，6 KB 一口气拿得到。
+   进页后再建就晚了 —— 2026-10-29 真机：页内空闲 17.2 KB 但最大连续块只有 4.3 KB。 */
+void demo_pet_voice_init(void)
+{
+    if (s_talk_task) return;
+    static const uint32_t kStacks[] = { 6144, 5120, 4608 };
+    for (size_t i = 0; i < sizeof(kStacks) / sizeof(kStacks[0]); i++) {
+        if (xTaskCreate(voice_worker, "pet_talk", kStacks[i], NULL, 5, &s_talk_task) == pdPASS) {
+            ESP_LOGI(TAG, "语音任务已常驻：栈 %u B（建之前空闲堆 %u / 最大块 %u）",
+                     (unsigned)kStacks[i], (unsigned)esp_get_free_heap_size(),
+                     (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+            return;
+        }
+        s_talk_task = NULL;
+    }
+    ESP_LOGE(TAG, "语音任务建不起来（空闲堆 %u / 最大块 %u）——她将不出声",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+}
+
+esp_err_t demo_pet_start(void)
+{
+    if (s_task) return ESP_OK;
+    s_running = true;
+
+    /* 常驻语音任务：**在 start() 里建**（页面还没铺 LVGL 对象，堆是整的）。
+       2026-10-29 M1 真机：进页后空闲 17.2 KB 但最大连续块只剩 4.3 KB ⇒ 每次开麦再 xTaskCreate(6144) 必失败。
+       6 KB 一次拿不到就往下退一档（每次都把内存数字打出来，别静默降级）。 */
+    demo_pet_voice_init();            /* 正常在开机时就建好了，这里只是兜底 */
+    if (xTaskCreate(pet_task, "pet_ui", 3072, NULL, 4, &s_task) != pdPASS) {
+        s_running = false;
+        s_task = NULL;
+        return ESP_ERR_NO_MEM;
+    }
+    return ESP_OK;
+}
+
+esp_err_t demo_pet_stop(void)
+{
+    s_running = false;
+    for (int i = 0; i < 60 && s_task; i++) vTaskDelay(pdMS_TO_TICKS(10));
+    return ESP_OK;
+}
