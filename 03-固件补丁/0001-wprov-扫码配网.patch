+#include <fcntl.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <unistd.h>
+static void net_probe_one(const char *ip, int port)
+{
+    struct sockaddr_in a;
+    memset(&a, 0, sizeof(a));
+    a.sin_family = AF_INET;
+    a.sin_port = htons((uint16_t)port);
+    if (inet_pton(AF_INET, ip, &a.sin_addr) != 1) { ESP_LOGW("netprobe", "地址不对 %s", ip); return; }
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) { ESP_LOGW("netprobe", "%s:%d 建 socket 失败", ip, port); return; }
+    const int fl = fcntl(fd, F_GETFL, 0);
+    fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+    int r = connect(fd, (struct sockaddr *)&a, sizeof(a));
+    bool ok = (r == 0);
+    if (!ok) {
+        fd_set wf; FD_ZERO(&wf); FD_SET(fd, &wf);
+        struct timeval tv = { .tv_sec = 2, .tv_usec = 0 };
+        const int sel = select(fd + 1, NULL, &wf, NULL, &tv);
+        if (sel > 0) {
+            int err = 0; socklen_t l = sizeof(err);
+            getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &l);
+            ok = (err == 0);
+            if (!ok) ESP_LOGW("netprobe", "%s:%d 连不上（SO_ERROR=%d）", ip, port, err);
+        } else {
+            ESP_LOGW("netprobe", "%s:%d 连不上（select=%d，2 秒超时）", ip, port, sel);
+        }
+    }
+    close(fd);
+    if (ok) ESP_LOGW("netprobe", "%s:%d ✅ 连上了（空闲堆 %u）", ip, port, (unsigned)esp_get_free_heap_size());
+}
+static void net_probe_task(void *arg)
+{
