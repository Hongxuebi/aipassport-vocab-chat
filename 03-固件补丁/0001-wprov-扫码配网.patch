+/* 标签帧（M2）：LLM 在回复里给的那个 `[害羞]` 标签 → **这一轮的她就是那张脸**。
+   优先级（PRD §4.2 / `72` §3.4）：戳 > 打断·录音 > 标签帧 > 状态机。
+   ⚠ 回调跑在 **pet_talk 任务**里 ⇒ 只写标志/拷字节，**绝不碰 LVGL**；
+   换图仍然由 pet_task（嘴型那条路）和 talk_round（说完那张）在锁里做。 */
+static const uint8_t k_tag_face[10] = {
+    0xFF,                                              /* 0 = 无标签 */
+    F_SHY, F_SOFT, F_SMUG, F_SNARK, F_HAPPY,           /* 1 害羞 2 心软 3 得意 4 嫌弃 5 开心 */
+    F_DONTGO, F_CRY, F_DAZED, F_THINK,                 /* 6 求别走 7 大哭 8 迷糊 9 思考 */
+};
+
+/* ---------------------------------------------------------------- 折行（v0.109：按**像素**，不按字数）
+   2026-10-31 16:2x 实测报的真问题：「她回英文，明明能占 3 行，屏上只有左半块，内容还很少」。
+   真因：`fusion_ui16` 是**比例字**（i=5.3px / a=8px / W=13.3px / 汉字=16px），而老代码按「14 字/行」切 ——
+   英文一行只填到 ~110/224 px（就是"左半块"），14 字×3 行=42 字符的上限又把英文整条回复砍短。
+   新规则（中英同一套）：
+     ① 行宽按**像素**算（TEXT_W=224），字宽取 `lv_font_get_glyph_width`（比例字必须这么量）；
+     ② 英文**不拆单词**：优先在空格后折；只有单个词比一整行还宽时才硬拆；
+     ③ 中文可任意折，但**避头尾**（行首不留 ，。！？、；：）」』…，允许多吃 16 px）；
+     ④ 行数：先算自然行数 N；N≤3 时按 ceil(总宽/N) 起、每档 +8px 试重排**均分**（v0.95 的观感）；
+     ⑤ 超过 3 行：按 total/3 起重排，末行退字补「…」（保证 224 px 装得下）。
+   ⚠️ **不许在栈上开"每字一份"的数组**（2026-10-31 16:23 就是这么崩的：160×16B=2.5KB，
+   `Stack protection fault` 开机就重启）。这里只存 8 个行指针，宽度边走边量。 */
+
+/* 行首禁则（中文标点不许打头） */
+static bool wrap_no_head(uint32_t cp)
+{
+    switch (cp) {
+    case 0xFF0C: case 0xFF01: case 0xFF1F: case 0xFF09: case 0xFF1B: case 0xFF1A:  /* ，！？）；： */
+    case 0x3002: case 0x3001: case 0x300D: case 0x300F: case 0x3011: case 0x300B:  /* 。、」』】》 */
+    case 0x2026:                                                                   /* … */
+        return true;
+    default:
+        return false;
+    }
+}
+
+static int u8_len(const char *p)
+{
+    const unsigned char c = (unsigned char)*p;
+    int n = (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 : (c >= 0xC0) ? 2 : 1;
+    for (int k = 1; k < n; k++) if (!p[k]) { n = k; break; }
+    return n;
+}
+
+static uint32_t u8_cp(const char *p, int len)
+{
+    const unsigned char c = (unsigned char)p[0];
+    if (len == 1) return c;
+    if (len == 2) return ((uint32_t)(c & 0x1F) << 6) | (uint32_t)(p[1] & 0x3F);
+    if (len == 3) return ((uint32_t)(c & 0x0F) << 12) | ((uint32_t)(p[1] & 0x3F) << 6) | (uint32_t)(p[2] & 0x3F);
+    return ((uint32_t)(c & 0x07) << 18) | ((uint32_t)(p[1] & 0x3F) << 12) |
+           ((uint32_t)(p[2] & 0x3F) << 6) | (uint32_t)(p[3] & 0x3F);
+}
+
+static int u8_adv(const char *p, int len)
+{
+    return (int)lv_font_get_glyph_width(&fusion_ui16, u8_cp(p, len), 0);
+}
+
+/* 中文字符占比（用来决定折行策略）：中文按"均分"，英文按"贪心填满"。
+   为什么分开（2026-10-31 16:3x 使用侧指出来的）：英文一个字符才 5~13px，均分会让每行只用到 160/224，
+   右边缘留一条空 —— 要求的是"today 能塞进 day 后面、and 能塞进 rest 后面"。中文一字符 16px，
+   贪心会让末行只剩 1~2 个字（30 字 → 14+14+2），所以中文继续均分。 */
+static int cjk_ratio_x100(const char *s)
+{
+    int cjk = 0, all = 0;
+    while (*s) {
+        const int n = u8_len(s);
+        const uint32_t cp = u8_cp(s, n);
+        if (cp != ' ' && cp != '\t') {
+            all++;
+            if ((cp >= 0x3000 && cp <= 0x9FFF) || (cp >= 0xFF00 && cp <= 0xFFEF)) cjk++;
+        }
+        s += n;
+    }
+    return all ? (cjk * 100 / all) : 0;
+}
+
+static int text_px(const char *s)
+{
+    int w = 0;
+    while (*s) { const int n = u8_len(s); w += u8_adv(s, n); s += n; }
+    return w;
+}
+
+/* [a,b) 区间的像素宽（末行退字时用） */
+static int text_px2(const char *a, const char *b)
+{
+    int w = 0;
+    while (a < b) { const int n = u8_len(a); w += u8_adv(a, n); a += n; }
+    return w;
+}
+
+/* 按 target 宽排一次（最多记 cap 行，返回行指针）；装不下也照实排到 cap 行 */
+static int wrap_run(const char *s, int target, const char **ss, const char **ee, int cap)
+{
+    const char *p = s;
+    int lines = 0;
+    while (*p && lines < cap) {
+        const char *start = p, *last_space = NULL;
+        int width = 0;
+        while (*p) {
+            const int n = u8_len(p);
+            const int w = u8_adv(p, n);
+            if (width + w > target) break;
+            width += w;
+            if (*p == ' ') last_space = p;
+            p += n;
+        }
+        if (p == start) {                     /* 单个字比整行还宽：硬放一个，别死循环 */
+            p += u8_len(p);
+        } else if (*p) {
+            const char *brk = last_space ? last_space + 1 : p;   /* 英文在空格后折 */
+            if (*brk) {                                        /* 避头尾：标点挤回上一行 */
+                const int n2 = u8_len(brk);
+                if (wrap_no_head(u8_cp(brk, n2)) && brk > start + 1 && width + u8_adv(brk, n2) <= target + 16) {
+                    brk += n2;
+                }
+            }
+            while (*brk == ' ') brk++;                         /* 新行不以空格打头 */
+            if (brk <= start) brk = start + 1;
+            p = brk;
+        }
+        ss[lines] = start; ee[lines] = p; lines++;
+    }
+    return lines;
+}
+
+/* 参数：src 原文、prefix 前缀（"你："/"她："）、out 出串、outsz 出串容量。返回画了几行。 */
+static int wrap_lines(const char *src, const char *prefix, char *out, size_t outsz)
+{
+    if (!out || outsz < 8) return 0;
+    out[0] = '\0';
+    if (!src || !src[0]) return 0;
+
+    char full[200];
+    snprintf(full, sizeof(full), "%s%s", prefix ? prefix : "", src);
+    const int total = text_px(full);
+
+    const char *ss[8], *ee[8];
+    int lines = wrap_run(full, TEXT_W, ss, ee, ECHO_LINES + 1);
+
+    /* 英文为主 ⇒ 保住"贪心填满"（使用侧 16:3x 要的：每行尽量塞、右边别留空）；
+       中文为主 ⇒ 均分（不然末行只剩一两个字，难看）。装不下 3 行时一律按 total/3 重排。 */
+    const bool mostly_cjk = cjk_ratio_x100(full) >= 30;
+    if (lines > 1 && (lines > ECHO_LINES || mostly_cjk)) {
+        const int want = (lines > ECHO_LINES) ? ECHO_LINES : lines;
+        const int base = (total + want - 1) / want;
+        for (int d = 0; d <= 32; d += 8) {
+            const int target = (base + d > TEXT_W) ? TEXT_W : base + d;
+            const char *s2[8], *e2[8];
+            const int l2 = wrap_run(full, target, s2, e2, ECHO_LINES + 1);
+            if (l2 <= want) {
+                for (int i = 0; i < l2; i++) { ss[i] = s2[i]; ee[i] = e2[i]; }
+                lines = l2;
+                break;
+            }
+        }
+    }
+    if (lines > ECHO_LINES) lines = ECHO_LINES;
+    const bool cut = (*ee[lines - 1] != '\0');
+
+    char *o = out;
+    char *end = out + outsz - 4;                          /* 留「…」和结束符 */
+    for (int L = 0; L < lines; L++) {
+        const char *stop = ee[L];
+        if (cut && L == lines - 1) {
+            const int ell = (int)lv_font_get_glyph_width(&fusion_ui16, 0x2026, 0);
+            int w = text_px2(ss[L], stop);
+            while (w + ell > TEXT_W) {                    /* 退字给「…」腾地方 */
+                const char *q = stop - 1;
+                while (q > ss[L] && ((unsigned char)*q & 0xC0) == 0x80) q--;
+                if (q <= ss[L]) break;                        /* 只剩一个字就不退了 */
+                w -= u8_adv(q, u8_len(q));
+                stop = q;
+            }
+        }
+        for (const char *q = ss[L]; q < stop && o < end; q++) *o++ = *q;
+        if (cut && L == lines - 1) { *o++ = 0xE2; *o++ = 0x80; *o++ = 0xA6; }   /* … */
+        if (L + 1 < lines) *o++ = '\n';
+    }
+    *o = '\0';
+    return lines;
+}
+
+/* 我说的/她说的都走这一条：**调用方必须已持 LVGL 锁** */
+static void hers_apply_locked(void)
+{
+    s_her_dirty = false;
+    if (!s_bubble) return;
+    if (!s_her_src[0]) {                                  /* 这轮她没给文本：气泡收起来 */
+        lv_label_set_text(s_bubble, "");
+        if (s_bubble_box) lv_obj_add_flag(s_bubble_box, LV_OBJ_FLAG_HIDDEN);
+        return;
+    }
+    const int n = wrap_lines(s_her_src, "她：", s_her_show, sizeof(s_her_show));
+    lv_label_set_text(s_bubble, s_her_show);
+    if (s_bubble_box) lv_obj_clear_flag(s_bubble_box, LV_OBJ_FLAG_HIDDEN);
+    ESP_LOGI(TAG, "气泡上屏：%d 行 ｜「%s」", n, s_her_show);
+}
+
+static void echo_apply_locked(void)
+{
+    s_echo_dirty = false;
+    if (!s_echo) return;
+    const int n = wrap_lines(s_echo_src, "你：", s_echo_show, sizeof(s_echo_show));
+    lv_label_set_text(s_echo, s_echo_show);
+    ESP_LOGI(TAG, "回显上屏：%d 行 ｜「%s」", n, s_echo_show);
+}
+
+/* 她说的（可能跑在 pet_talk 任务里 ⇒ 只写缓冲 + 立标志） */
+/* v0.122：把服务端那句"我去看看。"变成点点前面的底文「我看看」。只去掉句末标点，别自己改词。 */
+static void check_base_set(const char *text)
+{
+    size_t n = 0;
+    if (text) {
+        while (text[n] && n < sizeof(s_check_base) - 1) { s_check_base[n] = text[n]; n++; }
+    }
+    s_check_base[n] = 0;
+    static const char *k_tail[3] = { "\xE3\x80\x82", "\xEF\xBC\x81", "\xE2\x80\xA6" };   /* 。！ … */
+    for (int k = 0; k < 3; k++) {
+        const size_t tl = strlen(k_tail[k]);
+        while (n >= tl && memcmp(s_check_base + n - tl, k_tail[k], tl) == 0) {
+            n -= tl;
+            s_check_base[n] = 0;
+        }
+    }
+    while (n > 0 && (s_check_base[n - 1] == '\n' || s_check_base[n - 1] == ' ')) s_check_base[--n] = 0;
+}
+
+static void her_set(const char *text)
+{
+    s_her_src[0] = '\0';
+    if (text && text[0]) {
+        size_t n = 0;
+        while (text[n] && n < HER_MAX_BYTES) n++;
+        memcpy(s_her_src, text, n);
+        s_her_src[n] = '\0';
+    }
+    s_her_dirty = true;
+}
+
+/* 写入回显文本（可能跑在 pet_talk 任务里 ⇒ 这里**只写静态缓冲 + 立标志**）。
+   超长时**按字符边界**截断并补「…」—— 按字节硬切会留半个汉字，屏上就是一个方块。 */
+static void echo_set(const char *text)
+{
+    if (!text || !text[0]) return;
+    size_t n = 0;
+    bool   cut = false;
+    while (text[n]) {
+        const unsigned char c = (unsigned char)text[n];
+        int len = (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 : (c >= 0xC0) ? 2 : 1;
+        if (n + (size_t)len > ECHO_MAX_BYTES - 3) { cut = true; break; }  /* 留 3 B 给「…」 */
+        n += (size_t)len;
+    }
+    memcpy(s_echo_src, text, n);
+    s_echo_src[n] = '\0';
+    if (cut) strcat(s_echo_src, "\xE2\x80\xA6");
+    s_echo_dirty = true;
+}
+
+/* 一轮开始/退出页面：两块都擦掉（PRD F6：气泡常驻到**下一次交互**） */
+static void echo_clear(void)
+{
+    s_checking     = false;          /* v0.122：换轮/退页一定停掉点点动画 */
+    s_echo_src[0]  = '\0';
+    s_echo_show[0] = '\0';
+    s_her_src[0]   = '\0';
+    s_her_show[0]  = '\0';
+    s_echo_dirty   = true;          /* 让 pet_task 把空串刷上屏 */
+    s_her_dirty    = true;
+}
+
+static void on_voice_meta(uint8_t tag, const char *text, uint8_t flags)
+{
+    if (flags & VOICE_META_FLAG_HER) {
+        /* v0.93：她说的话 → 气泡。**不动表情骨架**（这帧的 tag 是 0，别把这一轮的表情冲掉） */
+        if (flags & VOICE_META_FLAG_CHECK) {          /* v0.122：第一段是"我去查"，气泡跑点点 */
+            s_checking = true;
+            s_dot_t = 0;
+            s_dot_i = 0;
+            check_base_set(text);                     /* 底文只取一次，别叠点点 */
+            ESP_LOGI(TAG, "她开始查：「%s」→ 气泡跑点点（底文「%s」）", text ? text : "", s_check_base);
+        } else {                                       /* 第二段就是答案：停动画、照常上屏 */
+            s_checking = false;
+        }
+        her_set(text);
+        /* 🔴 v0.122 补：**答案帧现在带表情了**（以前一直是 0）。老代码在 HER 分支里一律不换脸，
+           结果自查这一轮从头到尾都是「思考」——10:35 说的「一直就是查查的表情」就是这个。
+           这里把 tag 吃下来：脸和骨架都换成答案那张，答案一开始说就是那张脸。 */
+        if (tag != 0 && tag < (uint8_t)sizeof(k_tag_face)) {
+            const uint8_t f2 = k_tag_face[tag];
+            if (f2 < FACE_EMO_N) {
+                s_tag_face = f2;
+                s_skeleton = f2;
+                ESP_LOGI(TAG, "答案帧带表情：tag %u → 换成答案那张脸", (unsigned)tag);
+            }
+        }
+        return;
+    }
+    const uint8_t f = (tag < (uint8_t)sizeof(k_tag_face)) ? k_tag_face[tag] : (uint8_t)0xFF;
+    if (f < FACE_EMO_N) {
+        s_tag_face = f;
+        s_skeleton = f;          /* 骨架跟着换：她这三档嘴型就是这张脸的三张嘴 */
+    } else {
+        s_tag_face = 0xFF;       /* 无标签/没映射：行为跟 v0.89 完全一样（风险最低） */
+    }
+    echo_set(text);              /* v0.92：识别文本上屏（字库已扩到常用 4043 字） */
+    ESP_LOGI(TAG, "标签帧：tag %u → %s ｜ 回显「%s」",
+             (unsigned)tag, f < FACE_EMO_N ? "换骨架" : "无标签（照骨架走）", text ? text : "");
+}
+
+/* 嘴巴节拍：**调用方必须已持 LVGL 锁**。只在档位真变了才换图。 */
+static void mouth_tick_locked(uint32_t now)
+{
+    /* 网卡住时"没有新块"也当静音：别让她一直张着嘴发呆 */
+    const bool stale = (uint32_t)(now - s_last_chunk_ms) > MOUTH_STALL_MS;
+    const uint16_t lvl = stale ? MOUTH_LVL_SILENT : mouth_lvl(s_audio_mean);
+
+    if (lvl <= MOUTH_LVL_CLOSE_UP) s_quiet_blocks++; else s_quiet_blocks = 0;
+
+    int want = s_mouth_tier;
+    if (s_quiet_blocks >= 4) {                       /* 128 ms 静音 = 合上（句读之间别噼啪） */
+        want = 0;
+    } else if (s_quiet_blocks >= 2) {                /* 64 ms = 先收半张 */
+        if (want > 1) want = 1;
+    } else if (want == 0) {
+        want = 1;                                    /* 有声音：先半张 */
+    } else if (want == 1 && lvl >= MOUTH_LVL_HALF_UP) {
+        want = 2;                                    /* 够响：大开 */
+    } else if (want == 2 && lvl <= MOUTH_LVL_HALF_DN) {
+        want = 1;                                    /* 回落：半张 */
+    }
+
+    if (want == s_mouth_tier) return;
+    if ((uint32_t)(now - s_tier_since) < MOUTH_MIN_DWELL_MS) return;
+
+    const int prev = s_mouth_tier;
+    s_mouth_tier  = want;
+    s_tier_since  = now;
+    if (want < 3) s_cal_tier[want]++;
+    /* 骨架 = 开口那一刻的情绪；三档取它的 {闭/半/大}（PRD §4.4） */
+    const uint8_t emo = (s_skeleton < FACE_EMO_N) ? s_skeleton : (uint8_t)F_NEUTRAL;
+    face_set_locked(k_face3[emo][want], "说话嘴型");
+    ESP_LOGI(TAG, "嘴型 %d→%d（情绪 %u / 脸 %u ｜ mean %u lvl %u 静音块 %u）", prev, want,
+             (unsigned)emo, (unsigned)k_face3[emo][want],
+             (unsigned)s_audio_mean, (unsigned)lvl, (unsigned)s_quiet_blocks);
+}
+
+/* ---- 微动：调用方必须已持 LVGL 锁 ---- */
+/* 只有立绘跟着微动/抖动挪（PRD §4.3「整屏上移」）。
+   v0.95：关系账读数搬到顶栏后**不再跟着抖** —— 它是 HUD，跳一下反而抢戏。 */
+static void apply_pos_locked(void)
+{
+    if (s_img) lv_obj_set_pos(s_img, FACE_X + s_dx, FACE_Y + s_dy + s_shake_dy);
+}
+
+static void micro_set(int dx, int dy)
+{
+    if (dx == s_dx && dy == s_dy) return;      /* 没变就不动（不动 = 不重绘） */
+    s_dx = (int8_t)dx;
+    s_dy = (int8_t)dy;
+    apply_pos_locked();
+}
+
+/* 戳的抖动：整屏上移 amp px，PET_SHAKE_MS 后自己落回（pet_task 里收） */
+static void shake_locked(int amp)
+{
+    s_shake_dy  = (int8_t)(-amp);
+    s_shake_until = now_ms() + PET_SHAKE_MS;
+    apply_pos_locked();
+}
+
+/* 待机呼吸 / 思考抖一下 / 得意上跳；其它脸不动。换脸立刻归零。 */
+static void micro_mode(int mode, const char *why)
+{
+    if (mode == s_micro_mode) return;
+    s_micro_mode = mode;
+    ESP_LOGI(TAG, "微动：%s（%s）", mode == 1 ? "呼吸 y±1" : mode == 2 ? "思考抖一下 x±1"
+                              : mode == 3 ? "得意上跳 2px" : "停", why);
+}
+
+static void micro_tick_locked(uint32_t now)
+{
+    const int f = s_face;
+
+    if (f != s_micro_face) {                   /* 换脸：偏移归零，节拍重起 */
+        s_micro_face = f;
+        micro_set(0, 0);
+        s_micro_step = 0;
+        s_micro_next = now + MICRO_BREATH_MS;
+        s_think_until = 0;
+        return;
+    }
+    if (s_her_voice || s_talk_busy || s_boost_face >= 0 || f == PM_SLEEP) {
+        micro_set(0, 0);                       /* 说话/升级提示/睡着：一律不动 */
+        micro_mode(0, f == PM_SLEEP ? "睡着" : s_her_voice ? "她在说话" : "先不动");
+        return;
+    }
+
+    if (f == PM_SMUG) {                        /* 得意：进这张脸时上跳 2 px，220 ms 落回 */
+        micro_mode(3, "得意");
+        if (s_micro_step == 0) {
+            micro_set(0, -2);
+            s_micro_step = 1;
+            s_micro_next = now + 220;
+        } else if (s_micro_step == 1 && (int32_t)(now - s_micro_next) >= 0) {
+            micro_set(0, 0);
+            s_micro_step = 2;
+        }
+        return;
+    }
+
+    if (f == PM_THINK) {                       /* 思考：每 4.5 s 抖一下 x±1，250 ms */
+        micro_mode(2, "思考");
+        if (s_think_until && (int32_t)(now - s_think_until) >= 0) {
+            micro_set(0, 0);
+            s_think_until = 0;
+            return;
+        }
+        if (!s_think_until && (int32_t)(now - s_micro_next) >= 0) {
+            micro_set((s_micro_step & 1) ? 1 : -1, 0);
+            s_micro_step++;
+            s_think_until = now + MICRO_THINK_DUR;
+            s_micro_next = now + MICRO_THINK_MS;
+        }
+        return;
+    }
+
+    if (f == PM_NEUTRAL) {                     /* 待机：y 走 0/-1/0/+1，一拍 550 ms */
+        micro_mode(1, "待机");
+        static const int8_t kBreath[4] = { 0, -1, 0, 1 };
+        if ((int32_t)(now - s_micro_next) >= 0) {
+            micro_set(0, kBreath[s_micro_step & 3]);
+            s_micro_step++;
+            s_micro_next = now + MICRO_BREATH_MS;
+        }
+        return;
+    }
+
+    micro_set(0, 0);                           /* 嫌弃/心虚/里层那些：不微动 */
+    micro_mode(0, "这张脸不微动");
+}
+
+/* 亲密度升到 L1/L2：拿里层脸演 1.2 s（这就是"提示"，v1 不带台词）。
+   `_locked` 版要求调用方**已持 LVGL 锁**（按键回调里就是这种情况）。 */
+static void maybe_level_up_locked(int old_level, const char *why)
+{
+    if (s_mood.level <= old_level || !faces_ready()) return;
+    const bool l2 = (s_mood.level >= 2);
+    const int  f  = l2 ? PM_SHY : PM_SOFT;
+    s_boost_face  = f;
+    s_boost_until = now_ms() + PET_BOOST_MS;
+    face_set_locked(f, l2 ? "升到 L2" : "升到 L1");
+    ESP_LOGI(TAG, "亲密度升到 L%u：演「%s」%.1f s（%s，亲密度 %u）",
+             (unsigned)s_mood.level, l2 ? "害羞翻肚皮" : "心软护着你",
+             PET_BOOST_MS / 1000.0, why, (unsigned)s_store.int家用电脑y);
+}
+
+/* 自己拿锁的版本：给说话任务、进页补发这些没持锁的地方用 */
+static void maybe_level_up(int old_level, const char *why)
+{
+    if (s_mood.level <= old_level) return;
+    if (!bsp_lvgl_lock(300)) return;
+    maybe_level_up_locked(old_level, why);
+    bsp_lvgl_unlock();
+}
+
+/* ================================ 戳（PRD §4.3） ================================ */
+
+/* "不高兴" = 当前脸是嫌弃/心虚/求别走/大哭，或上一轮对话失败 */
+static bool face_is_unhappy(void)
+{
+    const uint8_t f = pm_face(&s_mood);
+    return (f == F_SNARK || f == F_GUILTY || f == F_DONTGO || f == F_CRY) || s_last_fail;
+}
+
+/* 好感结算：**5 s 只结算一次**（防连点刷分）。调用方须持锁。 */
+static void tap_settle_locked(int delta, const char *why)
+{
+    const uint32_t now = now_ms();
+    if (s_tap_settle && (uint32_t)(now - s_tap_settle) < PET_TAP_SETTLE_MS) {
+        ESP_LOGI(TAG, "戳·%s：好感 %+d 被 5 s 防刷挡下（亲密度仍 %u）", why, delta,
+                 (unsigned)s_store.int家用电脑y);
+        return;
+    }
+    s_tap_settle = now;
+    int v = (int)s_store.int家用电脑y + delta;
+    if (v < 0) v = 0;
+    if (v > (int)PM_INTIMACY_MAX) v = (int)PM_INTIMACY_MAX;
+    const int old_lv = s_mood.level;
+    s_store.int家用电脑y = (uint16_t)v;
+    s_mood.level     = pm_level_of(s_store.int家用电脑y);
+    pet_store_save(&s_store);
+    lvl_paint_locked();
+    ESP_LOGI(TAG, "戳·%s：好感 %+d → %u（L%u）", why, delta,
+             (unsigned)s_store.int家用电脑y, (unsigned)s_mood.level);
+    maybe_level_up_locked(old_lv, "戳出来的一下");
+}
+
+/* 一次戳（松手 <200 ms 且没开麦）。调用方须持锁。 */
+static void tap_locked(void)
+{
+    const uint32_t now = now_ms();
+    if (s_tap_n == 0 || (uint32_t)(now - s_tap_t0) > PET_TAP_GAP_MS) {
+        s_tap_n  = 0;
+        s_tap_t0 = now;
+    }
+    s_tap_n++;
+
+    const bool unhappy = face_is_unhappy();
+    shake_locked(unhappy ? PET_SHAKE_PX * 2 : PET_SHAKE_PX);   /* 不高兴：抖动加倍 */
+
+    if (s_tap_n >= PET_3TAP_N) {
+        s_tap_n = 0;
+        /* 连戳三下：害羞 8 / 生气 1 / 开心 6（8:1:6；"生气"先用 1 嫌弃顶，PRD T7） */
+        const uint32_t r = esp_random() % 15u;
+        const uint8_t  f = (r < 8u) ? (uint8_t)F_SHY : (r < 9u ? (uint8_t)F_SNARK : (uint8_t)F_HAPPY);
+        pm_face_show(&s_mood, f);                 /* 内部脸跟上，下次开口的骨架才对 */
+        face_set_locked(f, "连戳三下");
+        s_tap_back_until = now + PM_HOLD_MS;
+        tap_settle_locked((unhappy || f == F_SNARK) ? -2 : +1, "连戳三下");
+        ESP_LOGI(TAG, "连戳三下 → %s（r=%u）",
+                 f == F_SHY ? "害羞" : (f == F_SNARK ? "生气" : "开心"), (unsigned)r);
+    } else {
+        pm_face_show(&s_mood, F_SNARK);
+        face_set_locked(F_SNARK, unhappy ? "被戳·更生气" : "被戳了");
+        s_tap_back_until = now + PET_TAP_HOLD_MS;
+        tap_settle_locked(unhappy ? -1 : +1, unhappy ? "她正不高兴" : "戳一下");
+    }
+}
+
+/* 按住说话：录 → 边录边发 → 松手收尾并播放回复。
+   注意按钮回调绝不能干这个（会阻塞输入任务）——所以单独一个任务。 */
+/* 一轮"按住说话"。**跑在常驻的 pet_talk 任务里**（见 voice_worker）：
+   以前是每次开麦 xTaskCreate(6144)，2026-10-29 M1 真机发现**堆被 LVGL 切碎**
+   （空闲 17.2 KB 但最大连续块只有 4.3 KB）⇒ 任务起不来、她不出声。改成进页时建一次、常驻复用。 */
+static void talk_round(void)
+{
+    ESP_LOGI(TAG, "按住说话：开始");
+    s_tag_face = 0xFF;                        /* 本轮标签还没来：先照骨架走 */
+    echo_clear();                             /* 上一轮的"你说的"先擦掉，等这一轮的来 */
+
+    esp_err_t e = voice_talk_begin("/talk");
+    if (e != ESP_OK) {
+        ESP_LOGE(TAG, "开不了语音连接：%s", esp_err_to_name(e));
+        face_set(F_GUILTY, "开不了连接");
+        vTaskDelay(pdMS_TO_TICKS(800));
+        s_talk_busy = false;
+        face_set(F_NEUTRAL, "回待机");
+        return;
+    }
+
+    /* 丢掉开头 4 块（≈128ms）：codec 一开机的爆音（真机实测首 100ms RMS 23275，后面全是 40），
+       带上去只会让识别变差 */
+    for (int i = 0; i < 4; i++) {
+        if (voice_talk_feed() != ESP_OK) break;
+    }
+
+    const uint32_t t0 = now_ms();
+    while (!s_talk_stop) {
+        if (voice_talk_feed() != ESP_OK) break;      /* 打断也会走到这儿（feed 直接返回不合法状态） */
+        /* 到硬顶就自己收尾（20 秒；作者会先说几秒再开口、说完几秒才松手）。
+           真正的"说完了"靠松手，不靠这个超时。 */
+        if (now_ms() - t0 > voice_talk_max_ms()) break;
+    }
+    s_talking = false;
+
+    /* 播放总时长上限 20 s → 45 s（2026-11-01 12:0x）：使用侧让念日记，118 字的一篇 TTS 出来 18.4 s，
+       加上前面「我查查」+ 取数正好越过 20 s ⇒ 她念到一半就被这里掐掉（真机 12:02 那轮只出来 60 字）。
+       45 s 够念完一篇 200 字上限的日记；真正的卡死由 recv 的 20 s 空闲超时兜底。 */
+    esp_err_t r = voice_talk_end(45000);
+    s_her_voice = false;                      /* 声音没了：嘴交给静音逻辑收 */
+
+    if (voice_talk_aborted()) {
+        /* 插话（M2）：她自己闭嘴，**不算失败** —— 不记 last_fail、不动亲密度、不演心虚。
+           状态机立刻进"听你说"（跟正常开麦一致）；接着按住 ● 到 250 ms 就由 pet_task
+           用同一个常驻任务起下一轮 ⇒ "她闭嘴"到"我开口"之间那段（实测 150–400 ms，`72` §1.3）。 */
+        if (bsp_lvgl_lock(200)) {
+            apply_pm_locked(pm_event(&s_mood, PM_EV_TALK_START, now_ms()), "插话·听你说");
+            bsp_lvgl_unlock();
+        }
+        s_talk_busy = false;
+        ESP_LOGI(TAG, "打断收尾：已闭嘴，等你开口（空闲堆 %u B）", (unsigned)esp_get_free_heap_size());
+        return;
+    }
+
+    cal_report(r == ESP_OK);                  /* 这一轮的电平账（第一次上机就靠它定阈值） */
+
+    /* 一轮结束交给状态机：成功 → **保持开口那一刻的情绪（闭档）**，1.8 s 后再按亲密度衰减；
+       失败 → 心虚 → 心软（PRD §4.4 / §4.6） */
+    int old_level = s_mood.level;
+    s_last_fail = (r != ESP_OK);              /* "她正不高兴"的来源之一 */
+    /* 说完停在**哪张脸的闭档**：标签帧定的 > 开口那一刻的骨架（M2；无标签时与 v0.89 完全一致） */
+    const uint8_t emo = (s_tag_face < FACE_EMO_N)
+                            ? s_tag_face
+                            : ((s_skeleton < FACE_EMO_N) ? s_skeleton : (uint8_t)F_NEUTRAL);
+    if (r == ESP_OK) {                        /* 聊成一次，亲密度 +1（存盘，别丢） */
+        if (s_store.int家用电脑y < PM_INTIMACY_MAX) s_store.int家用电脑y++;
+        s_mood.level = pm_level_of(s_store.int家用电脑y);
+        s_store.last_seen = s_store.last_seen ? s_store.last_seen : (uint32_t)time(NULL);
+        /* I2S 里还躺着整个 DMA 队列（现在 32 块 × 240 帧 = 480 ms）——等它放完再收嘴，
+           别让嘴比声音早闭。跟着 bsp_audio_tx_buffer_ms() 走，以后改队列长度不用再改这里。 */
+        vTaskDelay(pdMS_TO_TICKS(bsp_audio_tx_buffer_ms() + 20));
+        face_set(k_face3[emo][1], "说完·收嘴");   /* 大开 → 半张 → 闭：两跳软收 */
+        vTaskDelay(pdMS_TO_TICKS(90));
+    }
+    if (bsp_lvgl_lock(200)) {
+        const int f = (r == ESP_OK) ? pm_hold(&s_mood, k_face3[emo][0], now_ms())
+                                    : pm_event(&s_mood, PM_EV_FAIL, now_ms());
+        apply_pm_locked(f, r == ESP_OK ? "说完·保持情绪" : "没接上");
+        bsp_lvgl_unlock();
+    }
+    esp_err_t se = pet_store_save(&s_store);
+    if (bsp_lvgl_lock(200)) { lvl_paint_locked(); bsp_lvgl_unlock(); }   /* 亲密度 +1，屏上数字跟着变 */
+    if (r == ESP_OK) maybe_level_up(old_level, "聊了一次");   /* 攒够 20/80 就演一下里层脸 */
+    ESP_LOGI(TAG, "按住说话：结束（%s，亲密度 %u → L%u，存盘 %s，空闲堆 %u B）", esp_err_to_name(r),
+             (unsigned)s_store.int家用电脑y, (unsigned)s_mood.level, esp_err_to_name(se),
+             (unsigned)esp_get_free_heap_size());
+    s_talk_busy = false;
+}
+
+/* 自测口子（APP_M2_DIAG 用）：她是不是正在出声。只读，线程安全（只读一个 volatile bool）。 */
+bool demo_pet_her_voice(void) { return s_her_voice; }
+
+/* 常驻语音任务：进页时建一次（那时堆还整），之后靠任务通知唤醒 */
+static void voice_worker(void *arg)
+{
+    (void)arg;
+    for (;;) {                       /* 全生命周期常驻：页退不删（退页后堆更碎，重建不回来） */
+        ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
+        if (!s_running) continue;    /* 页面不在就不干活（但别退） */
+        talk_round();
+    }
+}
+
+// ---------------------------------------------------------------- 推进任务
+/* 状态机节拍：delay-in-button 的"到点换脸"全在这里出。
+   P4 的微动（呼吸/抖一下）也挂这儿，但要限频 ≤2 fps、说话中停。 */
+static void pet_task(void *arg)
+{
+    (void)arg;
+    uint32_t next_tick = 0;
+    bool voice_was = false;
+    while (s_running) {
+        const uint32_t now = now_ms();
+        if (now >= next_tick) {
+            next_tick = now + 40;                 /* 40 ms 判一次嘴型（比 32 ms 一块略粗，够用） */
+            /* 她刚开口：档位从"闭"起，别沿用上一轮的 */
+            if (s_her_voice && !voice_was) {
+                voice_was = true;
+                s_mouth_tier = 0;
+                s_quiet_blocks = 0;
+                s_tier_since = now;
+            } else if (!s_her_voice) {
+                voice_was = false;
+            }
+            if (bsp_lvgl_lock(100)) {
+                /* ① 按住 ● ≥250 ms 才开麦（短按留给"戳"，见 PET_ARM_MS） */
+                if (s_armed && !s_talk_busy && (uint32_t)(now - s_press_ms) >= PET_ARM_MS) {
+                    s_armed = false;
+                    s_skeleton = pm_face(&s_mood);              /* 开口那一刻的情绪 = 骨架 */
+                    if (s_skeleton >= FACE_EMO_N) s_skeleton = F_NEUTRAL;
+                    apply_pm_locked(pm_event(&s_mood, PM_EV_TALK_START, now), "听你说");
+                    if (!s_talk_task) {
+                        ESP_LOGE(TAG, "语音任务不在（进页没建起来）");
+                        s_talk_busy = false; s_talking = false; s_press_talk = false;
+                    } else {
+                        s_talk_busy   = true;
+                        s_talking     = true;
+                        s_talk_stop   = false;
+                        s_press_talk  = true;
+                        xTaskNotifyGive(s_talk_task);
+                    }
+                }
+                /* ② 抖动（上移 3 px）到点回位 */
+                if (s_shake_until && (int32_t)(now - s_shake_until) >= 0) {
+                    s_shake_until = 0;
+                    s_shake_dy    = 0;
+                    apply_pos_locked();
+                }
+                /* ③ 戳的反应演完了，回待机 */
+                if (s_tap_back_until && (int32_t)(now - s_tap_back_until) >= 0) {
+                    s_tap_back_until = 0;
+                    if (!s_her_voice && !s_talk_busy) {
+                        apply_pm_locked(pm_hold(&s_mood, F_NEUTRAL, now), "戳完·回待机");
+                    }
+                }
+                if (s_leave_pending) {
+                    /* ④ 道别：先嘴硬 350 ms，再露"道别微笑"（L0/L1）或"求别走"（L2），1 s 后真退出 */
+                    const uint32_t dt = (uint32_t)(now - s_leave_t0);
+                    if (dt >= 350u && s_face != (int)s_leave_face) {
+                        face_set_locked(s_leave_face, s_leave_face == F_FAREWELL ? "道别微笑" : "求别走");
+                    }
+                    if (dt >= 1000u) {
+                        s_leave_pending = false;
+                        ESP_LOGI(TAG, "道别演完，回菜单");
+                        app_demo_back();
+                    }
+                } else if (s_her_voice) {
+                    mouth_tick_locked(now);       /* 说话中：嘴型接管，EV_TICK 不许改脸 */
+                } else if (s_boost_face >= 0 && (int32_t)(now - s_boost_until) < 0) {
+                    /* 升级提示还在演：别让状态机把它顶掉 */
+                } else {
+                    if (s_boost_face >= 0) s_boost_face = -1;      /* 提示结束，交回状态机 */
+                    if (!s_talk_busy && !s_tap_back_until) apply_pm_locked(pm_tick(&s_mood, now), "到点");
+                }
+                micro_tick_locked(now);           /* 呼吸/抖一下/上跳：≤2 fps */
+                /* v0.122：她在查 ⇒ 气泡 "我看看." / ".." / "..."，300 ms 一拍（有个活气，不像卡死）。
+                   底文取服务端那句、去掉句末标点，别自己编词。 */
+                if (s_checking && (uint32_t)(now - s_dot_t) >= 300u) {
+                    s_dot_t = now;
+                    s_dot_i = (uint8_t)((s_dot_i + 1) & 3u);
+                    char buf[72];
+                    snprintf(buf, sizeof(buf), "%s%.*s", s_check_base, (int)s_dot_i, "...");
+                    if (strcmp(buf, s_her_src) != 0) {      /* 只在真变了才标脏，别每拍都重排 */
+                        strncpy(s_her_src, buf, HER_MAX_BYTES);
+                        s_her_src[HER_MAX_BYTES] = 0;
+                        s_her_dirty = true;
+                    }
+                }
+                if (s_echo_dirty) echo_apply_locked();   /* 回显：只在脏的时候改 label */
+                if (s_her_dirty) hers_apply_locked();    /* 气泡（她说的） */
+
+                bsp_lvgl_unlock();
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(TASK_TICK_MS));
+    }
+    s_task = NULL;
+    vTaskDelete(NULL);
+}
