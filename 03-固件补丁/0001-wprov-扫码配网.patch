+++ b/main/demo_tomato.c
@@ -0,0 +1,503 @@
+// main/demo_tomato.c —— 番茄时间 · A 款「反应堆核心」（2026-10-28 视觉重做）
+//
+// 设计稿：`51-番茄页视觉候选-2026-10-28.md` / A 款（深空青 + 电流环 + 刻度盘）。
+// 口径：
+//   · **对象一次建好**，之后只改文字/颜色/弧角度（N13 —— 回调里 create/delete 会黑屏/卡死）
+//   · 三档 15 / 25 / 45（▲▼ 循环换档，跑起来以后不许换）；● 开始/暂停/继续；长按 ● 由框架退出
+//   · 四态：待机 / 专注中 / 已暂停 / 到点（颜色 + 中文状态 + 顶栏英文遥测三处一起变）
+//   · 到点：环变红 + 闪 3 下 + 今日轮次 +1
+//   · NVS 续计：{档位, 剩秒, 状态, 天, 时间戳, 轮次}；跑起来每 30 秒存一次，进页按经过时间扣掉
+//   · 内存：~28 个对象，无新图、无新字库；12 个刻度是 2px 小矩形（旋转 30°）不是图片
+//
+// ⚠️ 没做的：到点后联动桌宠表情（跨页，等 M5 一起做）。
+// ✅ v0.91 补上：到点「叮」一声（`app_ding.c`，常驻 450 ms 铃音）——
+//    这里只**点单**（建任务后立刻返回），450 ms 的 I2S 写在 `ding_task` 里，不在 LVGL 上下文（N1/N18）。
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include "lvgl.h"
+#include "demo.h"
+#include "ui_pixel.h"
+#include "app_ding.h"
+#include "app_config.h"
+#include "esp_log.h"
+#include "nvs.h"
+#include "pet_store.h"
+#include "tomato_up.h"
+#include "time_sync.h"
+#if APP_TOMATO_DIAG
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#endif
+
+LV_FONT_DECLARE(fusion_ui12);
+LV_FONT_DECLARE(fusion_ui16);
+LV_FONT_DECLARE(clock48);
+
+static const char *TAG = "tomato";
+
+#if APP_TOMATO_DIAG
+/* 端到端自测用：让 tick_cb 把剩余秒数砍到几秒（15 分钟没法当自测跑）。
+   跨任务只写这一个标志，真正的赋值在 tick_cb（LVGL 上下文）里做。交付版必须 0。 */
+static volatile bool s_short_pending;
+#endif
+
+/* ---------------- 几何（240×320，环心 120,146） ---------------- */
+#define CX       120
+#define CY       146
+#define RING_D   180
+#define RING_X   (CX - RING_D / 2)
+#define RING_Y   (CY - RING_D / 2)
+#define TICK_R   96
+
+/* ---------------- 配色（跟主页同一套深空青） ---------------- */
+#define C_TRACK  0x0C2A36
+#define C_DIM    0x2E7E92
+#define C_CY     0x7FE7FF
+#define C_AMBER  0xFFB23E
+#define C_RED    0xE43B2F
+#define C_INK    0xE6F9FF
+#define C_MUTE   0x8FA4B8
+#define C_EDGE   0x1E3A47
+#define C_PANEL  0x08141C
+#define C_SEL    0x0E2A36
+
+#define NVS_NS   "tomato"
+#define SAVE_EVERY 30                    /* 秒：跑起来以后多久落一次盘（护 Flash） */
+
+typedef enum { TM_IDLE = 0, TM_RUN = 1, TM_PAUSE = 2, TM_DONE = 3 } tm_state_t;
+
+static const int PRESET[3] = { 15, 25, 45 };
+static const char *STATE_TXT[4] = { "待机", "专注中", "已暂停", "时间到" };
+/* 2026-10-31 实测报「上面英文换成中文」「开始后面两个方块」：
+   顶栏原本是英文遥测串；提示行的两个方块是**全角空格 U+3000**（字库子集里没有，屏上就是方块）。
+   现在顶栏写中文，提示行一律用 ASCII 空格 + 「·」分隔。 */
+static const char *HEAD_TXT[4]  = { "番茄钟 · 待机", "番茄钟 · 专注",
+                                    "番茄钟 · 暂停", "番茄钟 · 完成" };
+static const char *HINT_TXT[4]  = { "● 开始 · ▲▼ 换时长", "● 暂停 · 长按 ● 退出",
+                                    "● 继续 · 长按 ● 退出", "● 再来 · 长按 ● 退出" };
+
+static lv_obj_t *s_scr;
+static lv_obj_t *s_head;      /* 顶栏英文遥测 */
+static lv_obj_t *s_round;     /* 今日第几个 */
+static lv_obj_t *s_arc;       /* 底圈 + 进度指示 */
+static lv_obj_t *s_glow;      /* 进度外侧的一层"辉光"（低透明度，替掉 blur） */
+static lv_obj_t *s_inner;     /* 内圈细线 */
+static lv_obj_t *s_time;      /* 大数字 */
+static lv_obj_t *s_state;     /* 中文状态 */
+static lv_obj_t *s_hint;
+static lv_obj_t *s_chip[3];
+static lv_obj_t *s_chip_l[3];
+
+static lv_timer_t *s_tick;    /* 1 秒 */
+static lv_timer_t *s_blink;   /* 到点闪 */
+static int s_blink_n;
+
+static tm_state_t s_st;
+static int s_preset = 1;      /* 0/1/2 → 15/25/45 */
+static int s_total;           /* 总秒数 */
+static int s_left;            /* 剩余秒数 */
+static int s_rounds;          /* 今天已完成几个 */
+static time_t s_saved_at;
+
+/* ---------------------------------------------------------------- 小工具 */
+static void label_center(lv_obj_t *lb)
+{
+    lv_obj_set_style_text_align(lb, LV_TEXT_ALIGN_CENTER, 0);
+}
+
+static lv_obj_t *block(lv_obj_t *parent, int x, int y, int w, int h, uint32_t color)
+{
+    lv_obj_t *o = lv_obj_create(parent);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_pos(o, x, y);
+    lv_obj_set_size(o, w, h);
+    lv_obj_set_style_radius(o, 0, 0);
+    lv_obj_set_style_border_width(o, 0, 0);
+    lv_obj_set_style_pad_all(o, 0, 0);
+    lv_obj_set_style_bg_color(o, lv_color_hex(color), 0);
+    return o;
+}
+
+static uint32_t state_color(void)
+{
+    switch (s_st) {
+        case TM_RUN:   return C_CY;
+        case TM_PAUSE: return C_AMBER;
+        case TM_DONE:  return C_RED;
+        default:       return C_DIM;
+    }
+}
+
+/* ---------------------------------------------------------------- 环 */
+static lv_obj_t *make_arc(lv_obj_t *parent, int width, bool only_indicator)
+{
+    lv_obj_t *a = lv_arc_create(parent);
+    lv_obj_remove_flag(a, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(a, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_pos(a, RING_X, RING_Y);
+    lv_obj_set_size(a, RING_D, RING_D);
+    lv_obj_set_style_bg_opa(a, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_width(a, 0, 0);
+    lv_obj_set_style_pad_all(a, 0, 0);
+    lv_arc_set_bg_angles(a, 0, 360);
+    lv_arc_set_rotation(a, 270);                  /* 0° 从 12 点开始，顺时针 */
+    lv_arc_set_angles(a, 0, 0);
+    lv_obj_remove_style(a, NULL, LV_PART_KNOB);   /* 不要旋钮 */
+    lv_obj_set_style_arc_width(a, width, LV_PART_MAIN);
+    lv_obj_set_style_arc_width(a, width, LV_PART_INDICATOR);
+    lv_obj_set_style_arc_color(a, lv_color_hex(C_TRACK), LV_PART_MAIN);
+    lv_obj_set_style_arc_color(a, lv_color_hex(C_CY), LV_PART_INDICATOR);
+    lv_obj_set_style_arc_opa(a, only_indicator ? LV_OPA_TRANSP : LV_OPA_COVER, LV_PART_MAIN);
+    lv_obj_set_style_arc_opa(a, LV_OPA_COVER, LV_PART_INDICATOR);
+    lv_obj_set_style_arc_rounded(a, true, LV_PART_INDICATOR);
+    return a;
+}
+
+static void make_ticks(lv_obj_t *scr)
+{
+    for (int i = 0; i < 12; i++) {
+        const float rad = (float)i * 30.0f * 3.14159265f / 180.0f;
+        const int big = (i % 3 == 0);
+        const int w = big ? 2 : 1;
+        const int h = big ? 9 : 5;
+        const int x = CX + (int)lroundf(sinf(rad) * TICK_R) - w / 2;
+        const int y = CY - (int)lroundf(cosf(rad) * TICK_R) - h / 2;
+        lv_obj_t *t = block(scr, x, y, w, h, big ? C_DIM : 0x2C6172);
+        lv_obj_set_style_opa(t, big ? LV_OPA_COVER : LV_OPA_70, 0);
+        lv_obj_set_style_transform_rotation(t, i * 300, 0);   /* 0.1° 单位：30° */
+    }
+}
+
+/* ---------------------------------------------------------------- 画一帧（只改属性，不建对象） */
+static void paint(void)
+{
+    char b[16];
+    const int sec = s_left > 0 ? s_left : 0;
+    snprintf(b, sizeof(b), "%02d:%02d", sec / 60, sec % 60);
+    lv_label_set_text(s_time, b);
+
+    int deg = 0;
+    if (s_total > 0) deg = ((s_total - sec) * 360) / s_total;
+    if (deg < 0) deg = 0;
+    if (deg > 360) deg = 360;
+    lv_arc_set_angles(s_arc, 0, deg);
+    lv_arc_set_angles(s_glow, 0, deg);
+
+    uint32_t c = state_color();
+    lv_obj_set_style_arc_color(s_arc, lv_color_hex(c), LV_PART_INDICATOR);
+    lv_obj_set_style_arc_color(s_glow, lv_color_hex(c), LV_PART_INDICATOR);
+    lv_obj_set_style_text_color(s_state, lv_color_hex(c), 0);
+
+    lv_label_set_text(s_head, HEAD_TXT[s_st]);
+    lv_label_set_text(s_state, STATE_TXT[s_st]);
+    lv_label_set_text(s_hint, HINT_TXT[s_st]);
+
+    char r[16];
+    snprintf(r, sizeof(r), "%02d", s_rounds > 99 ? 99 : s_rounds);
+    lv_label_set_text(s_round, r);
+
+    for (int i = 0; i < 3; i++) {
+        const bool sel = (i == s_preset);
+        lv_obj_set_style_border_color(s_chip[i], lv_color_hex(sel ? C_CY : C_EDGE), 0);
+        lv_obj_set_style_bg_color(s_chip[i], lv_color_hex(sel ? C_SEL : C_PANEL), 0);
+        lv_obj_set_style_text_color(s_chip_l[i], lv_color_hex(sel ? C_INK : C_MUTE), 0);
+    }
+}
+
+/* ---------------------------------------------------------------- 落盘 / 读回 */
+static void tm_save(bool force)
+{
+    const time_t now = time_sync_valid() ? time_sync_now() : 0;
+    if (!force && now > 0 && s_saved_at > 0 && (now - s_saved_at) < SAVE_EVERY) return;
+
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return;
+    (void)nvs_set_u8(h, "min", (uint8_t)s_preset);
+    (void)nvs_set_u16(h, "left", (uint16_t)(s_left < 0 ? 0 : s_left));
+    (void)nvs_set_u8(h, "st", (uint8_t)s_st);
+    (void)nvs_set_u16(h, "day", (uint16_t)(now > 0 ? (now / 86400) : 0));
+    (void)nvs_set_i64(h, "ts", (int64_t)now);
+    (void)nvs_set_u8(h, "rnd", (uint8_t)(s_rounds > 99 ? 99 : s_rounds));
+    (void)nvs_commit(h);
+    nvs_close(h);
+    s_saved_at = now;
+}
+
+static void tm_load(void)
+{
+    s_preset = 1;
+    s_total = PRESET[s_preset] * 60;
+    s_left = s_total;
+    s_st = TM_IDLE;
+    s_rounds = 0;
+
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) return;
+    uint8_t pr = 1, st = 0, rnd = 0;
+    uint16_t left = 0, day = 0;
+    int64_t ts = 0;
+    (void)nvs_get_u8(h, "min", &pr);
+    (void)nvs_get_u16(h, "left", &left);
+    (void)nvs_get_u8(h, "st", &st);
+    (void)nvs_get_u16(h, "day", &day);
+    (void)nvs_get_i64(h, "ts", &ts);
+    (void)nvs_get_u8(h, "rnd", &rnd);
+    nvs_close(h);
+
+    if (pr > 2) pr = 1;
+    s_preset = pr;
+    s_total = PRESET[pr] * 60;
+    s_left = (left > 0 && left <= s_total) ? (int)left : s_total;
+
+    const time_t now = time_sync_valid() ? time_sync_now() : 0;
+    const uint16_t today = now > 0 ? (uint16_t)(now / 86400) : 0;
+    if (now > 0 && day == today) {
+        s_rounds = rnd > 99 ? 99 : rnd;
+        if (st == TM_RUN && ts > 0) {
+            int passed = (int)(now - (time_t)ts);
+            if (passed < 0) passed = 0;
+            s_left -= passed;
+            if (s_left <= 0 || passed > 90) {
+                /* 过点、或者"最后一次落盘已经是一分半以前"（说明中间断过电/放着没管）：
+                   当成没开始，别一进来就接着一个早就结束的番茄 */
+                s_left = s_total;
+                s_st = TM_IDLE;
+            } else {
+                s_st = TM_RUN;
+            }
+            ESP_LOGI(TAG, "续计：%d 秒前开始，剩 %d 秒", passed, s_left);
+        } else if (st == TM_PAUSE) {
+            s_st = TM_PAUSE;
+            ESP_LOGI(TAG, "续计：暂停在 %d 秒", s_left);
+        }
+    }
+    if (s_left < 0) s_left = 0;
+}
+
+/* ---------------------------------------------------------------- 到点闪 3 下 */
+static void blink_cb(lv_timer_t *t)
+{
+    (void)t;
+    s_blink_n++;
+    lv_obj_set_style_arc_opa(s_arc, (s_blink_n & 1) ? LV_OPA_30 : LV_OPA_COVER, LV_PART_INDICATOR);
+    if (s_blink_n >= 6) {
+        lv_timer_pause(s_blink);
+        lv_obj_set_style_arc_opa(s_arc, LV_OPA_COVER, LV_PART_INDICATOR);
+    }
+}
+
+static void blink_start(void)
+{
+    s_blink_n = 0;
+    lv_obj_set_style_arc_opa(s_arc, LV_OPA_COVER, LV_PART_INDICATOR);
+    lv_timer_reset(s_blink);
+    lv_timer_resume(s_blink);
+}
+
+/* ---------------------------------------------------------------- 1 秒 */
+static void tick_cb(lv_timer_t *t)
+{
+    (void)t;
+#if APP_TOMATO_DIAG
+    if (s_short_pending) {          /* 自测：无视当前状态，直接开一个 4 秒的番茄 */
+        s_short_pending = false;
+        s_total = 4;
+        s_left  = 4;
+        s_st    = TM_RUN;
+        ESP_LOGW(TAG, "【自测】剩余砍到 4 秒");
+    }
+#endif
+    if (s_st != TM_RUN) return;
+
+    if (s_left > 0) s_left--;
+    if (s_left <= 0) {
+        s_left = 0;
+        s_st = TM_DONE;
+        if (s_rounds < 99) s_rounds++;
+        tm_save(true);
+        blink_start();
+        pet_store_pending_tomato();       /* → 桌宠页下次进页补发：+2 亲密度 + 演"得意→开心" */
+        /* PRD §5.4：完成就记账（只落 NVS + 起后台补传，这里在 tick 回调里，绝不碰网络） */
+        tomato_up_note(PRESET[s_preset], s_preset, s_rounds);
+        (void)app_ding_start();           /* 到点先"叮"（独立任务，不等它；语音中会自动让位） */
+        ESP_LOGW(TAG, "时间到：%d 分钟完成，今天第 %d 个", PRESET[s_preset], s_rounds);
+    } else {
+        tm_save(false);
+        const int used = s_total - s_left;
+        if (used > 0 && (used % 10) == 0) {
+            ESP_LOGI(TAG, "计时 %02d:%02d（已过 %d 秒）", s_left / 60, s_left % 60, used);
+        }
+    }
+    paint();
+}
+
+/* ---------------------------------------------------------------- 页面 */
+void demo_tomato_enter(void)
+{
+    tm_load();
+
+    s_scr = lv_obj_create(NULL);
+    lv_obj_remove_flag(s_scr, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_color(s_scr, lv_color_hex(UI_SC_BG), 0);
+    lv_obj_set_style_border_width(s_scr, 0, 0);
+    lv_obj_set_style_radius(s_scr, 0, 0);
+    lv_obj_set_style_pad_all(s_scr, 0, 0);
+
+    lv_obj_t *band = block(s_scr, 0, 0, 240, 132, UI_SC_BAND);   /* 顶光，跟主页同一手法 */
+    lv_obj_set_style_bg_opa(band, LV_OPA_50, 0);
+
+    s_head = ui_pixel_label(s_scr, HEAD_TXT[TM_IDLE], &fusion_ui12, C_DIM);
+    lv_obj_set_pos(s_head, 12, 9);
+    lv_obj_set_size(s_head, 170, 16);
+
+    s_round = ui_pixel_label(s_scr, "00", &fusion_ui12, C_DIM);
+    lv_obj_set_pos(s_round, 200, 9);
+    lv_obj_set_size(s_round, 28, 16);
+    lv_obj_set_style_text_align(s_round, LV_TEXT_ALIGN_RIGHT, 0);
+
+    make_ticks(s_scr);
+
+    s_glow = make_arc(s_scr, 16, true);
+    lv_obj_set_style_arc_opa(s_glow, LV_OPA_20, LV_PART_INDICATOR);
+    s_arc = make_arc(s_scr, 8, false);
+
+    s_inner = lv_obj_create(s_scr);
+    lv_obj_remove_flag(s_inner, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(s_inner, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_pos(s_inner, CX - 75, CY - 75);
+    lv_obj_set_size(s_inner, 150, 150);
+    lv_obj_set_style_radius(s_inner, 75, 0);
+    lv_obj_set_style_bg_opa(s_inner, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_color(s_inner, lv_color_hex(0x103743), 0);
+    lv_obj_set_style_border_width(s_inner, 1, 0);
+    lv_obj_set_style_pad_all(s_inner, 0, 0);
+
+    s_time = ui_pixel_label(s_scr, "25:00", &clock48, C_INK);
+    lv_obj_set_pos(s_time, CX - 100, CY - 28);
+    lv_obj_set_size(s_time, 200, 56);
+    label_center(s_time);
+
+    s_state = ui_pixel_label(s_scr, STATE_TXT[TM_IDLE], &fusion_ui16, C_DIM);
+    lv_obj_set_pos(s_state, CX - 100, CY + 32);
+    lv_obj_set_size(s_state, 200, 20);
+    lv_obj_set_style_text_letter_space(s_state, 4, 0);
+    label_center(s_state);
+
+    for (int i = 0; i < 3; i++) {
+        const int x = 41 + i * 56;
+        s_chip[i] = block(s_scr, x, 252, 46, 22, C_PANEL);
+        lv_obj_set_style_radius(s_chip[i], 3, 0);
+        lv_obj_set_style_border_color(s_chip[i], lv_color_hex(C_EDGE), 0);
+        lv_obj_set_style_border_width(s_chip[i], 1, 0);
+        char b[4];
+        snprintf(b, sizeof(b), "%d", PRESET[i]);
+        s_chip_l[i] = ui_pixel_label(s_chip[i], b, &fusion_ui12, C_MUTE);
+        lv_obj_set_pos(s_chip_l[i], 0, 2);
+        lv_obj_set_size(s_chip_l[i], 44, 16);
+        label_center(s_chip_l[i]);
+    }
+
+    s_hint = ui_pixel_label(s_scr, HINT_TXT[TM_IDLE], &fusion_ui12, C_MUTE);
+    lv_obj_set_pos(s_hint, 10, 286);
+    lv_obj_set_size(s_hint, 220, 16);
+    label_center(s_hint);
+
+    s_tick = lv_timer_create((lv_timer_cb_t)tick_cb, 1000, NULL);
+    s_blink = lv_timer_create((lv_timer_cb_t)blink_cb, 250, NULL);
+    lv_timer_pause(s_blink);
+
+    paint();
+    if (s_st == TM_DONE) blink_start();
+    lv_screen_load(s_scr);
+    ESP_LOGI(TAG, "番茄页（A 款）就绪：第 %d 档 %d 分钟｜状态 %d｜剩 %d 秒｜今天第 %d 个",
+             s_preset + 1, PRESET[s_preset], (int)s_st, s_left, s_rounds);
+}
+
+void demo_tomato_exit(void)
+{
+    if (s_st == TM_RUN || s_st == TM_PAUSE) tm_save(true);
+    if (s_tick) { lv_timer_delete(s_tick); s_tick = NULL; }
+    if (s_blink) { lv_timer_delete(s_blink); s_blink = NULL; }
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; }
+    s_head = s_round = s_arc = s_glow = s_inner = s_time = s_state = s_hint = NULL;
+    for (int i = 0; i < 3; i++) { s_chip[i] = NULL; s_chip_l[i] = NULL; }
+    s_st = TM_IDLE;
+}
+
+void demo_tomato_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    if (ev != BSP_BTN_CLICK) return;
+
+    if (btn == BSP_BTN_UP || btn == BSP_BTN_DOWN) {
+        if (s_st == TM_RUN || s_st == TM_PAUSE) return;    /* 跑起来就不许换档 */
+        s_preset = (s_preset + ((btn == BSP_BTN_UP) ? 1 : 2)) % 3;
+        s_total = PRESET[s_preset] * 60;
+        s_left = s_total;
+        s_st = TM_IDLE;
+        tm_save(true);
+        paint();
+        ESP_LOGI(TAG, "换时长：%d 分钟", PRESET[s_preset]);
+        return;
+    }
+
+    if (btn != BSP_BTN_OK) return;
+    switch (s_st) {
+        case TM_IDLE:
+        case TM_DONE:
+            s_left = s_total;
+            s_st = TM_RUN;
+            break;
+        case TM_RUN:
+            s_st = TM_PAUSE;
+            break;
+        case TM_PAUSE:
+            s_st = TM_RUN;
+            break;
+        default:
+            break;
+    }
+    tm_save(true);
+    paint();
+    ESP_LOGW(TAG, "状态 %d，剩 %d 秒", (int)s_st, s_left);
+}
+
+/* ---------------------------------------------------------------- 自测（交付版关） */
+#if APP_TOMATO_DIAG
+#include "esp_heap_caps.h"
+#include "esp_system.h"
+
+/* 整条链真机验一次：进番茄页 → 剩余砍到 4 秒 → 到点听「叮」。
+   判据（串口）：`番茄页（A 款）就绪` → `【自测】剩余砍到 4 秒` → `时间到` → `ding: 叮：已播`。
+   ⚠️ 进页面为什么还要补一颗键：`app_request_enter_name()` 只是**点单**
+   （`s_pending_enter`），要等下一次按键的回调跑完才真正换页（见 `main.c` 的 process_input）。
+   第一版自测漏了这颗键 ⇒ ● 被主页吃掉，进了「背单词」（2026-10-29 真机踩的）。 */
+static void tomato_diag_task(void *arg)
+{
+    (void)arg;
+    vTaskDelay(pdMS_TO_TICKS(8000));            /* 等 WiFi/屏幕起来，堆宽裕 */
+    ESP_LOGI(TAG, "【自测】进番茄页");
+    app_sim_enter("番茄时间");                    /* 点单 + 补键，见 demo.h 的说明 */
+    vTaskDelay(pdMS_TO_TICKS(800));
+    s_short_pending = true;
+    vTaskDelay(pdMS_TO_TICKS(1200));
+    ESP_LOGI(TAG, "【自测】4 秒番茄开跑，等到点");
+    vTaskDelay(pdMS_TO_TICKS(9000));
+    ESP_LOGI(TAG, "【自测】收尾：叮 busy=%d ｜ 空闲堆 %u B ｜ 最大块 %u B",
+             (int)app_ding_busy(), (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    vTaskDelete(NULL);
+}
+
+void demo_tomato_diag_start(void)
+{
+    if (xTaskCreate(tomato_diag_task, "tm_diag", 3072, NULL, 3, NULL) != pdPASS) {
+        ESP_LOGW(TAG, "【自测】任务建不起来");
+    }
+}
+#else
+void demo_tomato_diag_start(void) { }
+#endif
