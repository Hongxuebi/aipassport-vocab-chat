+void demo_pet_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    if (!faces_ready() || !s_img) return;
+    if (!bsp_lvgl_lock(200)) return;
+    switch (ev) {
+        case BSP_BTN_PRESS: {
+            /* 睡着时任何键先"叫醒"（这一下不触发录制） */
+            if (pm_face(&s_mood) == PM_SLEEP) {
+                apply_pm_locked(pm_event(&s_mood, PM_EV_WAKE, now_ms()), "被叫醒");
+                break;
+            }
+            /* ● 按下：① **她在说话 ⇒ 插话**（PRD §4.2 优先级第二位，2026-10-29 M2）
+               ② 否则先只抖一下（戳 = 按下，PRD §4.3）；真开麦由 pet_task 在 250 ms 后做，
+               这样"戳她"不会白跑一轮语音。这里只置标志，绝不阻塞输入任务。 */
+            if (btn == BSP_BTN_OK && !s_leave_pending) {
+                /* 新手势开始：把上一次留下的"这次 CLICK 不算戳"清掉。
+                   ⚠ 不清的后果（v0.89 就有的小毛病）：长按 ≥500 ms 松开**不会**再发 CLICK
+                   （组件只发 LONG），s_ignore_click 会一直挂着 ⇒ **说完话后的第一下戳被吃掉**。 */
+                s_ignore_click = false;
+                if (s_talk_busy && s_her_voice) {
+                    /* 打断：按键回调里**只置标志** —— 真停声要等 I2S（bsp_audio_flush_tx），
+                       那是 pet_talk 的活，塞在 LVGL 锁里会把输入任务卡住（`72` §1.3）。 */
+                    voice_talk_abort();
+                    s_her_voice  = false;          /* 嘴立刻停，不等那一块音频收完 */
+                    s_mouth_tier = 0;
+                    s_press_ms   = now_ms();
+                    s_armed      = true;           /* 继续按住（≥250 ms）= 接着说 */
+                    s_press_talk = false;
+                    s_ignore_click = true;         /* 这一下不算戳 */
+                    ESP_LOGI(TAG, "插话：她正说着，按 ● 打断");
+                    break;
+                }
+                if (!s_talk_busy) {
+                    s_press_ms   = now_ms();
+                    s_armed      = true;
+                    s_press_talk = false;
+                    shake_locked(PET_SHAKE_PX);
+                }
+            }
+            break;
+        }
+        case BSP_BTN_RELEASE:
+            if (btn == BSP_BTN_OK) {
+                s_armed = false;
+                if (s_press_talk) {                  /* 开过麦：正常收尾 */
+                    s_talk_stop = true;
+                    apply_pm_locked(pm_event(&s_mood, PM_EV_TALK_END, now_ms()), "等回复");
+                    s_ignore_click = true;           /* 随之而来的 CLICK 不算戳 */
+                    s_press_talk   = false;
+                }
+            }
+            break;
+        case BSP_BTN_CLICK:
+            if (btn == BSP_BTN_OK) {                 /* 短按 = 戳她（没开麦才算） */
+                if (s_ignore_click) {
+                    s_ignore_click = false;          /* 这一下刚开过麦，不是戳 */
+                } else if (!s_talk_busy && !s_leave_pending) {
+                    tap_locked();
+                }
+            } else if (btn == BSP_BTN_UP) {
+                step_face(-1);
+            } else {
+                step_face(+1);
+            }
+            break;
+        case BSP_BTN_DOUBLE:
+            if (btn == BSP_BTN_OK) {
+                step_face(+1);                        /* 顺手：双击 ● = 下一张（验图用） */
+            } else {                                  /* 双击 ▲/▼ = 亲密度 ±20（调试口子） */
+                const int old_lv = s_mood.level;
+                int v = (int)s_store.int家用电脑y + (btn == BSP_BTN_UP ? PET_DEBUG_STEP : -PET_DEBUG_STEP);
+                if (v < 0) v = 0;
+                if (v > (int)PM_INTIMACY_MAX) v = (int)PM_INTIMACY_MAX;
+                s_store.int家用电脑y = (uint16_t)v;
+                s_mood.level = pm_level_of(s_store.int家用电脑y);
+                pet_store_save(&s_store);
+                ESP_LOGI(TAG, "亲密度 %u → L%u（双击%s）", (unsigned)s_store.int家用电脑y,
+                         (unsigned)s_mood.level, btn == BSP_BTN_UP ? "▲" : "▼");
+                /* 升级那一瞬间要看得见（否则双击只是数字变，屏上没反应） */
+                lvl_paint_locked();
+                maybe_level_up_locked(old_lv, btn == BSP_BTN_UP ? "双击▲调试" : "双击▼调试");
+            }
+            break;
+        case BSP_BTN_LONG:
+            if (btn == BSP_BTN_UP) {                 /* 长按▲ = 道别 + 退出（● 借给说话用了） */
+                if (!s_leave_pending) {
+                    s_leave_pending = true;
+                    s_leave_t0      = now_ms();
+                    s_leave_face    = (s_mood.level >= 2) ? (uint8_t)F_DONTGO : (uint8_t)F_FAREWELL;
+                    apply_pm_locked(pm_event(&s_mood, PM_EV_LEAVE, now_ms()), "要求走");
+                    ESP_LOGI(TAG, "道别：%s（L%u；1 s 后回菜单）",
+                             s_leave_face == F_FAREWELL ? "道别微笑" : "求别走",
+                             (unsigned)s_mood.level);
+                }
+            }
+            break;
+        default:
+            break;
+    }
+    bsp_lvgl_unlock();
+}
