+    for (int i = 0; i < 5; i++) { app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(200)); }
+    app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(1500));
+    app_sim_key(BSP_BTN_OK, BSP_BTN_LONG);  vTaskDelay(pdMS_TO_TICKS(1500));
+
+    ESP_LOGW(TAG, "HOME_DIAG 5：▼ → AI对话 → ●（应看到桌宠页就绪 + 首帧指纹）");
+    app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(250));
+    app_sim_key(BSP_BTN_OK,   BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(3000));
+    app_sim_key(BSP_BTN_OK, BSP_BTN_LONG);    vTaskDelay(pdMS_TO_TICKS(1200));
+    ESP_LOGW(TAG, "HOME_DIAG 结束");
