+// ---------------------------------------------------------------- 页面
+void demo_pet_enter(void)
+{
+    s_scr = ui_pixel_screen_create2(PET_TITLE, false);
+
+    /* 底边 y=286 那条 1 px 发丝线是 `ui_pixel` 给**所有页面**画的装饰；桌宠页要把它让给第三行字
+       （"我说的"现在到 304，会横穿它）。**只删这一页的这一根**，共享的 ui_pixel.c 一个字不动。 */
+    /* 🔴 必须先 update_layout 再量尺寸：LVGL v9 的 coords 是**懒刷新**的，
+       刚建完的对象 lv_obj_get_width/height/y 全是 0（2026-10-29 就这么踩了一次）。 */
+    lv_obj_update_layout(s_scr);
+    for (int32_t i = (int32_t)lv_obj_get_child_count(s_scr) - 1; i >= 0; i--) {
+        lv_obj_t *c = lv_obj_get_child(s_scr, i);
+        if (c && lv_obj_get_height(c) == 1 && lv_obj_get_width(c) >= 200) {
+            ESP_LOGI(TAG, "删掉底边发丝线（y=%d）：第三行字要用到 304", (int)lv_obj_get_y(c));
+            lv_obj_delete(c);
+            break;
+        }
+    }
+
+    const esp_err_t e = faces_mount();
+    if (e != ESP_OK) {
+        /* 失败要看得见：显示一句人话，别黑屏（N4） */
+        lv_obj_t *lbl = lv_label_create(s_scr);
+        lv_obj_set_style_text_font(lbl, &fusion_ui16, 0);
+        lv_obj_set_style_text_color(lbl, lv_color_hex(UI_SC_INK), 0);
+        lv_label_set_text(lbl, "没有表情包\n先烧 pet 分区");
+        lv_obj_set_size(lbl, 200, 80);
+        lv_obj_set_style_text_align(lbl, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_center(lbl);
+        lv_screen_load(s_scr);
