+static const char *TAG = "voice";
+
+#define VOICE_SR       16000
+#define VOICE_CHUNK    1024          /* 1KB = 512 采样 = 32ms @16k */
+/* 单次最长 20 秒（2026-10-28 21:0x 作者：会"按住好几秒才开始说话、说完好几秒才松手"，
+   6 秒从**按下**算起，等于把使用侧真实说的话切掉一半 —— 改成从按下算 20 秒，靠 VAD 之外的手段
+   不再做"自动超时收尾"，只在 20 秒硬顶处收。服务端按 1.5s 空闲收口，不靠这个值）。 */
+#define VOICE_MAX_MS   20000
+#define VOICE_RECV_MS  20000         /* 等回复的超时 */
+
+static int     s_fd = -1;
+static bool    s_active;
+static voice_talk_level_cb_t s_level_cb;
+static voice_talk_meta_cb_t  s_meta_cb;
+static uint8_t s_buf[VOICE_CHUNK];
+static uint32_t s_up_bytes;
+
+/* 打断（M2）：s_abort 由按键侧置位，s_aborted 记"本轮确实是被打断收尾的" */
+static volatile bool s_abort;
+static bool     s_aborted;
+static bool     s_boot_primed;   /* 冷启动预热只做一次「大灌」 */
+static int64_t  s_last_play_us;  /* 上次真正往 I2S 写音频的时刻（算闲置多久用） */
+/* 本轮元数据帧（'AE1'）里带来的东西：标签 0 = 无；两份文本（我说的 ASR / 她说的回话，已截断） */
+#define VOICE_META_TEXT_MAX 120     /* 我说的：≤120 B ≈ 40 汉字（v0.97：60 → 120，屏上 3 行装满） */
+#define VOICE_HER_TEXT_MAX  127     /* 她说的：≤127 B ≈ 42 汉字（屏上 3 行 42 字，刚好装下） */
+static uint8_t  s_tag;
+static char     s_meta_text[VOICE_META_TEXT_MAX + 1];
+static char     s_her_text[VOICE_HER_TEXT_MAX + 1];
+
+/* ---------------------------------------------------------------- 设备自报（v0.121）
+ * 电量/音量只有设备自己知道，而设备能到的只有 8802 这条语音口：
+ * 塞进鉴权头 `AIPV2 <令牌> vol=70 soc=82 mv=4012` —— 不进音频、不多一次往返、不占常驻 RAM。
+ * 服务端按字段解析；老服务端只看第 2 个字段，多几个也不影响。
+ * 读不到的数（soc<0 / mv<=0）干脆不写，别拿假数冒充实测。 */
+static int vc_hdr(char *buf, size_t cap)
+{
+    int n = snprintf(buf, cap, "AIPV2 %s vol=%d", AIP_DEV_TOKEN, (int)app_volume_get());
+    if (n <= 0 || (size_t)n >= cap - 1) return -1;
+    const int soc = bsp_battery_soc();
+    const int mv  = bsp_battery_mv();
+    if (soc >= 0) n += snprintf(buf + n, cap - (size_t)n, " soc=%d", soc);
+    if (mv > 0)   n += snprintf(buf + n, cap - (size_t)n, " mv=%d", mv);
+    if (n <= 0 || (size_t)n >= cap - 1) return -1;
+    buf[n++] = '\n';
+    buf[n] = 0;
+    return n;
+}
+
+bool voice_talk_active(void) { return s_active; }
+
+void voice_talk_set_level_cb(voice_talk_level_cb_t cb) { s_level_cb = cb; }
+
+void voice_talk_set_meta_cb(voice_talk_meta_cb_t cb) { s_meta_cb = cb; }
+
+void voice_talk_abort(void) { s_abort = true; }
+
+bool voice_talk_aborted(void) { return s_aborted; }
+
+/* 精确读 n 字节（**只按剩余字节数 recv**，绝不越过帧头把 PCM 吞进来 —— 一旦吞了，
+   后面的 PCM 就少一块，声音会缺 32 ms 的豁口，而且永不对齐）。 */
+static bool read_exact(uint8_t *p, size_t n)
+{
+    while (n > 0) {
+        if (s_abort) return false;
+        const int r = recv(s_fd, p, n, 0);
+        if (r <= 0) return false;                 /* 0 = 对端关了；-1 = 超时/出错 */
+        p += r;
+        n -= (size_t)r;
+    }
+    return true;
+}
+
+/* crc8（poly 0x07）：中途帧的防假命中。音频里恰好出现 "AE2"+crc 对上的概率 ≈ 2^-32。 */
+static uint8_t vc_crc8(const uint8_t *p, size_t n)
+{
+    uint8_t c = 0;
+    for (size_t i = 0; i < n; i++) {
+        c ^= p[i];
+        for (int k = 0; k < 8; k++) c = (uint8_t)((c & 0x80) ? ((c << 1) ^ 0x07) : (c << 1));
+    }
+    return c;
+}
+
+/* UTF-8 安全截断：别把半个汉字留在日志/屏上 */
+static void utf8_trim(char *s, size_t max)
+{
+    size_t n = strlen(s);
+    if (n > max) { n = max; s[n] = 0; }
+    size_t i = n;
+    while (i > 0 && ((unsigned char)s[i - 1] & 0xC0) == 0x80) i--;   /* 跳过续字节 */
+    if (i == 0) return;
+    const unsigned char c = (unsigned char)s[i - 1];
+    size_t need = 1;
+    if (c >= 0xF0) need = 4;
+    else if (c >= 0xE0) need = 3;
+    else if (c >= 0xC0) need = 2;
+    if (i - 1 + need > n) s[i - 1] = 0;          /* 尾部这个字不完整 ⇒ 砍掉 */
+}
+
+/* 一块 PCM16 的平均幅度 mean(|s16|)：512 个绝对值求和（几百个周期），
+   别开方、别浮点（C3 没 FPU）—— 拿来驱嘴型足够了。 */
+static uint32_t mean_abs_pcm16(const uint8_t *p, size_t bytes)
+{
+    uint32_t sum = 0, n = 0;
+    for (size_t i = 0; i + 1 < bytes; i += 2) {
+        int16_t v;
+        memcpy(&v, p + i, 2);
+        sum += (uint32_t)(v < 0 ? -(int32_t)v : v);
+        n++;
+    }
+    return n ? sum / n : 0;
+}
+
+/* ---------------- 端点：**只有公网**（作者 2026-11-01 定，原话：「这条作废，以后全部默认没有局域网这个事情」）
+ * 🔴 从此**没有"在家走局域网"这回事**：端点表里删掉局域网（LAN_HOST），一律公网。
+ *   理由：局域网那条路一旦"连得上但不回包"，就是 8 秒白等 + 整页退离线（2026-11-01 11:27 真机踩到）；
+ *   而公网网关实测 RTT 25–79 ms，比局域网还稳，没有任何理由留着它。
+ *   成功过的端点仍记进 NVS（一个 u8 键，32 B），下次先试它。
+ *   ⚠️ 别再往 EPS 里加局域网或"按环境选起点"的逻辑。 */
+typedef struct { const char *host; uint16_t port; } voice_ep_t;
+
+static const voice_ep_t EPS[] = {
+    { AIP_VOICE_HOST_GW,  AIP_VOICE_PORT_GW  },   /* ① 公网 8000 网关（默认，外网已验证） */
+    { AIP_VOICE_HOST_PUB, AIP_VOICE_PORT_PUB },   /* ② 公网直连 RELAY_VOICE_PORT（等云安全组放行） */
+    { AIP_VOICE_HOST_ALT, AIP_VOICE_PORT_ALT },   /* ③ 兜底：开发机转发（临时，换热点就变） */
+};
+#define EPS_N ((int)(sizeof(EPS) / sizeof(EPS[0])))
+
+/* 记住上次成功的端点（一个 u8 键，NVS 里 32 B 条目，不占 RAM、不进音频循环）。
+   2026-11-01 起**只用一个键 "idx"**：没有家里/外面两套了（局域网整条路已删）。 */
+static int8_t s_ep_cache = -1;
+
+static int8_t ep_load(void)
+{
+    if (s_ep_cache >= 0) return s_ep_cache;
+    int8_t v8 = 0;                                /* 默认第 1 个 = 公网 8000 网关 */
+    nvs_handle_t h;
+    if (nvs_open("voice", NVS_READONLY, &h) == ESP_OK) {
+        uint8_t v = 0;
+        if (nvs_get_u8(h, "idx", &v) == ESP_OK && v < EPS_N) v8 = (int8_t)v;
+        nvs_close(h);
+    }
+    s_ep_cache = v8;
+    return v8;
+}
+
+static void ep_remember(int i)
+{
+    if (s_ep_cache == i) return;                  /* 值没变就不写 flash */
+    s_ep_cache = (int8_t)i;
+    nvs_handle_t h;
+    if (nvs_open("voice", NVS_READWRITE, &h) != ESP_OK) return;
+    (void)nvs_set_u8(h, "idx", (uint8_t)i);
+    (void)nvs_commit(h);
+    nvs_close(h);
+}
+
+/* 非阻塞 connect + select：对端不可达时 0.9 秒就放弃，别让按键卡在那儿 */
+static int ep_connect(const voice_ep_t *e, int timeout_ms)
+{
+    int fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (fd < 0) return -1;
+    const int fl = fcntl(fd, F_GETFL, 0);
+    fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+
+    struct sockaddr_in a = {0};
+    a.sin_family = AF_INET;
+    a.sin_port = htons(e->port);
+    a.sin_addr.s_addr = inet_addr(e->host);
+
+    int r = connect(fd, (struct sockaddr *)&a, sizeof(a));
+    if (r != 0) {
+        if (errno != EINPROGRESS) { close(fd); return -1; }
+        fd_set wf;
+        FD_ZERO(&wf);
+        FD_SET(fd, &wf);
+        struct timeval tv = { .tv_sec = timeout_ms / 1000,
+                              .tv_usec = (timeout_ms % 1000) * 1000 };
+        r = select(fd + 1, NULL, &wf, NULL, &tv);
+        if (r <= 0) { close(fd); errno = ETIMEDOUT; return -1; }
+        int err = 0;
+        socklen_t len = sizeof(err);
+        if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len) != 0 || err != 0) {
+            close(fd);
+            errno = err ? err : EIO;
+            return -1;
+        }
+    }
+    fcntl(fd, F_SETFL, fl);
+    return fd;
+}
+
+/* ---------------------------------------------------------------- 数据网关（2026-10-30 23:4x）
+ * 定的硬规矩：**联网即可用** —— 不许有「只有局域网才做得了」的功能。
+ * 设备唯一可靠的通道是语音口 8802，所以取数据/回传也挂这条（HTTP 只在同网时当兜底）：
+ *   GET : b"GET1" + path                   → b"RES1" + 2B len + body
+ *   POST: b"PST1" + path + 0x00 + body     → b"RES1" + 2B len + body
+ * 只读一次、自己开自己关，不碰 s_fd / 语音状态。 */
+/* 单端点的一次尝试（v0.125：从 vc_do 里拆出来，见下面 vc_do 的端点回退）。
+   改动的理由（2026-11-01 11:27 真机）：①在家先连局域网服务端机，连得上但**8 秒没回包**
+   ⇒ 整个 /queue 失败、整页退离线，却**不试下一个端点**。现在失败就换端点。 */
+static int vc_do_ep(int ep_i, const char *path, const char *body, size_t blen,
+                    char *out, size_t cap,
+                    /* 出参 */ const char **why)
+{
+    if (!path || !out || cap < 16) return -1;
+    if (why) *why = "参数";
+
+    /* 🔴 2026-11-01 定：**没有局域网这回事**（端点表里已经删了）。一律从公网网关开始，
+       成功过的端点记进 NVS 先试它。 */
+    int fd = ep_connect(&EPS[ep_i], (ep_i == ep_load()) ? 2500 : 1200);
+    if (fd < 0) {
+        if (why) *why = "连不上";
+        return -1;
+    }
+
+    char hdr[128];
+    const int hn = vc_hdr(hdr, sizeof(hdr));
+    if (hn <= 0) { close(fd); if (why) *why = "头太长"; return -1; }
+    if (send(fd, hdr, hn, 0) != hn) { close(fd); if (why) *why = "发头失败"; return -1; }
+
+    uint8_t head[8];
+    size_t hl;
+    if (body) {                                  /* PST1：魔法｜路径｜0x00｜正文 */
+        hl = 4 + strlen(path) + 1 + blen;
+        uint8_t *buf = malloc(hl);
+        if (!buf) { close(fd); if (why) *why = "没内存"; return -1; }
+        memcpy(buf, "PST1", 4);
+        memcpy(buf + 4, path, strlen(path));
+        buf[4 + strlen(path)] = 0;
+        if (blen) memcpy(buf + 5 + strlen(path), body, blen);
+        const uint8_t lh[2] = { (uint8_t)(hl >> 8), (uint8_t)(hl & 0xFF) };
+        const int ok = (send(fd, lh, 2, 0) == 2) && (send(fd, buf, hl, 0) == (int)hl);
+        free(buf);
+        if (!ok) { close(fd); if (why) *why = "发正文失败"; return -1; }
+    } else {                                     /* GET1：魔法｜路径（路径最长 200 B） */
+        const size_t n = 4 + strlen(path);
+        if (n > sizeof(head)) {                      /* head 是 8 B 的临时区：换大缓冲，别悄悄失败 */
+            uint8_t big[256];
+            if (n > sizeof(big)) { close(fd); if (why) *why = "路径太长"; return -1; }
+            memcpy(big, "GET1", 4);
+            memcpy(big + 4, path, strlen(path));
+            const uint8_t lh[2] = { (uint8_t)(n >> 8), (uint8_t)(n & 0xFF) };
+            const int ok = (send(fd, lh, 2, 0) == 2) && (send(fd, big, n, 0) == (int)n);
+            if (!ok) { close(fd); if (why) *why = "发请求失败"; return -1; }
+            goto wait_reply;
+        }
+        memcpy(head, "GET1", 4);
+        memcpy(head + 4, path, strlen(path));
+        const uint8_t lh[2] = { (uint8_t)(n >> 8), (uint8_t)(n & 0xFF) };
+        if (send(fd, lh, 2, 0) != 2 || send(fd, head, n, 0) != (int)n) { close(fd); if (why) *why = "发请求失败"; return -1; }
+    }
+
+wait_reply:
+    {
+    struct timeval tv = { .tv_sec = 3, .tv_usec = 0 };   /* 回包都小；超时要便宜，才能快点换端点 */
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+    uint8_t h[6];
+    size_t got = 0;
+    while (got < sizeof(h)) {
+        const int r = recv(fd, h + got, sizeof(h) - got, 0);
+        if (r <= 0) { close(fd); if (why) *why = "读头超时"; return -1; }
+        got += (size_t)r;
+    }
+    if (memcmp(h, "RES1", 4) != 0) {
+        ESP_LOGW(TAG, "数据网关：回包不是 RES1（%02x %02x %02x %02x）", h[0], h[1], h[2], h[3]);
+        close(fd);
+        if (why) *why = "回包不是 RES1";
+        return -2;
+    }
+    const int len = h[4] | (h[5] << 8);
+    if (len <= 0 || (size_t)len >= cap) {
+        ESP_LOGW(TAG, "数据网关：正文 %d B 放不进 %u B（%s）", len, (unsigned)cap, path);
+        close(fd);
+        if (why) *why = "回包太大";
+        return -3;
+    }
+    got = 0;
+    while (got < (size_t)len) {
+        const int r = recv(fd, out + got, len - got, 0);
+        if (r <= 0) { close(fd); if (why) *why = "读正文超时"; return -1; }
+        got += (size_t)r;
+    }
+    out[len] = 0;
+    close(fd);
+    return 0;
+    }
+}
+
+/* v0.125：**端点回退**。连不上、或连上了但没回包/回包不对，就换下一个端点再试一遍。
+   2026-11-01 11:27 真机就是死在"连得上但 8 秒没回包"上：/queue 一次失败 ⇒ 整页退成离线、复习全记"离线"。 */
+static int vc_do(const char *path, const char *body, size_t blen, char *out, size_t cap)
+{
+    if (!path || !out || cap < 16) return -1;
+    const int start = ep_load();
+    int rc = -1;
+    for (int k = 0; k < EPS_N; k++) {
+        const int i = (start + k) % EPS_N;
+        const char *why = "";
+        const int64_t t0 = esp_timer_get_time();
+        rc = vc_do_ep(i, path, body, blen, out, cap, &why);
+        const uint32_t ms = (uint32_t)((esp_timer_get_time() - t0) / 1000);
+        if (rc == 0) {
+            ep_remember(i);
+            if (k > 0) ESP_LOGI(TAG, "数据网关：第 %d 个端点成功（%s，%u ms）", i + 1, path, (unsigned)ms);
+            return 0;
+        }
+        ESP_LOGW(TAG, "数据网关：端点 %s:%u 失败（%s，%u ms，rc=%d）→ 换下一个",
+                 EPS[i].host, (unsigned)EPS[i].port, why, (unsigned)ms, rc);
+    }
+    ESP_LOGW(TAG, "数据网关：%d 个端点全失败（%s）", EPS_N, path);
+    return rc;
+}
+
+int voice_talk_get(const char *path, char *out, size_t cap)
+{
+    return vc_do(path, NULL, 0, out, cap);
+}
+
+int voice_talk_post(const char *path, const char *body, size_t blen, char *out, size_t cap)
+{
+    return vc_do(path, body ? body : "", blen, out, cap);
+}
+
+int voice_talk_greet(char *out, size_t cap)
+{
+    return vc_do("/greet", NULL, 0, out, cap);
+}
+
+/* 把 buffer 原样发完（不计入音频字节） */
+static esp_err_t voice_send_raw(const uint8_t *p, size_t n)
+{
+    size_t sent = 0;
+    while (sent < n) {
+        const int w = send(s_fd, p + sent, n - sent, 0);
+        if (w <= 0) {
+            if (errno == EAGAIN || errno == EWOULDBLOCK) { vTaskDelay(pdMS_TO_TICKS(2)); continue; }
+            ESP_LOGW(TAG, "发送失败 errno=%d", errno);
+            return ESP_FAIL;
+        }
+        sent += (size_t)w;
+    }
+    return ESP_OK;
+}
+
+/* AIPV2 帧：`[2字节长度][数据]`，**长度 0 = 说完了**。
+   为什么要这个：公网那一跳是 frp，它一看到 FIN 就把双向连接一起关，回话会被吞掉
+   （2026-10-28 真机+外网实测：shutdown 后 0 字节；不 shutdown 改用 0 帧，回包 39KB/0.9s）。 */
+static esp_err_t voice_send_frame(const uint8_t *p, uint16_t n)
+{
+    const uint8_t hdr[2] = { (uint8_t)(n >> 8), (uint8_t)(n & 0xFF) };
+    if (voice_send_raw(hdr, sizeof(hdr)) != ESP_OK) return ESP_FAIL;
+    if (n == 0) return ESP_OK;
+    return voice_send_raw(p, n);
+}
+
+/* 鉴权头：公网口是敞开的，连上先自报设备令牌（服务端机侧设了 AITALK_TOKEN 才校验；
+   没设就原样把头剥掉）。格式 `AIPV2 <64 位令牌>\n`，一次 send 发完。
+   AIPV2 = 后面的音频按帧发；老服务端不认识 V2 也没关系，它会当音频处理（我们只和自家服务端配对）。 */
+static esp_err_t voice_send_auth(void)
+{
+    char hdr[128];
+    const int n = vc_hdr(hdr, sizeof(hdr));      /* v0.121：顺带自报电量/音量 */
+    if (n <= 0) { ESP_LOGE(TAG, "鉴权头拼不出来（n=%d）", n); return ESP_FAIL; }
+    return voice_send_raw((const uint8_t *)hdr, (size_t)n);
+}
+
+uint32_t voice_talk_max_ms(void)
+{
+    return (uint32_t)VOICE_MAX_MS;
+}
+
+esp_err_t voice_talk_begin(const char *path)
+{
+    (void)path;                                  /* 裸 TCP 没有路径，留着接口兼容 */
+    if (s_active) return ESP_ERR_INVALID_STATE;
+
+    /* 2026-11-01 起一律公网（局域网端点已删）；成功过的端点先试，失败按顺序轮 */
+    const int start = ep_load();
+    int64_t t0 = esp_timer_get_time();
+    for (int k = 0; k < EPS_N; k++) {
+        const int i = (start + k) % EPS_N;
+        const int64_t ta = esp_timer_get_time();
+        s_fd = ep_connect(&EPS[i], 900);
+        if (s_fd >= 0) {
+            ESP_LOGI(TAG, "已连上端点%d %s:%u（%.0fms）", i + 1, EPS[i].host, EPS[i].port,
+                     (esp_timer_get_time() - ta) / 1000.0);
+            ep_remember(i);
+            break;
+        }
+        ESP_LOGW(TAG, "端点%d %s:%u 连不上（%.0fms，errno=%d）%s", i + 1, EPS[i].host, EPS[i].port,
+                 (esp_timer_get_time() - ta) / 1000.0, errno,
+                 (k + 1 < EPS_N) ? "，换下一个" : "");
+    }
+    if (s_fd < 0) {
+        ESP_LOGE(TAG, "%d 个端点都连不上：先看 WiFi，再看中继站 8000；实在不行让开发机的转发兜着（最后一个）", EPS_N);
+        return ESP_FAIL;
+    }
+
+    struct timeval tv = { .tv_sec = 3, .tv_usec = 0 };   /* 回包都小；超时要便宜，才能快点换端点 */
+    setsockopt(s_fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(s_fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+    int one = 1;
+    setsockopt(s_fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));   /* 语音别攒包 */
+
+    /* 联网口敞着就得自报身份；这一步不能省（省了等于谁都能拿它烧 DeepSeek） */
+    if (voice_send_auth() != ESP_OK) {
+        ESP_LOGE(TAG, "端点连上但鉴权头没发出去，断开");
+        close(s_fd);
+        s_fd = -1;
+        return ESP_FAIL;
+    }
+
+    if (bsp_audio_set_format(VOICE_SR, 16, 1) != ESP_OK) {
+        ESP_LOGE(TAG, "音频格式设不上（%d/%d/1）", VOICE_SR, 16);
+        close(s_fd);
+        s_fd = -1;
+        return ESP_FAIL;
+    }
+    /* 🔴 冷启动（2026-10-31）：静置久了第一次播，codec/DMA 起振会「刺啦」一阵 ⇒ 先灌一段数字静音把通路拉起来。
+       **只在真闲置时才灌**（使用侧 01:1x 问「是不是多了点」）：那 120 ms 静音会占掉大半个 240 ms DMA，
+       虽然回复通常 1–3 s 才到、听感上不增延迟，但没必要每轮都灌。现在按「上次播完多久」分档：
+         开机首轮 / 闲置 > 120 s → 120 ms（够起振，留余量）
+         闲置 30–120 s        → 40 ms
+         刚聊过（< 30 s）     → 不灌（连着聊时零开销） */
+    {
+        static const uint8_t z[320];        /* 16 kHz / 16 bit / 单声道 = 10 ms */
+        const int64_t idle_ms = s_last_play_us ? (esp_timer_get_time() - s_last_play_us) / 1000 : -1;
+        int ms = 0;
+        const char *why = "刚聊过，不预热";
+        if (idle_ms < 0 || idle_ms > 120000) { ms = 120; why = (idle_ms < 0) ? "开机首轮" : "闲置超 120 s"; }
+        else if (idle_ms > 30000)            { ms = 40;  why = "闲置 30~120 s"; }
+        for (int i = 0; i < ms / 10; i++) (void)bsp_audio_write(z, sizeof(z));
+        s_boot_primed = true;
+        ESP_LOGI(TAG, "冷启动预热：%d ms（%s，闲置 %lld ms）", ms, why, (long long)idle_ms);
+    }
+
+    s_up_bytes = 0;
+    s_abort = false;                    /* 新的一轮：清掉上一次的打断标志 */
+    s_aborted = false;
+    s_tag = 0;
+    s_meta_text[0] = 0;
+    s_her_text[0]  = 0;
+    s_active = true;
+    return ESP_OK;
+}
+
+esp_err_t voice_talk_feed(void)
+{
+    if (!s_active || s_fd < 0) return ESP_ERR_INVALID_STATE;
+    if (s_abort) return ESP_ERR_INVALID_STATE;      /* 打断了：别再往上传（收尾在 end 里做） */
+
+    if (bsp_audio_read(s_buf, sizeof(s_buf)) != ESP_OK) {
+        ESP_LOGW(TAG, "麦克风读失败");
+        return ESP_FAIL;
+    }
+    if (voice_send_frame(s_buf, (uint16_t)sizeof(s_buf)) != ESP_OK) {
+        ESP_LOGW(TAG, "发送失败（已发 %u B）", (unsigned)s_up_bytes);
+        return ESP_FAIL;
+    }
+    s_up_bytes += (uint32_t)sizeof(s_buf);
+    return ESP_OK;
+}
+
+esp_err_t voice_talk_end(int play_timeout_ms)
+{
+    if (!s_active || s_fd < 0) return ESP_ERR_INVALID_STATE;
+    s_active = false;
+
+    const int64_t t0 = esp_timer_get_time();
+
+    /* 打断优先：已经在录的时候被打断 ⇒ 连结束帧都不发，直接丢 DMA + 关连接。
+       （发了也没用：服务端会拿半句话跑一整轮 ASR+TTS，回包白白占链路。） */
+    if (s_abort) {
+        ESP_LOGW(TAG, "打断：还没松手就收（上行 %u B），不发了", (unsigned)s_up_bytes);
+        (void)bsp_audio_flush_tx();
+        s_aborted = true;
+        close(s_fd);
+        s_fd = -1;
+        return ESP_OK;
+    }
+
+    /* 说完了 = 发一个 0 长度帧。**这里绝不能 shutdown(SHUT_WR)**：
+       公网那跳是 frp，看到 FIN 会把双向连接一起关，回话就没了。 */
+    if (voice_send_frame(NULL, 0) != ESP_OK) {
+        ESP_LOGW(TAG, "结束帧没发出去（已发 %u B）", (unsigned)s_up_bytes);
+        close(s_fd);
+        s_fd = -1;
+        return ESP_FAIL;
+    }
+    ESP_LOGI(TAG, "上行 %u B（%.2fs），已发结束帧，等回复…", (unsigned)s_up_bytes,
+             s_up_bytes / 2.0 / VOICE_SR);
+
+    struct timeval tv = { .tv_sec = VOICE_RECV_MS / 1000, .tv_usec = 0 };
+    setsockopt(s_fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+    esp_err_t ret = ESP_OK;
+    uint32_t played = 0;
+    bool first = true;
+    /* 音量走用户设置（2026-10-28 起不再写死 80%）：设置页能调，NVS 记着 */
+    bsp_audio_set_volume(app_volume_get());
+
+    /* 播放前二次灌静音（2026-11-01 12:0x，实测报「第一次说话『我查查』的时候有噪音」）：
+       begin() 里那 120 ms 是**开麦**那一刻灌的，到真出声中间隔着 4~10 s 录音；
+       第一次真正往喇叭写时，DMA/codec 可能又"凉"了 ⇒ 这里补 20 ms，把起振噪声压在静音里。
+       20 ms 听不出来（气泡本来也有 ~150 ms 前导静音），但能挡住"第一声之前那下爆音"。
+       只加静音、不改别的时序；听感不对就回滚 voice_talk.c.bak-playprime-*。 */
+    {
+        static const uint8_t z[320];            /* 10 ms @16k/16bit/单声道 */
+        for (int i = 0; i < 2; i++) (void)bsp_audio_write(z, sizeof(z));
+        ESP_LOGI(TAG, "播放前静音 20 ms（挡第一声之前的起振噪声）");
+    }
+
+    /* ---- ① 元数据帧（M2/v0.93）：'AE1' + 标签 + text_len + flags + 文本，**可以连着几个** ----
+       现在服务端发两个：`[ASR 帧 flags=0]` `[她说 帧 flags=1]`，然后才是 PCM。
+       设备**循环读**，读到的 8 字节 magic 不匹配就说明到头了 ⇒ 那 8 字节按 PCM 播
+       （老服务端只发一个帧、或以后想再加帧，都走同一条路；丢 4 ms 开头比"整条没声音"好）。 */
+    for (;;) {
+        uint8_t hd[8];
+        if (!read_exact(hd, sizeof(hd))) {
+            if (!s_abort) {
+                ESP_LOGW(TAG, "等回复超时（一个字节都没来）");
+                ret = ESP_ERR_TIMEOUT;
+            }
+            break;
+        }
+        if (!(hd[0] == 'A' && hd[1] == 'E' && hd[2] == '1')) {
+            ESP_LOGI(TAG, "元数据帧读完（%u B 起是 PCM）", (unsigned)hd[0]);
+            first = false;
+            if (s_level_cb) s_level_cb(mean_abs_pcm16(hd, sizeof(hd)), true);
+            if (bsp_audio_write(hd, sizeof(hd)) != ESP_OK) {
+                ESP_LOGW(TAG, "喇叭写失败");
+                ret = ESP_FAIL;
+            } else {
+                played += (uint32_t)sizeof(hd);
+            }
+            break;
+        }
+        s_tag = hd[3];
+        const size_t  tl    = (size_t)((unsigned)hd[4] | ((unsigned)hd[5] << 8));
+        const uint8_t flags = hd[6];
+        const bool    hers  = (flags & VOICE_META_FLAG_HER) != 0;
+        char   *dst = hers ? s_her_text : s_meta_text;
+        const size_t cap = hers ? VOICE_HER_TEXT_MAX : VOICE_META_TEXT_MAX;
+        const size_t want = tl > cap ? cap : tl;
+        dst[0] = 0;
+        if (want) {
+            uint8_t tb[VOICE_HER_TEXT_MAX];
+            if (!read_exact(tb, want)) {
+                if (!s_abort) { ESP_LOGW(TAG, "元数据文本没读全"); ret = ESP_ERR_TIMEOUT; }
+                break;
+            }
+            memcpy(dst, tb, want);
+            dst[want] = 0;
+            utf8_trim(dst, cap);                     /* 别留半个汉字 */
+        }
+        /* 声明比我们留的长：多出来的也得读掉，否则会被当 PCM 播（声音里插一段噪音） */
+        size_t skip = tl - want;
+        while (skip > 0) {
+            uint8_t d[32];
+            const size_t k = skip > sizeof(d) ? sizeof(d) : skip;
+            if (!read_exact(d, k)) { ret = ESP_ERR_TIMEOUT; break; }
+            skip -= k;
+        }
+        if (ret != ESP_OK) break;
+        if (hers) ESP_LOGI(TAG, "元数据帧：她说「%s」（%u B，flags %u）", dst, (unsigned)tl, (unsigned)flags);
+        else      ESP_LOGI(TAG, "元数据帧：标签 %u，回显「%s」（%u B），flags %u",
+                           (unsigned)s_tag, dst, (unsigned)tl, (unsigned)flags);
+        if (s_meta_cb) s_meta_cb(s_tag, dst, flags);
+    }
+
+    /* 下行流的"断流账"（2026-10-29 夜加）：使用侧放过一次"破音"，服务端两次发的是**同样的字节**，
+       TTS 峰值只有 0.43 FS ⇒ 不是削顶；那就得看"播放的时候是不是没数据往下送"。
+       DMA 能兜 bsp_audio_tx_buffer_ms()（现在 360 ms）：**最长等数据 < 它就不会断**。 */
+    uint32_t max_wait_ms = 0, stalls = 0, chunks = 0;
+
+    for (;;) {
+        if (ret != ESP_OK) break;
+        if (s_abort) {                              /* 打断：她闭嘴，把 DMA 里剩的一起丢掉 */
+            (void)bsp_audio_flush_tx();
+            s_aborted = true;
+            ESP_LOGW(TAG, "打断：停在 %.0f ms（已播 %u B，DMA 队列已丢）",
+                     (esp_timer_get_time() - t0) / 1000.0, (unsigned)played);
+            break;
+        }
+        const int64_t tw0 = esp_timer_get_time();
+        int r = recv(s_fd, s_buf, sizeof(s_buf), 0);      /* 可变：中途帧后的 PCM 要接着播 */
+        const uint32_t wait_ms = (uint32_t)((esp_timer_get_time() - tw0) / 1000);
+        /* ---- 中途帧（v0.121）：'AE2' + 标签 + 长度 + flags + crc8 + 文本 ----
+           用途：自查两段式——她先说完「我去看看」，停一下再发答案；这一帧让气泡/表情跟着换成答案。
+           只在**块首**认（服务端保证两段之间有空档，块首就是帧头），外加 crc8 ⇒ 假命中可忽略。 */
+        if (r >= 8 && s_buf[0] == 'A' && s_buf[1] == 'E' && s_buf[2] == '2' &&
+            vc_crc8(s_buf, 7) == s_buf[7]) {
+            const size_t tl = (size_t)((unsigned)s_buf[4] | ((unsigned)s_buf[5] << 8));
+            if (tl <= VOICE_HER_TEXT_MAX) {
+                uint8_t tb[VOICE_HER_TEXT_MAX + 1];
+                size_t have = (size_t)r - 8;
+                size_t got2 = have < tl ? have : tl;
+                if (got2) memcpy(tb, s_buf + 8, got2);
+                while (got2 < tl) {                       /* 帧被拆到两个包里也能读全 */
+                    const int rr = recv(s_fd, tb + got2, tl - got2, 0);
+                    if (rr <= 0) break;
+                    got2 += (size_t)rr;
+                }
+                tb[tl] = 0;
+                utf8_trim((char *)tb, tl);
+                const uint8_t mflag = s_buf[6];
+                s_tag = s_buf[3];
+                if (mflag & VOICE_META_FLAG_HER) memcpy(s_her_text, tb, tl + 1);
+                else                             memcpy(s_meta_text, tb, tl + 1);
+                if (s_meta_cb) s_meta_cb(s_tag, (mflag & VOICE_META_FLAG_HER) ? s_her_text : s_meta_text, mflag);
+                /* 这一段之间的"停顿"是**设计**（她先说"我去看看"，查完再补答案），
+                   不能算进断流账，否则每次自查都报一次假警；下面的分段重新计。 */
+                ESP_LOGI(TAG, "中途帧：%s「%s」（标签 %u，两段之间空 %.0f ms —— 设计如此，不算断流）",
+                         (mflag & VOICE_META_FLAG_HER) ? "她说" : "回显",
+                         (mflag & VOICE_META_FLAG_HER) ? s_her_text : s_meta_text,
+                         (unsigned)s_tag, wait_ms);
+                max_wait_ms = 0;
+                stalls = 0;
+                /* 🔴 帧和 PCM 常常落在**同一个 recv**里（服务端一次 sendall 发的）：
+                   帧后面那段音频必须挪到最前面照常播，否则答案开头会少 20~60 ms（听着像"哒"一声）。 */
+                const int left = (int)have - (int)got2;
+                if (left > 0) {
+                    memmove(s_buf, s_buf + 8 + tl, (size_t)left);
+                    r = left;
+                } else {
+                    r = 0;
+                    continue;                             /* 这一包只有帧，没有音频 */
+                }
+            }
+        }
+        if (r > 0) {
+            chunks++;
+            if (wait_ms > max_wait_ms) max_wait_ms = wait_ms;
+            if (wait_ms > 150) stalls++;            /* 150 ms 以上就算一次"卡顿"（听感上开始有缝） */
+            const bool is_first = first;
+            if (first) {
+                ESP_LOGI(TAG, "首字节 %.0fms（从松手到出声）", (esp_timer_get_time() - t0) / 1000.0);
+                first = false;
+            }
+            /* 先算电平再写喇叭：嘴型早于声音一点点，比晚一拍好 */
+            if (s_level_cb) s_level_cb(mean_abs_pcm16(s_buf, (size_t)r), is_first);
+            if (bsp_audio_write(s_buf, (size_t)r) != ESP_OK) {
+                ESP_LOGW(TAG, "喇叭写失败");
+                ret = ESP_FAIL;
+                break;
+            }
+            s_last_play_us = esp_timer_get_time();
+            played += (uint32_t)r;
+            if (play_timeout_ms > 0 && (esp_timer_get_time() - t0) / 1000 > play_timeout_ms) {
+                ESP_LOGW(TAG, "播放超时（%d ms），先停", play_timeout_ms);
+                break;
+            }
+        } else if (r == 0) {
+            break;                                    /* 对端关闭 = 音频发完 */
+        } else {
+            if (errno == EAGAIN || errno == EWOULDBLOCK) {
+                ESP_LOGW(TAG, "等回复超时");
+                ret = ESP_ERR_TIMEOUT;
+            } else {
+                ESP_LOGW(TAG, "接收出错 errno=%d", errno);
+                ret = ESP_FAIL;
+            }
+            break;
+        }
+    }
+    ESP_LOGI(TAG, "播放完成 %u B（%.2fs）｜ 松手到播完 %.0fms ｜ 块 %u ｜ 最长等数据 %u ms ｜ "
+                  ">150ms 断流 %u 次 ｜ DMA 兜 %d ms ｜ 音量 %u%%",
+             (unsigned)played, played / 2.0 / VOICE_SR, (esp_timer_get_time() - t0) / 1000.0,
+             (unsigned)chunks, (unsigned)max_wait_ms, (unsigned)stalls,
+             bsp_audio_tx_buffer_ms(), (unsigned)app_volume_get());
+    if (max_wait_ms > (uint32_t)bsp_audio_tx_buffer_ms()) {
+        ESP_LOGW(TAG, "⚠️ 这一轮断流 %u ms > DMA 能兜的 %d ms ⇒ **中间一定有空档/爆音**（网络，不是固件）",
+                 (unsigned)max_wait_ms, bsp_audio_tx_buffer_ms());
+    }
+
+    close(s_fd);
+    s_fd = -1;
+    return ret;
+}
+
+/* ---------------------------------------------------------------- 一次性联调 */
+esp_err_t voice_talk_once(int sec, const char *path)
+{
+    if (sec <= 0) sec = 2;
+    if (sec * 1000 > VOICE_MAX_MS) sec = VOICE_MAX_MS / 1000;
+
+    esp_err_t e = voice_talk_begin(path);
+    if (e != ESP_OK) return e;
+
+    const int64_t t0 = esp_timer_get_time();
+    const int chunks = (sec * VOICE_SR * 2) / VOICE_CHUNK;
+    for (int i = 0; i < chunks; i++) {
+        if (voice_talk_feed() != ESP_OK) break;
+    }
+    const double rec = (esp_timer_get_time() - t0) / 1e6;
+    ESP_LOGI(TAG, "录了 %.2fs（%d 块 / %u B），开始收回复", rec, chunks, (unsigned)s_up_bytes);
+    return voice_talk_end(20000);
+}
diff --git a/main/voice_talk.h b/main/voice_talk.h
new file mode 100644
index 0000000..9f8c951
--- /dev/null
+++ b/main/voice_talk.h
@@ -0,0 +1,75 @@
+// main/voice_talk.h —— 设备侧语音上行/下行（按住说话的最小实现）
+//
+// 设计口径（为什么长这样）：
+//   · **绝不缓存整段**：3 秒 16k/16bit 双声道就 192KB，C3 空闲堆只有 ~26KB、最大连续块 8.7KB。
+//     所以录音是「读 512B → 立刻写进 HTTP 分块」；回放是「读 512B → 立刻写进 I2S」。
+//   · 上传用 **chunked**（esp_http_client_open 传 -1）：设备事先不知道要录多久，不能先填 Content-Length。
+//   · 采样格式固定 **16000Hz / 16bit / 单声道**：跟服务端机 aitalk.py 的 say+afconvert 输出一致。
+#pragma once
+
+#include <stddef.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "esp_err.h"
+
+// 一次性做完：录 sec 秒 → POST path → 边收边播回来。给自检/联调用。
+// 返回 ESP_OK 只代表"链路跑通"，不代表内容正确。
+esp_err_t voice_talk_once(int sec, const char *path);
+
+// 按住说话的流式版本（M2 用）：
+//   begin() 开始录音并建立上传连接；feed() 从麦克风搬一块上去；end() 收尾并播放回复。
+//   三步都要在同一个任务里调（内部不是线程安全的）。
+// 单次录音的硬上限（毫秒）。页面用它做"到顶自动收尾"，别再写死 6000。
+uint32_t voice_talk_max_ms(void);
+
+esp_err_t voice_talk_begin(const char *path);
+esp_err_t voice_talk_feed(void);          // 读一块麦克风 → 上传；返回 ESP_OK
+esp_err_t voice_talk_end(int play_timeout_ms);
+
+// 是否正在一次对话中（界面用来决定显示哪段表情）
+bool voice_talk_active(void);
+
+// 电平回调（2026-10-29 加，给她"说话张嘴"用）：
+//   收回复音频时，**每收一块（1024 B = 512 采样）调一次**，在 end() 里同步调用。
+//   mean_abs = 这一块的 mean(|s16|)，0..32768；first = 本轮的第一个字节（= 她开始出声）。
+//   回调跑在**调用 end() 的那个任务**里 ⇒ 只许写标志/算数，**绝不许碰 LVGL**。
+typedef void (*voice_talk_level_cb_t)(uint32_t mean_abs, bool first);
+void voice_talk_set_level_cb(voice_talk_level_cb_t cb);
+
+/* 下行元数据帧（2026-10-29 M2，口径见 `72-M2-开工调研` §3.2）：
+   服务端在她那句回话的 PCM **之前**先发 8 字节头（**可以连着发多个**，见下）：
+     0..2 `'A' 'E' '1'` ｜ 3 表情标签 ｜ 4..5 text_len(u16 LE) ｜ 6 flags ｜ 7 保留
+     8..  text_len 字节 UTF-8，然后才是 PCM。
+   标签：0=无 1害羞 2心软 3得意 4嫌弃 5开心 6求别走 7大哭 8迷糊 9思考。
+   **flags 第 0 位 = 这段文本是「她说的」**（0 = 我说的 ASR 回显；v0.93 起）。
+   服务端顺序：`[ASR 帧 flags=0] [她说 帧 flags=1] PCM`；设备**循环读**到 magic 不匹配为止
+   （那段字节按 PCM 播）⇒ 只发一个帧的老服务端、以后想再加帧，都兼容。
+   回调在**调 end() 的那个任务**里同步执行 ⇒ 只许记标志，绝不许碰 LVGL；text 可能是 ""。 */
+typedef void (*voice_talk_meta_cb_t)(uint8_t tag, const char *text, uint8_t flags);
+
+/* flags 位定义（必须和服务端机 `aitalk.py` 的 META_FLAG_HER 一致） */
+#define VOICE_META_FLAG_HER   0x01u   /* 这段文本是「她说的」 */
+#define VOICE_META_FLAG_CHECK 0x02u   /* v0.122：她正在查（气泡里跑点点动画，别让她干等着） */
+void voice_talk_set_meta_cb(voice_talk_meta_cb_t cb);
+
+/* 打断（2026-10-29 M2）：按 ● = 插话。
+   只置一个标志 —— 真正的"丢 DMA + 关连接 + 收尾"在跑 begin/feed/end 的那个任务里做
+   （bsp_audio_flush_tx 要等 I2S，绝不能从按键回调里调）。下一次 begin() 自动清掉。 */
+void voice_talk_abort(void);
+
+/* W3 v1.1（2026-10-30）：**开场也走语音口取**。
+   为什么不是 HTTP：设备与服务端机**永远不在同一个网络**（作者定），HTTP 8801 只有局域网能到；
+   语音口 8802 有公网通道（中继网关 / 公网直连），所以 /greet 挂这条。
+   成功返回 0（out 里是 JSON 正文），失败 <0。 */
+int voice_talk_greet(char *out, size_t cap);
+
+/* 同一个网关的通用口（2026-10-30 23:4x，联网即可用）：取/回传都走语音口 8802。
+   成功返回 0（out 里是正文），失败 <0（调用方可以退 HTTP 兜底）。 */
+int voice_talk_get(const char *path, char *out, size_t cap);
+int voice_talk_post(const char *path, const char *body, size_t blen, char *out, size_t cap);
+
+/* 上一轮是不是被"打断"收尾的（false = 正常走完 / 出错）。
+   用来把打断和失败分开：打断**不算失败**（不记 last_fail、不加亲密度、不演心虚）。 */
+bool voice_talk_aborted(void);
