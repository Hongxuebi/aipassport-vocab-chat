+    }
+    /* 等 LVGL/主页起来再进页：WiFi 抢在开机动画前就绪时，太早进页等于没进（2026-10-28 踩过） */
+    for (int i = 0; i < 80; i++) {
+        if (bsp_lvgl_lock(100)) { bsp_lvgl_unlock(); break; }
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+    vTaskDelay(pdMS_TO_TICKS(800));
+
+    int target = -1;
+    for (int i = 0; i < demo_count(); i++) {
+        const struct demo_entry *e = demo_at(i);
