+
+void demo_selftest_exit(void)
+{
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; s_lbl = NULL; }
+}
+
+void demo_selftest_key(bsp_btn_t btn, bsp_btn_ev_t ev) { (void)btn; (void)ev; }
diff --git a/main/demo_settings.c b/main/demo_settings.c
new file mode 100644
index 0000000..e943cc9
--- /dev/null
+++ b/main/demo_settings.c
@@ -0,0 +1,223 @@
+// main/demo_settings.c —— 设置（2026-10-28 新增；14:5x 加「音量」可调；2026-10-29 M2 加「麦克风」）
+//
+// 作者："设置再说" —— 这一版列出来、能翻、能点，点了给一句实话，不假装能改。
+// 真能改的两项：**音量**（%）＋**麦克风增益**（dB）。
+//
+// 调节态交互（两项同一套）：
+//   ● 进某行 → 变成调节态 → ▲ 加 / ▼ 减（音量每按一下"嘟"一声当场试听；
+//   麦克风不响 —— 它改的是**拾音**，听不出来，看串口 `麦克风增益 N dB` / 之后 ASR 回显）
+//   → ● 保存退出。长按 ● 仍是回主页（框架管）。
+//   调节态里 ▲▼ **不再移动光标**，避免"想调音量结果换了行"。
+//
+// ⚠ **8 行版（M2）**：ROW_* 是数组下标，插一行后面全要改（`72` §2.3 写死的坑）。
+//   配网 0 / 音量 1 / 麦克风 2 / 亮度 3 / 番茄时长 4 / 立即对时 5 / 实验室 6 / 关于 7
+#include <stdio.h>
+#include <string.h>
+#include "esp_system.h"
+
+#include "lvgl.h"
+#include "demo.h"
+#include "ui_pixel.h"
+#include "esp_log.h"
+#include "time_sync.h"
+
+#include "app_mic_gain.h"
+#include "app_volume.h"
+
+LV_FONT_DECLARE(fusion_ui16);
+
+static const char *TAG = "settings";
+
+void app_request_enter_name(const char *name);
+
+#define ST_ROWS 8
+static const char *ROW[ST_ROWS] = {
+    "配网", "音量", "麦克风", "亮度", "番茄时长", "立即对时", "实验室", "关于"
+};
+#define ROW_WIFI 0
+#define ROW_VOL  1
+#define ROW_MIC  2
+#define ROW_TIME 5
+#define ROW_LAB  6
+
+/* 行几何（8 行版）：标题牌到 y=35、底部发丝线在 286。
+   44 起、27 一行、24 高 ⇒ 最后一行 233..257，提示行 262..284 —— 正好塞得下。
+   （7 行时是 50 + i*30；插一行后必须重排，不然后两行直接压到提示行上。） */
+#define ROW_Y0  44
+#define ROW_DY  27
+#define ROW_H   24
+
+#define VOL_STEP 5     // 音量 % / 档
+#define MIC_STEP 2     // 麦克风 dB / 档（定的 ±2）
+
+static lv_obj_t *s_scr;
+static lv_obj_t *s_row[ST_ROWS];
+static lv_obj_t *s_val[ST_ROWS];        // 行右边的值（音量 % / 麦克风 dB）
+static lv_obj_t *s_hint;
+static int  s_sel;
+static int  s_adj;                      // 0 = 不在调节态；否则 = 正在调的那一行（ROW_VOL / ROW_MIC）
+
+static void set_hint(const char *txt)
+{
+    if (s_hint) lv_label_set_text(s_hint, txt);
+}
+
+static void show_val(int row)
+{
+    if (row < 0 || row >= ST_ROWS || !s_val[row]) return;
+    if (row == ROW_VOL) {
+        lv_label_set_text_fmt(s_val[row], "%d%%", (int)app_volume_get());
+    } else if (row == ROW_MIC) {
+        lv_label_set_text_fmt(s_val[row], "%ddB", app_mic_gain_get());
+    }
+}
+
+static void paint_sel(void)
+{
+    for (int i = 0; i < ST_ROWS; i++) {
+        if (!s_row[i]) continue;
+        const bool hot = (i == s_sel) || (s_adj && i == s_adj);
+        lv_obj_set_style_bg_color(s_row[i], lv_color_hex(hot ? UI_PANEL_SEL : UI_PANEL), 0);
+        lv_obj_set_style_border_color(s_row[i], lv_color_hex(hot ? UI_CY : UI_PANEL_EDGE), 0);
+    }
+}
+
+static void step_vol(int delta)
+{
+    int v = (int)app_volume_get() + delta;
+    if (v < 0) v = 0;
+    if (v > 100) v = 100;
+    app_volume_set((uint8_t)v, false);
+    show_val(ROW_VOL);
+    if (s_hint) lv_label_set_text_fmt(s_hint, "音量 %d%%   ▲加 ▼减   ●保存", v);
+    (void)app_volume_beep_at(1400, 70);          // 当场听得见
+}
+
+static void step_mic(int delta)
+{
+    const int v = app_mic_gain_get() + delta;
+    app_mic_gain_set(v, false);                  // 立即生效（会当场念一句试）
+    show_val(ROW_MIC);
+    if (s_hint) lv_label_set_text_fmt(s_hint, "麦克风 %d dB   ▲+2 ▼-2   ●保存", app_mic_gain_get());
+    /* 不"嘟"：这调的是拾音，出声只会让使用侧以为改的是喇叭 */
+}
+
+void demo_settings_enter(void)
+{
+    s_scr = ui_pixel_screen_create("设置");
+    s_sel = ROW_WIFI;
+    s_adj = 0;
+    ESP_LOGI(TAG, "进设置页：音量 %u%% ｜ 麦克风 %d dB",
+             (unsigned)app_volume_get(), app_mic_gain_get());
+
+    for (int i = 0; i < ST_ROWS; i++) {
+        lv_obj_t *row = ui_pixel_panel_dark(s_scr, 12, ROW_Y0 + i * ROW_DY, 216, ROW_H, i == s_sel);
+        s_row[i] = row;
+        lv_obj_t *t = ui_pixel_label(row, ROW[i], &fusion_ui16, UI_SC_INK);
+        lv_obj_set_size(t, 150, 20);
+        lv_obj_set_pos(t, 12, 2);
+        if (i == ROW_VOL || i == ROW_MIC) {
+            s_val[i] = ui_pixel_label(row, "", &fusion_ui16, UI_CY);
+            lv_obj_set_size(s_val[i], 48, 20);
+            lv_obj_set_pos(s_val[i], 156, 2);
+            lv_obj_set_style_text_align(s_val[i], LV_TEXT_ALIGN_RIGHT, 0);
+        }
+    }
+    show_val(ROW_VOL);
+    show_val(ROW_MIC);
+
+    s_hint = ui_pixel_label(s_scr, "▲▼ 选   ● 进入 / 执行   长按 ● 返回主页", &fusion_ui16, UI_SC_MUTE);
+    lv_obj_set_size(s_hint, 216, 22);
+    lv_obj_set_pos(s_hint, 12, 262);
+    lv_obj_set_style_text_align(s_hint, LV_TEXT_ALIGN_CENTER, 0);
+
+    lv_screen_load(s_scr);
+    ESP_LOGI(TAG, "设置页就绪（%d 项）", ST_ROWS);
+}
+
+void demo_settings_exit(void)
+{
+    app_volume_save();                  // 没按 ● 就长按退出也不会丢
+    app_mic_gain_save();
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; }
+    memset(s_row, 0, sizeof(s_row));
+    memset(s_val, 0, sizeof(s_val));
+    s_hint = NULL;
+    s_adj = 0;
+}
+
+void demo_settings_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    /* ---------------- 调节态（音量 / 麦克风）---------------- */
+    if (s_adj) {
+        if (ev != BSP_BTN_CLICK) return;            // 长按 ● 交给框架（回主页），这里不拦
+        if (btn == BSP_BTN_UP) {
+            if (s_adj == ROW_VOL) step_vol(+VOL_STEP); else step_mic(+MIC_STEP);
+            return;
+        }
+        if (btn == BSP_BTN_DOWN) {
+            if (s_adj == ROW_VOL) step_vol(-VOL_STEP); else step_mic(-MIC_STEP);
+            return;
+        }
+        if (btn == BSP_BTN_OK) {
+            app_volume_save();
+            app_mic_gain_save();
+            const int which = s_adj;
+            s_adj = 0;
+            paint_sel();
+            set_hint(which == ROW_VOL ? "音量已保存" : "麦克风增益已保存");
+            ESP_LOGI(TAG, "保存：音量 %u%% ｜ 麦克风 %d dB",
+                     (unsigned)app_volume_get(), app_mic_gain_get());
+            return;
+        }
+        return;
+    }
+
+    /* ---------------- 普通列表 ---------------- */
+    if (ev != BSP_BTN_CLICK) return;
+
+    if (btn == BSP_BTN_DOWN && s_sel < ST_ROWS - 1) s_sel++;
+    else if (btn == BSP_BTN_UP && s_sel > 0) s_sel--;
+    else if (btn == BSP_BTN_OK) {
+        ESP_LOGW(TAG, "点了：%s", ROW[s_sel]);
+        if (s_sel == ROW_WIFI) {                /* 配网：没网时连时钟都不准，放第一项 */
+            /* 2026-10-30 作者要「换网简单」：不再就地开热点（那页内存不够，httpd 时起时不起），
+               改成置标记 + 重启 —— 下次开机跳过音频/语音，热点和网页都在，配完自己重启回来。 */
+            app_prov_boot_request(true);
+            esp_restart();
+            return;
+        }
+        if (s_sel == ROW_VOL) {                 /* 音量：进调节态 */
+            s_adj = ROW_VOL;
+            paint_sel();
+            if (s_hint) lv_label_set_text_fmt(s_hint, "音量 %d%%   ▲加 ▼减   ●保存",
+                                              (int)app_volume_get());
+            (void)app_volume_beep_at(1400, 70);
+            return;
+        }
+        if (s_sel == ROW_MIC) {                 /* 麦克风增益：进调节态（M2） */
+            s_adj = ROW_MIC;
+            paint_sel();
+            if (s_hint) lv_label_set_text_fmt(s_hint, "麦克风 %d dB   ▲+2 ▼-2   ●保存",
+                                              app_mic_gain_get());
+            return;
+        }
+        if (s_sel == ROW_TIME) {                /* 立即对时 */
+            time_sync_request_sync();
+            set_hint("已请求对时（联网后生效）");
+            return;
+        }
+        if (s_sel == ROW_LAB) {                 /* 实验室：开发页的入口 */
+            app_request_enter_name("实验室");
+            return;
+        }
+        if (s_hint) lv_label_set_text_fmt(s_hint, "「%s」下一版再说", ROW[s_sel]);
+        return;
+    } else return;
+
+    ESP_LOGI(TAG, "光标 %d/%d：%s", s_sel + 1, ST_ROWS, ROW[s_sel]);
+    paint_sel();
+}
+
+esp_err_t demo_settings_start(void) { return ESP_OK; }
+esp_err_t demo_settings_stop(void)  { return ESP_OK; }
