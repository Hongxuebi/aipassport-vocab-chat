+# ---------------------------------------------------------------- 设备令牌
+# main/secrets.h 由 _工具/生成设备令牌.sh 生成（600 权限、不进 git、不进补丁）。
+# 构建时把里面的令牌读出来当宏注入固件 —— 令牌"烧进固件"但源码里不留明文。
+if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/secrets.h")
+    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/secrets.h" _tok_line REGEX "AIP_DEV_TOKEN")
+    string(REGEX REPLACE ".*\"([0-9a-fA-F]+)\".*" "\\1" _tok "${_tok_line}")
+    target_compile_definitions(${COMPONENT_LIB} PRIVATE AIP_DEV_TOKEN="${_tok}")
+    string(LENGTH "${_tok}" _toklen)
