diff --git a/components/assets/assets_fs.c b/components/assets/assets_fs.c
new file mode 100644
index 0000000..7237d83
--- /dev/null
+++ b/components/assets/assets_fs.c
@@ -0,0 +1,225 @@
+// components/assets/assets_fs.c —— assets 分区（SPIFFS）实现
+//
+// 设计（对应 `32 §6`）：
+//   · 资源放 assets 分区（1MB），SPIFFS 挂载在 /assets，首次挂载失败自动格式化
+//   · 缓存上限由 LRU 控制：写之前先看剩余空间，不够就删"最久没被用过"的
+//   · 下载走服务端机（AIP_SERVER_BASE），流式写盘，sha256 可选校验
+//   · **任何失败只影响资源，不影响背单词**（N4：必须打日志，不许静默）
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "esp_log.h"
+#include "esp_vfs_fat.h"
+#include "esp_spiffs.h"
+#include "esp_http_client.h"
+#include "mbedtls/sha256.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#include "assets_fs.h"
+
+static const char *TAG = "assets";
+static bool s_mounted;
+
+#define ASSETS_BASE  "/assets"
+#define ASSETS_MAXF  4
+#define LRU_N        48
+#define RESERVE      (48u * 1024u)     /* 永远留 48KB 余量，别把分区写满 */
+
+typedef struct { char name[40]; uint32_t used_ms; } lru_t;
+static lru_t s_lru[LRU_N];
+static int   s_lru_n;
+
+esp_err_t assets_init(void)
+{
+    esp_vfs_spiffs_conf_t cfg = {
+        .base_path = ASSETS_BASE,
+        .partition_label = "assets",
+        .max_files = ASSETS_MAXF,
+        .format_if_mount_failed = true,
+    };
+    esp_err_t e = esp_vfs_spiffs_register(&cfg);
+    if (e != ESP_OK) {
+        ESP_LOGE(TAG, "assets 分区挂载失败：%s（资源功能不可用，背单词不受影响）", esp_err_to_name(e));
+        s_mounted = false;
+        return e;
+    }
+    size_t total = 0, used = 0;
+    if (esp_spiffs_info("assets", &total, &used) == ESP_OK) {
+        ESP_LOGI(TAG, "assets 已挂载：总 %u KB，已用 %u KB（余 %u KB）",
+                 (unsigned)(total / 1024), (unsigned)(used / 1024), (unsigned)((total - used) / 1024));
+    } else {
+        ESP_LOGW(TAG, "assets 挂载了但读不到统计信息");
+    }
+    s_mounted = true;
+    return ESP_OK;
+}
+
+size_t assets_total(void)
+{
+    size_t t = 0, u = 0;
+    if (!s_mounted || esp_spiffs_info("assets", &t, &u) != ESP_OK) return 0;
+    return t;
+}
+
+size_t assets_used(void)
+{
+    size_t t = 0, u = 0;
+    if (!s_mounted || esp_spiffs_info("assets", &t, &u) != ESP_OK) return 0;
+    return u;
+}
+
+static void path_of(const char *name, char *out, size_t cap)
+{
+    snprintf(out, cap, ASSETS_BASE "/%s", name);
+}
+
+void assets_touch(const char *name)
+{
+    uint32_t now = (uint32_t)(xTaskGetTickCount() * portTICK_PERIOD_MS);
+    for (int i = 0; i < s_lru_n; i++) {
+        if (strcmp(s_lru[i].name, name) == 0) { s_lru[i].used_ms = now; return; }
+    }
+    if (s_lru_n < LRU_N) {
+        snprintf(s_lru[s_lru_n].name, sizeof(s_lru[0].name), "%s", name);
+        s_lru[s_lru_n].used_ms = now;
+        s_lru_n++;
+    } else {
+        /* 表满：替换最老的一条（等价于把它忘了，下次淘汰优先删它） */
+        int oldest = 0;
+        for (int i = 1; i < LRU_N; i++) if (s_lru[i].used_ms < s_lru[oldest].used_ms) oldest = i;
+        snprintf(s_lru[oldest].name, sizeof(s_lru[0].name), "%s", name);
+        s_lru[oldest].used_ms = now;
+    }
+}
+
+bool assets_exists(const char *name)
+{
+    if (!s_mounted) return false;
+    char p[80]; path_of(name, p, sizeof(p));
+    struct stat st;
+    return stat(p, &st) == 0;
+}
+
+esp_err_t assets_remove(const char *name)
+{
+    if (!s_mounted) return ESP_ERR_INVALID_STATE;
+    char p[80]; path_of(name, p, sizeof(p));
+    if (unlink(p) != 0) return ESP_FAIL;
+    for (int i = 0; i < s_lru_n; i++) {
+        if (strcmp(s_lru[i].name, name) == 0) { s_lru[i] = s_lru[--s_lru_n]; break; }
+    }
+    ESP_LOGI(TAG, "已删资源 %s", name);
+    return ESP_OK;
+}
+
+esp_err_t assets_evict_lru(size_t need)
+{
+    if (!s_mounted) return ESP_ERR_INVALID_STATE;
+    if (assets_total() == 0) return ESP_ERR_INVALID_STATE;
+    while (assets_total() - assets_used() < need + RESERVE) {
+        int oldest = -1;
+        uint32_t t = 0xffffffffu;
+        for (int i = 0; i < s_lru_n; i++) {
+            if (s_lru[i].used_ms < t && assets_exists(s_lru[i].name)) { t = s_lru[i].used_ms; oldest = i; }
+        }
+        if (oldest < 0) { ESP_LOGW(TAG, "没东西可淘汰了（要 %u B）", (unsigned)need); return ESP_ERR_NO_MEM; }
+        char nm[40]; snprintf(nm, sizeof(nm), "%s", s_lru[oldest].name);
+        if (assets_remove(nm) != ESP_OK) { s_lru[oldest].used_ms = 0xfffffffeu; }
+    }
+    return ESP_OK;
+}
+
+esp_err_t assets_write(const char *name, const void *buf, size_t len)
+{
+    if (!s_mounted) return ESP_ERR_INVALID_STATE;
+    esp_err_t e = assets_evict_lru(len);
+    if (e != ESP_OK) ESP_LOGW(TAG, "淘汰后空间仍紧，硬写试试");
+    char p[80]; path_of(name, p, sizeof(p));
+    FILE *f = fopen(p, "wb");
+    if (!f) { ESP_LOGE(TAG, "写 %s 失败（打不开）", name); return ESP_FAIL; }
+    size_t w = fwrite(buf, 1, len, f);
+    fclose(f);
+    if (w != len) { ESP_LOGE(TAG, "写 %s 只写了 %u/%u", name, (unsigned)w, (unsigned)len); return ESP_FAIL; }
+    assets_touch(name);
+    ESP_LOGI(TAG, "写入资源 %s（%u B）", name, (unsigned)len);
+    return ESP_OK;
+}
+
+esp_err_t assets_read(const char *name, void *buf, size_t cap, size_t *out_len)
+{
+    if (!s_mounted) return ESP_ERR_INVALID_STATE;
+    char p[80]; path_of(name, p, sizeof(p));
+    FILE *f = fopen(p, "rb");
+    if (!f) return ESP_ERR_NOT_FOUND;
+    size_t r = fread(buf, 1, cap, f);
+    fclose(f);
+    if (out_len) *out_len = r;
+    assets_touch(name);
+    return ESP_OK;
+}
+
+esp_err_t assets_fetch(const char *abs_url, const char *token,
+                       const char *name, size_t max_len, const char *sha256_hex)
+{
+    if (!s_mounted) return ESP_ERR_INVALID_STATE;
+    const char *url = abs_url;
+
+    esp_http_client_config_t cfg = { .url = url, .timeout_ms = 8000, .buffer_size = 512 };
+    esp_http_client_handle_t c = esp_http_client_init(&cfg);
+    if (!c) { ESP_LOGE(TAG, "http init 失败"); return ESP_FAIL; }
+    if (token && token[0]) esp_http_client_set_header(c, "X-Dev-Token", token);
+
+    esp_err_t ret = ESP_FAIL;
+    char tmp[96]; snprintf(tmp, sizeof(tmp), ASSETS_BASE "/.%s.part", name);
+    char fin[80]; path_of(name, fin, sizeof(fin));
+    FILE *f = NULL;
+
+    if (esp_http_client_open(c, 0) != ESP_OK) { ESP_LOGE(TAG, "连不上 %s", url); goto out; }
+    if (esp_http_client_get_status_code(c) != 200 &&
+        (esp_http_client_fetch_headers(c) < 0 || esp_http_client_get_status_code(c) != 200)) {
+        ESP_LOGE(TAG, "下载 %s HTTP %d", url, esp_http_client_get_status_code(c));
+        goto out;
+    }
+    if (assets_evict_lru(max_len) != ESP_OK) ESP_LOGW(TAG, "空间紧，先试写");
+
+    f = fopen(tmp, "wb");
+    if (!f) { ESP_LOGE(TAG, "临时文件打不开"); goto out; }
+    mbedtls_sha256_context sha; mbedtls_sha256_init(&sha); mbedtls_sha256_starts(&sha, 0);
+
+    static uint8_t s_io[512];   /* 静态 IO 缓冲：堆太紧（最大连续块 ~7.6KB） */
+    uint8_t *buf = s_io;
+    size_t total = 0;
+    for (;;) {
+        int r = esp_http_client_read(c, (char *)buf, 512);
+        if (r < 0) { ESP_LOGE(TAG, "读取中断（%u B）", (unsigned)total); break; }
+        if (r == 0) break;
+        if (total + r > max_len) { ESP_LOGE(TAG, "超过上限 %u", (unsigned)max_len); total = 0; break; }
+        mbedtls_sha256_update(&sha, buf, r);
+        if (fwrite(buf, 1, r, f) != (size_t)r) { ESP_LOGE(TAG, "写盘失败"); total = 0; break; }
+        total += (size_t)r;
+    }
+    fclose(f);
+
+    uint8_t dig[32]; char hex[65] = {0};
+    mbedtls_sha256_finish(&sha, dig); mbedtls_sha256_free(&sha);
+    for (int i = 0; i < 32; i++) sprintf(hex + i * 2, "%02x", dig[i]);
+
+    if (total == 0) { unlink(tmp); ESP_LOGE(TAG, "下载失败 %s", url); goto out; }
+    if (sha256_hex && sha256_hex[0] && strcasecmp(hex, sha256_hex) != 0) {
+        unlink(tmp); ESP_LOGE(TAG, "sha256 不符：%s / 期望 %s", hex, sha256_hex); goto out;
+    }
+    unlink(fin);
+    if (rename(tmp, fin) != 0) { unlink(tmp); ESP_LOGE(TAG, "改名失败"); goto out; }
+    assets_touch(name);
+    ESP_LOGI(TAG, "下载完成 %s（%u B）", name, (unsigned)total);
+    ret = ESP_OK;
+
+out:
+    esp_http_client_close(c);
+    esp_http_client_cleanup(c);
+    return ret;
+}
diff --git a/components/assets/assets_fs.h b/components/assets/assets_fs.h
new file mode 100644
index 0000000..1bb5267
--- /dev/null
+++ b/components/assets/assets_fs.h
@@ -0,0 +1,30 @@
+// components/assets/assets_fs.h —— assets 分区（SPIFFS）：挂载 / 读写 / LRU 淘汰 / 从服务端机下载
+#pragma once
+#include <stddef.h>
+#include <stdbool.h>
+#include "esp_err.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+esp_err_t assets_init(void);                                   /* 挂载（失败必须打日志，N4） */
+size_t    assets_total(void);
+size_t    assets_used(void);
+esp_err_t assets_write(const char *name, const void *buf, size_t len);
+esp_err_t assets_read(const char *name, void *buf, size_t cap, size_t *out_len);
+bool      assets_exists(const char *name);
+esp_err_t assets_remove(const char *name);
+void      assets_touch(const char *name);                      /* 更新 LRU 时间戳 */
+
+/* 从服务端机下载一个资源到 assets/<name>（流式写盘；sha256 可选，给了就校验）
+   abs_url：完整 http 地址；token：设备令牌；网络细节由调用方决定（本组件不依赖 main） */
+esp_err_t assets_fetch(const char *abs_url, const char *token,
+                       const char *name, size_t max_len, const char *sha256_hex);
+
+/* LRU：腾出至少 need 字节（删最久没用过的；删不动就返回 ESP_ERR_NO_MEM） */
+esp_err_t assets_evict_lru(size_t need);
+
+#ifdef __cplusplus
+}
+#endif
