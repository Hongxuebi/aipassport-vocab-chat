+{
+    if (!s_lvl) return;
+    char buf[24];
+    snprintf(buf, sizeof(buf), "L%u · %u", (unsigned)s_mood.level, (unsigned)s_store.int家用电脑y);
+    lv_label_set_text(s_lvl, buf);
