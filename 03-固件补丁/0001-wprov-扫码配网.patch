+// components/wprov/wprov_http.c
+// 配网页（服务端直出 HTML，零 JS）—— 手机上任何浏览器都能用：
+//   GET  /            → 扫到的 WiFi 列表（每个都是一个链接）
+//   GET  /pick?s=xxx  → 输密码表单（POST /connect）
+//   POST /connect     → 提交后立刻回状态页，自动刷新看结果
+//   GET  /status      → 连接中 / 成功 / 失败(reason)
+// 另有通配兜底 → 302 回首页（安卓探测路径带随机后缀）
+//
+// 依据：docs/reference/phoenixzhc/softap-provisioning-and-resource-budget.zh_CN.md
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "esp_http_server.h"
+#include "esp_log.h"
+#include "esp_netif.h"
+#include "esp_system.h"
+#include "esp_heap_caps.h"
+#include "lwip/sockets.h"
+#include "lwip/inet.h"
+
+#include "wprov.h"
+
+static const char *TAG = "wprov_http";
+static httpd_handle_t s_srv;
+static TaskHandle_t   s_dns_task;
+static volatile bool  s_dns_run;
+static volatile int   s_dns_sock = -1;
+static char           s_body[288];
+
+/* ------------------------------------------------------------------ 小工具 */
+static void html_esc(const char *in, char *out, size_t n)
+{
+    size_t o = 0;
+    for (const char *p = in; *p && o + 7 < n; p++) {
+        switch (*p) {
+        case '<': o += (size_t)snprintf(out + o, n - o, "&lt;"); break;
+        case '>': o += (size_t)snprintf(out + o, n - o, "&gt;"); break;
+        case '&': o += (size_t)snprintf(out + o, n - o, "&amp;"); break;
+        case '"': o += (size_t)snprintf(out + o, n - o, "&quot;"); break;
+        default:  out[o++] = *p; break;
+        }
+    }
+    out[o] = 0;
+}
+
+static void url_enc(const char *in, char *out, size_t n)
+{
+    static const char *hex = "0123456789ABCDEF";
+    size_t o = 0;
+    for (const unsigned char *p = (const unsigned char *)in; *p && o + 4 < n; p++) {
+        if ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+            (*p >= '0' && *p <= '9') || *p == '-' || *p == '_' || *p == '.' || *p == '~') {
+            out[o++] = (char)*p;
+        } else {
+            out[o++] = '%';
+            out[o++] = hex[*p >> 4];
+            out[o++] = hex[*p & 0x0F];
+        }
+    }
+    out[o] = 0;
+}
+
+static int hexv(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* 从 k=v&k2=v2 里取值并 URL 解码 */
+static bool form_get(const char *body, const char *key, char *out, size_t n)
+{
+    size_t klen = strlen(key);
+    const char *p = body;
+    while (p && *p) {
+        if (strncmp(p, key, klen) == 0 && p[klen] == '=') {
+            p += klen + 1;
+            size_t o = 0;
+            while (*p && *p != '&' && o + 1 < n) {
+                if (*p == '%' && p[1] && p[2] && hexv(p[1]) >= 0 && hexv(p[2]) >= 0) {
+                    out[o++] = (char)(hexv(p[1]) * 16 + hexv(p[2]));
+                    p += 3;
+                } else if (*p == '+') {
+                    out[o++] = ' '; p++;
+                } else {
+                    out[o++] = *p++;
+                }
+            }
+            out[o] = 0;
+            return true;
+        }
+        p = strchr(p, '&');
+        if (p) p++;
+    }
+    return false;
+}
+
+/* 配网页（**表单式，不用 JS**，2026-10-26 真机第二次踩后重写）
+   真机经过：手机连上热点、拿到 LAN_HOST、页面也下发了，但
+   ① 页面里 fetch('/api/scan') 从来不来（脚本没跑完/被截断）；
+   ② 就算列表改成服务端内嵌，页内「选它」也点不动（脚本没执行）。
+   结论：**别让关键路径依赖脚本**。现在全走链接 + 表单：
+     GET  /             列出扫到的 WiFi（服务端拼好），每行「选它」→ /p?s=<名字>
+     GET  /p?s=名字      输密码页（名字已填好，可改）
+     POST /c            form: s=名字&p=密码 → 交给 wprov 去连 → 回「已提交」
+   每个页面 ≤800B、一次发送（Content-Length，不分块、不 malloc 大块）。 */
+/* 配网页（2026-10-26 晚 第三版）：**一个小页面搞定，≤1.5KB**
+   为什么又改：手机"连上热点后页面空白" —— 热点头起来后只剩 ~5.6KB 堆，3KB 的多表单页面
+   经常发到一半就断（chunk 发送要 socket 缓冲）。所以：
+     · 一个 <select> 列出 WiFi（每行只有 ~45 字节）
+     · 一个密码框 + 一个"手打名字"框（列表没有时用）
+     · 一个提交按钮 —— 全在一个表单里，**一次请求、零脚本、零跳转**
+   浏览器原生下拉框在手机上就是"点一下弹列表"，比一堆输入框省内存也好点。 */
+/* 配网页（2026-10-26 12:2x 第四版）：**整页 ≤1KB**（小迪复盘第七条：max_connection 4→2、页面压到 1KB 内）
+   手机连上热点后堆只剩 ~5.6KB，页面越大越容易发一半就断（表现为"连接成功→空白"）。
+   取舍：列表保留（手输 WiFi 名容易错，但密码会输），去掉"手打名字"输入框（使用侧本来也打不对）。 */
+static const char LIST_HEAD[] =
+"<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
+"<title>配网</title><style>body{font:16px -apple-system;margin:0;padding:12px;background:#f4f4ea}"
+"h3{margin:0 0 6px}p{color:#666;font-size:13px;margin:0 0 8px}"
+"select,input,button{width:100%;box-sizing:border-box;font-size:16px;padding:10px;margin:6px 0;"
+"border-radius:8px;border:1px solid #ccd}button{background:#1689e8;color:#fff;border:0}</style>"
+"<h3>AI Passport 配网</h3><p>这个热点不上网，提示“无互联网”点继续。选 WiFi、输密码、连它。</p>"
+/* 2026-10-30 作者：「没有简单介绍可以长按上键清除所有网络」。设备屏那行是常驻的，这行给手机端也写一份（纯文本，不依赖脚本） */
+"<p>要清掉记住的旧网络：在设备上长按 ▲。</p>"
+"<form action=/c method=post><select name=s>@@ROWS@@</select>"
+"<input name=p type=password placeholder='WiFi 密码'><button>连它</button></form></html>";
+
+static const char PICK_HTML[] =
+"<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
+"<title>输密码</title>"
+"<style>body{font:16px -apple-system,sans-serif;margin:0;padding:14px;background:#f4f4ea}"
+"p{color:#666;font-size:13px}input,button{width:100%;box-sizing:border-box;font-size:16px;padding:12px;margin:6px 0;border-radius:8px;border:1px solid #ccd}"
+"button{background:#1689e8;color:#fff;border:0}</style>"
+"<h3>连 WiFi</h3><p>名字不对可以直接改；密码是路由器那个。</p>"
+"<form method=post action=/c>"
+"<input name=s value=\"@@SSID@@\" placeholder='WiFi 名称'>"
+"<input name=p type=password placeholder='WiFi 密码'>"
+"<button>确定，连它</button></form></html>";
+
+static const char DONE_HTML[] =
+"<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
+"<title>已提交</title><style>body{font:16px -apple-system,sans-serif;margin:0;padding:16px;background:#f4f4ea}</style>"
+"<h3>已提交</h3><p>机器正在连，成功后热点自动关闭，屏幕回到菜单。</p></html>";
+
+static const char BAD_HTML[] =
+"<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
+"<title>没收到名字</title><style>body{font:16px -apple-system,sans-serif;margin:0;padding:16px;background:#f4f4ea}</style>"
+"<h3>没收到 WiFi 名称</h3><p><a href=/>返回重选</a></p></html>";
+
+/* %XX 解码（GET 查询串用；表单体的解码在 form_get 里） */
+static void url_dec(const char *in, char *out, size_t n)
+{
+    size_t o = 0;
+    for (const char *p = in; p && *p && o + 1 < n; ) {
+        if (*p == '%' && p[1] && p[2] && hexv(p[1]) >= 0 && hexv(p[2]) >= 0) {
+            out[o++] = (char)(hexv(p[1]) * 16 + hexv(p[2]));
+            p += 3;
+        } else if (*p == '+') {
+            out[o++] = ' ';
+            p++;
+        } else {
+            out[o++] = *p++;
+        }
+    }
+    out[o] = 0;
+}
+
+static esp_err_t sed_plain(httpd_req_t *req, const char *body)
+{
+    httpd_resp_set_type(req, "text/html; charset=utf-8");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    return httpd_resp_send(req, body, HTTPD_RESP_USE_STRLEN);
+}
+
+/* GET / —— 扫到的 WiFi 直接拼进页面（不依赖脚本再拉一次） */
+static esp_err_t h_root(httpd_req_t *req)
+{
+    static const char MARK[] = "@@ROWS@@";
+    const char *mark = strstr(LIST_HEAD, MARK);
+    const int n = wprov_ap_count();
+    if (!mark) {
+        ESP_LOGE(TAG, "列表页缺占位符 %s", MARK);
+        httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "page");
+        return ESP_FAIL;
+    }
+    ESP_LOGI(TAG, "GET %s -> 列表页（%d 个热点，空闲堆 %u B，最大块 %u B）", req->uri, n,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    httpd_resp_set_type(req, "text/html; charset=utf-8");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+
+    esp_err_t e = httpd_resp_send_chunk(req, LIST_HEAD, (ssize_t)(mark - LIST_HEAD));
+    const wprov_ap_t *l = wprov_ap_list();
+    char row[160], name[120];
+    for (int i = 0; e == ESP_OK && i < n && i < 8; i++) {   /* 只列最强 8 个：页面压到 1KB 出头 */
+        html_esc(l[i].ssid, name, sizeof(name));
+        /* 每行就是一个完整的表单：名字 + 密码框 + 按钮。
+           点行不再"跳新页面"（v0.2 能用的交互其实是**本页操作**；改成跳转后，第二个请求一失败就表现为"点了没反应"）。 */
+        const int len = snprintf(row, sizeof(row),
+                                 "<option value=\"%s\">%s %ddBm%s</option>",
+                                 name, name, (int)l[i].rssi, l[i].secure ? " *" : "");
+        e = httpd_resp_send_chunk(req, row, (ssize_t)len);
+    }
+    if (e == ESP_OK && n == 0) {
+        static const char NONE[] = "<option value=\"\">（没扫到热点，重进本页会重扫）</option>";
+        e = httpd_resp_send_chunk(req, NONE, (ssize_t)(sizeof(NONE) - 1));
+    }
+    /* 🔴 2026-10-26 12:5x 真机：手机上**只看到下拉框、没有密码框** —— 因为这里漏发了占位符
+       **后半段**（`</select>` + 密码框 + 连它 + `</form>`）。页面模板是一整个字符串，占位符在中间，
+       发完列表必须把 mark 之后的尾巴也发出去。 */
+    if (e == ESP_OK) {
+        const char *tail = mark + sizeof(MARK) - 1;
+        e = httpd_resp_send_chunk(req, tail, (ssize_t)strlen(tail));
+    }
+    if (e == ESP_OK) e = httpd_resp_send_chunk(req, NULL, 0);
+    ESP_LOGI(TAG, "列表页发完：%s", e == ESP_OK ? "OK" : esp_err_to_name(e));
+    return e;
+}
+
+/* GET /p?s=名字 —— 输密码页（服务端把名字填好） */
+static esp_err_t h_pick(httpd_req_t *req)
+{
+    static const char MARK[] = "@@SSID@@";
+    char q[224], enc[128], ssid[80], esc[200], page[900];
+
+    const char *mark = strstr(PICK_HTML, MARK);
+    if (!mark) { httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "page"); return ESP_FAIL; }
+
+    ssid[0] = 0;
+    if (httpd_req_get_url_query_str(req, q, sizeof(q)) == ESP_OK) {
+        if (httpd_query_key_value(q, "s", enc, sizeof(enc)) == ESP_OK) url_dec(enc, ssid, sizeof(ssid));
+    }
+    html_esc(ssid, esc, sizeof(esc));
+    const int len = snprintf(page, sizeof(page), "%.*s%s%s",
+                             (int)(mark - PICK_HTML), PICK_HTML, esc, mark + sizeof(MARK) - 1);
+    ESP_LOGI(TAG, "GET /p -> 输密码页（名字=\"%s\"）", ssid);
+    httpd_resp_set_type(req, "text/html; charset=utf-8");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    return httpd_resp_send(req, page, (ssize_t)len);
+}
+
+/* POST /c —— 表单提交（s=名字&p=密码） */
+static esp_err_t h_connect_form(httpd_req_t *req)
+{
+    ESP_LOGI(TAG, "POST /c (%d B)", req->content_len);
+    if (req->content_len <= 0 || req->content_len >= (int)sizeof(s_body)) {
+        return sed_plain(req, BAD_HTML);
+    }
+    int total = 0;
+    while (total < (int)req->content_len) {
+        const int r = httpd_req_recv(req, s_body + total, req->content_len - total);
+        if (r <= 0) return sed_plain(req, BAD_HTML);
+        total += r;
+    }
+    s_body[total] = 0;
+
+    char ssid[33] = {0}, pass[65] = {0}, manual[33] = {0};
+    (void)form_get(s_body, "s2", manual, sizeof(manual));   /* 手打名字优先 */
+    if (manual[0]) snprintf(ssid, sizeof(ssid), "%s", manual);
+    else if (!form_get(s_body, "s", ssid, sizeof(ssid)) || ssid[0] == 0) {
+        return sed_plain(req, BAD_HTML);
+    }
+    (void)form_get(s_body, "p", pass, sizeof(pass));
+
+    const esp_err_t r = wprov_request_connect(ssid, pass);
+    ESP_LOGI(TAG, "POST /c：ssid=\"%s\" 密码长度 %d → %s", ssid, (int)strlen(pass), esp_err_to_name(r));
+    return sed_plain(req, r == ESP_OK ? DONE_HTML : BAD_HTML);
+}
+
+static esp_err_t h_redirect(httpd_req_t *req)
+{
+    ESP_LOGI(TAG, "GET %s -> 302 /", req->uri);
+    httpd_resp_set_status(req, "302 Found");
+    httpd_resp_set_hdr(req, "Location", "http://AP_IP/");
+    return httpd_resp_send(req, NULL, 0);
+}
+
+static esp_err_t err_404(httpd_req_t *req, httpd_err_code_t err)
+{
+    (void)err;
+    httpd_resp_set_status(req, "302 Found");
+    httpd_resp_set_hdr(req, "Location", "http://AP_IP/");
+    return httpd_resp_send(req, NULL, 0);
+}
+
+/* 路径比较：**必须忽略查询串**。/p?s=xxx 的 req->uri 是 "/p?s=xxx"，用 strcmp 比 "/p" 永远不等，
+   结果点"选它"只是把列表页又发一遍（2026-10-26 我自己用 curl 抓出来的）。 */
+static bool uri_is(httpd_req_t *req, const char *path)
+{
+    const size_t n = strlen(path);
+    if (strncmp(req->uri, path, n) != 0) return false;
+    return req->uri[n] == 0 || req->uri[n] == '?';
+}
+
+/* 所有 GET 都进这里分发（IDF 默认只做精确匹配，通配要显式打开 uri_match_fn） */
+static esp_err_t h_get(httpd_req_t *req)
+{
+    if (uri_is(req, "/p")) return h_pick(req);
+    /* 其余一律**直接回配网页**（/、/index.html、/generate_204、/favicon.ico、带随机后缀的探测路径）。
+       2026-10-26 真机：探测请求回 302 → 手机跟着跳，但**那一次 GET / 根本没到设备**（两个 socket 被
+       探测连接占着），系统"登录网络"面板就白屏。按标准做法：探测请求本身就回 200 + 页面，
+       面板一次请求就能显示出内容。 */
+    return h_root(req);
+}
+
+static esp_err_t h_post(httpd_req_t *req)
+{
+    if (uri_is(req, "/c")) return h_connect_form(req);
+    return h_redirect(req);
+}
+
+static const httpd_uri_t URIS[] = {
+    { .uri = "/*", .method = HTTP_GET,  .handler = h_get },
+    { .uri = "/*", .method = HTTP_POST, .handler = h_post },
+};
+
+/* ------------------------------------------------------------------ 通配 DNS */
+static void dns_task(void *arg)
+{
+    int s = socket(AF_INET, SOCK_DGRAM, 0);
+    if (s < 0) { vTaskDelete(NULL); return; }
+    s_dns_sock = s;
+
+    struct sockaddr_in a = { 0 };
+    a.sin_family = AF_INET;
+    a.sin_port = htons(53);
+    a.sin_addr.s_addr = htonl(INADDR_ANY);
+    if (bind(s, (struct sockaddr *)&a, sizeof(a)) < 0) { close(s); s_dns_sock = -1; vTaskDelete(NULL); return; }
+
+    uint8_t buf[384];
+    while (s_dns_run) {
+        struct sockaddr_in from; socklen_t fl = sizeof(from);
+        int n = recvfrom(s, buf, sizeof(buf), 0, (struct sockaddr *)&from, &fl);
+        if (n < 17 || !s_dns_run) continue;
+        int q = 12;
+        while (q < n && buf[q] != 0) q += (buf[q] + 1);
+        q += 5;
+        if (q + 16 > (int)sizeof(buf) || q > n) continue;
+        uint8_t rsp[384];
+        memcpy(rsp, buf, (size_t)q);
+        rsp[2] = 0x81; rsp[3] = 0x80;
+        rsp[6] = 0; rsp[7] = 1;
+        rsp[8] = 0; rsp[9] = 0; rsp[10] = 0; rsp[11] = 0;
+        int p = q;
+        rsp[p++] = 0xC0; rsp[p++] = 0x0C;
+        rsp[p++] = 0x00; rsp[p++] = 0x01;
+        rsp[p++] = 0x00; rsp[p++] = 0x01;
+        rsp[p++] = 0; rsp[p++] = 0; rsp[p++] = 0; rsp[p++] = 60;
+        rsp[p++] = 0x00; rsp[p++] = 0x04;
+        rsp[p++] = 192; rsp[p++] = 168; rsp[p++] = 4; rsp[p++] = 1;
+        sendto(s, rsp, (size_t)p, 0, (struct sockaddr *)&from, fl);
+    }
+    close(s);
+    s_dns_sock = -1;
+    s_dns_task = NULL;
+    vTaskDelete(NULL);
+}
+
+/* ------------------------------------------------------------------ 起停 */
+esp_err_t wprov_http_start(void)
+{
+    if (s_srv) return ESP_OK;
+
+    httpd_config_t cfg = HTTPD_DEFAULT_CONFIG();
+    cfg.max_uri_handlers   = 12;
+    cfg.max_open_sockets   = 2;         /* 2026-10-26：2 → 3。手机打开一个页会并发开
+                                           HTML + favicon + 系统联网探测（3 条），2 条时后面的请求
+                                           直接被踢（页面看着"发完了"其实点不动/白屏）。
+                                           不敢给 4：C3 上多一个 socket ≈ 2KB 堆，给了 4 之后
+                                           二维码画布都分不出来（实测最大连续块掉到 1.5KB）。 */
+    cfg.backlog_conn       = 2;
+    cfg.recv_wait_timeout  = 3;
+    cfg.send_wait_timeout  = 10;
+    cfg.lru_purge_enable   = true;
+    cfg.stack_size         = 3072;      /* 原 6656：热点头起来后堆只剩 8KB，任务建不起来
+                                          （报 ESP_ERR_HTTPD_TASK = 手机连上热点但网页打不开，2026-10-25） */
+    cfg.server_port        = 80;
+    cfg.uri_match_fn       = httpd_uri_match_wildcard;   /* 关键：不打开通配不生效 */
+
+    esp_err_t e = httpd_start(&s_srv, &cfg);
+    if (e != ESP_OK) {
+        ESP_LOGE(TAG, "httpd 起不来: %s（空闲堆 %u，最大连续块 %u）—— 手机连上热点也打不开网页",
+                 esp_err_to_name(e),
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        s_srv = NULL;
+        return e;
+    }
+    for (size_t i = 0; i < sizeof(URIS) / sizeof(URIS[0]); i++) {
+        esp_err_t re = httpd_register_uri_handler(s_srv, &URIS[i]);
+        if (re != ESP_OK) ESP_LOGW(TAG, "注册 %s 失败: %s", URIS[i].uri, esp_err_to_name(re));
+    }
+    httpd_register_err_handler(s_srv, HTTPD_404_NOT_FOUND, err_404);
+
+    s_dns_run = true;
+    if (xTaskCreate(dns_task, "wprov_dns", 2048, NULL, 4, &s_dns_task) != pdPASS) {
+        ESP_LOGW(TAG, "DNS 任务起不来（手输 AP_IP 仍可用）");
+        s_dns_run = false;
+    }
+    /* 现读 STA 的 IP（wprov_last_ip 是"最近一次结果"，进配网页时被 clear_result 清过） */
+    char lan[20] = {0};
+    esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t ip = {0};
+    if (nf && esp_netif_get_ip_info(nf, &ip) == ESP_OK && ip.ip.addr) {
+        snprintf(lan, sizeof(lan), IPSTR, IP2STR(&ip.ip));
+    }
+    ESP_LOGI(TAG, "配网页已起：http://AP_IP/ ｜同 WiFi 直连：%s",
+             lan[0] ? lan : "（设备还没连上路由器，只能走热点）");
+    return ESP_OK;
+}
+
+void wprov_http_stop(void)
+{
+    s_dns_run = false;
+    if (s_dns_sock >= 0) shutdown(s_dns_sock, SHUT_RDWR);
+    for (int i = 0; i < 40 && s_dns_task; i++) vTaskDelay(pdMS_TO_TICKS(10));
+    if (s_srv) { httpd_stop(s_srv); s_srv = NULL; }
+    ESP_LOGI(TAG, "配网页/DNS 已停，空闲堆 %u B，最大连续块 %u B",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+}
