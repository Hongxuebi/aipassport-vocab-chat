+void demo_pet_echo_diag_start(void) { }
+#endif
diff --git a/main/demo_provision.c b/main/demo_provision.c
new file mode 100644
index 0000000..d03d8e3
--- /dev/null
+++ b/main/demo_provision.c
@@ -0,0 +1,633 @@
+// main/demo_provision.c —— 扫码配网页（SoftAP + 二维码 + 手机选网）
+//
+// 流程：起热点 → 屏上出二维码（扫了直接连热点）→ 手机弹出配网页 → 选 WiFi + 输密码
+//       → 机器先验证能连上，成功才保存凭据 → 关热点，回正常模式。
+//
+// 说明：
+//  · 中文暂不上屏（Montserrat 无中文字形，会显示方块），所以本页用英文；
+//    手机端网页是中文（浏览器有字体）。中文字库子集做好后这页再换中文。
+//  · 本页是"临时配网"，退出必须把 DNS/HTTP/AP 全停干净（见 wprov_stop）。
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include "app_config.h"      /* APP_PROV_SERIAL / PROV_DIAG 开关。漏了它 ⇒ #if 恒假，串口配网那段一直是死代码（2026-10-29 闸查出来的） */
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "esp_heap_caps.h"
+#include "esp_timer.h"
+#include "esp_system.h"
+#include "esp_log.h"
+#include "lvgl.h"
+#include "qrcodegen.h"
+
+#include "bsp_display.h"
+#include "bsp_audio.h"
+#include "demo.h"
+#include "ui_pixel.h"
+#include "wprov.h"
+#include "net_client.h"
+#include "esp_netif.h"
+
+LV_FONT_DECLARE(fusion_ui12);
+
+static const char *TAG = "prov";
+
+static lv_obj_t *s_scr, *s_qr_cv, *s_tip, *s_list, *s_state, *s_dbg;
+static lv_obj_t *s_hint;           /* 屏上常驻那行「长按▲ 清除保存的网络」（2026-10-30 作者要的） */
+static lv_obj_t *s_url;            /* 地址行（tick 里刷新：IP 通常进页之后才拿到） */
+static char      s_url_ip[20];     /* 上次显示过的 IP，避免每帧重画 */
+static lv_timer_t *s_timer;
+static uint16_t *s_qr_buf;
+static int s_qr_px;
+static volatile bool s_net_busy, s_ap_ready, s_qr_done;
+static volatile bool s_page_on;      /* 串口配网口：只在「配网」页里吃输入 */
+#if APP_PROV_SERIAL
+static bool s_serial_started;    /* 串口配网任务只建一次 */
+#endif
+static bool s_entry_connected;   /* 进页那一刻就已经连着 WiFi（不是本次配网的成果） */
+/* 2026-10-30：进页超过 9 秒还没画二维码 ⇒ 热点/网络任务没起来（十有八九是内存）。
+   原来这种情况下 tip 一直停在"正在开启热点..."，人只能干等 —— 现在把堆打到屏上。 */
+static int64_t s_tip_deadline_us;
+static bool    s_tip_dead;
+
+/* 唯一的网络任务入口：已经在跑就拒绝。
+   🔴 2026-10-25 卡死现场：▲▼ 在"没扫到网"时会当重扫用，而那条路**没有互斥**，
+   连按几下就起了多个网络任务同时 esp_wifi_scan_start/start_ap → wifi 任务占满 CPU
+   → Task watchdog（IDLE 饿死）。所有新建网络任务都必须走这里。 */
+static void prov_task_start(TaskFunction_t fn, const char *name, int prio);
+static bool s_done_shown;
+static int64_t s_done_us;
+static int  s_sel;                 /* 屏上选中的第几个 WiFi */
+static char s_ap_ssid[33], s_ap_pass[24];
+static int s_last_n = -1;
+
+/* ------------------------------------------------------------------ QR */
+#if APP_PROV_SERIAL
+/* 串口配网口（兜底，开发用）：设备插在电脑上时，发一行
+       WIFI <SSID> <密码>
+   到 USB 串口，就等于在网页里提交了一次。
+   为什么要有它：手机的"无互联网"判定会让它反复掉热点，网页那一路偶尔走不通；
+   设备反正插在电脑上，这条路是确定性的。**日志只打密码长度，不打明文。** */
+static void serial_prov_task(void *arg)
+{
+    (void)arg;
+    static char line[160];
+    for (;;) {
+        if (!s_page_on) {
+            vTaskDelay(pdMS_TO_TICKS(300));
+            continue;
+        }
+        if (!fgets(line, sizeof(line), stdin)) {
+            vTaskDelay(pdMS_TO_TICKS(200));
+            continue;
+        }
+        int n = (int)strlen(line);
+        while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r')) line[--n] = 0;
+        if (strncmp(line, "WIFI ", 5) != 0) continue;
+
+        char *p = line + 5;
+        while (*p == ' ') p++;
+        char *sp = strchr(p, ' ');
+        if (!sp) {
+            ESP_LOGW(TAG, "串口配网用法：WIFI <SSID> <密码>（收到的是：%s）", line);
+            continue;
+        }
+        *sp = 0;
+        const char *ssid = p, *pass = sp + 1;
+        ESP_LOGW(TAG, "串口配网：ssid=\"%s\" 密码长度 %d → 提交", ssid, (int)strlen(pass));
+        const esp_err_t e = wprov_request_connect(ssid, pass);
+        ESP_LOGW(TAG, "串口配网提交结果：%s", esp_err_to_name(e));
+    }
+}
+#endif
+
+/* 现读 STA 的 IP（wprov_last_ip 会被 clear_result 清掉，配网页要用"当前"的地址） */
+static void sta_ip_now(char *out, size_t n)
+{
+    out[0] = 0;
+    esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t ip;
+    if (nf && esp_netif_get_ip_info(nf, &ip) == ESP_OK && ip.ip.addr) {
+        snprintf(out, n, IPSTR, IP2STR(&ip.ip));
+    }
+}
+
+/* 地址行：热点页地址 + 同 WiFi 直连地址（IP 变了就重画） */
+static void refresh_url_label(void)
+{
+    if (!s_url) return;
+    char lan[20] = {0}, u[72];
+    sta_ip_now(lan, sizeof(lan));
+    if (lan[0]) snprintf(u, sizeof(u), "热点 AP_IP\n同 WiFi 直连 %s", lan);
+    else        snprintf(u, sizeof(u), "http://AP_IP");
+    if (strcmp(lan, s_url_ip) != 0) {
+        snprintf(s_url_ip, sizeof(s_url_ip), "%s", lan);
+        lv_label_set_text(s_url, u);
+        ESP_LOGI(TAG, "屏上地址更新：热点 AP_IP ｜同 WiFi 直连 %s", lan[0] ? lan : "（还没有 IP）");
+    }
+}
+
+static void build_qr(void)
+{
+    char text[96];
+    snprintf(text, sizeof(text), "WIFI:T:WPA;S:%s;P:%s;;", s_ap_ssid, s_ap_pass);
+
+    /* 🔴 2026-10-25 二维码出不来的真因：原来一开口就按**版本 10** 申请两块缓冲（约 7.3KB），
+       而热点+扫描之后最大连续块只剩 5.1KB → malloc 失败 → 函数静默 return，屏上一直"正在开启热点"。
+       现在按内容长度挑最小版本（45 字符的 WiFi 码，版本 4 就够，约 2.4KB），失败会打日志。 */
+    uint8_t *tmp = NULL, *qr = NULL;
+    int ver = 4;
+    for (; ver <= 10; ver += 2) {
+        tmp = malloc(qrcodegen_BUFFER_LEN_FOR_VERSION(ver));
+        qr  = malloc(qrcodegen_BUFFER_LEN_FOR_VERSION(ver));
+        if (tmp && qr) break;
+        free(tmp); free(qr); tmp = qr = NULL;
+    }
+    if (!tmp || !qr) {
+        ESP_LOGE(TAG, "二维码缓冲申请失败（空闲堆 %u，最大连续块 %u）",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        free(tmp); free(qr);
+        return;
+    }
+
+    bool ok = qrcodegen_encodeText(text, tmp, qr, qrcodegen_Ecc_LOW,
+                                   2, (uint8_t)ver, qrcodegen_Mask_AUTO, true);
+    if (!ok) ESP_LOGE(TAG, "二维码编码失败（%d 字节，版本上限 %d）", (int)strlen(text), ver);
+    int n = ok ? qrcodegen_getSize(qr) : 0;
+    if (n > 0) {
+        /* 内存账：热点头起来后最大连续块只有 ~5KB，而 66×66 的 RGB565 要 8.7KB。
+           所以**画布按 1 像素/模块存**（29×29 → 1.7KB），显示时用 lv_image_set_scale 放大 3 倍。
+           1bpp 画布试过：LVGL 这版渲染 I1 时崩（Store access fault），所以走 RGB565 + 放大。 */
+        int px = n;
+        /* 🔴 必须按 LVGL 自己的 stride 分配：29px 的 RGB565 每行是 60 字节（对齐到 4），
+           照 px*2=58 分配会让渲染越界写 → 踩坏堆 → tlsf 断言重启（2026-10-25 实测）。 */
+        const uint32_t stride = lv_draw_buf_width_to_stride((uint32_t)px, LV_COLOR_FORMAT_RGB565);
+        const size_t need = (size_t)stride * (size_t)px;
+        s_qr_buf = heap_caps_malloc(need, MALLOC_CAP_8BIT);
+        if (!s_qr_buf) {
+            ESP_LOGE(TAG, "二维码画布申请失败：需要 %u B，空闲堆 %u，最大连续块 %u",
+                     (unsigned)need, (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                     (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        } else {
+            for (int y = 0; y < px; y++) {
+                for (int x = 0; x < px; x++) {
+                    const bool on = qrcodegen_getModule(qr, x, y);
+                    const uint16_t c = on ? 0x0000 : 0xFFFF;
+                    uint8_t *dst = (uint8_t *)s_qr_buf + (size_t)y * stride + (size_t)x * 2;
+                    dst[0] = (uint8_t)(c & 0xFF);
+                    dst[1] = (uint8_t)(c >> 8);
+                }
+            }
+            if (!s_qr_cv) {
+                s_qr_cv = lv_canvas_create(s_scr);
+                lv_obj_align(s_qr_cv, LV_ALIGN_TOP_MID, 0, 58);
+                lv_obj_remove_flag(s_qr_cv, LV_OBJ_FLAG_SCROLLABLE);
+            }
+            lv_canvas_set_buffer(s_qr_cv, s_qr_buf, px, px, LV_COLOR_FORMAT_RGB565);
+            /* 放大 3 倍显示（87px）；关抗锯齿，二维码方块才不糊 */
+            lv_image_set_scale(s_qr_cv, 3 * 256);
+            lv_image_set_antialias(s_qr_cv, false);
+            s_qr_px = px * 3;
+            s_qr_done = true;
+            ESP_LOGI(TAG, "二维码 %d×%d 存/%d×%d 显示（%d 模块，stride %u，缓冲 %u B，空闲堆 %u）",
+                     px, px, px * 3, px * 3, n, (unsigned)stride, (unsigned)need,
+                     (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT));
+        }
+    }
+    free(tmp);
+    free(qr);
+}
+
+/* ------------------------------------------------------------------ 网络线程 */
+static void net_task(void *arg)
+{
+    s_net_busy = true;
+    wprov_init();
+    wprov_start_worker();
+    wprov_get_ap(s_ap_ssid, sizeof(s_ap_ssid), s_ap_pass, sizeof(s_ap_pass));
+    /* 热点起不来就别再往下打"就绪"了：状态已经是 FAILED，屏上会出失败原因。
+       原来不看返回值，堆被打死之后每轮仍显示"热点+扫描就绪"，等于骗自己。 */
+    esp_err_t ap = wprov_start_ap();
+    if (ap != ESP_OK) {
+        s_net_busy = false;
+        ESP_LOGE(TAG, "配网页：热点没起来（%s），屏上显示失败", esp_err_to_name(ap));
+        vTaskDelete(NULL);
+        return;
+    }
+    /* 扫描已经在 wprov_start_ap() 里做完了（切纯 AP 之前，那时 STA 接口还在）。
+       这里只等 tick 把二维码画出来即可 —— 反过来先画二维码会把连续块吃到 1.5KB。 */
+    s_ap_ready = true;                     /* 允许 tick 画二维码 */
+    for (int i = 0; i < 40 && !s_qr_done; i++) vTaskDelay(pdMS_TO_TICKS(100));
+    if (!s_qr_done) ESP_LOGW(TAG, "等二维码超时（4 秒）");
+    s_net_busy = false;
+    ESP_LOGI(TAG, "热点+扫描就绪，空闲堆 %u B，最大连续块 %u B",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    vTaskDelete(NULL);
+}
+
+/* ------------------------------------------------------------------ 刷新 */
+static void tick(lv_timer_t *t)
+{
+    (void)t;
+    refresh_url_label();          /* 拿到 IP 就把"同 WiFi 直连地址"补到屏上 */
+
+    /* 连上了：把 SSID + IP 摆出来，2 秒后自动回菜单（不用你按键）。
+       ⚠️ 但"进页前就压根连着"不算 —— 那种情况要留在页面上（换网用），别一闪就跳走。 */
+    if (wprov_state() == WPROV_CONNECTED && !s_entry_connected) {
+        if (!s_done_shown) {
+            char ssid[33] = {0}, ip[16] = {0}, b[128];
+            wprov_connected_ssid(ssid, sizeof(ssid));
+            wprov_last_ip(ip, sizeof(ip));
+            snprintf(b, sizeof(b), "连接成功\n%s\n地址 %s", ssid, ip);
+            if (s_list) lv_label_set_text(s_list, b);
+            if (s_state) lv_label_set_text(s_state, "2 秒后返回");
+            if (s_tip) lv_label_set_text(s_tip, "");
+            s_done_shown = true;
+            s_done_us = esp_timer_get_time();
+        } else if (esp_timer_get_time() - s_done_us > 2000000) {
+            app_demo_back();
+            return;
+        }
+    }
+    if (!s_qr_done && s_ap_ready && s_ap_ssid[0]) {
+        build_qr();
+        if (s_tip) {
+            char b[96];
+            snprintf(b, sizeof(b), "热点 %s\n密码 %s", s_ap_ssid, s_ap_pass);
+            lv_label_set_text(s_tip, b);
+        }
+    }
+
+    /* 9 秒还没二维码 ⇒ 网络任务/热点没起来（2026-10-30 实测就是内存不够）。
+       别让人对着"正在开启热点..."干等：把真实账目打到屏上，重启就有救。 */
+    if (!s_qr_done && !s_tip_dead && s_tip && s_tip_deadline_us &&
+        esp_timer_get_time() - s_tip_deadline_us > 9000000) {
+        char b[96];
+        s_tip_dead = true;
+        snprintf(b, sizeof(b), "热点没起来\n空闲 %uK 连续 %uK\n重启一下再试",
+                 (unsigned)(esp_get_free_heap_size() / 1024),
+                 (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_8BIT) / 1024));
+        lv_label_set_text(s_tip, b);
+        ESP_LOGE(TAG, "进页 9 秒还没二维码：空闲堆 %u 最大块 %u（多半是内存不够起 AP/httpd）",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    }
+    if (!s_state) return;
+    if (s_done_shown) return;                 /* 成功页已摆好，等自动返回，别再覆盖 */
+
+    wprov_state_t s = wprov_state();
+    /* 「长按▲ 清除保存的网络」这行：失败页要占 7 行（234..318），会让位；
+       其余时候常驻（进页就能看见，不用猜）。 */
+    if (s_hint) {
+        if (wprov_fail_locked() || s == WPROV_FAILED) lv_obj_add_flag(s_hint, LV_OBJ_FLAG_HIDDEN);
+        else                                          lv_obj_clear_flag(s_hint, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (wprov_fail_locked()) {
+        char b[128];
+        snprintf(b, sizeof(b), "已连续失败 %d 次", wprov_fail_streak());
+        if (s_list) lv_label_set_text(s_list, b);
+        lv_label_set_text(s_state, "按确定重试");
+        return;
+    }
+    if (s == WPROV_FAILED) {
+        char ssid[33] = {0}, b[160];
+        wprov_last_ssid(ssid, sizeof(ssid));
+        snprintf(b, sizeof(b),
+                 "FAILED\n\n%s\nreason=%d\n\nHotspot is back.\nReopen AP_IP",
+                 ssid, wprov_last_reason());
+        lv_label_set_text(s_state, b);
+        if (s_list) lv_label_set_text(s_list, "");
+        return;
+    }
+    switch (s) {
+    case WPROV_AP_UP:      lv_label_set_text(s_state, "热点已就绪"); break;
+    case WPROV_SCANNING:   lv_label_set_text(s_state, "正在扫描");   break;
+    case WPROV_CONNECTING: lv_label_set_text(s_state, "正在连接");   break;
+    case WPROV_CONNECTED:  lv_label_set_text(s_state, "已连上");     break;
+    case WPROV_FAILED:     lv_label_set_text(s_state, "连接失败");   break;
+    default:               lv_label_set_text(s_state, "空闲");       break;
+    }
+
+    if (s_dbg) {
+        char d[80];
+        snprintf(d, sizeof(d), "空闲 %uK 连续 %uK",
+                 (unsigned)(esp_get_free_heap_size() / 1024),
+                 (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_8BIT) / 1024));
+        lv_label_set_text(s_dbg, d);
+    }
+
+    /* 扫到的 WiFi 列表（▶ = 当前选中，● 直连；▲▼ 换） */
+    int n = wprov_ap_count();
+    if (n != s_last_n && s_list) {
+        s_last_n = n;
+        if (s_sel >= n) s_sel = 0;
+        char b[352];
+        int off = 0;
+        off += snprintf(b + off, sizeof(b) - off, "附近 %d 个   上下选   确定连\n", n);
+        for (int i = 0; i < n && i < 5 && off < (int)sizeof(b) - 40; i++) {
+            off += snprintf(b + off, sizeof(b) - off, "%s%-15.15s %d\n",
+                            i == s_sel ? "> " : "  ", wprov_ap_list()[i].ssid,
+                            wprov_ap_list()[i].rssi);
+        }
+        lv_label_set_text(s_list, b);
+    }
+}
+
+/* ------------------------------------------------------------------ 生命周期 */
+void demo_provision_enter(void)
+{
+    /* 进页前先记住"是不是本来就连着"：本来就连着的话，本页不该 2 秒自动跳回菜单
+       （用户进来是为了换网，二维码得留在屏幕上） */
+    /* 先把联网用的 16KB 收包缓冲还回堆：热点起来后要分二维码画布(1.7KB)、DNS/httpd 栈、
+       以及**手机加入时 wifi 驱动要的缓冲**（2026-10-26 真机：堆只剩 2.4KB 时手机一连上就被 deauth reason=1） */
+    net_client_release_rx();
+    /* 2026-10-30：配网页是全机最费内存的一页（扫描 + AP + httpd + 二维码 ≈ 20KB），
+       而语音那套（codec 对象 + 编解码句柄）在配网期间一点用不上 —— 先收起来，
+       出页再叫醒（bsp_audio_wake 会重新 open codec）。这是补"httpd 任务栈差 1~2KB"的口子。 */
+    bsp_audio_sleep();
+    s_entry_connected = (wprov_state() == WPROV_CONNECTED);
+    wprov_clear_result();          /* 不清的话上一轮的 CONNECTED 会让本页 2 秒后自动跳走 */
+    wprov_reset_fail();
+    s_tip_deadline_us = esp_timer_get_time();
+    s_tip_dead = false;
+    s_sel = 0;
+    s_done_shown = false;
+    s_qr_done = false;
+    s_ap_ready = false;
+    s_last_n = -1;
+
+    s_scr = ui_pixel_screen_create("配网");
+
+    /* 二维码下方：热点名/口令（14px，两行） */
+    s_tip = lv_label_create(s_scr);
+    lv_obj_set_width(s_tip, 220);
+    lv_obj_set_style_text_align(s_tip, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(s_tip, &fusion_ui12, 0);
+    lv_obj_set_style_text_color(s_tip, lv_color_hex(UI_CY_DIM), 0);   /* 深色底：用青色，别再用深蓝 */
+    lv_obj_align(s_tip, LV_ALIGN_TOP_MID, 0, 140);
+    lv_label_set_text(s_tip, "正在开启热点...");
+
+    /* 网址一行（14px）—— 内容会在 tick 里随 IP 变化刷新 */
+    lv_obj_t *url = lv_label_create(s_scr);
+    s_url = url;
+    s_url_ip[0] = 0;
+    lv_obj_set_style_text_font(url, &fusion_ui12, 0);
+    lv_obj_set_style_text_color(url, lv_color_hex(UI_SC_INK), 0);
+    lv_obj_align(url, LV_ALIGN_TOP_MID, 0, 178);
+    {
+        /* 两条路都写上：连了热点就用 AP_IP；手机和机器**在同一个 WiFi** 时直接开 LAN 地址
+           （2026-10-26：手机加热点会失败，这条同 WiFi 的直连更可靠） */
+        char lan[20] = {0}, u[64];
+        sta_ip_now(lan, sizeof(lan));
+        if (lan[0]) snprintf(u, sizeof(u), "热点页 AP_IP\n同 WiFi 直连 %s", lan);
+        else        snprintf(u, sizeof(u), "http://AP_IP");
+        lv_label_set_text(url, u);
+    }
+
+    /* 主区域：WiFi 列表 / 失败原因 都在这里（14px，5 行 ≈ 85px） */
+    s_list = lv_label_create(s_scr);
+    lv_obj_set_width(s_list, 224);
+    lv_obj_set_style_text_font(s_list, &fusion_ui12, 0);
+    lv_obj_set_style_text_color(s_list, lv_color_hex(UI_SC_INK), 0);
+    lv_obj_align(s_list, LV_ALIGN_TOP_MID, 0, 198);
+    lv_label_set_text(s_list, "正在扫描附近网络...");
+
+    /* 2026-10-30 作者：「配网里没有简单介绍可以长按上键清除所有网络，我需要能看见」。
+       这个操作 2026-10-25 就做了，但一直只写在代码和文档里 —— 现在常驻在列表下面一行。
+       版面：列表 198..270（头一行 + 5 个热点，12px 行高），这行 271..284，发丝线在 286，不打架。
+       失败页要占 7 行（234..318），所以 tick 里失败/封顶时把这一行藏起来让位。 */
+    s_hint = lv_label_create(s_scr);
+    lv_obj_set_size(s_hint, 224, 13);                 /* N11：中文标签必须给固定 w/h */
+    lv_obj_set_style_text_align(s_hint, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(s_hint, &fusion_ui12, 0);
+    lv_obj_set_style_text_color(s_hint, lv_color_hex(UI_CY_DIM), 0);
+    lv_obj_align(s_hint, LV_ALIGN_TOP_MID, 0, 271);
+    lv_label_set_text(s_hint, "长按▲ 清除保存的网络");
+
+    /* 底部一行状态 */
+    s_state = lv_label_create(s_scr);
+    lv_obj_set_width(s_state, 224);
+    lv_obj_set_style_text_align(s_state, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(s_state, &fusion_ui12, 0);
+    lv_obj_set_style_text_color(s_state, lv_color_hex(UI_SC_INK), 0);
+    lv_obj_align(s_state, LV_ALIGN_BOTTOM_MID, 0, -2);
+    lv_label_set_text(s_state, "启动中");
+
+    lv_screen_load(s_scr);
+    s_timer = lv_timer_create(tick, 500, NULL);
+
+    /* 先占住 s_net_busy 再建任务：不然连按两下会起两个网络线程，两个都在动同一套 WiFi */
+    ESP_LOGI(TAG, "配网页 enter 完成（堆 %u B / 最大块 %u B），准备起网络任务",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    prov_task_start(net_task, "prov_net", 4);
+
+#if APP_PROV_SERIAL
+    /* 串口配网口**必须建在网络任务之后**：2026-10-30 配网救援实测，进页时最大连续块
+       只有 6.4KB —— 先建 3072B 的串口任务，6144B 的网络任务就分不到内存，热点根本起不来
+       （那正好是作者看到的"一直正在开启热点"）。先让网络任务拿到它要的那块，串口口晚 1 秒开，
+       人来得及；网络任务就算没起来，串口这条路也还在。 */
+    s_page_on = true;
+    if (!s_serial_started) {
+        s_serial_started = true;
+        if (xTaskCreate(serial_prov_task, "prov_serial", 3072, NULL, 2, NULL) != pdPASS) {
+            ESP_LOGW(TAG, "串口配网任务起不来（堆紧）—— 只能用网页配网");
+        } else {
+            ESP_LOGW(TAG, "串口配网口已开：发一行 `WIFI <SSID> <密码>` 到串口也能连");
+        }
+    }
+#endif
+}
+
+static void reconnect_task(void *arg)
+{
+    (void)arg;
+    wprov_autoconnect();
+    s_net_busy = false;
+    vTaskDelete(NULL);
+}
+
+void demo_provision_exit(void)
+{
+    /* 已经连上了就别再拆网重连（那是刚配好的连接，拆了要多等 1-2 秒） */
+    bool was_connected = (wprov_state() == WPROV_CONNECTED);
+    if (s_timer) { lv_timer_delete(s_timer); s_timer = NULL; }
+    if (!was_connected) wprov_stop();
+    if (s_qr_buf) { heap_caps_free(s_qr_buf); s_qr_buf = NULL; }
+    /* 2026-10-26 加：把配网页借走的 16KB 收包缓冲回填（进来时 release 掉的）。
+       不回填，出页后的第一次补传要现场 malloc，多半失败 —— 作者会看到"待传 N 一直不减"。 */
+    net_client_reserve_rx();
+    bsp_audio_wake();          /* 配网期间收起来的 codec 叫醒（见 enter） */
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; }
+    s_qr_cv = NULL;
+    s_tip = s_list = s_state = s_dbg = NULL;
+    s_hint = NULL;
+    s_qr_done = false;
+    s_ap_ready = false;
+    s_done_shown = false;
+    s_page_on = false;             /* 离开本页就不再吃串口输入 */
+    /* 只有在没有别的网络线程在跑时才去自动重连。
+       否则"退出即重连"会和下一轮的开页抢同一套 WiFi/堆：
+       真机 20 轮实测出现过页内空闲堆被压到 14.9KB（一次扫描都够呛）。
+       用 s_net_busy 这个已有的开关互斥，不新增机制。 */
+    if (!was_connected) prov_task_start(reconnect_task, "prov_reconnect", 3);
+
+    /* 配网启动模式（设置→配网 触发的那次重启）：这一页使命完成，清标记重启回正常模式。
+       **成功**（tick 里 2 秒后自动退页）和**放弃**（长按 ●）都走这里 —— 不重启的话
+       这台就停在"没有音频"的状态，作者会以为机器坏了。 */
+    if (app_prov_boot_pending()) {
+        app_prov_boot_request(false);
+        ESP_LOGW(TAG, "配网页退出：清配网标记，重启回正常模式");
+        vTaskDelay(pdMS_TO_TICKS(250));
+        esp_restart();
+    }
+}
+
+/* 压测（临时开关 APP_PROV_STRESS）：进配网页 → 连按 ▲▼ 30 次 → 看会不会再卡死。
+   这就是 2026-10-25 那次看门狗的复现场景（多个网络任务并发抢 WiFi）。 */
+static void prov_stress_fn(void *arg)
+{
+    (void)arg;
+    vTaskDelay(pdMS_TO_TICKS(2500));
+    /* 菜单里"配网"是第 8 项（下标 7）：往下按 7 次再确定 */
+    for (int i = 0; i < 8; i++) {      /* 菜单第 9 项 = 配网（前面有"背单词"占位） */
+        app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(250));   /* 120ms 会被输入队列丢掉（深度只有 8） */
+    }
+    vTaskDelay(pdMS_TO_TICKS(300));
+    app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);
+    vTaskDelay(pdMS_TO_TICKS(1500));
+    ESP_LOGW(TAG, "STRESS 连按 ▲▼ 30 次（每次间隔 60ms，模拟手抖狂按）");
+    for (int i = 0; i < 30; i++) {
+        app_sim_key((i & 1) ? BSP_BTN_UP : BSP_BTN_DOWN, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(60));
+    }
+    vTaskDelay(pdMS_TO_TICKS(20000));       /* 等 20 秒看在不在转圈/看门狗 */
+    ESP_LOGW(TAG, "STRESS 结束：20 秒内没崩就算通过");
+    vTaskDelete(NULL);
+}
+
+/* 诊断（临时开关 APP_PROV_DIAG）：进配网页，每秒打一次关键状态。
+   2026-10-28 改：主页/菜单结构变了，不再靠数 ▼ 次数，直接按名字找页面下标。 */
+static void prov_diag_fn(void *arg)
+{
+    (void)arg;
+    vTaskDelay(pdMS_TO_TICKS(9000));   /* 开机动画 4.5s + 主页起来 + 输入任务就绪，再按 */
+    ESP_LOGW(TAG, "DIAG 走真实路径：主页 ▼▼▼ → ● 进设置 → ● 第一项「配网」");
+    app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(250));
+    app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(250));
+    app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(250));
+    app_sim_key(BSP_BTN_OK,   BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(1200));
+    app_sim_key(BSP_BTN_OK,   BSP_BTN_CLICK); vTaskDelay(pdMS_TO_TICKS(800));
+
+    for (int i = 0; i < 10; i++) {
+        vTaskDelay(pdMS_TO_TICKS(1000));
+        ESP_LOGW(TAG, "DIAG t=%ds: net_busy=%d ap_ready=%d qr_done=%d state=%d(4=AP_UP) 已扫=%d ssid=%s 空闲堆=%u 最大块=%u",
+                 i + 1, (int)s_net_busy, (int)s_ap_ready, (int)s_qr_done,
+                 (int)wprov_state(), wprov_ap_count(), s_ap_ssid[0] ? s_ap_ssid : "(空)",
+                 (unsigned)(esp_get_free_heap_size() / 1024),
+                 (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_8BIT)));
+    }
+    vTaskDelete(NULL);
+}
+
+void prov_diag_start(void) { xTaskCreate(prov_diag_fn, "prov_diag", 6144, NULL, 2, NULL); }
+
+void prov_stress_test(void)
+{
+    xTaskCreate(prov_stress_fn, "prov_stress", 6144, NULL, 2, NULL);
+}
+
+static void prov_task_start(TaskFunction_t fn, const char *name, int prio)
+{
+    if (s_net_busy) {
+        ESP_LOGW(TAG, "网络任务已在跑，忽略这次启动（%s）", name);
+        return;
+    }
+    s_net_busy = true;
+    /* 🔴 2026-10-30 第二次进配网页的真身（作者报"一直正在开启热点"）：
+       退过一次再进来，wifi 驱动留下碎片，最大连续块只剩 5,632 B ⇒ 6144 的栈建不起来
+       ⇒ 热点/扫描全部不动，屏上永远停在那一句。按档位往下退，能建起来就先干活：
+       prov_net 实际栈用量不到 2KB（ESP_LOG + wifi 几个配置结构体），4096 够用；
+       真到 4096 都建不起来，说明已经不是"少一点"而是彻底没内存了，如实报错。 */
+    static const uint32_t kStacks[] = { 6144, 5120, 4608, 4096 };
+    for (size_t i = 0; i < sizeof(kStacks) / sizeof(kStacks[0]); i++) {
+        if (xTaskCreate(fn, name, kStacks[i], NULL, (UBaseType_t)prio, NULL) == pdPASS) {
+            if (i) ESP_LOGW(TAG, "网络任务 %s 降栈到 %uB 才起来（最大块紧张）",
+                            name, (unsigned)kStacks[i]);
+            ESP_LOGI(TAG, "网络任务已启动：%s（%uB 栈，空闲 %u 最大块 %u）", name,
+                     (unsigned)kStacks[i],
+                     (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                     (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+            return;
+        }
+    }
+    s_net_busy = false;
+    ESP_LOGE(TAG, "网络任务起不来：%s（堆 %u B，最大块 %u B，连 4096B 栈都分不到）", name,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+}
+
+void demo_provision_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    /* 长按 ▲ = 清除所有已保存的网络（换网/改密码时的唯一入口；原来只能刷机，2026-10-25 补） */
+    if (ev == BSP_BTN_LONG && btn == BSP_BTN_UP) {
+        esp_err_t r = wprov_forget_all();
+        ESP_LOGW(TAG, "长按▲清除已保存网络：%s（现在共记住 %d 个）",
+                 esp_err_to_name(r), wprov_saved_count());
+        if (s_list)  lv_label_set_text(s_list, "已清除保存的网络");
+        if (s_state) lv_label_set_text(s_state, "请重新选择");
+        s_last_n = -1;
+        return;
+    }
+    if (ev != BSP_BTN_CLICK) return;
+
+    int n = wprov_ap_count();
+    int shown = n > 5 ? 5 : n;
+
+    if (btn == BSP_BTN_UP || btn == BSP_BTN_DOWN) {
+        if (shown == 0) {                                  /* 没扫到：▲▼ 当重扫用 */
+            if (s_ap_ready && !wprov_fail_locked())
+                prov_task_start(net_task, "prov_scan", 4);
+            return;
+        }
+        s_sel += (btn == BSP_BTN_UP) ? -1 : 1;
+        if (s_sel < 0) s_sel = shown - 1;
+        if (s_sel >= shown) s_sel = 0;
+        s_last_n = -1;                                     /* 强制重画 */
+        return;
+    }
+
+    if (btn != BSP_BTN_OK) return;
+
+    /* ●：封顶先解封；否则连当前选中的那个网 */
+    if (wprov_fail_locked()) {
+        wprov_reset_fail();
+        s_last_n = -1;
+        return;
+    }
+    if (shown == 0) {
+        if (s_ap_ready) prov_task_start(net_task, "prov_scan", 4);
+        return;
+    }
+
+    const wprov_ap_t *l = wprov_ap_list();
+    char pass[65] = {0};
+    esp_err_t r = wprov_find_saved(l[s_sel].ssid, pass, sizeof(pass));
+    if (r == ESP_OK) {
+        ESP_LOGI(TAG, "屏上直连 %s（用保存的密码）", l[s_sel].ssid);
+        wprov_request_connect(l[s_sel].ssid, pass);
+    } else if (!l[s_sel].secure) {
+        ESP_LOGI(TAG, "屏上直连 %s（开放网络）", l[s_sel].ssid);
+        wprov_request_connect(l[s_sel].ssid, "");
+    } else {
+        ESP_LOGW(TAG, "%s 没存过密码，得用手机页", l[s_sel].ssid);
+        if (bsp_lvgl_lock(200)) {
+            if (s_state) lv_label_set_text(s_state, "没有保存的密码 请用手机网页");
+            bsp_lvgl_unlock();
+        }
+    }
+}
