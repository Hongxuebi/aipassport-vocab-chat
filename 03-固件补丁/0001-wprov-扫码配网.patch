+void demo_diary_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    if (ev != BSP_BTN_CLICK) return;
+    ESP_LOGI(TAG, "按键 btn=%d（屏 %d/%d）", (int)btn, s_cur + 1, s_nscr);
+    if (btn == BSP_BTN_OK) {
+        app_demo_back();
+        return;
+    }
+    int delta = 0;
+    if (btn == BSP_BTN_DOWN) delta = 1;
+    else if (btn == BSP_BTN_UP) delta = -1;
+    else return;
+    if (s_nscr <= 0) return;
+
+    const int want = s_cur + delta;
+    if (want < 0 || want >= s_nscr) return;
+    s_cur = want;
+    if (bsp_lvgl_lock(300)) {
+        paint_locked();
+        bsp_lvgl_unlock();
+    }
+    ESP_LOGI(TAG, "翻到第 %d/%d 屏（%s 第 %d/%d 页）", s_cur + 1, s_nscr,
+             s_day[s_scr_day[s_cur]], s_scr_page[s_cur], s_scr_pages[s_cur]);
+}
