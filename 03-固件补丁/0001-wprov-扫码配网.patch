new file mode 100644
index 0000000..011489d
--- /dev/null
+++ b/components/evlog/esp/evlog_esp.c
@@ -0,0 +1,118 @@
+// components/evlog/esp/evlog_esp.c —— EVLOG 的真机后端
+//
+// 只做"接线"：所有序号/环形/断头/水位的逻辑都在 evlog.c 里（host 测了 1722 项）。
+// 真机比 host 多三件事：① Flash 走 esp_partition（带基址偏移）② 水位进 NVS
+// ③ 一把 FreeRTOS 互斥锁 —— 写事件在 LVGL 任务里、补传在后台任务里，两边会撞。
+#include <string.h>
+
+#include "esp_log.h"
+#include "esp_partition.h"
+#include "nvs.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+
+#include "evlog.h"
+#include "evlog_esp.h"
+
+static const char *TAG = "evlog";
+static const esp_partition_t *s_part;
+static SemaphoreHandle_t s_mtx;
+
+static const uint32_t s_span = EVLOG_ESP_SECTORS * EVLOG_SECTOR;   /* 128KB */
+
+static int e_read(void *ctx, uint32_t off, void *buf, size_t len)
+{
+    (void)ctx;
+    if (!s_part || off + len > s_span) return -1;
+    return esp_partition_read(s_part, EVLOG_ESP_BASE + off, buf, len) == ESP_OK ? 0 : -1;
+}
+
+static int e_write(void *ctx, uint32_t off, const void *buf, size_t len)
+{
+    (void)ctx;
+    if (!s_part || off + len > s_span) return -1;
+    /* 只写不擦：evlog.c 的顺序是"擦整区 → 写头 → 追加"，擦由 e_erase 单独做 */
+    return esp_partition_write(s_part, EVLOG_ESP_BASE + off, buf, len) == ESP_OK ? 0 : -1;
+}
+
+static int e_erase(void *ctx, uint32_t off, size_t len)
+{
+    (void)ctx;
+    if (!s_part || off + len > s_span) return -1;
+    return esp_partition_erase_range(s_part, EVLOG_ESP_BASE + off, len) == ESP_OK ? 0 : -1;
+}
+
+/* ---------------------------------------------------------------- 水位（NVS） */
+#define NVS_NS   "evlog"
+#define NVS_KEY  "ack"
+
+static int e_ack_read(void *ctx, uint32_t *ack)
+{
+    (void)ctx;
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) return -1;
+    const esp_err_t r = nvs_get_u32(h, NVS_KEY, ack);
+    nvs_close(h);
+    return r == ESP_OK ? 0 : -1;
+}
+
+static int e_ack_write(void *ctx, uint32_t ack)
+{
+    (void)ctx;
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return -1;
+    esp_err_t r = nvs_set_u32(h, NVS_KEY, ack);
+    if (r == ESP_OK) r = nvs_commit(h);
+    nvs_close(h);
+    return r == ESP_OK ? 0 : -1;
+}
+
+/* ---------------------------------------------------------------- 互斥 */
+static void e_lock(void *ctx)
+{
+    (void)ctx;
+    if (s_mtx) xSemaphoreTake(s_mtx, portMAX_DELAY);
+}
+
+static void e_unlock(void *ctx)
+{
+    (void)ctx;
+    if (s_mtx) xSemaphoreGive(s_mtx);
+}
+
+/* ---------------------------------------------------------------- 对外 */
+evlog_err_t evlog_esp_mount(void)
+{
+    s_part = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "storage");
+    if (!s_part) {
+        ESP_LOGE(TAG, "找不到 storage 分区（分区表没刷？）");
+        return EVLOG_ERR_IO;
+    }
+    if (s_part->size < EVLOG_ESP_BASE + s_span) {
+        ESP_LOGE(TAG, "storage 分区太小：%u B（事件日志要到 %u B）",
+                 (unsigned)s_part->size, (unsigned)(EVLOG_ESP_BASE + s_span));
+        return EVLOG_ERR_NOSPACE;
+    }
+    if (!s_mtx) {
+        s_mtx = xSemaphoreCreateMutex();
+        if (!s_mtx) ESP_LOGW(TAG, "互斥锁创建失败：写事件与补传可能撞车");
+    }
+
+    evlog_io_t io = {
+        .ctx = NULL,
+        .sectors = EVLOG_ESP_SECTORS,
+        .read = e_read, .write = e_write, .erase = e_erase,
+        .ack_read = e_ack_read, .ack_write = e_ack_write,
+        .lock = e_lock, .unlock = e_unlock,
+    };
+    const evlog_err_t err = evlog_mount(&io);
+    if (err == EVLOG_OK) {
+        ESP_LOGI(TAG, "事件日志就绪：seq %u..%u（待传 %u）｜已确认 %u｜容量 %u 条｜被覆盖 %u 条",
+                 (unsigned)evlog_oldest(), (unsigned)(evlog_head() - 1),
+                 (unsigned)evlog_pending(), (unsigned)evlog_ack(),
+                 (unsigned)evlog_capacity(), (unsigned)evlog_dropped());
+    } else {
+        ESP_LOGE(TAG, "事件日志挂载失败：%s", evlog_err_str(err));
+    }
+    return err;
+}
diff --git a/components/evlog/evlog.c b/components/evlog/evlog.c
new file mode 100644
index 0000000..4693e9d
--- /dev/null
+++ b/components/evlog/evlog.c
@@ -0,0 +1,372 @@
+// components/evlog/evlog.c —— EVLOG 的纯逻辑实现（host 测试与真机共用同一份）
+//
+// 布局：
+//   扇区 4096B = 头 16B + 255 条 × 16B
+//   头：magic 'ELG1' | ver | rsv | sector_seq(u16) | first_seq(u32) | crc32(前 12B)
+//   记录：card_id(u16) grade(u8) flags(u8) rt_ms(u16) day(u16) t_ms(u32) | crc32(前 12B)
+//
+// 三个关键不变式（host 测试逐条验）：
+//   I1  seq 单调：s_head 只增不减；扇区头的 first_seq = 该区第一条的 seq
+//   I2  断头即止：CRC 不对/乱码 ⇒ 那是条写坏的尾巴，本区到此为止，后面一律不读
+//   I3  覆盖先擦再写：轮转时先擦最旧的区、写头成功后才往里追加（头写失败就不追加）
+#include <string.h>
+
+#include "evlog.h"
+
+#define EVLOG_MAGIC   0x31474C45u   /* "ELG1"（小端） */
+#define EVLOG_VER     2u
+#define ALL_FF(v)     ((v) == 0xFFu)
+
+typedef struct {
+    bool     valid;
+    uint16_t gen;        /* 该扇区的代数（每轮转 +1，16 位回绕） */
+    uint32_t first;      /* 该扇区第一条记录的 seq */
+} hdr_t;
+
+static evlog_io_t s_io;
+static bool       s_mounted;
+static hdr_t      s_hdr[EVLOG_MAX_SECTORS];
+static uint32_t   s_cur;        /* 当前写扇区下标 */
+static uint16_t   s_cur_gen;    /* 当前写扇区的代数 */
+static uint32_t   s_used;       /* 当前扇区有效条数 0..255 */
+static uint32_t   s_head;       /* 下一条要分配的 seq（从 1 起） */
+static bool       s_writable;   /* 当前扇区还能追加？断头/写满时为 false */
+static uint32_t   s_ack;        /* 已上传水位 */
+
+/* ---------------------------------------------------------------- 小工具 */
+static uint32_t crc32_calc(const uint8_t *p, size_t n)
+{
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < n; i++) {
+        crc ^= p[i];
+        for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(crc & 1)));
+    }
+    return ~crc;
+}
+
+static uint16_t get_u16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+static uint32_t get_u32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static void put_u16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static void put_u32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t sec_off(uint32_t i) { return i * EVLOG_SECTOR; }
+static uint32_t rec_off(uint32_t i, uint32_t slot) { return sec_off(i) + EVLOG_HDR + slot * EVLOG_REC; }
+
+static bool all_ff(const uint8_t *p, size_t n)
+{
+    for (size_t i = 0; i < n; i++) if (!ALL_FF(p[i])) return false;
+    return true;
+}
+
+/* ---------------------------------------------------------------- 扇区头 */
+/* 返回 0 = 有效；-1 = 读失败；-2 = 无效（magic/版本/CRC/首序号不对） */
+static int hdr_load(uint32_t i, uint16_t *gen, uint32_t *first)
+{
+    uint8_t h[EVLOG_HDR];
+    if (s_io.read(s_io.ctx, sec_off(i), h, sizeof(h)) != 0) return -1;
+    if (get_u32(h) != EVLOG_MAGIC || h[4] != EVLOG_VER) return -2;
+    if (get_u32(h + 12) != crc32_calc(h, 12)) return -2;
+    const uint32_t f = get_u32(h + 8);
+    if (f == 0) return -2;
+    *gen = get_u16(h + 6);
+    *first = f;
+    return 0;
+}
+
+static int hdr_store(uint32_t i, uint16_t gen, uint32_t first)
+{
+    uint8_t h[EVLOG_HDR];
+    memset(h, 0, sizeof(h));
+    put_u32(h, EVLOG_MAGIC);
+    h[4] = (uint8_t)EVLOG_VER;
+    put_u16(h + 6, gen);
+    put_u32(h + 8, first);
+    put_u32(h + 12, crc32_calc(h, 12));
+    if (s_io.write(s_io.ctx, sec_off(i), h, sizeof(h)) != 0) return -1;
+    uint8_t back[EVLOG_HDR];                    /* 回读：抓"写进去了但内容不对" */
+    if (s_io.read(s_io.ctx, sec_off(i), back, sizeof(back)) != 0) return -1;
+    return memcmp(h, back, sizeof(h)) == 0 ? 0 : -1;
+}
+
+/* ---------------------------------------------------------------- 记录 */
+static int rec_load(uint32_t sector, uint32_t slot, evlog_rec_t *out)
+{
+    uint8_t b[EVLOG_REC];
+    if (s_io.read(s_io.ctx, rec_off(sector, slot), b, sizeof(b)) != 0) return -1;
+    if (all_ff(b, sizeof(b))) return -3;                       /* 空白槽 */
+    if (get_u32(b + 16) != crc32_calc(b, 16)) return -3;       /* 坏/写了一半 */
+    const uint8_t grade = b[2];
+    if (grade < 1 || grade > 4) return -4;                     /* CRC 对但字段不合逻辑 */
+    if (out) {
+        out->card_id = get_u16(b);
+        out->grade   = grade;
+        out->flags   = b[3];
+        out->rt_ms   = get_u16(b + 4);
+        out->flip_ms = get_u16(b + 6);
+        out->day     = get_u16(b + 8);
+        out->t_ms    = get_u32(b + 10);
+    }
+    return 0;
+}
+
+static void rec_encode(const evlog_rec_t *r, uint8_t b[EVLOG_REC])
+{
+    memset(b, 0, EVLOG_REC);
+    put_u16(b, r->card_id);
+    b[2] = r->grade;
+    b[3] = r->flags;
+    put_u16(b + 4, r->rt_ms);
+    put_u16(b + 6, r->flip_ms);
+    put_u16(b + 8, r->day);
+    put_u32(b + 10, r->t_ms);
+    put_u32(b + 16, crc32_calc(b, 16));
+}
+
+/* ---------------------------------------------------------------- 轮转 */
+/* 擦掉"下一个"扇区（环里最旧的一代）→ 写头 → 游标移过去。
+   头写失败就不当它是新扇区：下一次追加会再试再下一个（宁可多丢一代，不写脏区）。 */
+static evlog_err_t rotate(void)
+{
+    if (s_io.sectors < 2) return EVLOG_ERR_NOSPACE;
+    const uint32_t next = (s_cur + 1) % s_io.sectors;
+    const uint16_t gen = (uint16_t)(s_cur_gen + 1);
+    const uint32_t first = s_head;
+
+    s_hdr[next].valid = false;
+    if (s_io.erase(s_io.ctx, sec_off(next), EVLOG_SECTOR) != 0) return EVLOG_ERR_IO;
+    if (hdr_store(next, gen, first) != 0) return EVLOG_ERR_IO;
+
+    s_hdr[next].valid = true;
+    s_hdr[next].gen = gen;
+    s_hdr[next].first = first;
+    s_cur = next;
+    s_cur_gen = gen;
+    s_used = 0;
+    s_writable = true;
+    return EVLOG_OK;
+}
+
+/* ---------------------------------------------------------------- 生命周期 */
+evlog_err_t evlog_mount(evlog_io_t *io)
+{
+    if (!io || !io->read || !io->write || !io->erase) return EVLOG_ERR_PARAM;
+    if (io->sectors == 0 || io->sectors > EVLOG_MAX_SECTORS) return EVLOG_ERR_PARAM;
+
+    evlog_unmount();
+    s_io = *io;
+    s_mounted = true;
+    memset(s_hdr, 0, sizeof(s_hdr));
+    s_cur = 0; s_cur_gen = 0; s_used = 0; s_head = 1; s_writable = false; s_ack = 0;
+
+    /* ① 先读水位：万一盘被擦过，seq 从 ack+1 起，**不与服务端机见过的序号撞车** */
+    if (s_io.ack_read) {
+        uint32_t a = 0;
+        if (s_io.ack_read(s_io.ctx, &a) == 0) s_ack = a;
+    }
+
+    /* ② 扫扇区头，找最新一代（代数用 16 位差值比较，抗回绕） */
+    bool any = false;
+    uint32_t best = 0;
+    uint16_t best_gen = 0;
+    for (uint32_t i = 0; i < s_io.sectors; i++) {
+        uint16_t gen = 0; uint32_t first = 0;
+        if (hdr_load(i, &gen, &first) != 0) continue;
+        s_hdr[i].valid = true;
+        s_hdr[i].gen = gen;
+        s_hdr[i].first = first;
+        if (!any || (int16_t)(gen - best_gen) > 0) { any = true; best = i; best_gen = gen; }
+    }
+
+    if (!any) {
+        /* 全新 / 全坏：格式化 0 号扇区，seq 从 ack+1 起 */
+        const uint32_t first = s_ack + 1;
+        if (s_io.erase(s_io.ctx, 0, EVLOG_SECTOR) != 0) { s_mounted = false; return EVLOG_ERR_IO; }
+        if (hdr_store(0, 1, first) != 0) { s_mounted = false; return EVLOG_ERR_IO; }
+        s_hdr[0].valid = true; s_hdr[0].gen = 1; s_hdr[0].first = first;
+        s_cur = 0; s_cur_gen = 1; s_used = 0; s_head = first;
+        s_writable = true;
+        return EVLOG_OK;
+    }
+
+    /* ③ 数出最新扇区的有效条数（遇到断头就停） */
+    s_cur = best;
+    s_cur_gen = best_gen;
+    uint32_t used = 0;
+    while (used < EVLOG_PER_SECTOR) {
+        if (rec_load(best, used, NULL) != 0) break;
+        used++;
+    }
+    s_used = used;
+    s_head = s_hdr[best].first + used;
+
+    /* ④ 能不能接着追加：满了不行；尾巴槽不是全 FF（写坏一半）也不行 */
+    s_writable = false;
+    if (used < EVLOG_PER_SECTOR) {
+        uint8_t b[EVLOG_REC];
+        const bool ok = (s_io.read(s_io.ctx, rec_off(best, used), b, sizeof(b)) == 0);
+        s_writable = ok && all_ff(b, sizeof(b));
+    }
+
+    /* ⑤ 盘比水位旧（比如换过 flash / 重刷了数据区）：序号接着水位走，绝不回头 */
+    if (s_head <= s_ack) { s_head = s_ack + 1; s_writable = false; }
+    return EVLOG_OK;
+}
+
+void evlog_unmount(void)
+{
+    s_mounted = false;
+}
+
+/* ---------------------------------------------------------------- 写 */
+evlog_err_t evlog_append(const evlog_rec_t *r, uint32_t *seq_out)
+{
+    if (!s_mounted) return EVLOG_ERR_IO;
+    if (!r || r->grade < 1 || r->grade > 4) return EVLOG_ERR_PARAM;
+
+    uint8_t b[EVLOG_REC], back[EVLOG_REC];
+    evlog_err_t err = EVLOG_OK;
+    uint32_t off;
+
+    if (s_io.lock) s_io.lock(s_io.ctx);
+
+    if (!s_writable || s_used >= EVLOG_PER_SECTOR) {
+        err = rotate();
+        if (err != EVLOG_OK) goto done;
+    }
+
+    rec_encode(r, b);
+    off = rec_off(s_cur, s_used);
+
+    /* 两段写：先 16B 载荷、再 4B CRC —— 掉电断在中间时 CRC 缺失 ⇒ 下次挂载认作尾巴
+       （VER 2：载荷 12→16 加了 flip_ms；写的大小也要跟着改） */
+    if (s_io.write(s_io.ctx, off, b, 16) != 0 || s_io.write(s_io.ctx, off + 16, b + 16, 4) != 0) {
+        s_writable = false;
+        err = EVLOG_ERR_IO;
+        goto done;
+    }
+    if (s_io.read(s_io.ctx, off, back, sizeof(back)) != 0 || memcmp(back, b, sizeof(b)) != 0) {
+        s_writable = false;
+        err = EVLOG_ERR_IO;
+        goto done;
+    }
+
+    if (seq_out) *seq_out = s_head;
+    s_head++;
+    s_used++;
+    if (s_used >= EVLOG_PER_SECTOR) s_writable = false;
+
+done:
+    if (s_io.unlock) s_io.unlock(s_io.ctx);
+    return err;
+}
+
+/* ---------------------------------------------------------------- 读 */
+/* 找 seq 落在哪个扇区。**重代优先**：断头的扇区会让"名义区间"和下一代重叠
+   （比如 0 区只写了 10 条就断了，1 区从 seq=11 起），这时 seq=11 同时落在两区的名义区间里，
+   必须取代数新的那个 —— 否则会去读老区的空白槽，判成"断层"，后面的数据全读不出来。 */
+static int find_sector(uint32_t seq, uint32_t *slot_out)
+{
+    int found = -1;
+    uint16_t found_gen = 0;
+    uint32_t found_slot = 0;
+    for (uint32_t i = 0; i < s_io.sectors; i++) {
+        if (!s_hdr[i].valid) continue;
+        if (seq < s_hdr[i].first) continue;
+        const uint32_t slot = seq - s_hdr[i].first;
+        if (slot >= EVLOG_PER_SECTOR) continue;
+        if (found < 0 || (int16_t)(s_hdr[i].gen - found_gen) > 0) {
+            found = (int)i;
+            found_gen = s_hdr[i].gen;
+            found_slot = slot;
+        }
+    }
+    if (found >= 0) *slot_out = found_slot;
+    return found;
+}
+
+int evlog_read(uint32_t from_seq, evlog_rec_t *out, uint32_t *seqs, int max)
+{
+    if (!s_mounted || !out || max <= 0) return 0;
+    if (s_io.lock) s_io.lock(s_io.ctx);
+
+    int n = 0;
+    uint32_t seq = from_seq ? from_seq : 1;
+    while (n < max && seq < s_head) {
+        uint32_t slot = 0;
+        const int i = find_sector(seq, &slot);
+        if (i < 0) break;                                   /* 这段被环形覆盖了 */
+        if (rec_load((uint32_t)i, slot, &out[n]) != 0) break;
+        if (seqs) seqs[n] = seq;
+        n++;
+        seq++;
+    }
+
+    if (s_io.unlock) s_io.unlock(s_io.ctx);
+    return n;
+}
+
+/* ---------------------------------------------------------------- 水位与统计 */
+uint32_t evlog_head(void)   { return s_head; }
+
+uint32_t evlog_oldest(void)
+{
+    uint32_t oldest = s_head;
+    bool any = false;
+    uint16_t best_gen = 0;
+    for (uint32_t i = 0; i < s_io.sectors && s_mounted; i++) {
+        if (!s_hdr[i].valid) continue;
+        if (!any || (int16_t)(best_gen - s_hdr[i].gen) > 0) {   /* 取最老的一代 */
+            any = true;
+            best_gen = s_hdr[i].gen;
+            oldest = s_hdr[i].first;
+        }
+    }
+    return oldest;
+}
+
+uint32_t evlog_ack(void) { return s_ack; }
+
+evlog_err_t evlog_ack_set(uint32_t seq)
+{
+    if (!s_mounted) return EVLOG_ERR_IO;
+    if (seq <= s_ack) return EVLOG_OK;                 /* 只升不降（重复 ack 是常态） */
+    s_ack = seq;
+    if (s_io.ack_write && s_io.ack_write(s_io.ctx, seq) != 0) return EVLOG_ERR_IO;  /* 内存照升，下次再存 */
+    return EVLOG_OK;
+}
+
+uint32_t evlog_pending(void)
+{
+    if (!s_mounted || s_head == 0) return 0;
+    const uint32_t last = s_head - 1;
+    return (last > s_ack) ? (last - s_ack) : 0;
+}
+
+uint32_t evlog_dropped(void)
+{
+    if (!s_mounted) return 0;
+    const uint32_t oldest = evlog_oldest();
+    return (oldest > s_ack + 1) ? (oldest - s_ack - 1) : 0;
+}
+
+uint32_t evlog_capacity(void)
+{
+    return s_mounted ? s_io.sectors * EVLOG_PER_SECTOR : 0;
+}
+
+const char *evlog_err_str(evlog_err_t e)
+{
+    switch (e) {
+    case EVLOG_OK:          return "ok";
+    case EVLOG_ERR_IO:      return "io error（读/写/擦或回读不符）";
+    case EVLOG_ERR_PARAM:   return "param error（挂载参数或字段越界）";
+    case EVLOG_ERR_NOSPACE: return "no space（扇区数不够）";
+    default:                return "?";
+    }
+}
diff --git a/components/evlog/include/evlog.h b/components/evlog/include/evlog.h
new file mode 100644
index 0000000..be3c1d1
--- /dev/null
+++ b/components/evlog/include/evlog.h
@@ -0,0 +1,102 @@
+// components/evlog/include/evlog.h —— EVLOG：只追加的复习事件日志（C2-b）
+//
+// 为什么要有它（24 §2②）：
+//   PGB2 存的是"每张卡的当前状态"（快照），能恢复、不能上报 —— 快照里没有
+//   "当时按了什么、多快按的、当时在不在线"。服务端机要做墨墨那套调度，要的是**事件流**。
+//
+// 设计（每一条都对应一个真机约束）
+//   · **一条事件 16 字节**：12B 载荷 + 4B CRC32。掉电时最坏只丢"正在写的那一条"，
+//     不会因为一条坏记录把后面全判死（CRC 不对 ⇒ 当尾巴，停止扫描）
+//   · **序号 seq = 幂等键**：从 1 起单调递增，**跨重启不重置**（扇区头里存 first_seq，
+//     记录序号按"槽位"推导，所以一条记录不浪费 4 字节存序号）
+//   · **环形扇区**：4KB/扇区，每区 1 个头 + 255 条；写满就覆盖最旧的扇区（先擦后写头再追加）
+//   · **覆盖会丢数据就如实记账**：未上传却被覆盖的条数由 evlog_dropped() 报出来，
+//     不许装成"没丢"
+//   · **纯逻辑**：IO 走回调（host 测试用内存 Flash），不依赖 ESP-IDF；并发保护也走回调，
+//     真机给一把 FreeRTOS 互斥锁，host 传 NULL
+//
+// ⚠️ 线程约定：本文件**不是线程安全**的。真机后端在 io.lock/unlock 里放互斥锁，
+//    公开函数每次调用首尾各取一次（不递归）—— 调用方别在已持锁时再调公开函数。
+#pragma once
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define EVLOG_SECTOR        4096u                                   /* Flash 擦除粒度 */
+#define EVLOG_HDR           16u                                     /* 扇区头 */
+#define EVLOG_REC           20u                                     /* 单条记录 */
+#define EVLOG_PER_SECTOR    ((EVLOG_SECTOR - EVLOG_HDR) / EVLOG_REC) /* 255 */
+#define EVLOG_MAX_SECTORS   64u                                     /* 头缓存上限 */
+
+/* 一条复习事件（16 字节载荷；落盘时后面接 4 字节 CRC）—— VER 2 起 */
+typedef struct {
+    uint16_t card_id;   /* 词表下标 0..N-1 */
+    uint8_t  grade;     /* 1 忘记 / 2 模糊 / 3 认识 / 4 熟知（= srs_grade_t） */
+    uint8_t  flags;     /* EV_FLAG_* */
+    uint16_t rt_ms;     /* 反应时：从看到问题面到按下评分，毫秒；封顶 65535 */
+    uint16_t flip_ms;   /* 翻面时：从看到问题面到第一次翻面（=回忆段）；0=没翻面就打了分 */
+    uint16_t day;       /* 设备"学习第几天"（0 基） */
+    uint32_t t_ms;      /* 本场会话内的相对时刻（ms），给"越背越慢/走神"分析用 */
+} evlog_rec_t;
+
+#define EV_FLAG_OFFLINE     0x01u   /* 这条是在没有服务端机队列时产生的（离线兜底） */
+#define EV_FLAG_REPEAT      0x02u   /* 当日重来的那一次（墨墨式巩固） */
+#define EV_FLAG_RT_CAP      0x04u   /* 反应时超过 65535ms，已封顶 */
+#define EV_FLAG_READONLY    0x08u   /* 进度库处于只读（数据比固件新），事件只记不改 */
+
+/* 后端：真机 = esp_partition + NVS 水位；host = 内存数组 */
+typedef struct {
+    void     *ctx;
+    uint32_t  sectors;      /* 扇区数，≤ EVLOG_MAX_SECTORS */
+    int (*read)(void *ctx, uint32_t off, void *buf, size_t len);
+    int (*write)(void *ctx, uint32_t off, const void *buf, size_t len);
+    int (*erase)(void *ctx, uint32_t off, size_t len);
+    int (*ack_read)(void *ctx, uint32_t *ack);      /* 允许为 NULL（= 没有水位，按 0 起） */
+    int (*ack_write)(void *ctx, uint32_t ack);
+    void (*lock)(void *ctx);                        /* 可选 */
+    void (*unlock)(void *ctx);                      /* 可选 */
+} evlog_io_t;
+
+typedef enum {
+    EVLOG_OK = 0,
+    EVLOG_ERR_IO = -1,       /* 读/写/擦失败（含回读不符） */
+    EVLOG_ERR_PARAM = -2,    /* 挂载参数不对，或记录字段越界 */
+    EVLOG_ERR_NOSPACE = -3,  /* 扇区数不够/分区太小 */
+} evlog_err_t;
+
+/* ---------------------------------------------------------------- 生命周期 */
+/* 扫扇区头 → 找最新一代 → 数出它的有效条数 → 定位写游标。
+   全盘没有有效头 ⇒ 格式化 0 号扇区（seq 从 1 起）。
+   **任何扇区坏了都只跳过它**，不拖累其它扇区（1 个坏区最多丢 255 条）。 */
+evlog_err_t evlog_mount(evlog_io_t *io);
+void        evlog_unmount(void);
+
+/* ---------------------------------------------------------------- 写 */
+/* 追加一条事件；成功时 *seq_out = 这条的序号（幂等键）。
+   返回 EVLOG_ERR_IO 表示没写进去（调用方照常继续，别打断背单词）。 */
+evlog_err_t evlog_append(const evlog_rec_t *r, uint32_t *seq_out);
+
+/* ---------------------------------------------------------------- 读 */
+/* 从 from_seq 起顺序读最多 max 条（跨扇区）。返回读到的条数；-1 = IO 错。
+   seqs 可为 NULL；非 NULL 时填每条的真实序号（= 幂等键）。
+   **读到断层就停**（被环形覆盖或写坏）—— 调用方要么接受，要么把水位推进（见 evlog_oldest）。 */
+int evlog_read(uint32_t from_seq, evlog_rec_t *out, uint32_t *seqs, int max);
+
+/* ---------------------------------------------------------------- 水位与统计 */
+uint32_t    evlog_head(void);      /* 下一条要分配的序号（从 1 起；1 = 还没写过） */
+uint32_t    evlog_oldest(void);    /* 盘上现存最旧序号（空 = head） */
+uint32_t    evlog_ack(void);       /* 已确认上传的水位（NVS 里，跨重启） */
+evlog_err_t evlog_ack_set(uint32_t seq);   /* **只升不降**；写 NVS 失败返回 IO，内存照升 */
+uint32_t    evlog_pending(void);   /* head - ack - 1（待上传条数） */
+uint32_t    evlog_dropped(void);   /* 未上传却被环形覆盖掉的条数（如实上报） */
+uint32_t    evlog_capacity(void);  /* 总容量（条） */
+const char *evlog_err_str(evlog_err_t e);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/evlog/include/evlog_esp.h b/components/evlog/include/evlog_esp.h
new file mode 100644
index 0000000..0ce0885
--- /dev/null
+++ b/components/evlog/include/evlog_esp.h
@@ -0,0 +1,24 @@
+// components/evlog/include/evlog_esp.h —— EVLOG 的真机后端入口
+#pragma once
+
+#include "evlog.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 分区内的排布（storage 分区 4MB）：
+     0x00000 .. 0x04000   PGB2 双区快照（16KB，见 components/store）
+     0x04000 .. 0x10000   留给 PGB2 以后扩表/扩区（48KB 空档）
+     0x10000 ..           EVLOG 环形（32 扇区 = 128KB = 8160 条）
+   每天 90 条 ⇒ 约 90 天；上传后水位推进，覆盖的都是"已传过的"旧扇区。 */
+#define EVLOG_ESP_BASE     0x10000u
+#define EVLOG_ESP_SECTORS  32u
+
+/* 找 storage 分区 → 挂载（含 NVS 水位、互斥锁）。可重复调用；失败只打日志。
+   返回 EVLOG_OK 表示可用；EVLOG_ERR_NOSPACE = 分区不够大（分区表没刷对）。 */
+evlog_err_t evlog_esp_mount(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/evlog/test/host_test.c b/components/evlog/test/host_test.c
new file mode 100644
index 0000000..cd5a676
--- /dev/null
+++ b/components/evlog/test/host_test.c
@@ -0,0 +1,444 @@
+// components/evlog/test/host_test.c —— EVLOG 单测（含"随机掉电"压测）
+//
+// 验什么（每条都是 C2-b 的验收项）：
+//   ① 序号单调、跨重启不重置；盘被擦过时从 ack+1 起（绝不与服务端机见过的序号撞车）
+//   ② 记录字段 12B 往返不失真（含 65535 / 0xFFFFFFFF 边界）
+//   ③ 环形轮转：写满覆盖最旧一代，未上传被覆盖的条数由 dropped() 如实报出
+//   ④ 断头（写了一半的记录）：只当尾巴，不吞后面的；下一次追加自动换区，序号不断档
+//   ⑤ 扇区头坏了：只跳过那一个区，其余照读；水位比盘新时序号接着水位走
+//   ⑥ 随机掉电 300 次：**只要 append 返回过 OK，重启后一定还读得回来且内容一致**
+//
+// 编译运行（gate.sh 的 host 项会自动跑）：
+//   cc -O2 -Wall -Wextra -Icomponents/evlog/include \
+//      components/evlog/test/host_test.c components/evlog/evlog.c -lm -o /tmp/_evlog_t && /tmp/_evlog_t
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "evlog.h"
+
+/* ---------------------------------------------------------------- 测试台 */
+static int g_fail = 0, g_checks = 0;
+
+#define CHECK(cond, fmt, ...) do {                                        \
+        g_checks++;                                                       \
+        if (!(cond)) {                                                    \
+            g_fail++;                                                     \
+            printf("  ❌ %s:%d  " fmt "\n", __FILE__, __LINE__, ##__VA_ARGS__); \
+        }                                                                 \
+    } while (0)
+
+#define T_SECTORS 4          /* 4 区 × 255 = 1020 条，够把轮转压出来又不拖慢测试 */
+#define T_FLASH   (EVLOG_SECTOR * 8)
+
+typedef struct {
+    uint8_t  flash[T_FLASH];
+    uint32_t ack;
+    long     budget;     /* 本次允许写的字节数；<0 = 不限 */
+    long     used;
+    int      cutting;    /* 1 = 到预算就断电 */
+    long     cuts;
+} ram_t;
+
+static void ram_reset(ram_t *r)
+{
+    memset(r->flash, 0xFF, sizeof(r->flash));
+    r->ack = 0;
+    r->budget = -1; r->used = 0; r->cutting = 0; r->cuts = 0;
+}
+
+static size_t take(ram_t *r, size_t want)
+{
+    if (!r->cutting || r->budget < 0) { r->used += (long)want; return want; }
+    const long left = r->budget - r->used;
+    if (left >= (long)want) { r->used += (long)want; return want; }
+    const size_t part = left > 0 ? (size_t)left : 0;
+    r->used += (long)part;
+    r->cuts++;
+    r->cutting = 0;              /* 断电后不再接受写入 */
+    return part;
+}
+
+static int ram_read(void *ctx, uint32_t off, void *buf, size_t len)
+{
+    ram_t *r = (ram_t *)ctx;
+    if ((size_t)off + len > sizeof(r->flash)) return -1;
+    memcpy(buf, r->flash + off, len);
+    return 0;
+}
+
+static int ram_write(void *ctx, uint32_t off, const void *buf, size_t len)
+{
+    ram_t *r = (ram_t *)ctx;
+    if ((size_t)off + len > sizeof(r->flash)) return -1;
+    const size_t n = take(r, len);
+    memcpy(r->flash + off, buf, n);
+    return n < len ? -1 : 0;
+}
+
+static int ram_erase(void *ctx, uint32_t off, size_t len)
+{
+    ram_t *r = (ram_t *)ctx;
+    if ((size_t)off + len > sizeof(r->flash)) return -1;
+    const size_t n = take(r, len);
+    memset(r->flash + off, 0xFF, n);
+    return n < len ? -1 : 0;
+}
+
+static int ram_ack_read(void *ctx, uint32_t *ack)
+{
+    ram_t *r = (ram_t *)ctx;
+    if (r->ack == 0) return -1;        /* 没存过 = 像 NVS 里没这个键 */
+    *ack = r->ack;
+    return 0;
+}
+
+static int ram_ack_write(void *ctx, uint32_t ack)
+{
+    ram_t *r = (ram_t *)ctx;
+    r->ack = ack;
+    return 0;
+}
+
+static void io_init(evlog_io_t *io, ram_t *r, uint32_t sectors)
+{
+    memset(io, 0, sizeof(*io));
+    io->ctx = r;
+    io->sectors = sectors;
+    io->read = ram_read;
+    io->write = ram_write;
+    io->erase = ram_erase;
+    io->ack_read = ram_ack_read;
+    io->ack_write = ram_ack_write;
+}
+
+static evlog_rec_t mk(uint16_t id, uint8_t grade, uint16_t rt, uint16_t day, uint32_t t)
+{
+    evlog_rec_t r;
+    memset(&r, 0, sizeof(r));
+    r.card_id = id; r.grade = grade; r.rt_ms = rt; r.day = day; r.t_ms = t;
+    return r;
+}
+
+static int same(const evlog_rec_t *a, const evlog_rec_t *b)
+{
+    return a->card_id == b->card_id && a->grade == b->grade && a->flags == b->flags &&
+           a->rt_ms == b->rt_ms && a->day == b->day && a->t_ms == b->t_ms;
+}
+
+/* 顺序读一遍：从 oldest 起，最多 cap 条（seqs 可选） */
+
+/* ---------------------------------------------------------------- ① 基本读写 + 跨重启 */
+static void t_basic(ram_t *r, evlog_io_t *io)
+{
+    puts("[1] 基本读写 / 跨重启 / 水位");
+    ram_reset(r);
+    io_init(io, r, T_SECTORS);
+    CHECK(evlog_mount(io) == EVLOG_OK, "挂载空白 flash");
+    CHECK(evlog_head() == 1 && evlog_pending() == 0 && evlog_oldest() == 1, "新盘：head=1 空");
+    CHECK(evlog_capacity() == T_SECTORS * EVLOG_PER_SECTOR, "容量 %u", evlog_capacity());
+
+    for (int i = 0; i < 10; i++) {
+        uint32_t seq = 0;
+        evlog_rec_t e = mk((uint16_t)i, (uint8_t)(1 + i % 4), (uint16_t)(900 + i), 3, (uint32_t)(i * 1500));
+        CHECK(evlog_append(&e, &seq) == EVLOG_OK, "第 %d 条追加成功", i + 1);
+        CHECK(seq == (uint32_t)(i + 1), "序号 = %u（应为 %d）", seq, i + 1);
+    }
+    CHECK(evlog_head() == 11 && evlog_pending() == 10, "head=%u pending=%u", evlog_head(), evlog_pending());
+
+    evlog_rec_t got[16]; uint32_t seqs[16];
+    int n = evlog_read(1, got, seqs, 16);
+    CHECK(n == 10, "读回 %d 条（应 10）", n);
+    for (int i = 0; i < n && i < 10; i++) {
+        evlog_rec_t want = mk((uint16_t)i, (uint8_t)(1 + i % 4), (uint16_t)(900 + i), 3, (uint32_t)(i * 1500));
+        CHECK(same(&got[i], &want), "第 %d 条内容一致", i + 1);
+        CHECK(seqs[i] == (uint32_t)(i + 1), "第 %d 条 seq=%u", i + 1, seqs[i]);
+    }
+
+    /* 从中间读、越界读 */
+    n = evlog_read(5, got, seqs, 3);
+    CHECK(n == 3 && seqs[0] == 5 && seqs[2] == 7, "从 5 读 3 条 → %d 条，首 seq=%u", n, seqs[0]);
+    CHECK(evlog_read(11, got, seqs, 8) == 0, "读到 head 之外 = 0 条");
+    CHECK(evlog_read(100, got, NULL, 8) == 0, "读空段 = 0 条");
+
+    /* 跨重启：序号不重置、记录还在 */
+    evlog_unmount();
+    CHECK(evlog_mount(io) == EVLOG_OK, "重启后再挂载");
+    CHECK(evlog_head() == 11 && evlog_pending() == 10, "重启后 head=%u pending=%u", evlog_head(), evlog_pending());
+    CHECK(evlog_read(1, got, NULL, 16) == 10, "重启后仍读回 10 条");
+
+    /* 水位只升不降；重复 ack 是常态 */
+    CHECK(evlog_ack_set(5) == EVLOG_OK && evlog_pending() == 5, "ack=5 → pending=%u", evlog_pending());
+    CHECK(evlog_ack_set(3) == EVLOG_OK && evlog_pending() == 5, "ack 回退被忽略 → pending=%u", evlog_pending());
+    evlog_unmount();
+    CHECK(evlog_mount(io) == EVLOG_OK, "重启");
+    CHECK(evlog_ack() == 5 && evlog_pending() == 5, "水位跨重启：ack=%u pending=%u", evlog_ack(), evlog_pending());
+}
+
+/* ---------------------------------------------------------------- ② 字段边界 */
+static void t_fields(ram_t *r, evlog_io_t *io)
+{
+    puts("[2] 字段边界");
+    ram_reset(r);
+    io_init(io, r, 2);
+    CHECK(evlog_mount(io) == EVLOG_OK, "挂载");
+    evlog_rec_t e = mk(452, 4, 65535, 65535, 0xFFFFFFFFu);
+    e.flags = EV_FLAG_OFFLINE | EV_FLAG_REPEAT | EV_FLAG_RT_CAP | EV_FLAG_READONLY;
+    uint32_t seq = 0;
+    CHECK(evlog_append(&e, &seq) == EVLOG_OK, "边界值写入");
+    evlog_rec_t got;
+    CHECK(evlog_read(seq, &got, NULL, 1) == 1, "读回");
+    CHECK(same(&got, &e), "边界值往返一致（id=%u g=%u rt=%u day=%u t=%u f=%u）",
+          got.card_id, got.grade, got.rt_ms, got.day, got.t_ms, got.flags);
+
+    /* 非法评分：不许写进日志（会污染算法） */
+    evlog_rec_t bad = mk(1, 0, 100, 0, 0);
+    CHECK(evlog_append(&bad, &seq) == EVLOG_ERR_PARAM, "grade=0 被拒");
+    bad.grade = 5;
+    CHECK(evlog_append(&bad, &seq) == EVLOG_ERR_PARAM, "grade=5 被拒");
+    CHECK(evlog_head() == 2, "被拒的没占序号：head=%u", evlog_head());
+
+    /* 参数校验 */
+    evlog_io_t j = *io;
+    j.sectors = 0;
+    CHECK(evlog_mount(&j) == EVLOG_ERR_PARAM, "sectors=0 被拒");
+    j.sectors = EVLOG_MAX_SECTORS + 1;
+    CHECK(evlog_mount(&j) == EVLOG_ERR_PARAM, "sectors 超上限被拒");
+    j = *io; j.read = NULL;
+    CHECK(evlog_mount(&j) == EVLOG_ERR_PARAM, "缺 read 回调被拒");
+    io_init(io, r, 2);
+    evlog_mount(io);
+    evlog_unmount();
+    evlog_rec_t x = mk(1, 3, 1, 1, 1);
+    CHECK(evlog_append(&x, NULL) == EVLOG_ERR_IO, "未挂载时追加 = IO 错");
+}
+
+/* ---------------------------------------------------------------- ③ 环形轮转 */
+static void t_wrap(ram_t *r, evlog_io_t *io)
+{
+    puts("[3] 环形轮转（覆盖最旧一代 + dropped 如实记账）");
+    ram_reset(r);
+    io_init(io, r, T_SECTORS);
+    CHECK(evlog_mount(io) == EVLOG_OK, "挂载");
+
+    const int total = T_SECTORS * EVLOG_PER_SECTOR + 100;   /* 多写 100 条 → 覆盖最旧 */
+    for (int i = 0; i < total; i++) {
+        evlog_rec_t e = mk((uint16_t)(i % 453), 3, 1000, 0, (uint32_t)i);
+        if (evlog_append(&e, NULL) != EVLOG_OK) { CHECK(0, "第 %d 条写失败", i); return; }
+    }
+    const uint32_t cap = evlog_capacity();
+    CHECK(evlog_head() == (uint32_t)total + 1, "head=%u", evlog_head());
+    /* 淘汰是**按扇区**的：写满第 5 代回到 0 区时，0 区那 255 条整块没了 →
+       oldest 从 1 跳到 256（不是 101）。这条差别要记住：真机上是"一天左右"的粒度。 */
+    const uint32_t oldest_want = EVLOG_PER_SECTOR + 1;
+    CHECK(evlog_oldest() == oldest_want, "oldest=%u（应 %u）", evlog_oldest(), oldest_want);
+    CHECK(evlog_pending() == total, "pending=%u（一条没上传）", evlog_pending());
+    CHECK(evlog_dropped() == oldest_want - 1, "dropped=%u（应 %u = 被覆盖的都算丢）",
+          evlog_dropped(), oldest_want - 1);
+    CHECK((uint32_t)(evlog_head() - evlog_oldest()) == (uint32_t)total + 1 - oldest_want,
+          "现存 %u 条（= head - oldest）", evlog_head() - evlog_oldest());
+    (void)cap;
+
+    /* 覆盖之后：旧序号读不到（断层），现存的最旧一条能读 */
+    evlog_rec_t got[8]; uint32_t seqs[8];
+    CHECK(evlog_read(1, got, seqs, 8) == 0, "已被覆盖的 seq=1 读不到");
+    int n = evlog_read(evlog_oldest(), got, seqs, 8);
+    CHECK(n == 8 && seqs[0] == evlog_oldest(), "从 oldest 起读得动：%d 条 seq=%u", n, seqs[0]);
+
+    /* 上传完水位后 dropped 归零（覆盖的是已上传的，不算丢） */
+    CHECK(evlog_ack_set(evlog_oldest() - 1) == EVLOG_OK, "水位推到 oldest-1");
+    CHECK(evlog_dropped() == 0, "dropped=%u（覆盖的都是已上传的）", evlog_dropped());
+    CHECK(evlog_pending() == evlog_head() - 1 - evlog_ack(), "pending=%u", evlog_pending());
+
+    /* 单扇区：写满就报 NOSPACE，不许死循环/踩内存 */
+    ram_reset(r);
+    io_init(io, r, 1);
+    CHECK(evlog_mount(io) == EVLOG_OK, "单扇区挂载");
+    for (int i = 0; i < (int)EVLOG_PER_SECTOR; i++) {
+        evlog_rec_t e = mk(1, 3, 1, 0, 0);
+        CHECK(evlog_append(&e, NULL) == EVLOG_OK, "单扇区第 %d 条", i + 1);
+    }
+    evlog_rec_t e2 = mk(1, 3, 1, 0, 0);
+    CHECK(evlog_append(&e2, NULL) == EVLOG_ERR_NOSPACE, "单扇区写满 = NOSPACE");
+    CHECK(evlog_head() == EVLOG_PER_SECTOR + 1, "head 没乱跳：%u", evlog_head());
+}
+
+/* ---------------------------------------------------------------- ④ 断头 */
+static void t_torn(ram_t *r, evlog_io_t *io)
+{
+    puts("[4] 断头记录（掉电写了半条）");
+    ram_reset(r);
+    io_init(io, r, T_SECTORS);
+    evlog_mount(io);
+    for (int i = 0; i < 10; i++) {
+        evlog_rec_t e = mk((uint16_t)i, 3, 1000, 0, (uint32_t)i);
+        evlog_append(&e, NULL);
+    }
+    /* 手工把第 11 个槽写成"有载荷、没 CRC"——模拟写一半断电 */
+    const uint32_t off = EVLOG_SECTOR * 0 + EVLOG_HDR + 10 * EVLOG_REC;
+    memset(r->flash + off, 0xAB, 12);
+
+    evlog_unmount();
+    CHECK(evlog_mount(io) == EVLOG_OK, "带断头再挂载");
+    CHECK(evlog_head() == 11, "断头没占序号：head=%u", evlog_head());
+    CHECK(evlog_pending() == 10, "pending=%u", evlog_pending());
+
+    /* 下一次追加必须换区，且序号接得上 */
+    evlog_rec_t e = mk(99, 4, 500, 0, 5000);
+    uint32_t seq = 0;
+    CHECK(evlog_append(&e, &seq) == EVLOG_OK && seq == 11, "换区后第一条 seq=%u", seq);
+
+    evlog_rec_t got[16]; uint32_t seqs[16];
+    int n = evlog_read(1, got, seqs, 16);
+    CHECK(n == 11, "跨区连读 %d 条（应 11）", n);
+    CHECK(n == 11 && seqs[10] == 11 && got[10].card_id == 99, "第 11 条在新区、内容对");
+    for (int i = 0; i < 10 && i < n; i++) CHECK(seqs[i] == (uint32_t)(i + 1), "旧区第 %d 条 seq=%u", i + 1, seqs[i]);
+}
+
+/* ---------------------------------------------------------------- ⑤ 扇区头坏 / 水位比盘新 */
+static void t_badhdr(ram_t *r, evlog_io_t *io)
+{
+    puts("[5] 扇区头坏 / 水位比盘新");
+    ram_reset(r);
+    io_init(io, r, T_SECTORS);
+    evlog_mount(io);
+    for (int i = 0; i < 300; i++) {            /* 跨到第 2 区 */
+        evlog_rec_t e = mk((uint16_t)(i % 453), 3, 1000, 0, (uint32_t)i);
+        evlog_append(&e, NULL);
+    }
+    const uint32_t head_before = evlog_head();
+
+    r->flash[EVLOG_SECTOR * 1] ^= 0xFF;        /* 把第 2 区的 magic 打坏 */
+    evlog_unmount();
+    CHECK(evlog_mount(io) == EVLOG_OK, "坏头后仍能挂载");
+    CHECK(evlog_head() == EVLOG_PER_SECTOR + 1, "退回上一个完整区（head=%u，应 %u）", evlog_head(), EVLOG_PER_SECTOR + 1u);
+    evlog_rec_t got[8];
+    CHECK(evlog_read(1, got, NULL, 8) == 8, "第 1 区的记录还在");
+    (void)head_before;
+
+    /* 水位比盘新：序号绝不回头（否则会跟服务端机见过的序号撞车 → 被当重复丢掉） */
+    CHECK(evlog_ack_set(5000) == EVLOG_OK, "水位先推到 5000");
+    evlog_unmount();
+    CHECK(evlog_mount(io) == EVLOG_OK, "挂载");
+    CHECK(evlog_head() == 5001, "head 接着水位：%u", evlog_head());
+    evlog_rec_t e = mk(7, 3, 100, 0, 0);
+    uint32_t seq = 0;
+    CHECK(evlog_append(&e, &seq) == EVLOG_OK && seq == 5001, "新事件 seq=%u", seq);
+
+    /* 盘被整片擦掉（换 flash / 重刷数据区）→ 也从 ack+1 起 */
+    memset(r->flash, 0xFF, sizeof(r->flash));
+    evlog_unmount();
+    CHECK(evlog_mount(io) == EVLOG_OK, "空盘挂载");
+    CHECK(evlog_head() == 5001, "空盘 head=%u（接着水位，不回到 1）", evlog_head());
+}
+
+/* ---------------------------------------------------------------- ⑥ 随机掉电 */
+/* 判据（这就是设备对服务端机的承诺）：
+   ① 只要 append 返回过 OK，这条记录在**任何重启之后**都必须还在、内容一致
+   ② [oldest, head) 区间里**不许有空洞**（序号连续、每条读得回来）
+   ③ head 只增不减；被环形覆盖的只能是 oldest 之前的（有账可查：dropped）
+   模型里 budget = 本次允许写的字节数，写到一半断电 ⇒ 写/擦返回 -1。 */
+static void t_powercut(ram_t *r, evlog_io_t *io)
+{
+    puts("[6] 随机掉电 300 次：OK 过的记录必须还在，序号不许断档");
+    ram_reset(r);
+    io_init(io, r, 8);              /* 8 区 = 2040 条，测试期间不会因覆盖干扰判据 */
+    CHECK(evlog_mount(io) == EVLOG_OK, "挂载");
+
+    static evlog_rec_t committed[8192];      /* committed[seq-1] */
+    CHECK(8192 >= 8 * (int)EVLOG_PER_SECTOR, "测试数组够大");
+
+    for (int i = 0; i < 250; i++) {          /* 先写到快满一区，好让掉电砸在轮转上 */
+        evlog_rec_t e = mk((uint16_t)(i % 453), 3, 1000, 0, (uint32_t)i);
+        uint32_t seq = 0;
+        if (evlog_append(&e, &seq) != EVLOG_OK) { CHECK(0, "预置第 %d 条失败", i); return; }
+        committed[seq - 1] = e;
+    }
+    int ncommit = 250;
+
+    srand(20261026);
+    int ok = 0, cut = 0;
+    uint32_t last_oldest = 1;
+    for (int trial = 0; trial < 300; trial++) {
+        r->cutting = 1;
+        /* 三种预算：太小（连 16B 都写不完）/ 中等（写一半）/ 足够（能过 4KB 擦除） */
+        const int pick = rand() % 4;
+        r->budget = (pick == 0) ? 1 + rand() % 15
+                  : (pick == 1) ? 1 + rand() % 4100
+                  : 1 + rand() % 9000;
+        r->used = 0;
+
+        evlog_rec_t e = mk((uint16_t)(trial % 453), (uint8_t)(1 + trial % 4),
+                           (uint16_t)(500 + trial), 1, (uint32_t)trial);
+        uint32_t seq = 0;
+        const evlog_err_t rc = evlog_append(&e, &seq);
+
+        r->cutting = 0;
+        r->budget = -1;
+        if (rc == EVLOG_OK) {
+            CHECK(seq == (uint32_t)ncommit + 1, "序号连续：seq=%u（应 %d）", seq, ncommit + 1);
+            committed[seq - 1] = e;
+            ncommit++;
+            ok++;
+        } else if (rc == EVLOG_ERR_IO) {
+            cut++;
+        } else {
+            CHECK(0, "第 %d 次追加出现意外错误 %d", trial, (int)rc);
+            return;
+        }
+
+        /* 断电 → 重启 */
+        evlog_unmount();
+        if (evlog_mount(io) != EVLOG_OK) { CHECK(0, "掉电后挂载失败（第 %d 次）", trial); return; }
+
+        const uint32_t head = evlog_head();
+        const uint32_t oldest = evlog_oldest();
+        CHECK(head >= (uint32_t)ncommit + 1, "第 %d 次：head=%u 没退（已确认 %d 条）", trial, head, ncommit);
+        CHECK(oldest >= last_oldest, "第 %d 次：oldest=%u 没退（上次 %u）", trial, oldest, last_oldest);
+        last_oldest = oldest;
+        CHECK(evlog_pending() == head - 1 - evlog_ack(), "第 %d 次：pending=%u", trial, evlog_pending());
+
+        /* 无空洞 + 内容一致（这是最硬的一条） */
+        int holes = 0, mismatch = 0;
+        for (uint32_t sq = oldest; sq < head; sq++) {
+            evlog_rec_t got;
+            if (evlog_read(sq, &got, NULL, 1) != 1) { holes++; continue; }
+            if (sq <= (uint32_t)ncommit && !same(&got, &committed[sq - 1])) mismatch++;
+        }
+        CHECK(holes == 0 && mismatch == 0,
+              "第 %d 次掉电：空洞 %d 条 / 内容不符 %d 条（oldest=%u head=%u）", trial, holes, mismatch, oldest, head);
+        if (holes || mismatch) return;
+    }
+
+    CHECK(ok > 0 && cut > 0, "掉电覆盖了两种结局：成功 %d 次 / 被打断 %d 次", ok, cut);
+    printf("     （成功 %d 次、被打断 %d 次、共确认 %d 条、最终 head=%u、被覆盖掉 %u 条）\n",
+           ok, cut, ncommit, evlog_head(), evlog_head() - 1 - (uint32_t)ncommit + evlog_dropped());
+
+    /* 最后再一次性读全部：能连续读出 ncommit - (oldest-1) 条 */
+    const uint32_t oldest = evlog_oldest();
+    static evlog_rec_t all[8192];
+    static uint32_t    allseq[8192];
+    const int n = evlog_read(oldest, all, allseq, 8192);
+    CHECK(n == (int)(evlog_head() - oldest), "整段连读 %d 条（应 %u）", n, evlog_head() - oldest);
+    for (int i = 0; i < n; i++) {
+        if (allseq[i] != oldest + (uint32_t)i) { CHECK(0, "第 %d 条序号断档：%u", i, allseq[i]); break; }
+    }
+}
+
+int main(void)
+{
+    static ram_t r;
+    evlog_io_t io;
+
+    puts("== EVLOG host 测试 ==");
+    t_basic(&r, &io);
+    t_fields(&r, &io);
+    t_wrap(&r, &io);
+    t_torn(&r, &io);
+    t_badhdr(&r, &io);
+    t_powercut(&r, &io);
+
+    printf("\n%s：%d 项检查，失败 %d 项\n", g_fail == 0 ? "✅ PASS" : "❌ FAIL", g_checks, g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
