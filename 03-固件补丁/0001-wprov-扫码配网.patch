--- /dev/null
+++ b/main/tomato_up.h
@@ -0,0 +1,20 @@
+// main/tomato_up.h —— 番茄上报（PRD §5.4）
+//
+// 每完成一个番茄，往服务端机 `~/aipassport/tomato.jsonl` 追加一行（七个字段，契约不许改）：
+//   {"dev":"a3b71565","ts":1793440000,"date":"2026-10-31","dur":25,"mode":1,"round":3,"at":1793440005}
+//
+// 三条规矩（照 ev_sync 那套，都是踩过的）：
+//   ① 网络不进 LVGL 上下文：完成番茄时只**排队**，上传在独立任务里
+//   ② 不许静默丢：先进 NVS，传上去了才抹掉；关机重启也还在
+//   ③ 起点按环境选（外面先走公网网关），家里那个永远排最后
+#pragma once
+
+// 开机调一次（NVS 就绪之后）：把上次没传完的接着传。
+void tomato_up_init(void);
+
+// 完成一个番茄：dur = 分钟（15/25/45），mode = 档位 0/1/2，round = 当天第几个。
+// **不联网、不阻塞**，只落 NVS + 起一次后台补传。
+void tomato_up_note(int dur, int mode, int round);
+
+// 还有几条没传上去（给自测/日志看）。
+int tomato_up_pending(void);
