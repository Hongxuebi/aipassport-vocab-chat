+static lv_obj_t     *s_bubble_box;  /* 气泡底板（v0.93） */
+static lv_obj_t     *s_bubble;      /* 她说的（气泡里，亮） */
+
+/* ---- 戳（PRD §4.3）与"开麦门槛"（2026-10-29 M1）--------------------------------
+ * 以前按下 ● 立刻开麦 ⇒ 每次"戳"都白跑一轮语音（还白送 1 点亲密度）。
+ * 现在：按下只抖一下，**按住 ≥250 ms 才开麦**；没开麦的短按 = 戳。 */
+#define PET_ARM_MS        250u    /* 按住多久才开麦（小于它 = 戳） */
+#define PET_TAP_GAP_MS   1500u    /* 连戳窗口 */
+#define PET_TAP_SETTLE_MS 5000u   /* 好感结算冷却（防连点刷分） */
