+static char          s_echo_show[ECHO_LINES * ECHO_CHARS_PER_LINE * 4 + 4]; /* 折好行的上屏串 */
+static char          s_her_show[ECHO_LINES * ECHO_CHARS_PER_LINE * 4 + 4];
+static volatile bool s_echo_dirty;
+static volatile bool s_her_dirty;
