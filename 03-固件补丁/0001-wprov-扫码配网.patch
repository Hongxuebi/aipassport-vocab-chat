+    lv_obj_align(s_dbg, LV_ALIGN_BOTTOM_LEFT, 10, -6);
+    lv_label_set_text(s_dbg, "");
+
+    lv_screen_load(s_scr);
+    s_inited = true;
+    show_current();
+
+    /* 后台去问服务端机；界面不等它 */
+    s_sync_cancel = false;
+    s_fetch_state = 1;
+    if (xTaskCreate(fetch_task, "card_fetch", 4096, (void *)(intptr_t)s_day, 3, NULL) != pdPASS) {
+        s_fetch_state = 3;
+    }
+    if (!s_timer) s_timer = lv_timer_create(sync_tick, 300, NULL);
+
+    ev_sync_request();              /* 上次离线攒下的事件，进页面就先补一次（后台任务，不等它） */
+
+
+    ESP_LOGI(TAG, "进入卡片页：第 %u 天，队列 %d 张，已学 %u 张，seq=%u，空闲堆 %u B",
+             (unsigned)(s_day + 1), s_qn, (unsigned)pgb2_count(), (unsigned)pgb2_seq(),
+             (unsigned)esp_get_free_heap_size());
+}
+
+void demo_card_exit(void)
+{
+    if (s_since_sync > 0) {
+        pgb2_err_t se = pgb2_sync();
+        ESP_LOGI(TAG, "离开时落盘：%s，seq=%u，本次打了 %d 张",
+                 pgb2_err_str(se), (unsigned)pgb2_seq(), s_grade_cnt);
+    }
+    /* 回传交给补传线程（不再在这里起 6KB 栈的任务，见 handoff_state 的注释） */
+    s_sync_cancel = true;
+    handoff_state();
+    /* 抓队列的任务还在跑（手机一样快的网络也可能 4 秒）就先别起补传：
+       两个 6KB 任务并存正是"退页后堆 0 KB"的另一半原因。让它收尾时替我们踢一脚。 */
+    if (s_fetch_state == 1) {
+        s_defer_sync = true;
+        ESP_LOGI(TAG, "抓队列还在跑 → 回传推迟到它收尾再发");
+    } else {
+        ev_sync_request();         /* 状态 + 本场的事件一起发；传不上去下次进页面再说 */
+    }
+    /* v0.126.2：**退页不再释放网络队列**（≈10 KB），下次进页面立刻就能用带词块的那份，
+       不用再赌"队列 5 秒后才到"。真正释放只发生在下次抓到新队列时（net_queue_free + 覆盖）。 */
+    s_online = false;
+    if (s_grade_cnt > 0) nvs_day_mark_active();   /* 本会话有打分 → 下次进入算"过了一天" */
+    if (s_timer) { lv_timer_delete(s_timer); s_timer = NULL; }
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; }
+    s_word = s_ipa = s_cn = s_prog = s_hint = s_dbg = s_done = NULL;
+    s_chunk = NULL;                        /* v0.124 */
+    s_qn = s_qi = 0;
+    s_inited = false;
+    /* 「退出任何页面后堆回到 ≥8KB」的证据链：这一行 + evsync 的「补传线程收工」那行 */
+    ESP_LOGI(TAG, "退出卡片页：空闲堆 %u B，最大连续块 %u B（回传在后台线程里跑）",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+}
+
+/* ---------------------------------------------------------------- 自测（临时开关） */
+/* 真机验收用：自动进页 → 按 20 张「认识」→ 返回 → 再进出 10 轮看 LVGL 池稳不稳。
+   走的是真按键路径（app_sim_key），和手按完全同一条链路。 */
+void card_autotest(void)
+{
+    vTaskDelay(pdMS_TO_TICKS(7000));          /* 等菜单起来（LVGL 初始化约 5 s，7 s 稳） */
+
+    lv_mem_monitor_t m0, m1;
+    lv_mem_monitor(&m0);
+
+    app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);    /* 「背单词」是菜单第一项 */
+    vTaskDelay(pdMS_TO_TICKS(900));
+
+    char w[40] = {0}, ipa[40] = {0};
+    if (s_word) { strncpy(w, lv_label_get_text(s_word), sizeof(w) - 1); }
+    if (s_ipa)  { strncpy(ipa, lv_label_get_text(s_ipa), sizeof(ipa) - 1); }
+    ESP_LOGI(TAG, "AUTOTEST 首张(问题面)：%s %s ｜队列 %d 张 ｜释义显示=%d",
+             w, ipa, s_qn, s_cn ? (int)(lv_label_get_text(s_cn)[0] != 0) : -1);
+
+    /* 3 张打「忘记」（长按 ▼）→ 应触发当日重来，队列变长；
+       顺便验「任意键翻面」：分别用 ▲ / ▼ / ● 翻面 */
+    const bsp_btn_t reveal_key[3] = { BSP_BTN_UP, BSP_BTN_DOWN, BSP_BTN_OK };
+    int q_before = s_qn;
+    for (int i = 0; i < 3 && s_qi < s_qn; i++) {
+        app_sim_key(reveal_key[i], BSP_BTN_CLICK);    /* 任意键翻面 */
+        vTaskDelay(pdMS_TO_TICKS(200));
+        ESP_LOGI(TAG, "AUTOTEST 用第 %d 个键翻面 → 释义显示=%d", (int)reveal_key[i],
+                 s_cn ? (int)(lv_label_get_text(s_cn)[0] != 0) : -1);
+        app_sim_key(BSP_BTN_DOWN, BSP_BTN_LONG);      /* 忘记 */
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+    ESP_LOGI(TAG, "AUTOTEST 忘记 3 张：队列 %d → %d 张（应 +N，当日重来）", q_before, s_qn);
+
+    /* 2 张打「模糊」（▼ 单击） */
+    for (int i = 0; i < 2 && s_qi < s_qn; i++) {
+        app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(200));
+        app_sim_key(BSP_BTN_DOWN, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+
+    /* 4 张打「认识」（● 单击，翻面也是 ●） */
+    for (int i = 0; i < 4 && s_qi < s_qn; i++) {
+        app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(200));
+        app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+    /* 1 张打「熟知」（▲ 单击） */
+    if (s_qi < s_qn) {
+        app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(200));
+        app_sim_key(BSP_BTN_UP, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+    ESP_LOGI(TAG, "AUTOTEST 打完：本次 %d 张（忘记3/模糊2/认识4/熟知1），库里 %u 张，队列收尾 %d/%d",
+             s_grade_cnt, (unsigned)pgb2_count(), s_qi, s_qn);
+
+    app_sim_key(BSP_BTN_OK, BSP_BTN_LONG);        /* 返回菜单 */
+    vTaskDelay(pdMS_TO_TICKS(600));
+
+    /* 再进出 10 轮：对象只建一次/只删一次，池不该往下掉 */
+    for (int r = 0; r < 10; r++) {
+        app_sim_key(BSP_BTN_OK, BSP_BTN_CLICK);
+        vTaskDelay(pdMS_TO_TICKS(500));
+        app_sim_key(BSP_BTN_OK, BSP_BTN_LONG);
+        vTaskDelay(pdMS_TO_TICKS(450));
+    }
+    lv_mem_monitor(&m1);
+    int drop = (int)m0.free_size - (int)m1.free_size;
+    ESP_LOGI(TAG, "AUTOTEST 10 轮进出：池 free %u → %u（掉 %d B，%.1f%%），frag %u%% → %u%%",
+             (unsigned)m0.free_size, (unsigned)m1.free_size, drop,
+             100.0 * drop / (double)(m0.free_size ? m0.free_size : 1), m0.frag_pct, m1.frag_pct);
+    ESP_LOGI(TAG, "AUTOTEST %s", (drop < (int)(m0.free_size / 50) && m1.frag_pct <= m0.frag_pct + 10)
+             ? "PASS（10 轮进出池稳定）" : "FAIL（有泄漏）");
+    /* C2-b：事件日志必须跟本次打分条数对得上（离线时这些都会挂在"待传"里） */
+    ESP_LOGI(TAG, "AUTOTEST 事件日志：本次打分 %d 张 ｜ 待传 %u 条 ｜ 补传状态 %d",
+             s_grade_cnt, (unsigned)ev_sync_pending(), ev_sync_state());
+}
+
+void demo_card_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    if (!s_inited) return;
+
+    /* 第一段：**任意键翻面**（作者 2026-10-25 要求）。
+       单击/双击都算；长按不抢（长按 ● 还是框架的"返回菜单"）。 */
+    if (!s_revealed) {
+        if (ev == BSP_BTN_CLICK || ev == BSP_BTN_DOUBLE) {
+            s_revealed = true;
+            if (!s_flip_t0) s_flip_t0 = now_ms();   /* 回忆段结束 */
+            show_current();
+        }
+        return;
+    }
+
+    /* 第二段：按使用频率排 —— 认识(最常用)=● 、模糊=▼ 、熟知=▲ 、忘记=长按▼（破坏性动作要刻意） */
+    if (btn == BSP_BTN_UP   && ev == BSP_BTN_CLICK) { s_revealed = false; grade(SRS_EASY);  return; }
+    if (btn == BSP_BTN_OK   && ev == BSP_BTN_CLICK) { s_revealed = false; grade(SRS_GOOD);  return; }
+    if (btn == BSP_BTN_DOWN && ev == BSP_BTN_CLICK) { s_revealed = false; grade(SRS_HARD);  return; }
+    if (btn == BSP_BTN_DOWN && ev == BSP_BTN_LONG)  { s_revealed = false; grade(SRS_AGAIN); return; }
+    /* 其余（含长按 ● 返回菜单）交给框架 */
+}
