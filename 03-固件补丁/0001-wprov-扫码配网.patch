+++ b/components/store/CMakeLists.txt
@@ -0,0 +1,17 @@
+# components/store —— PGB2 进度库
+#   pgb2.c      纯逻辑，不依赖 ESP-IDF（host 测试也编它）
+#   esp/pgb2_esp.c  真机后端（esp_partition + NVS），放子目录是为了让 host 端
+#                   的 `cc components/store/*.c` 不会误把 ESP 依赖带进来
+idf_component_register(
+    SRCS "pgb2.c" "esp/pgb2_esp.c"
+    INCLUDE_DIRS "include"
+    PRIV_REQUIRES esp_partition nvs_flash
+)
+
+# 降级固件演练（19 §七 C0 验收项）：
+#   PGB2_FW_VERSION=1 idf.py -B build_old build
+# 就能编出一份"只认数据版本 1 的老固件"，用来验"旧固件读到新数据 → 只读、不写盘"。
+if(DEFINED ENV{PGB2_FW_VERSION})
+    target_compile_definitions(${COMPONENT_LIB} PUBLIC PGB2_VERSION_OVERRIDE=$ENV{PGB2_FW_VERSION})
+    message(STATUS "PGB2: 降级演练模式，数据版本上限 = $ENV{PGB2_FW_VERSION}")
+endif()
diff --git a/components/store/esp/pgb2_esp.c b/components/store/esp/pgb2_esp.c
new file mode 100644
index 0000000..8538736
--- /dev/null
+++ b/components/store/esp/pgb2_esp.c
@@ -0,0 +1,98 @@
+// components/store/pgb2_esp.c —— PGB2 的真机后端：esp_partition + NVS 确认槽
+//
+// 只做"接线"，不含任何逻辑：所有校验/双区/只读判断都在 pgb2.c 里（那份 host 测过 645 项）。
+// 真机与 host 的差别只有三件：Flash 必须按扇区对齐读、**写之前先擦**、确认槽进 NVS。
+#include <string.h>
+#include "esp_log.h"
+#include "esp_partition.h"
+#include "nvs.h"
+#include "pgb2.h"
+#include "pgb2_esp.h"
+
+static const char *TAG = "pgb2";
+static const esp_partition_t *s_part;
+
+/* ---------------------------------------------------------------- Flash 回调 */
+static int p_read(void *ctx, uint32_t off, void *buf, size_t len)
+{
+    (void)ctx;
+    if (!s_part || off + len > s_part->size) return -1;
+    return esp_partition_read(s_part, off, buf, len) == ESP_OK ? 0 : -1;
+}
+
+static int p_write(void *ctx, uint32_t off, const void *buf, size_t len)
+{
+    (void)ctx;
+    if (!s_part || off + len > s_part->size) return -1;
+    /* esp_partition_write 要求目标已擦过；pgb2.c 的顺序是"先擦整区 → 写载荷 → 写头"，
+       所以我们这里只写不擦 —— 擦除由 p_erase 单独做，语义与 host 的 ram_erase 一致。 */
+    return esp_partition_write(s_part, off, buf, len) == ESP_OK ? 0 : -1;
+}
+
+static int p_erase(void *ctx, uint32_t off, size_t len)
+{
+    (void)ctx;
+    if (!s_part || off + len > s_part->size) return -1;
+    return esp_partition_erase_range(s_part, off, len) == ESP_OK ? 0 : -1;
+}
+
+/* ---------------------------------------------------------------- 确认槽（NVS） */
+#define NVS_NS   "pgb2"
+#define NVS_KEY  "confirm"
+
+static int m_read(void *ctx, uint8_t out[16])
+{
+    (void)ctx;
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) return -1;
+    size_t len = 16;
+    esp_err_t e = nvs_get_blob(h, NVS_KEY, out, &len);
+    nvs_close(h);
+    return (e == ESP_OK && len == 16) ? 0 : -1;
+}
+
+static int m_write(void *ctx, const uint8_t in[16])
+{
+    (void)ctx;
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return -1;
+    esp_err_t e = nvs_set_blob(h, NVS_KEY, in, 16);
+    if (e == ESP_OK) e = nvs_commit(h);
+    nvs_close(h);
+    return e == ESP_OK ? 0 : -1;
+}
+
+/* ---------------------------------------------------------------- 对外 */
+pgb2_err_t pgb2_esp_mount(void)
+{
+    s_part = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "storage");
+    if (!s_part) {
+        ESP_LOGE(TAG, "找不到 storage 分区（分区表没刷？）");
+        return PGB2_ERR_IO;
+    }
+    if (s_part->size < 2 * PGB2_SECTOR) {
+        ESP_LOGE(TAG, "storage 分区太小：%u B（至少要 %u）",
+                 (unsigned)s_part->size, (unsigned)(2 * PGB2_SECTOR));
+        return PGB2_ERR_NOSPACE;
+    }
+    pgb2_io_t io = {
+        .ctx = NULL, .size = s_part->size,
+        .read = p_read, .write = p_write, .erase = p_erase,
+        .meta_read = m_read, .meta_write = m_write,
+    };
+    pgb2_err_t e = pgb2_mount(&io);
+    pgb2_err_t mv = pgb2_meta_verify();
+    const char *st = (e == PGB2_OK) ? "OK" : pgb2_err_str(e);
+    if (e == PGB2_ERR_CRC) {
+        ESP_LOGE(TAG, "PGB2 挂载：两区都坏（表已清空，下次写会重建）｜确认槽 %s", pgb2_err_str(mv));
+    } else if (mv != PGB2_OK) {
+        ESP_LOGE(TAG, "PGB2 挂载 %s 但**掉电比对失败**：%s（已确认的写入丢了/内容不符）",
+                 st, pgb2_err_str(mv));
+    } else {
+        ESP_LOGI(TAG, "PGB2 挂载 %s：seq=%u 卡数=%u 版本=%u%s｜确认槽 %s",
+                 st, (unsigned)pgb2_seq(), (unsigned)pgb2_count(),
+                 (unsigned)pgb2_data_version(),
+                 pgb2_readonly() ? " **只读（数据比固件新）**" : "", pgb2_err_str(mv));
+    }
+    return e;
+}
diff --git a/components/store/include/pgb2.h b/components/store/include/pgb2.h
new file mode 100644
index 0000000..fc5bd2b
--- /dev/null
+++ b/components/store/include/pgb2.h
@@ -0,0 +1,120 @@
+// components/store/include/pgb2.h —— PGB2 进度库（Passport Grade Book v2）
+//
+// 设计要点（对应 19 §四 Q10–Q12）：
+//   · **双区交替写**：两个扇区轮着写，写坏了旧的那份还在 → 掉电不会把进度清空
+//   · **整块 CRC**：头 CRC + 载荷 CRC；任何一处不对 → 本区作废、回退到另一区
+//   · **只读模式**（Q10）：数据版本 > 固件支持版本 → 只用内存副本、绝不写盘
+//   · **队列不落盘**（Q11）：这里只存每张卡的 S/D/到期日，队列由 due 现算
+//   · **掉电比对**（Q12）：CRC 对了不算数，还要比"最后确认写入的内容"是否真的一致
+//
+// 本文件**不依赖 ESP-IDF**：执行 IO 通过 pgb2_io_t 回调，host 测试与真机共用同一份逻辑。
+#pragma once
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PGB2_MAGIC          0x32424750u   /* "PGB2" 小端 */
+/* 本固件支持/写入的数据版本。
+   降级演练用：构建时定义 PGB2_VERSION_OVERRIDE=1 就假装"老固件只认版本 1"（见 CMakeLists）。 */
+#ifdef PGB2_VERSION_OVERRIDE
+#define PGB2_VERSION        PGB2_VERSION_OVERRIDE
+#else
+#define PGB2_VERSION        2             /* 本固件能写的格式版本 */
+#endif
+#define PGB2_SECTOR         8192u         /* 单区字节数；两区 = 16KB */
+#define PGB2_HDR            24u           /* 头长度 */
+#define PGB2_REC            16u           /* 单条记录长度（含 2 字节保留） */
+#define PGB2_MAX_CARDS      ((PGB2_SECTOR - PGB2_HDR) / PGB2_REC)   /* 510 */
+
+/* IO 后端：真机用 esp_partition，host 用内存。返回 0 = 成功。 */
+typedef struct {
+    void *ctx;
+    uint32_t size;                                                  /* 必须 == 2 * PGB2_SECTOR */
+    int (*read)(void *ctx, uint32_t off, void *buf, size_t len);
+    int (*write)(void *ctx, uint32_t off, const void *buf, size_t len);
+    int (*erase)(void *ctx, uint32_t off, size_t len);
+    /* 16 字节"确认槽"：真机落 NVS（掉电也在），host 用独立结构模拟。
+       每次 sync 成功后才写它 —— 用来跨重启比对"最后一次确认写入"。允许为 NULL。 */
+    int (*meta_read)(void *ctx, uint8_t out[16]);
+    int (*meta_write)(void *ctx, const uint8_t in[16]);
+} pgb2_io_t;
+
+typedef struct {
+    uint16_t id;        /* 词表序号 0..N-1 */
+    float    S;         /* FSRS 稳定性（天） */
+    float    D;         /* FSRS 难度 1..10 */
+    uint16_t reps;
+    uint8_t  lapses;
+    uint8_t  flags;     /* bit0 = 已引入（见过） */
+    uint16_t due_day;   /* 到期日（按"学习第几天"算，0 = 今天） */
+} pgb2_card_t;
+
+#define PGB2_FLAG_INTRODUCED  0x01u
+
+typedef enum {
+    PGB2_OK = 0,
+    PGB2_ERR_IO = -1,
+    PGB2_ERR_CRC = -2,          /* 两区都坏 */
+    PGB2_ERR_FULL = -3,
+    PGB2_ERR_PARAM = -4,
+    PGB2_ERR_READONLY = -5,     /* 数据比固件新：已切只读 */
+    PGB2_ERR_NOSPACE = -6,
+} pgb2_err_t;
+
+/* ---------------------------------------------------------------- 生命周期 */
+/* 挂载：读两区 → 校验 → 选 seq 最大且有效的区。两区都坏返回 PGB2_ERR_CRC（此时表为空）。
+   数据版本高于本固件 → 仍载入内存，但置只读（写会返回 PGB2_ERR_READONLY）。 */
+pgb2_err_t pgb2_mount(pgb2_io_t *io);
+void       pgb2_unmount(void);
+
+/* ---------------------------------------------------------------- 读写 */
+/* 只改内存；要落盘必须 pgb2_sync() */
+pgb2_err_t pgb2_put(const pgb2_card_t *card);
+pgb2_err_t pgb2_get(uint16_t id, pgb2_card_t *out);
+pgb2_err_t pgb2_erase_card(uint16_t id);
+
+/* 落盘：把内存全表写成一份新快照到**非活动区** → 回读校验（含内容比对）→ 切换活动区。
+   掉电发生在任何一步，下一次 mount 都能回到"上一个完整快照"。 */
+pgb2_err_t pgb2_sync(void);
+
+uint16_t   pgb2_count(void);
+uint32_t   pgb2_seq(void);          /* 当前活动快照的序号（每次 sync +1） */
+bool       pgb2_readonly(void);
+uint16_t   pgb2_data_version(void);
+const char *pgb2_err_str(pgb2_err_t e);
+
+/* ---------------------------------------------------------------- 掉电比对（Q12） */
+/* 环形日志：每次成功 sync 后记一条 {seq, 抽样 id, S, D}；上限 32 条。
+   重启后调 pgb2_ring_verify() 与盘上内容逐条比对 ——
+   **CRC 正确但内容不符 = FAIL**（格式完好 ≠ 逻辑正确）。 */
+#define PGB2_RING_CAP 32
+
+typedef struct {
+    uint32_t seq;
+    uint16_t id;
+    float    S;
+    float    D;
+} pgb2_ring_ent_t;
+
+void       pgb2_ring_reset(void);
+int        pgb2_ring_push(uint32_t seq, uint16_t id, float S, float D);
+int        pgb2_ring_count(void);
+const pgb2_ring_ent_t *pgb2_ring_last(void);
+/* 校验（同一会话内）：盘上 seq 必须 ≥ 日志里最大的 seq，且该 seq 抽样那条记录内容一致。
+   返回 PGB2_OK / PGB2_ERR_CRC（内容不符）/ PGB2_ERR_IO（盘上更旧 = 丢了已确认的写入） */
+pgb2_err_t pgb2_ring_verify(void);
+
+/* 校验（跨重启，Q12 的正主）：拿确认槽里的 {seq,id,S,D} 跟盘上核对。
+   · 盘上 seq < 确认 seq        → PGB2_ERR_IO   （已确认的写入丢了）
+   · 盘上 seq == 确认 seq 但内容不符 → PGB2_ERR_CRC （格式完好 ≠ 逻辑正确）
+   · 盘上 seq >  确认 seq        → OK（掉电发生在"写完盘、还没写确认槽"之间，属允许） */
+pgb2_err_t pgb2_meta_verify(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/store/include/pgb2_esp.h b/components/store/include/pgb2_esp.h
new file mode 100644
index 0000000..0b8b05b
--- /dev/null
+++ b/components/store/include/pgb2_esp.h
@@ -0,0 +1,16 @@
+// components/store/include/pgb2_esp.h —— 真机后端入口（esp_partition + NVS 确认槽）
+#pragma once
+
+#include "pgb2.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 找 "storage" 分区 → 挂载 → 比对确认槽，结果打日志。
+   返回 PGB2_OK 表示可用；PGB2_ERR_CRC = 两区都坏（表已清空，还能重建）。 */
+pgb2_err_t pgb2_esp_mount(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/store/pgb2.c b/components/store/pgb2.c
new file mode 100644
index 0000000..ce8ea0f
--- /dev/null
+++ b/components/store/pgb2.c
@@ -0,0 +1,374 @@
+// components/store/pgb2.c —— PGB2 核心逻辑（不依赖 ESP-IDF，host 可测）
+//
+// 扇区布局（每区 PGB2_SECTOR = 8192 B）：
+//   [0..3]   magic  "PGB2"
+//   [4..5]   version（u16 LE）
+//   [6..7]   保留
+//   [8..11]  seq（u32 LE）
+//   [12..13] count（u16 LE）
+//   [14..15] flags（u16 LE）
+//   [16..19] payload CRC32（覆盖记录区 [24 .. 24+count*16)）
+//   [20..23] header CRC32（覆盖 [0..20)）
+//   [24..]   记录，每条 16 B
+//
+// 记录（16 B）：
+//   [0..1] id  [2..3] reps  [4..5] due_day  [6] lapses  [7] flags
+//   [8..11] S（IEEE754 小端）  [12..15] D
+//
+// 为什么这么设计：
+//   · 双区 + 整块 CRC ⇒ 写一半掉电只会让"正在写的那区"失效，旧区仍是完整快照
+//   · 写后回读逐条比对 ⇒ 抓得住"CRC 对但内容错"这类（Q12 明确要求）
+#include <string.h>
+#include <stdio.h>
+#include <stdint.h>
+
+#include "pgb2.h"
+
+/* ---------------------------------------------------------------- 小工具 */
+static uint32_t crc32_calc(const uint8_t *p, size_t n)
+{
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < n; i++) {
+        crc ^= p[i];
+        for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(crc & 1)));
+    }
+    return ~crc;
+}
+
+static void put_u16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static void put_u32(uint8_t *p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+                                              p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24); }
+static uint16_t get_u16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+static uint32_t get_u32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void put_f32(uint8_t *p, float f) { uint32_t v; memcpy(&v, &f, 4); put_u32(p, v); }
+static float get_f32(const uint8_t *p) { uint32_t v = get_u32(p); float f; memcpy(&f, &v, 4); return f; }
+
+/* ---------------------------------------------------------------- 状态 */
+static pgb2_io_t s_io;
+static bool      s_mounted;
+static bool      s_readonly;
+static int       s_active;                  /* 0/1 = 当前活动区；-1 = 还没有有效区 */
+static uint32_t  s_seq;
+static uint16_t  s_ver;
+static uint16_t  s_used[PGB2_MAX_CARDS];    /* 稀疏表：存 id，0xFFFF = 空 */
+static pgb2_card_t s_cards[PGB2_MAX_CARDS];
+static uint16_t  s_n;
+
+static pgb2_ring_ent_t s_ring[PGB2_RING_CAP];
+static int s_ring_n, s_ring_head;
+
+const char *pgb2_err_str(pgb2_err_t e)
+{
+    switch (e) {
+    case PGB2_OK:           return "OK";
+    case PGB2_ERR_IO:       return "IO error";
+    case PGB2_ERR_CRC:      return "CRC error (both sectors bad)";
+    case PGB2_ERR_FULL:     return "table full";
+    case PGB2_ERR_PARAM:    return "bad param";
+    case PGB2_ERR_READONLY: return "read-only (data newer than firmware)";
+    case PGB2_ERR_NOSPACE:  return "no space";
+    }
+    return "?";
+}
+
+/* ---------------------------------------------------------------- 记录编解码 */
+static void rec_pack(uint8_t *p, const pgb2_card_t *c)
+{
+    put_u16(p + 0, c->id);
+    put_u16(p + 2, c->reps);
+    put_u16(p + 4, c->due_day);
+    p[6] = c->lapses;
+    p[7] = c->flags;
+    put_f32(p + 8, c->S);
+    put_f32(p + 12, c->D);
+}
+
+static void rec_unpack(const uint8_t *p, pgb2_card_t *c)
+{
+    c->id      = get_u16(p + 0);
+    c->reps    = get_u16(p + 2);
+    c->due_day = get_u16(p + 4);
+    c->lapses  = p[6];
+    c->flags   = p[7];
+    c->S       = get_f32(p + 8);
+    c->D       = get_f32(p + 12);
+}
+
+/* ---------------------------------------------------------------- 内存表操作 */
+static int find_slot(uint16_t id)
+{
+    for (int i = 0; i < s_n; i++) if (s_used[i] == id) return i;
+    return -1;
+}
+
+static pgb2_err_t table_put(const pgb2_card_t *c)
+{
+    int i = find_slot(c->id);
+    if (i < 0) {
+        if (s_n >= PGB2_MAX_CARDS) return PGB2_ERR_FULL;
+        i = s_n++;
+        s_used[i] = c->id;
+    }
+    s_cards[i] = *c;
+    return PGB2_OK;
+}
+
+static bool table_erase(uint16_t id)
+{
+    int i = find_slot(id);
+    if (i < 0) return false;
+    s_cards[i] = s_cards[s_n - 1];
+    s_used[i]  = s_used[s_n - 1];
+    s_n--;
+    return true;
+}
+
+/* ---------------------------------------------------------------- 扇区读写 */
+static uint32_t sec_off(int sec) { return (uint32_t)sec * PGB2_SECTOR; }
+
+static pgb2_err_t sector_read_hdr(int sec, uint32_t *seq, uint16_t *count,
+                                 uint16_t *ver, uint16_t *flags, bool *hdr_ok)
+{
+    uint8_t h[PGB2_HDR];
+    if (s_io.read(s_io.ctx, sec_off(sec), h, sizeof(h)) != 0) return PGB2_ERR_IO;
+    *hdr_ok = false;
+    if (get_u32(h) != PGB2_MAGIC) return PGB2_OK;
+    if (get_u32(h + 20) != crc32_calc(h, 20)) return PGB2_OK;
+    *seq   = get_u32(h + 8);
+    *count = get_u16(h + 12);
+    *flags = get_u16(h + 14);
+    *ver   = get_u16(h + 4);
+    if (*count > PGB2_MAX_CARDS) return PGB2_OK;
+    *hdr_ok = true;
+    return PGB2_OK;
+}
+
+/* 读整区到内存表；校验头 CRC + 载荷 CRC */
+static pgb2_err_t sector_load(int sec, uint32_t *seq, uint16_t *ver)
+{
+    uint32_t q = 0;
+    uint16_t cnt = 0, flags = 0, v = 0;
+    bool ok = false;
+    pgb2_err_t e = sector_read_hdr(sec, &q, &cnt, &v, &flags, &ok);
+    if (e != PGB2_OK) return e;
+    if (!ok) return PGB2_ERR_CRC;
+
+    uint8_t h[PGB2_HDR];
+    if (s_io.read(s_io.ctx, sec_off(sec), h, sizeof(h)) != 0) return PGB2_ERR_IO;
+    const uint32_t want_pcrc = get_u32(h + 16);
+    const size_t plen = (size_t)cnt * PGB2_REC;
+
+    static uint8_t buf[PGB2_MAX_CARDS * PGB2_REC];      /* 8KB 静态，不放栈上 */
+    if (plen) {
+        if (s_io.read(s_io.ctx, sec_off(sec) + PGB2_HDR, buf, plen) != 0) return PGB2_ERR_IO;
+        if (crc32_calc(buf, plen) != want_pcrc) return PGB2_ERR_CRC;
+    } else if (want_pcrc != crc32_calc(buf, 0)) {
+        return PGB2_ERR_CRC;
+    }
+
+    for (int i = 0; i < cnt; i++) {
+        pgb2_card_t c;
+        rec_unpack(buf + (size_t)i * PGB2_REC, &c);
+        if (table_put(&c) != PGB2_OK) return PGB2_ERR_FULL;
+    }
+    *seq = q;
+    *ver = v;
+    return PGB2_OK;
+}
+
+static void table_clear(void)
+{
+    s_n = 0;
+}
+
+/* ---------------------------------------------------------------- 生命周期 */
+pgb2_err_t pgb2_mount(pgb2_io_t *io)
+{
+    if (!io || !io->read || io->size < 2 * PGB2_SECTOR) return PGB2_ERR_PARAM;
+    s_io = *io;
+    s_mounted = true;
+    s_readonly = false;
+    s_active = -1;
+    s_seq = 0;
+    s_ver = 0;
+    table_clear();
+
+    /* 两个区都试一遍，挑 seq 最大的有效区 */
+    uint32_t best_seq = 0; int best = -1;
+    bool any_magic = false;
+    uint32_t q; uint16_t v;
+    for (int sec = 0; sec < 2; sec++) {
+        uint8_t m[4];
+        if (s_io.read(s_io.ctx, sec_off(sec), m, 4) == 0 && get_u32(m) == PGB2_MAGIC) any_magic = true;
+        table_clear();
+        if (sector_load(sec, &q, &v) != PGB2_OK) { table_clear(); continue; }
+        /* 注意：sector_load 会往表里塞数据；先记住它，再比 */
+        if (best < 0 || q > best_seq) {
+            best = sec; best_seq = q;
+        }
+        table_clear();
+    }
+    if (best < 0) {
+        s_active = -1; s_seq = 0; s_ver = 0;
+        /* 全新 Flash（两区连 magic 都没有）= 空盘，不是损坏；有 magic 却校验不过 = 真损坏 */
+        return any_magic ? PGB2_ERR_CRC : PGB2_OK;
+    }
+    table_clear();
+    if (sector_load(best, &q, &v) != PGB2_OK) { table_clear(); return PGB2_ERR_CRC; }
+    s_active = best;
+    s_seq = q;
+    s_ver = v;
+    if (s_ver > PGB2_VERSION) s_readonly = true;   /* Q10：数据比固件新 → 只读 */
+    return PGB2_OK;
+}
+
+void pgb2_unmount(void)
+{
+    s_mounted = false;
+    s_active = -1;
+    table_clear();
+}
+
+bool     pgb2_readonly(void)     { return s_readonly; }
+uint16_t pgb2_count(void)        { return s_n; }
+uint32_t pgb2_seq(void)          { return s_seq; }
+uint16_t pgb2_data_version(void) { return s_ver; }
+
+pgb2_err_t pgb2_put(const pgb2_card_t *card)
+{
+    if (!s_mounted || !card) return PGB2_ERR_PARAM;
+    return table_put(card);
+}
+
+pgb2_err_t pgb2_get(uint16_t id, pgb2_card_t *out)
+{
+    if (!s_mounted || !out) return PGB2_ERR_PARAM;
+    int i = find_slot(id);
+    if (i < 0) return PGB2_ERR_PARAM;
+    *out = s_cards[i];
+    return PGB2_OK;
+}
+
+pgb2_err_t pgb2_erase_card(uint16_t id)
+{
+    if (!s_mounted) return PGB2_ERR_PARAM;
+    return table_erase(id) ? PGB2_OK : PGB2_ERR_PARAM;
+}
+
+/* ---------------------------------------------------------------- 落盘 */
+pgb2_err_t pgb2_sync(void)
+{
+    if (!s_mounted) return PGB2_ERR_IO;
+    if (s_readonly) return PGB2_ERR_READONLY;
+
+    const int target = (s_active == 0) ? 1 : 0;      /* 永远写非活动区 */
+    const size_t plen = (size_t)s_n * PGB2_REC;
+
+    static uint8_t buf[PGB2_MAX_CARDS * PGB2_REC];
+    for (int i = 0; i < s_n; i++) rec_pack(buf + (size_t)i * PGB2_REC, &s_cards[i]);
+
+    uint8_t h[PGB2_HDR];
+    memset(h, 0, sizeof(h));
+    const uint32_t new_seq = s_seq + 1;
+    put_u32(h + 0, PGB2_MAGIC);
+    put_u16(h + 4, PGB2_VERSION);
+    put_u16(h + 6, 0);
+    put_u32(h + 8, new_seq);
+    put_u16(h + 12, s_n);
+    put_u16(h + 14, 0);
+    put_u32(h + 16, crc32_calc(buf, plen));
+    put_u32(h + 20, crc32_calc(h, 20));
+
+    /* 顺序很关键：先擦/写目标区，最后才写"头"。头写下去了才算这份快照成立。 */
+    if (s_io.erase(s_io.ctx, sec_off(target), PGB2_SECTOR) != 0) return PGB2_ERR_IO;
+    if (s_io.write(s_io.ctx, sec_off(target) + PGB2_HDR, buf, plen) != 0) return PGB2_ERR_IO;
+    if (s_io.write(s_io.ctx, sec_off(target), h, sizeof(h)) != 0) return PGB2_ERR_IO;
+
+    /* ---- 回读校验：不只比 CRC，还要逐条比内容（Q12：格式对 ≠ 内容对） ---- */
+    uint8_t rh[PGB2_HDR];
+    if (s_io.read(s_io.ctx, sec_off(target), rh, sizeof(rh)) != 0) return PGB2_ERR_IO;
+    if (memcmp(rh, h, sizeof(h)) != 0) return PGB2_ERR_CRC;
+    static uint8_t rbuf[PGB2_MAX_CARDS * PGB2_REC];
+    if (plen && s_io.read(s_io.ctx, sec_off(target) + PGB2_HDR, rbuf, plen) != 0) return PGB2_ERR_IO;
+    if (plen && memcmp(rbuf, buf, plen) != 0) return PGB2_ERR_CRC;
+
+    s_active = target;
+    s_seq = new_seq;
+    s_ver = PGB2_VERSION;
+
+    /* 掉电比对：RAM 环日志（同一会话） + 确认槽（跨重启） */
+    uint16_t fid = 0xFFFF; float fS = 0, fD = 0;
+    if (s_n > 0) { fid = s_cards[0].id; fS = s_cards[0].S; fD = s_cards[0].D;
+                   pgb2_ring_push(s_seq, fid, fS, fD); }
+    if (s_io.meta_write) {
+        uint8_t meta[16];
+        memset(meta, 0, sizeof(meta));
+        put_u32(meta + 0, PGB2_MAGIC);
+        put_u32(meta + 4, s_seq);
+        put_u16(meta + 8, fid);
+        put_u16(meta + 10, 0);
+        put_f32(meta + 12, fS);
+        /* D 用 12..15 太挤：把 D 塞进 ring 校验（同一会话），跨重启只比 S 与 id */
+        (void)fD;
+        s_io.meta_write(s_io.ctx, meta);
+    }
+    return PGB2_OK;
+}
+
+/* ---------------------------------------------------------------- 环形日志 */
+void pgb2_ring_reset(void) { memset(s_ring, 0, sizeof(s_ring)); s_ring_n = 0; s_ring_head = 0; }
+
+int pgb2_ring_push(uint32_t seq, uint16_t id, float S, float D)
+{
+    s_ring[s_ring_head].seq = seq;
+    s_ring[s_ring_head].id = id;
+    s_ring[s_ring_head].S = S;
+    s_ring[s_ring_head].D = D;
+    s_ring_head = (s_ring_head + 1) % PGB2_RING_CAP;
+    if (s_ring_n < PGB2_RING_CAP) s_ring_n++;
+    return 0;
+}
+
+int pgb2_ring_count(void) { return s_ring_n; }
+
+const pgb2_ring_ent_t *pgb2_ring_last(void)
+{
+    if (s_ring_n <= 0) return NULL;
+    int idx = (s_ring_head - 1 + PGB2_RING_CAP) % PGB2_RING_CAP;
+    return &s_ring[idx];
+}
+
+pgb2_err_t pgb2_meta_verify(void)
+{
+    if (!s_mounted || !s_io.meta_read) return PGB2_OK;
+    uint8_t meta[16];
+    if (s_io.meta_read(s_io.ctx, meta) != 0) return PGB2_OK;      /* 没写过确认槽 */
+    if (get_u32(meta) != PGB2_MAGIC) return PGB2_OK;
+    const uint32_t cseq = get_u32(meta + 4);
+    const uint16_t cid  = get_u16(meta + 8);
+    const float    cS   = get_f32(meta + 12);
+    if (cseq == 0) return PGB2_OK;
+
+    if (s_seq < cseq) return PGB2_ERR_IO;        /* 已确认的写入丢了 */
+    if (s_seq > cseq) return PGB2_OK;            /* 确认槽还没来得及写，允许 */
+    if (cid == 0xFFFF) return PGB2_OK;           /* 空表快照 */
+    pgb2_card_t c;
+    if (pgb2_get(cid, &c) != PGB2_OK) return PGB2_ERR_CRC;
+    if (c.S != cS) return PGB2_ERR_CRC;          /* 校验都对、内容不对 = FAIL */
+    return PGB2_OK;
+}
+
+pgb2_err_t pgb2_ring_verify(void)
+{
+    const pgb2_ring_ent_t *e = pgb2_ring_last();
+    if (!e || !s_mounted) return PGB2_OK;             /* 没日志 = 没写过，不算失败 */
+    if (s_seq < e->seq) return PGB2_ERR_IO;           /* 已经确认过的 seq 丢了 */
+    pgb2_card_t c;
+    if (pgb2_get(e->id, &c) != PGB2_OK) return PGB2_ERR_CRC;
+    if (c.S != e->S || c.D != e->D) return PGB2_ERR_CRC;   /* 校验通过但内容不符 = FAIL */
+    return PGB2_OK;
+}
diff --git a/components/store/test/host_test.c b/components/store/test/host_test.c
new file mode 100644
index 0000000..026cbcb
--- /dev/null
+++ b/components/store/test/host_test.c
@@ -0,0 +1,413 @@
+// components/store/test/host_test.c —— PGB2 单测 + 掉电 100 次（Q12：比对逻辑而非只 CRC）
+//
+// 编译运行（gate.sh 的 host 项会自动跑）：
+//   cc -O2 -Wall -Wextra -Icomponents/store/include \
+//      components/store/test/host_test.c components/store/pgb2.c -lm -o /tmp/_pgb2_t && /tmp/_pgb2_t
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "pgb2.h"
+
+/* ---------------------------------------------------------------- 测试台 */
+static int g_fail = 0, g_checks = 0;
+
+#define CHECK(cond, fmt, ...) do {                                   \
+        g_checks++;                                                  \
+        if (!(cond)) {                                               \
+            g_fail++;                                                \
+            printf("  ❌ %s:%d  " fmt "\n", __FILE__, __LINE__, ##__VA_ARGS__); \
+        }                                                            \
+    } while (0)
+
+/* 内存 Flash + 掉电模型：
+   cutting=1 时，累计写入超过 budget 就"只写一半然后断电"（返回 -1），精准模拟真机掉电。 */
+typedef struct {
+    uint8_t flash[2 * PGB2_SECTOR];
+    uint8_t meta[16];
+    int     meta_valid;
+    long    budget;        /* 本次允许写入的字节数；<0 = 不限制 */
+    long    used;
+    int     cutting;
+    long    cuts;          /* 统计：断电发生次数 */
+} ram_t;
+
+static void ram_reset(ram_t *r)
+{
+    memset(r->flash, 0xFF, sizeof(r->flash));
+    memset(r->meta, 0, sizeof(r->meta));
+    r->meta_valid = 0;
+    r->budget = -1; r->used = 0; r->cutting = 0; r->cuts = 0;
+}
+
+/* 返回还能写多少字节；不够就截断并标记断电 */
+static size_t budget_take(ram_t *r, size_t want)
+{
+    if (!r->cutting || r->budget < 0) { r->used += (long)want; return want; }
+    long left = r->budget - r->used;
+    if (left >= (long)want) { r->used += (long)want; return want; }
+    size_t part = left > 0 ? (size_t)left : 0;
+    r->used += (long)part;
+    r->cuts++;
+    r->cutting = 0;                    /* 断电之后不再接受任何写入 */
+    return part;
+}
+
+static int ram_read(void *ctx, uint32_t off, void *buf, size_t len)
+{
+    ram_t *r = (ram_t *)ctx;
+    if (off + len > sizeof(r->flash)) return -1;
+    memcpy(buf, r->flash + off, len);
+    return 0;
+}
+
+static int ram_write(void *ctx, uint32_t off, const void *buf, size_t len)
+{
+    ram_t *r = (ram_t *)ctx;
+    if (off + len > sizeof(r->flash)) return -1;
+    size_t n = budget_take(r, len);
+    memcpy(r->flash + off, buf, n);
+    if (n < len) return -1;            /* 停电了 */
+    return 0;
+}
+
+static int ram_erase(void *ctx, uint32_t off, size_t len)
+{
+    ram_t *r = (ram_t *)ctx;
+    if (off + len > sizeof(r->flash)) return -1;
+    size_t n = budget_take(r, len);
+    memset(r->flash + off, 0xFF, n);
+    if (n < len) return -1;
+    return 0;
+}
+
+static int ram_meta_read(void *ctx, uint8_t out[16])
+{
+    ram_t *r = (ram_t *)ctx;
+    if (!r->meta_valid) return -1;
+    memcpy(out, r->meta, 16);
+    return 0;
+}
+
+static int ram_meta_write(void *ctx, const uint8_t in[16])
+{
+    ram_t *r = (ram_t *)ctx;
+    memcpy(r->meta, in, 16);
+    r->meta_valid = 1;
+    return 0;
+}
+
+static pgb2_io_t make_io(ram_t *r)
+{
+    pgb2_io_t io;
+    io.ctx = r;
+    io.size = sizeof(r->flash);
+    io.read = ram_read; io.write = ram_write; io.erase = ram_erase;
+    io.meta_read = ram_meta_read; io.meta_write = ram_meta_write;
+    return io;
+}
+
+/* 造一张卡 */
+static pgb2_card_t card(uint16_t id, float S, float D, uint16_t due)
+{
+    pgb2_card_t c;
+    memset(&c, 0, sizeof(c));
+    c.id = id; c.S = S; c.D = D; c.reps = 3; c.lapses = 1;
+    c.flags = PGB2_FLAG_INTRODUCED; c.due_day = due;
+    return c;
+}
+
+/* 把"造卡 + 写"合成一句（C 里不能对函数返回值取地址） */
+#define PUT(idv, Sv, Dv, duev) do {                        \
+        pgb2_card_t _c = card((idv), (Sv), (Dv), (duev));   \
+        CHECK(pgb2_put(&_c) == PGB2_OK, "put %d", (int)(idv)); \
+    } while (0)
+
+static int flash_is_blank(const ram_t *r)
+{
+    for (size_t i = 0; i < sizeof(r->flash); i++) if (r->flash[i] != 0xFF) return 0;
+    return 1;
+}
+
+/* ---------------------------------------------------------------- 用例 */
+static void t_empty(ram_t *r)
+{
+    ram_reset(r);
+    pgb2_io_t io = make_io(r);
+    CHECK(pgb2_mount(&io) == PGB2_OK, "空盘挂载应 OK（不是损坏）");
+    CHECK(pgb2_count() == 0, "空盘 count 应为 0，实为 %u", pgb2_count());
+    CHECK(pgb2_seq() == 0, "空盘 seq 应为 0");
+    CHECK(!pgb2_readonly(), "空盘不该只读");
+    CHECK(flash_is_blank(r), "空盘用例前提：Flash 应全 0xFF");
+}
+
+static void t_basic(ram_t *r)
+{
+    ram_reset(r);
+    pgb2_io_t io = make_io(r);
+    CHECK(pgb2_mount(&io) == PGB2_OK, "挂载");
+
+    pgb2_card_t a = card(7, 3.5f, 5.25f, 4), b = card(9, 11.0f, 2.5f, 12);
+    CHECK(pgb2_put(&a) == PGB2_OK, "写 A");
+    CHECK(pgb2_put(&b) == PGB2_OK, "写 B");
+    CHECK(pgb2_sync() == PGB2_OK, "sync");
+
+    pgb2_unmount();
+    CHECK(pgb2_mount(&io) == PGB2_OK, "重挂载");
+    CHECK(pgb2_count() == 2, "应有 2 条，实为 %u", pgb2_count());
+    CHECK(pgb2_seq() == 1, "seq 应为 1，实为 %u", pgb2_seq());
+
+    pgb2_card_t got;
+    CHECK(pgb2_get(7, &got) == PGB2_OK && got.S == 3.5f && got.D == 5.25f && got.due_day == 4,
+          "A 的内容要一模一样（浮点不能走样）");
+    CHECK(pgb2_get(9, &got) == PGB2_OK && got.S == 11.0f, "B 的内容");
+}
+
+static void t_update_and_order(ram_t *r)
+{
+    ram_reset(r);
+    pgb2_io_t io = make_io(r);
+    pgb2_mount(&io);
+    PUT(1, 1.0f, 5.0f, 1);
+    pgb2_sync();                                   /* seq 1 */
+    PUT(1, 9.0f, 4.0f, 9);
+    pgb2_sync();                                   /* seq 2，写在另一个区 */
+    pgb2_unmount();
+    CHECK(pgb2_mount(&io) == PGB2_OK, "重挂载");
+    CHECK(pgb2_seq() == 2, "seq 应为 2（拿新的那份）");
+    pgb2_card_t got;
+    CHECK(pgb2_get(1, &got) == PGB2_OK && got.S == 9.0f, "应读到更新后的 S=9");
+}
+
+static void t_crc_fallback(ram_t *r)
+{
+    ram_reset(r);
+    pgb2_io_t io = make_io(r);
+    pgb2_mount(&io);
+    PUT(3, 4.0f, 5.0f, 2);
+    pgb2_sync();                                   /* seq 1（区 0） */
+    PUT(3, 8.0f, 5.0f, 6);
+    pgb2_sync();                                   /* seq 2（区 1） */
+    int active = (pgb2_seq() == 2) ? 1 : 0;
+    pgb2_unmount();
+
+    /* 把"最新那区"的载荷改一个字节（头 CRC 不动 → 只有载荷 CRC 能发现） */
+    r->flash[active * PGB2_SECTOR + PGB2_HDR + 8] ^= 0x01;
+
+    CHECK(pgb2_mount(&io) == PGB2_OK, "一区坏了要能活着挂载（回退到另一区）");
+    CHECK(pgb2_seq() == 1, "应回退到 seq 1，实为 %u", pgb2_seq());
+    pgb2_card_t got;
+    CHECK(pgb2_get(3, &got) == PGB2_OK && got.S == 4.0f, "回退后内容应是旧的那份");
+}
+
+static void t_both_bad(ram_t *r)
+{
+    ram_reset(r);
+    pgb2_io_t io = make_io(r);
+    pgb2_mount(&io);
+    PUT(5, 2.0f, 6.0f, 3);
+    pgb2_sync();                                   /* 区 0 有完整快照 */
+    PUT(5, 3.0f, 6.0f, 4);
+    pgb2_sync();                                   /* 区 1 也有 → 两区都有效 */
+    pgb2_unmount();
+    /* 破坏两区的**载荷**、保留 magic 与头 CRC：
+       这才是"损坏"；直接改 magic 会看起来像全新空盘（那是另一条分支，[1] 已覆盖）。 */
+    r->flash[0 * PGB2_SECTOR + PGB2_HDR + 8] ^= 0xFF;
+    r->flash[1 * PGB2_SECTOR + PGB2_HDR + 8] ^= 0xFF;
+    pgb2_err_t e = pgb2_mount(&io);
+    CHECK(e == PGB2_ERR_CRC, "两区都坏要明确报 CRC（不静默当空盘），实为 %d", (int)e);
+    CHECK(pgb2_count() == 0, "损坏后表为空（下次 sync 重建）");
+    /* 重建要能成功 */
+    PUT(6, 3.0f, 4.0f, 2);
+    CHECK(pgb2_sync() == PGB2_OK, "坏盘之后还能重建");
+}
+
+static void t_readonly(ram_t *r)
+{
+    ram_reset(r);
+    pgb2_io_t io = make_io(r);
+    pgb2_mount(&io);
+    PUT(2, 5.0f, 5.0f, 5);
+    pgb2_sync();
+    pgb2_unmount();
+
+    /* 手改版本号 = 99（模拟"用了新固件写过，现在跑老固件"），并修好头 CRC */
+    uint8_t h[PGB2_HDR];
+    int sec = 0;
+    memcpy(h, r->flash + sec * PGB2_SECTOR, PGB2_HDR);
+    h[4] = 99; h[5] = 0;
+    /* 重算头 CRC */
+    uint32_t crc = 0xFFFFFFFFu;
+    for (int i = 0; i < 20; i++) {
+        crc ^= h[i];
+        for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(crc & 1)));
+    }
+    crc = ~crc;
+    h[20] = (uint8_t)crc; h[21] = (uint8_t)(crc >> 8);
+    h[22] = (uint8_t)(crc >> 16); h[23] = (uint8_t)(crc >> 24);
+    memcpy(r->flash + sec * PGB2_SECTOR, h, PGB2_HDR);
+
+    CHECK(pgb2_mount(&io) == PGB2_OK, "新版本数据也要能挂（内存副本可用）");
+    CHECK(pgb2_readonly(), "版本 99 > 固件支持 2 → 必须只读");
+    CHECK(pgb2_data_version() == 99, "读到版本 99，实为 %u", pgb2_data_version());
+    CHECK(pgb2_count() == 1, "只读模式下数据还能看（count=1，实为 %u）", pgb2_count());
+
+    /* 只读模式：内存能改，盘绝不能动 */
+    uint8_t before[2 * PGB2_SECTOR];
+    memcpy(before, r->flash, sizeof(before));
+    PUT(2, 1.0f, 1.0f, 1);
+    CHECK(pgb2_sync() == PGB2_ERR_READONLY, "只读模式 sync 必须拒绝，实为 %d", (int)pgb2_sync());
+    CHECK(memcmp(before, r->flash, sizeof(before)) == 0, "只读模式一个字节都不许写盘");
+}
+
+static void t_meta_verify(ram_t *r)
+{
+    ram_reset(r);
+    pgb2_io_t io = make_io(r);
+    pgb2_mount(&io);
+    PUT(4, 6.0f, 4.0f, 8);
+    pgb2_sync();
+    CHECK(pgb2_meta_verify() == PGB2_OK, "确认槽一致时应 OK");
+
+    /* ① 盘上内容被改（把 S 改一位，同时把载荷 CRC 也重算好 —— 模拟"CRC 对但内容错"） */
+    ram_t copy = *r;
+    int sec = 1, changed = 0;
+    for (int s = 0; s < 2 && !changed; s++) {
+        uint32_t m;
+        memcpy(&m, copy.flash + s * PGB2_SECTOR, 4);
+        if (m == PGB2_MAGIC) { sec = s; changed = 1; }
+    }
+    copy.flash[sec * PGB2_SECTOR + PGB2_HDR + 8] ^= 0x01;   /* 动 S 的最低位 */
+    /* 重算载荷 CRC（让格式看起来完好） */
+    {
+        uint8_t h[PGB2_HDR];
+        memcpy(h, copy.flash + sec * PGB2_SECTOR, PGB2_HDR);
+        uint16_t cnt = (uint16_t)(h[12] | (h[13] << 8));
+        uint32_t crc = 0xFFFFFFFFu;
+        const uint8_t *p = copy.flash + sec * PGB2_SECTOR + PGB2_HDR;
+        for (size_t i = 0; i < (size_t)cnt * PGB2_REC; i++) {
+            crc ^= p[i];
+            for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(crc & 1)));
+        }
+        crc = ~crc;
+        h[16] = (uint8_t)crc; h[17] = (uint8_t)(crc >> 8);
+        h[18] = (uint8_t)(crc >> 16); h[19] = (uint8_t)(crc >> 24);
+        /* 头 CRC 覆盖 [0..20)，里面含载荷 CRC —— 不重算它，分区会被判整块无效，
+           就变成"回退到旧数据"，测不到"CRC 全对但内容不符"这个真正的坑 */
+        uint32_t hc = 0xFFFFFFFFu;
+        for (int i = 0; i < 20; i++) {
+            hc ^= h[i];
+            for (int k = 0; k < 8; k++) hc = (hc >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(hc & 1)));
+        }
+        hc = ~hc;
+        h[20] = (uint8_t)hc; h[21] = (uint8_t)(hc >> 8);
+        h[22] = (uint8_t)(hc >> 16); h[23] = (uint8_t)(hc >> 24);
+        memcpy(copy.flash + sec * PGB2_SECTOR, h, PGB2_HDR);
+    }
+    pgb2_io_t io2 = make_io(&copy);
+    pgb2_mount(&io2);
+    CHECK(pgb2_meta_verify() == PGB2_ERR_CRC, "CRC 对但内容不符 → 必须 FAIL(CRC)，实为 %d", (int)pgb2_meta_verify());
+
+    /* ② 确认槽比盘上更新（= 已确认的写入丢了） */
+    ram_t r3 = *r;
+    uint32_t seq;
+    memcpy(&seq, r3.meta + 4, 4);
+    seq += 5;
+    memcpy(r3.meta + 4, &seq, 4);
+    pgb2_io_t io3 = make_io(&r3);
+    pgb2_mount(&io3);
+    CHECK(pgb2_meta_verify() == PGB2_ERR_IO, "盘上比确认槽旧 → 必须 FAIL(IO)，实为 %d", (int)pgb2_meta_verify());
+}
+
+/* ---------------------------------------------------------------- 掉电 100 次 */
+static void t_powercut_100(void)
+{
+    printf("\n  掉电 100 次（每轮：改数据 → sync 随机被切断 → 重启 → 比对确认内容）\n");
+    enum { ROUNDS = 100 };
+    int lost = 0, corrupt = 0, ok_new = 0, ok_old = 0, cuts_total = 0;
+
+    ram_t r;
+    ram_reset(&r);
+    pgb2_io_t io = make_io(&r);
+    pgb2_mount(&io);
+    PUT(42, 1.0f, 5.0f, 1);
+    pgb2_sync();                                   /* 一个稳定的起点 */
+    pgb2_unmount();
+
+    unsigned seed = 20261025u;
+    for (int i = 0; i < ROUNDS; i++) {
+        /* --- 重启：只保留 flash 与 meta（内存/RAM 环全丢） --- */
+        pgb2_unmount();
+        pgb2_ring_reset();
+        io = make_io(&r);
+        pgb2_err_t me = pgb2_mount(&io);
+        CHECK(me == PGB2_OK, "第 %d 轮：重启后必须能挂载（实为 %d）", i, (int)me);
+        CHECK(pgb2_meta_verify() == PGB2_OK, "第 %d 轮：重启后确认槽必须对得上", i);
+
+        pgb2_card_t before;
+        int had = (pgb2_get(42, &before) == PGB2_OK);
+        const uint32_t seq_before = pgb2_seq();
+
+        /* --- 改数据 + sync，预算随机（0 .. 2.5 个区） --- */
+        seed = seed * 1103515245u + 12345u;
+        const long budget = (long)((seed >> 16) % (unsigned)(PGB2_SECTOR * 5 / 2));
+        PUT(42, (float)(i + 2), 5.0f, (uint16_t)(i % 30));
+        r.budget = budget; r.used = 0; r.cutting = 1;
+        const pgb2_err_t se = pgb2_sync();
+        r.cutting = 0; r.budget = -1;
+        cuts_total += (int)r.cuts; r.cuts = 0;
+
+        /* --- 再"重启"一次，验证：sync 成功的必须还在；没成功的必须仍是旧值 --- */
+        pgb2_unmount();
+        pgb2_ring_reset();
+        io = make_io(&r);
+        const pgb2_err_t me2 = pgb2_mount(&io);
+        CHECK(me2 == PGB2_OK, "第 %d 轮：掉电后必须能挂载（实为 %d）", i, (int)me2);
+        const pgb2_err_t mv = pgb2_meta_verify();
+        if (mv == PGB2_ERR_IO) { lost++; CHECK(0, "第 %d 轮：已确认的 seq 丢了（budget=%ld）", i, budget); }
+        if (mv == PGB2_ERR_CRC) { corrupt++; CHECK(0, "第 %d 轮：CRC 对但内容不符（budget=%ld）", i, budget); }
+
+        pgb2_card_t now;
+        if (se == PGB2_OK) {
+            /* 写完并回读校验过 ⇒ 内容必须是新的 */
+            ok_new++;
+            CHECK(pgb2_seq() > seq_before, "第 %d 轮：sync 成功却没换区（seq %u → %u）", i, seq_before, pgb2_seq());
+            CHECK(pgb2_get(42, &now) == PGB2_OK && now.S == (float)(i + 2),
+                  "第 %d 轮：sync 成功但读回 S=%.1f（应为 %.1f）", i, now.S, (float)(i + 2));
+        } else {
+            /* 被切断 ⇒ 必须完好地回到上一份确认状态，一个字节都不许丢 */
+            ok_old++;
+            if (had) {
+                CHECK(pgb2_get(42, &now) == PGB2_OK && now.S == before.S,
+                      "第 %d 轮：掉电后应回到旧值 S=%.1f，实为 %.1f", i, before.S, now.S);
+            }
+            CHECK(pgb2_seq() == seq_before, "第 %d 轮：掉电后 seq 应停在 %u，实为 %u", i, seq_before, pgb2_seq());
+        }
+    }
+    printf("     切断 %d 轮 / 成功 %d 轮（切点总计 %d 次）｜ 丢数据 %d 次 ｜ 内容不符 %d 次\n",
+           ok_old, ok_new, cuts_total, lost, corrupt);
+    CHECK(lost == 0, "100 次掉电里丢了 %d 次已确认数据", lost);
+    CHECK(corrupt == 0, "100 次掉电里 %d 次出现「CRC 对但内容不符」", corrupt);
+}
+
+/* ---------------------------------------------------------------- main */
+int main(void)
+{
+    ram_t r;
+    printf("PGB2 host 测试\n");
+    printf("  扇区 %u B × 2 ｜ 记录 %u B ｜ 最多 %u 张卡\n",
+           (unsigned)PGB2_SECTOR, (unsigned)PGB2_REC, (unsigned)PGB2_MAX_CARDS);
+
+    printf("\n[1] 空盘\n");            t_empty(&r);
+    printf("[2] 基本读写 + 重挂载\n");  t_basic(&r);
+    printf("[3] 覆盖更新与取新\n");      t_update_and_order(&r);
+    printf("[4] 一区 CRC 坏 → 回退\n");  t_crc_fallback(&r);
+    printf("[5] 两区全坏 → 报错 + 重建\n"); t_both_bad(&r);
+    printf("[6] 只读模式（数据比固件新）\n"); t_readonly(&r);
+    printf("[7] 确认槽跨重启比对\n");     t_meta_verify(&r);
+    t_powercut_100();
+
+    printf("\n%s  （%d 项检查，失败 %d）\n", g_fail ? "❌ FAIL" : "✅ 全部通过", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
