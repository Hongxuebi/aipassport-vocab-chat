+
+#if APP_VOICE_DIAG
+/* 【临时】走真实界面：进「AI对话」→ 模拟按住 ● 2.5 秒 → 松手 → 等回复播完 → 长按 ▲ 退出 */
+static void voice_diag_fn(void *arg)
+{
+    (void)arg;
+    for (int i = 0; i < 120; i++) {          /* 等 IP，别写死 9 秒 */
+        esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
