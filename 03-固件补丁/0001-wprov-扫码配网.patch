+    ESP_LOGI(TAG, "【自测】收尾：空闲堆 %u B ｜ 最大块 %u B",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    vTaskDelete(NULL);
+}
+
+void demo_diary_diag_start(void)
+{
+    if (xTaskCreate(diary_diag_task, "diary_diag", 3072, NULL, 3, NULL) != pdPASS)
+        ESP_LOGW(TAG, "【自测】任务建不起来");
+}
+#else
+void demo_diary_diag_start(void) { }
+#endif
