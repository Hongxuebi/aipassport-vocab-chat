index 0000000..7e8a938
--- /dev/null
+++ b/main/app_ding.c
@@ -0,0 +1,156 @@
+// main/app_ding.c —— 番茄到点那声「叮」的播放层（v0.91）
+//
+// 三条铁律（都是踩过的）：
+//   ① **不在 LVGL 上下文写 I2S**：450 ms 的写是阻塞的。`app_ding_start()` 只建任务、立刻返回；
+//      真正喂 I2S 在 `ding_task` 里（N1 / N18）。
+//   ② **单飞**：`s_busy` 先占标志再建任务，正响着再喊就拒绝（N2 那把锁的老写法），不叠两声。
+//   ③ **不跟语音抢**：`voice_talk_active()` 时直接让位 —— 两个任务同时写 I2S 是两段音频搅在一起。
+//
+// 为什么是常驻数组：不是懒 —— `73-番茄叮-分区余量与方案-2026-10-29.md` 里算过账，
+// 现在的分区表里**没有 assets 分区**了，能塞的地方只有裸 storage（装着学习进度，不碰）。
+#include "app_ding.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "app_config.h"
+#include "app_volume.h"
+#include "bsp_audio.h"
+#include "ding_pcm.h"
+#include "esp_heap_caps.h"
+#include "esp_timer.h"
+#include "esp_log.h"
+#include "esp_system.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "voice_talk.h"
+
+static const char *TAG = "ding";
+
+#define DING_CHUNK   2048        /* 一次喂 2 KB（64 ms）：好打断、栈上不留大缓冲 */
+#define DING_STACK   3072
+#define DING_PRIO    5           /* 和 pet_talk 同级：播音乐不该比刷屏低 */
+#define DING_TRY_MAX 3           /* 建任务失败重试次数（见 ding_try 的注释） */
+#define DING_RETRY_MS 400
+
+static volatile bool s_busy;
+static TaskHandle_t  s_task;
+static esp_timer_handle_t s_retry;      /* 失败重试用（放在 esp_timer 任务里跑，不另开栈） */
+static int           s_tries;
+
+
+static void ding_task(void *arg)
+{
+    (void)arg;
+    const size_t total = (size_t)k_ding_pcm_n * sizeof(int16_t);
+    esp_err_t    e     = bsp_audio_set_format(K_DING_SR, 16, 1);
+    if (e == ESP_OK) {
+        /* 语音页结束 / 休眠唤醒都会把 codec 复位 ⇒ 每次响之前把音量重设一次（幂等） */
+        app_volume_set(app_volume_get(), false);
+        for (size_t off = 0; off < total; off += DING_CHUNK) {
+            const size_t n = (total - off < DING_CHUNK) ? (total - off) : DING_CHUNK;
+            e = bsp_audio_write((const uint8_t *)k_ding_pcm + off, n);
+            if (e != ESP_OK) { ESP_LOGW(TAG, "写喇叭失败（已送 %u/%u B）：%s",
+                                        (unsigned)off, (unsigned)total, esp_err_to_name(e)); break; }
+        }
+    } else {
+        ESP_LOGW(TAG, "设置 16k/16/1 失败：%s", esp_err_to_name(e));
+    }
+
+    if (e == ESP_OK) {
+        ESP_LOGI(TAG, "叮：已播 %u 采样（%u ms），空闲堆 %u B",
+                 (unsigned)k_ding_pcm_n, (unsigned)(k_ding_pcm_n * 1000u / K_DING_SR),
+                 (unsigned)esp_get_free_heap_size());
+        /* 最后一块还在 DMA 里（最多 bsp_audio_tx_buffer_ms()），等它出完再放手，
+           这样 busy 标志和"耳朵听到的"是对齐的，不会被第二次叮咬尾。 */
+        vTaskDelay(pdMS_TO_TICKS(bsp_audio_tx_buffer_ms() > 0 ? bsp_audio_tx_buffer_ms() : 40));
+    }
+
+    s_task = NULL;
+    s_busy = false;
+    vTaskDelete(NULL);
+}
+
+/* 真正去建那个播放任务。**为什么要有重试**（2026-10-29 真机查出来的）：
+   开机第 5 s 时 WiFi 正在起，空闲堆只有 **3,644 B** —— 3 KB 栈的任务当场建不起来
+   （`叮：任务建不起来（空闲堆 3644 B）`），2.5 s 后同一个调用就成功了。
+   到点那一刻堆一般有 14–20 KB，但不该赌"每次都在宽裕时刻到点"，所以失败就排一次重试
+   —— 重试跑在**已有的 esp_timer 任务**里（不另开栈，也就不会再因为堆不够而失败）。 */
+static esp_err_t ding_try(void);            /* 下面才定义，重试回调要先声明 */
+
+static void ding_retry_cb(void *arg)
+{
+    (void)arg;
+    if (s_busy) return;                     /* 这段时间里别人（语音）占了，就别插队 */
+    (void)ding_try();                        /* 重试也失败：ding_try 内部会打日志并放弃 */
+}
+
+static esp_err_t ding_try(void)
+{
+    s_busy = true;
+    if (xTaskCreate(ding_task, "ding", DING_STACK, NULL, DING_PRIO, &s_task) == pdPASS) {
+        s_tries = 0;
+        return ESP_OK;
+    }
+    s_busy = false;
+    s_task = NULL;
+    if (++s_tries < DING_TRY_MAX) {
+        if (s_retry == NULL) {
+            const esp_timer_create_args_t a = { .callback = ding_retry_cb, .name = "ding_retry" };
+            if (esp_timer_create(&a, &s_retry) != ESP_OK) s_retry = NULL;
+        }
+        if (s_retry && esp_timer_start_once(s_retry, (uint64_t)DING_RETRY_MS * 1000) == ESP_OK) {
+            ESP_LOGW(TAG, "叮：堆太紧（空闲 %u B），%d ms 后第 %d 次重试",
+                     (unsigned)esp_get_free_heap_size(), DING_RETRY_MS, s_tries);
+            return ESP_OK;                  /* 已排队 ⇒ 对调用方算"接下了" */
+        }
+    }
+    s_tries = 0;
+    ESP_LOGW(TAG, "叮：任务建不起来（空闲堆 %u B，已重试 %d 次，这次放弃）",
+             (unsigned)esp_get_free_heap_size(), DING_TRY_MAX - 1);
+    return ESP_ERR_NO_MEM;
+}
+
+esp_err_t app_ding_start(void)
+{
+    if (s_busy) {
+        ESP_LOGI(TAG, "正在响（或已排队），忽略这次的叮");
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (voice_talk_active()) {
+        ESP_LOGI(TAG, "语音进行中，叮 让位");
+        return ESP_ERR_INVALID_STATE;
+    }
+    s_tries = 0;
+    return ding_try();
+}
+
+bool app_ding_busy(void) { return s_busy; }
+
+/* ---------------------------------------------------------------- 自测（交付版关） */
+#if APP_DING_DIAG
+static void ding_diag_task(void *arg)
+{
+    (void)arg;
+    vTaskDelay(pdMS_TO_TICKS(5000));
+    ESP_LOGI(TAG, "【自测】第一声叮");
+    (void)app_ding_start();
+    vTaskDelay(pdMS_TO_TICKS(2500));
+    ESP_LOGI(TAG, "【自测】第二声叮（验证单飞标志已释放）");
+    (void)app_ding_start();
+    vTaskDelay(pdMS_TO_TICKS(2500));
+    ESP_LOGI(TAG, "【自测】叮 完成：空闲堆 %u B ｜ 最大连续块 %u B",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    vTaskDelete(NULL);
+}
+
+void app_ding_diag_start(void)
+{
+    if (xTaskCreate(ding_diag_task, "ding_diag", DING_STACK, NULL, 3, NULL) != pdPASS) {
+        ESP_LOGW(TAG, "【自测】任务建不起来");
+    }
+}
+#else
+void app_ding_diag_start(void) { }
+#endif
diff --git a/main/app_ding.h b/main/app_ding.h
new file mode 100644
index 0000000..6370849
--- /dev/null
+++ b/main/app_ding.h
@@ -0,0 +1,27 @@
+// main/app_ding.h —— 番茄到点那声「叮」（v0.91）
+//
+// 为什么单独一层（而不是塞进 app_volume 的 beep）：
+//   · beep 是**方波感的正弦 90 ms**，用来"试听音量"够了，但当"番茄完成"的奖励音太寒酸；
+//   · 「叮」是 450 ms 的金属铃（非谐泛音 + 指数衰减），波形常驻 flash（`ding_pcm.c`，14,400 B）；
+//   · 它必须**在独立任务里**喂 I2S：450 ms 的写是阻塞的，绝不能在 LVGL 定时器/按键回调里做（N1/N18）。
+//
+// 口径（见 `73-番茄叮-分区余量与方案-2026-10-29.md` §四）：
+//   16 kHz / 16 bit / 单声道（和语音页同格式，切格式是幂等空转）；
+//   峰值 0.55 FS（音量 95% 也不削顶）；
+//   单飞：正响着再喊一次直接拒绝（不叠加）；
+//   语音进行中让位（不跟 TTS 抢 I2S）。
+#pragma once
+
+#include <stdbool.h>
+
+#include "esp_err.h"
+
+/* 立刻开始播一声「叮」：立刻返回，真正的写 I2S 在内部任务里跑。
+   返回 ESP_OK = 已开始；ESP_ERR_INVALID_STATE = 正在响 / 语音占用中；ESP_ERR_NO_MEM = 任务建不起来。 */
+esp_err_t app_ding_start(void);
+
+/* 是否正在响（含最后一块还在 DMA 里出的那一小段）。 */
+bool app_ding_busy(void);
+
+/* 自测：开机 5 s 后连响两声（`APP_DING_DIAG` 为 1 时才编译）。 */
+void app_ding_diag_start(void);
diff --git a/main/app_greet.c b/main/app_greet.c
new file mode 100644
index 0000000..69356fa
--- /dev/null
+++ b/main/app_greet.c
@@ -0,0 +1,113 @@
+// main/app_greet.c —— W3 开场：开机后台取一次 GET /greet（脸 + 一句 ≤14 字），进页上屏、默认不出声。
+//
+// 时序：开机（BSP 音频之后）→ 起一个 3 KB 栈的一次性任务 → 等 IP（最多 60 s）→ GET /greet
+//      → 存进内存（静态，几十字节）→ 任务自己退出。
+// 页里只调 app_greet_take()，**不发请求、不 malloc**（桌宠页的堆经不起）。
+// 拿不到（没网/超时/服务没起）就静默跳过：开场不该变成"进不去页面"。
+#include "app_greet.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "esp_log.h"
+#include "esp_netif.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "cJSON.h"
+
+#include "voice_talk.h"
+#include "app_config.h"
+#include "demo.h"
+
+static const char *TAG = "greet";
+
+#define GREET_LINE_MAX  64          /* 一句 ≤14 个汉字 = 42 B，留余量 */
+#define GREET_STACK     3072
+#define GREET_WAIT_MS   60000       /* 最多等 60 s 联网（开机到连上 WiFi 一般 2–5 s） */
+#define GREET_FACES     37
+
+static char             s_line[GREET_LINE_MAX];
+static int              s_face = -1;
+static volatile bool    s_ready;
+static bool             s_started;
+
+static bool ip_ok(void)
+{
+    esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t pi;
+    return nf && esp_netif_get_ip_info(nf, &pi) == ESP_OK && pi.ip.addr != 0;
+}
+
+static void greet_task(void *arg)
+{
+    (void)arg;
+#if APP_GREET_DIAG
+    /* 自测：**取真数据**，只多一步"9 s 后自动进 AI对话页"，用来验上屏（脸 + 气泡）。
+       判据：`开场就绪：face=…` → `【自测】进 AI对话页` → `开场上屏：…` → `气泡上屏：1 行`，无 Guru。 */
+    ESP_LOGI(TAG, "【自测】开场自测模式：等真数据后自动进页");
+#endif
+    for (int i = 0; i < GREET_WAIT_MS / 500; i++) {
+        if (ip_ok()) break;
+        vTaskDelay(pdMS_TO_TICKS(500));
+    }
+    if (!ip_ok()) {
+        ESP_LOGW(TAG, "没网，开场跳过（不挡进页）");
+        goto out;
+    }
+
+    /* 走语音口取（设备与服务端机永远不同网 ⇒ HTTP 到不了；见 voice_talk_greet 的注释） */
+    char body[256];
+    const int rc = voice_talk_greet(body, sizeof(body));
+    if (rc != 0) {
+        ESP_LOGW(TAG, "开场取数失败（%d），跳过（不挡进页）", rc);
+        goto out;
+    }
+
+    cJSON *j = cJSON_Parse(body);
+    if (!j) {
+        ESP_LOGW(TAG, "开场 JSON 解析失败：%s", body);
+        goto out;
+    }
+    const cJSON *fj = cJSON_GetObjectItem(j, "face");
+    const cJSON *lj = cJSON_GetObjectItem(j, "line");
+    if (cJSON_IsNumber(fj) && cJSON_IsString(lj) && lj->valuestring && lj->valuestring[0]) {
+        const int f = (int)fj->valuedouble;
+        if (f >= 0 && f < GREET_FACES) s_face = f;
+        snprintf(s_line, sizeof(s_line), "%s", lj->valuestring);
+        s_ready = true;
+        ESP_LOGI(TAG, "开场就绪：face=%d ｜「%s」（%s）", s_face, s_line, body);
+    } else {
+        ESP_LOGW(TAG, "/greet 缺 face/line，开场跳过");
+    }
+    cJSON_Delete(j);
+
+#if APP_GREET_DIAG
+    if (s_ready) {
+        vTaskDelay(pdMS_TO_TICKS(9000));
+        ESP_LOGI(TAG, "【自测】进 AI对话页（验开场上屏）");
+        app_sim_enter("AI对话");
+    }
+#endif
+
+out:
+    vTaskDelete(NULL);
+}
+
+void app_greet_init(void)
+{
+    if (s_started) return;
+    s_started = true;
+    if (xTaskCreate(greet_task, "greet", GREET_STACK, NULL, 4, NULL) != pdPASS) {
+        ESP_LOGE(TAG, "起任务失败（堆不够？），开场跳过");
+    }
+}
+
+int app_greet_take(int *face, char *out, size_t n)
+{
+    if (!s_ready || !s_line[0]) return 0;
+    if (out && n) snprintf(out, n, "%s", s_line);
+    if (face) *face = s_face;
+    s_ready = false;              /* 只上屏一次：第二次进页还是走平常的重逢/情绪逻辑 */
+    return 1;
+}
diff --git a/main/app_greet.h b/main/app_greet.h
new file mode 100644
index 0000000..9e421bd
--- /dev/null
+++ b/main/app_greet.h
@@ -0,0 +1,15 @@
+// main/app_greet.h —— W3 开场（2026-10-30）：开机后台取一次 GET /greet，进桌宠页上屏、默认不出声。
+//
+// 为什么放在开机后台、而不是"进页时再拉"：
+//   桌宠页是全机最费内存的页之一（18 KB 单缓冲 + LVGL），进页再起任务/开 socket 容易分不到
+//   连续块（v0.85 那次「内存不够 需要 36 KB」就是这类）。所以取数放在开机（BSP 音频之后），
+//   页里只读内存里那一句；拿不到就什么都不显示，绝不拖慢进页。
+#pragma once
+
+#include <stddef.h>
+
+/* 开机调一次（排在 demo_diary_init 之后，别早于 BSP 音频）。幂等。 */
+void app_greet_init(void);
+
+/* 取开场内容：成功（face 有效且 line 非空）返回 1 并拷到 out；只会成功一次（取完就清）。 */
+int app_greet_take(int *face, char *out, size_t n);
diff --git a/main/app_mic_gain.c b/main/app_mic_gain.c
new file mode 100644
index 0000000..4e2ba1a
--- /dev/null
+++ b/main/app_mic_gain.c
@@ -0,0 +1,74 @@
+// main/app_mic_gain.c —— 麦克风增益（NVS 持久化）
+//
+// 口径（2026-10-29 M2）：
+//   NVS `ui/micgain`（u8，0..42，默认 30）—— 跟音量的 `ui/vol` 同一个命名空间，别另起。
+//   改一次**立刻**生效：bsp_audio_set_in_gain() 会顺手把硬件 6 dB 档设好、数字尾数换掉；
+//   codec 下一次 open（换采样率/唤醒）时 bsp_audio 会自己套回这个值，所以不用在这里重复设。
+//
+// ⚠ 这个值直接影响**上行音量**：+2 dB ≈ 1.26 倍。它救不了"离得远/说话轻"，
+//   真正的收益只能靠念长句、看 ASR 回显（`72` §2.3）。
+#include "app_mic_gain.h"
+
+#include <stddef.h>
+
+#include "bsp_audio.h"
+#include "esp_log.h"
+#include "nvs.h"
+
+static const char *TAG = "micgain";
+
+#define MIC_NS  "ui"
+#define MIC_KEY "micgain"
+
+static int  s_db = APP_MIC_GAIN_DEFAULT;
+static bool s_dirty;
+
+static int clamp_db(int v)
+{
+    if (v < APP_MIC_GAIN_MIN) return APP_MIC_GAIN_MIN;
+    if (v > APP_MIC_GAIN_MAX) return APP_MIC_GAIN_MAX;
+    return v;
+}
+
+void app_mic_gain_init(void)
+{
+    nvs_handle_t h;
+    if (nvs_open(MIC_NS, NVS_READONLY, &h) == ESP_OK) {
+        uint8_t v = APP_MIC_GAIN_DEFAULT;
+        if (nvs_get_u8(h, MIC_KEY, &v) == ESP_OK) s_db = clamp_db((int)v);
+        nvs_close(h);
+    }
+    s_dirty = false;
+    bsp_audio_set_in_gain((float)s_db);
+    ESP_LOGI(TAG, "麦克风增益 %d dB（来自 NVS；硬件 6 dB 档 + 数字尾数，见 bsp_audio）", s_db);
+}
+
+int app_mic_gain_get(void) { return s_db; }
+
+void app_mic_gain_set(int db, bool save)
+{
+    const int v = clamp_db(db);
+    if (v != s_db) {
+        s_db = v;
+        s_dirty = true;
+    }
+    /* 即使没变也重设一次：codec 被 close/open 过之后，硬件档位会回到 open 时的值 */
+    bsp_audio_set_in_gain((float)s_db);
+    ESP_LOGI(TAG, "麦克风增益 → %d dB", s_db);
+    if (save) app_mic_gain_save();
+}
+
+void app_mic_gain_save(void)
+{
+    if (!s_dirty) return;
+    nvs_handle_t h;
+    if (nvs_open(MIC_NS, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "NVS 打不开，麦克风增益没存下（本次运行仍生效）");
+        return;
+    }
+    (void)nvs_set_u8(h, MIC_KEY, (uint8_t)s_db);
+    (void)nvs_commit(h);
+    nvs_close(h);
+    s_dirty = false;
+    ESP_LOGI(TAG, "麦克风增益 %d dB 已存 NVS", s_db);
+}
diff --git a/main/app_mic_gain.h b/main/app_mic_gain.h
new file mode 100644
index 0000000..7fd843a
--- /dev/null
+++ b/main/app_mic_gain.h
@@ -0,0 +1,26 @@
+// main/app_mic_gain.h —— 麦克风增益（NVS 持久化，0..42 dB）
+//
+// 为什么单独一层（2026-10-29 M2，作者："麦克风增益 +2 dB，进设置页可调"）：
+//   · 原来写死在 components/bsp/src/bsp_audio.c 的 `set_in_gain(30.0f)`，改一次要刷机；
+//   · 增益是"只有耳朵说了算"的量（`72` §2.3），必须**当场能调、退出重进还在、重启还在**。
+//   · 硬件只有 6 dB 台阶（ES8311 PGA），±2 dB 的细调由 bsp_audio 用数字尾数补 —— 见 bsp_audio.h。
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define APP_MIC_GAIN_DEFAULT 30   /* dB（跟写死那一版一样的声音，听着最熟） */
+#define APP_MIC_GAIN_MIN      0
+#define APP_MIC_GAIN_MAX     42   /* ES8311 PGA 上限 */
+
+// 开机调一次：读 NVS → bsp_audio_set_in_gain()。幂等，失败不影响开机。
+void app_mic_gain_init(void);
+
+// 当前增益（dB）
+int app_mic_gain_get(void);
+
+// 设增益：**立即生效**（不用重进设置页，也不用重开 codec）；save=true 时写 NVS。
+void app_mic_gain_set(int db, bool save);
+
+// 把当前值写进 NVS（退出设置页时兜底保存）
+void app_mic_gain_save(void);
diff --git a/main/app_volume.c b/main/app_volume.c
new file mode 100644
index 0000000..f192973
--- /dev/null
+++ b/main/app_volume.c
@@ -0,0 +1,126 @@
+// main/app_volume.c —— 全局音量（NVS 持久化）＋ 短提示音
+//
+// 为什么单独一层：音量要跨页面（设置页调、语音页用、以后蜂鸣也用），而且**必须记住**
+// （作者调一次不该每次开机重调）。放 NVS 的 "ui"/"vol"（和番茄、卡片那些 ns 分开）。
+//
+// 提示音口径（真机踩过的）：
+//   · 直接怼方波会在开头/结尾"啪"一声 ⇒ 前后各 3ms 线性淡入淡出。
+//   · 静态缓冲只占 1KB（512 采样 × 2B），严禁再大 —— 这台 C3 连上 WiFi 后最大连续块只有 ~21KB。
+//   · 写 I2S 前先 set_format(16000,16,1)：语音页播完是 16k，切格式是廉价的幂等操作。
+#include "app_volume.h"
+
+#include <math.h>
+#include <stddef.h>
+
+#include "bsp_audio.h"
+#include "esp_log.h"
+#include "nvs.h"
+
+static const char *TAG = "volume";
+
+#define VOL_NS  "ui"
+#define VOL_KEY "vol"
+
+#define BEEP_SR      16000
+#define BEEP_BUF_N   512          /* 32ms @16k，静态 1KB */
+#define BEEP_MAX_MS  400
+#define BEEP_MIN_MS  20
+#define BEEP_FADE_N  48           /* 3ms 淡入淡出，防爆音 */
+
+static uint8_t s_vol = APP_VOL_DEFAULT;
+static bool    s_ready;
+static bool    s_dirty;
+
+static uint8_t vol_clamp(int v)
+{
+    if (v < 0) return 0;
+    if (v > 100) return 100;
+    return (uint8_t)v;
+}
+
+void app_volume_init(void)
+{
+    nvs_handle_t h;
+    if (nvs_open(VOL_NS, NVS_READONLY, &h) == ESP_OK) {
+        uint8_t v = APP_VOL_DEFAULT;
+        if (nvs_get_u8(h, VOL_KEY, &v) == ESP_OK) s_vol = vol_clamp(v);
+        nvs_close(h);
+    }
+    s_ready = true;
+    s_dirty = false;
+    bsp_audio_set_volume(s_vol);
+    ESP_LOGI(TAG, "音量 %u%%（来自 NVS）", (unsigned)s_vol);
+}
+
+uint8_t app_volume_get(void) { return s_vol; }
+
+void app_volume_set(uint8_t percent, bool save)
+{
+    const uint8_t v = vol_clamp(percent);
+    if (v != s_vol) {
+        s_vol = v;
+        s_dirty = true;
+        ESP_LOGI(TAG, "音量 → %u%%", (unsigned)s_vol);
+    }
+    bsp_audio_set_volume(s_vol);      /* 即使没变也重设一次：语音页结束会被 codec 复位 */
+    if (save) app_volume_save();
+}
+
+void app_volume_save(void)
+{
+    if (!s_dirty) return;
+    nvs_handle_t h;
+    if (nvs_open(VOL_NS, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "NVS 打不开，音量没存下（本次运行仍生效）");
+        return;
+    }
+    (void)nvs_set_u8(h, VOL_KEY, s_vol);
+    (void)nvs_commit(h);
+    nvs_close(h);
+    s_dirty = false;
+    ESP_LOGI(TAG, "音量 %u%% 已存 NVS", (unsigned)s_vol);
+}
+
+esp_err_t app_volume_beep_at(int freq_hz, int ms)
+{
+    if (!s_ready) app_volume_init();
+    if (freq_hz < 200) freq_hz = 200;
+    if (freq_hz > 4000) freq_hz = 4000;
+    if (ms < BEEP_MIN_MS) ms = BEEP_MIN_MS;
+    if (ms > BEEP_MAX_MS) ms = BEEP_MAX_MS;
+
+    esp_err_t e = bsp_audio_set_format(BEEP_SR, 16, 1);
+    if (e != ESP_OK) {
+        ESP_LOGW(TAG, "设置音频格式失败：%s", esp_err_to_name(e));
+        return e;
+    }
+
+    static int16_t buf[BEEP_BUF_N];
+    const int   total = BEEP_SR * ms / 1000;
+    const float step  = 2.0f * 3.14159265f * (float)freq_hz / (float)BEEP_SR;
+    float       phase = 0.0f;
+
+    for (int done = 0; done < total; ) {
+        int n = total - done;
+        if (n > BEEP_BUF_N) n = BEEP_BUF_N;
+        for (int i = 0; i < n; i++) {
+            const int idx = done + i;
+            float env = 1.0f;
+            if (idx < BEEP_FADE_N) env = (float)idx / (float)BEEP_FADE_N;
+            const int left = total - idx;
+            if (left < BEEP_FADE_N) env = (float)left / (float)BEEP_FADE_N;
+            buf[i] = (int16_t)(sinf(phase) * env * 12000.0f);
+            phase += step;
+            if (phase > 6.2831853f) phase -= 6.2831853f;
+        }
+        e = bsp_audio_write(buf, (size_t)n * sizeof(int16_t));
+        if (e != ESP_OK) {
+            ESP_LOGW(TAG, "写喇叭失败：%s", esp_err_to_name(e));
+            return e;
+        }
+        done += n;
+    }
+    return ESP_OK;
+}
+
+esp_err_t app_volume_beep(void) { return app_volume_beep_at(1200, 90); }
