+/* ================================ 说话三档 ================================ */
+
+/* 电平 → 千分比（照流云记 `getMouthExpr` 那条曲线，整数算） */
+static uint16_t mouth_lvl(uint32_t mean)
+{
+    if (mean < MOUTH_SILENT_MEAN) return MOUTH_LVL_SILENT;
+    const uint32_t lvl = 50u + ((mean * 2500u) >> 15);      /* ≈ mean/13.1 */
+    return lvl > 1000u ? 1000u : (uint16_t)lvl;
+}
+
+/* voice_talk 的回调：**跑在 talk_task 里**，只写标志/算统计，绝不碰 LVGL */
+static void on_voice_level(uint32_t mean_abs, bool first)
+{
+    s_audio_mean    = mean_abs;
+    s_last_chunk_ms = now_ms();
+    if (first) {                       /* 首字节 = 她开始出声（EV_REPLY_START） */
+        s_her_voice = true;
+        s_cal_blocks = 0; s_cal_sum = 0; s_cal_max = 0;
+        memset(s_cal_tier, 0, sizeof(s_cal_tier));
+        memset(s_cal_bin, 0, sizeof(s_cal_bin));
+    }
+    s_cal_blocks++;
+    s_cal_sum += mean_abs;
+    /* 每 5 块（160 ms）吐一行电平：调试台的"实时电平条"就靠它（只在出声时才有） */
+    if ((s_cal_blocks % 5u) == 1u) {
+        ESP_LOGI(TAG, "电平 %u lvl %u", (unsigned)mean_abs, (unsigned)mouth_lvl(mean_abs));
+    }
+    if (mean_abs > s_cal_max) s_cal_max = mean_abs;
+    s_cal_bin[mean_abs >= 16000u ? 16u : (mean_abs / 1000u)]++;
+}
+
+/* 一轮说完打一行校准账：第一次上机靠它把 80 / 350 两个阈值钉死 */
+static void cal_report(bool ok)
+{
+    if (!s_cal_blocks) return;
+    char bins[130];
+    int off = 0;
+    for (int i = 0; i <= 16 && off < (int)sizeof(bins) - 8; i++) {
+        off += snprintf(bins + off, sizeof(bins) - off, "%s%u", i ? "," : "",
+                        (unsigned)s_cal_bin[i]);
+    }
+    ESP_LOGI(TAG, "电平统计（%s）：%u 块 / 均值 %u / 峰 %u ｜ 档位计数 闭 %u 半 %u 大 %u",
+             ok ? "成功" : "失败", (unsigned)s_cal_blocks,
+             (unsigned)(s_cal_sum / s_cal_blocks), (unsigned)s_cal_max,
+             (unsigned)s_cal_tier[0], (unsigned)s_cal_tier[1], (unsigned)s_cal_tier[2]);
+    ESP_LOGI(TAG, "电平直方图（mean 每 1000 一格，最后一格=≥16000）：%s", bins);
+}
