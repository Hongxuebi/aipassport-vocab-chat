+static void show_current(void)
+{
+    if (s_qi >= s_qn) {
+        /* 🔴 完成态也必须换成中文字库：s_prog/s_word 平时是 latin 字体，
+           直接塞中文会是一排方块（2026-10-31 实测报「完成当天任务后弹出好几个方块」）。 */
+        if (s_prog) {
+            lv_obj_set_style_text_font(s_prog, &fusion_ui16, 0);
+            lv_label_set_text(s_prog, "完成");
+        }
+        if (s_word) {
+            lv_obj_set_style_text_font(s_word, &fusion_ui24, 0);
+            lv_label_set_text(s_word, "今天完成");
+            lv_obj_align(s_word, LV_ALIGN_TOP_MID, 0, 50);
+        }
+        if (s_ipa)  lv_label_set_text(s_ipa, "");
+        if (s_chunk) { lv_label_set_text(s_chunk, ""); lv_obj_add_flag(s_chunk, LV_OBJ_FLAG_HIDDEN); }
+        if (s_cn)   lv_label_set_text(s_cn, s_grade_cnt ? "长按 ● 返回" : "没有要背的了");
+        if (s_hint) lv_label_set_text(s_hint, "");
+        return;
+    }
+    const qitem_t *q = &s_q[s_qi];
+    /* 反应时的起点 = **这张卡第一次出现**（翻面不算，翻面也是回忆的一部分） */
+    if (s_shown_qi != s_qi) { s_shown_qi = s_qi; s_card_t0 = now_ms(); s_flip_t0 = 0; }
+
+    /* 在线时用服务端机发来的词条内容（服务端机改了词/换了书，设备不用重刷）；
+       离线用固件内置表；**id 超出内置表就不查它**（v0.112 起词表可大于 453） */
+    const char *tx_word = "", *tx_ipa = "", *tx_cn = "", *tx_chunk = "";
+    if (q->id < WORDS_BASHANG_N) {
+        const word_entry_t *w = &WORDS_BASHANG[q->id];
+        tx_word = w->word; tx_ipa = w->ipa; tx_cn = w->cn;
+    }
+    if (s_online || s_netq.n > 0) {          /* v0.126.2：只要网络队列在，词条内容就用网络版 */
+        for (int i = 0; i < s_netq.n; i++) {
+            if (s_netq.items[i].id == q->id) {
+                if (s_netq.items[i].word && s_netq.items[i].word[0]) tx_word = s_netq.items[i].word;
+                if (s_netq.items[i].ipa  && s_netq.items[i].ipa[0])  tx_ipa  = s_netq.items[i].ipa;
+                if (s_netq.items[i].cn   && s_netq.items[i].cn[0])   tx_cn   = s_netq.items[i].cn;
+                if (s_netq.items[i].chunk && s_netq.items[i].chunk[0]) tx_chunk = s_netq.items[i].chunk;
+                break;
+            }
+        }
+    }
+
+    if (s_word) {
+        /* 按长度换字号：28px 只放得下短词；词组（57 个，最长 "not only ... but also ..."）
+           必须降字号，否则换行后压到音标上 */
+        const size_t n = strlen(tx_word);
+        /* 英文用 DejaVu 矢量字体（4bpp 抗锯齿）：点阵字体放大到 28px 会出毛边（2026-10-25 作者反馈"太糊"） */
+        const lv_font_t *f = (n <= 10) ? &latin28 : (n <= 18) ? &latin20 : &latin16;
+        lv_obj_set_style_text_font(s_word, f, 0);
+        lv_obj_align(s_word, LV_ALIGN_TOP_MID, 0, (n <= 10) ? 50 : 56);
+        lv_label_set_text(s_word, tx_word);
+    }
+    if (s_ipa)  lv_label_set_text(s_ipa, tx_ipa);
+    if (s_cn) {
+        /* 释义用大字（作者："汉字有点小"）：≤18 字用 24px（=12px 的整数 2 倍，硬边不糊）；
+           再长就降 16/12，避免三行字压到底部按键提示。
+           **答案面才显示**（两段式：先回忆，翻面再对答案） */
+        const int m = utf8_len(tx_cn);
+        /* 有词块就占掉 y≈212 那一行 ⇒ 释义最多给到 16px（12px 时 18 字/行，两行够），别压住词块 */
+        const lv_font_t *cf = (m <= 18) ? (tx_chunk[0] ? &fusion_ui16 : &fusion_ui24)
+                                        : (m <= 30) ? &fusion_ui16 : &fusion_ui12;
+        lv_obj_set_style_text_font(s_cn, cf, 0);
+        lv_obj_align(s_cn, LV_ALIGN_TOP_MID, 0, (cf == &fusion_ui24) ? 114 : 118);
+        lv_label_set_text(s_cn, s_revealed ? tx_cn : "");
+    }
+    if (s_chunk) {
+        lv_label_set_text(s_chunk, tx_chunk);
+        lv_obj_set_style_text_font(s_chunk, &latin20, 0);
+    }
+    if (s_prog) {
+        char b[24];
+        snprintf(b, sizeof(b), "%d/%d", s_qi + 1, s_qn);
+        lv_label_set_text(s_prog, b);
+    }
+    layout_phase();
+    if (s_dbg) {
+        /* 底栏一行：第几天 / 新复 / 在不在线 / 只读 / **待传 N**（24 §⑤ 要求的状态可见） */
+        char b[48];
+        const uint32_t pend = ev_sync_pending();
+        const int n = snprintf(b, sizeof(b), "D%u %s %s%s", (unsigned)(s_day + 1),
+                               q->is_new ? "新" : "复",
+                               s_online ? "在线" : "离线",
+                               pgb2_readonly() ? " 只读" : "");
+        if (pend && n > 0 && n < (int)sizeof(b)) {
+            snprintf(b + n, sizeof(b) - (size_t)n, " 待传%u", (unsigned)pend);
+        }
+        lv_label_set_text(s_dbg, b);
+    }
+}
