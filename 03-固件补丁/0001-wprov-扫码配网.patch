diff --git a/main/demo_home.c b/main/demo_home.c
new file mode 100644
index 0000000..556f0f9
--- /dev/null
+++ b/main/demo_home.c
@@ -0,0 +1,303 @@
+// main/demo_home.c —— 主页（2026-10-28 v2）：深空青 + 极简排版 + 双向电扫圆环
+//
+// 视觉来源：作者在网页候选里选定 **I-3（双向对扫）**
+//   配色 = B（深空 HUD）：底 #050A10 / 主色 #7FE7FF / 字 #E6F9FF
+//   排版 = E（极简轨道）：大时钟左对齐、细线分隔、选中项只有一个小方块、其余留白
+//   圆环 = 两条电流相向扫：亮段不等长，反向转动，构成"通电"感
+//
+// 实现要点（C3 只有 160MHz，别把重绘做贵了）：
+//   · 背景纯色（不用渐变），上面盖一条很淡的顶光带 → 每帧不会重算渐变
+//   · 环用 2 个 lv_arc（不做逐像素画布），10fps 改角度，单帧只重绘 160×160 区域
+//   · 时钟 1s 刷一次、电量 10s 读一次（I2C 别每秒打）
+//   · 规矩照旧：label 固定 w/h、中文只用 fusion 字库、退页删定时器
+#include <stdio.h>
+#include <string.h>
+
+#include "lvgl.h"
+#include "demo.h"
+#include "ui_pixel.h"
+#include "esp_log.h"
+#include "esp_netif.h"
+#include "bsp_battery.h"
+#include "time_sync.h"
+
+LV_FONT_DECLARE(fusion_ui12);
+LV_FONT_DECLARE(fusion_ui16);
+LV_FONT_DECLARE(clock48);
+
+static const char *TAG = "home";
+
+void app_request_enter(int idx);
+void app_request_enter_name(const char *name);
+
+/* ---- 配色（I-3）---- */
+#define SC_BG      0x05090Fu
+#define SC_BAND    0x0A1A26u
+#define CY         0x7FE7FFu
+#define CY_MID     0x3FA8C4u
+#define CY_GHOST   0x12323Fu
+#define INK        0xE6F9FFu
+#define MUTED      0x8FA4B8u
+#define HAIR       0x162834u
+
+/* ---- 圆环 ---- */
+#define RING_D      150              /* 直径（v0.98：160→150，给第 5 行让出 12 px） */
+#define RING_X      ((240 - RING_D) / 2)
+#define RING_Y      16
+#define RING_STEP   10               /* 每拍 10° */
+#define RING_MS     100              /* 10fps → 3600ms 一圈 */
+#define RING_LEN_F  46               /* 顺时针这条的亮段 */
+#define RING_LEN_R  32               /* 逆时针这条短一点，交错才有层次 */
+
+#define HOME_ROWS 5
+static const char *ROW_NAME[HOME_ROWS]   = { "背单词", "AI对话", "番茄时间", "日记", "设置" };
+static const char *ROW_TARGET[HOME_ROWS] = { "背单词", "AI对话", "番茄时间", "日记", "设置" };
+
+static lv_obj_t *s_scr;
+static lv_obj_t *s_row[HOME_ROWS];
+static lv_obj_t *s_mark[HOME_ROWS];
+static lv_obj_t *s_clock;
+static lv_obj_t *s_date;
+static lv_obj_t *s_net_l;   /* 左上角联网状态：已联网 / 未联网（2026-10-31 去掉 0x1F·WIFI） */
+static lv_obj_t *s_stat_r;
+static lv_obj_t *s_arc_f;
+static lv_obj_t *s_arc_r;
+static lv_timer_t *s_timer_1s;
+static lv_timer_t *s_timer_ring;
+static int s_sel;
+static int s_ang;
+static int s_batt_tick;
+
+static const char *WEEKDAY[7] = { "日", "一", "二", "三", "四", "五", "六" };
+
+// ---------------------------------------------------------------- 圆环
+static void ring_tick(lv_timer_t *t)
+{
+    (void)t;
+    s_ang = (s_ang + RING_STEP) % 360;
+    // 前 3 拍各打一行：能证明"圆环真的在动、而且没被拖慢"（3 行/次进页，不刷屏）
+    static int s_probe;
+    if (s_probe < 3) {
+        ESP_LOGI(TAG, "环第 %d 拍：%d° / %d°", s_probe + 1, s_ang, (360 - s_ang) % 360);
+        s_probe++;
+    }
+    const int a2 = (360 - s_ang) % 360;                 /* 反向那条 */
+    lv_arc_set_angles(s_arc_f, s_ang, (s_ang + RING_LEN_F) % 360);
+    lv_arc_set_angles(s_arc_r, a2, (a2 + RING_LEN_R) % 360);
+}
+
+static lv_obj_t *make_arc(lv_obj_t *parent, uint32_t color, int width, lv_opa_t opa)
+{
+    lv_obj_t *a = lv_arc_create(parent);
+    lv_obj_remove_flag(a, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(a, RING_D, RING_D);
+    lv_obj_set_pos(a, RING_X, RING_Y);
+    lv_obj_set_style_bg_opa(a, LV_OPA_TRANSP, 0);       /* 弧的背景方块透明 */
+    lv_arc_set_bg_angles(a, 0, 360);
+    lv_obj_remove_style(a, NULL, LV_PART_KNOB);         /* 不要旋钮 */
+    lv_obj_set_style_arc_width(a, width, LV_PART_MAIN);
+    lv_obj_set_style_arc_width(a, width, LV_PART_INDICATOR);
+    lv_obj_set_style_arc_color(a, lv_color_hex(color), LV_PART_MAIN);
+    lv_obj_set_style_arc_color(a, lv_color_hex(color), LV_PART_INDICATOR);
+    lv_obj_set_style_arc_opa(a, opa, LV_PART_MAIN);
+    lv_obj_set_style_arc_opa(a, LV_OPA_COVER, LV_PART_INDICATOR);
+    lv_arc_set_angles(a, 0, 0);
+    return a;
+}
+
+// ---------------------------------------------------------------- 1 秒
+static void clock_refresh(void)
+{
+    char buf[16];
+    char dbuf[40];
+    if (!time_sync_valid()) {
+        snprintf(buf, sizeof(buf), "--:--");
+        snprintf(dbuf, sizeof(dbuf), "未对时 · 等联网");
+    } else {
+        const time_t now = time_sync_now();
+        struct tm tmv;
+        localtime_r(&now, &tmv);
+        snprintf(buf, sizeof(buf), "%02d:%02d", tmv.tm_hour, tmv.tm_min);
+        snprintf(dbuf, sizeof(dbuf), "%04d.%02d.%02d  周%s", tmv.tm_year + 1900, tmv.tm_mon + 1,
+                 tmv.tm_mday, WEEKDAY[tmv.tm_wday % 7]);
+    }
+    if (s_clock && strcmp(lv_label_get_text(s_clock), buf) != 0) lv_label_set_text(s_clock, buf);
+    if (s_date && strcmp(lv_label_get_text(s_date), dbuf) != 0) lv_label_set_text(s_date, dbuf);
+}
+
+static bool net_online(void)
+{
+    esp_netif_t *nf = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t pi = {0};
+    return nf && esp_netif_get_ip_info(nf, &pi) == ESP_OK && pi.ip.addr;
+}
+
+static void status_refresh(bool force_batt)
+{
+    if (s_net_l) {
+        const char *want = net_online() ? "已联网" : "未联网";
+        if (strcmp(lv_label_get_text(s_net_l), want) != 0) lv_label_set_text(s_net_l, want);
+    }
+    if (!s_stat_r) return;
+    if (force_batt || (s_batt_tick % 10) == 0) {
+        const int soc = bsp_battery_soc();
+        if (soc >= 0) lv_label_set_text_fmt(s_stat_r, "%d%%", soc);
+        else          lv_label_set_text(s_stat_r, "--");
+    }
+    s_batt_tick++;
+}
+
+static void tick_1s(lv_timer_t *t)
+{
+    (void)t;
+    clock_refresh();
+    status_refresh(false);
+}
+
+// ---------------------------------------------------------------- 页面
+void demo_home_enter(void)
+{
+    s_sel = 0;
+    s_ang = 0;
+    s_batt_tick = 0;
+
+    s_scr = lv_obj_create(NULL);
+    lv_obj_remove_flag(s_scr, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_color(s_scr, lv_color_hex(SC_BG), 0);
+    lv_obj_set_style_border_width(s_scr, 0, 0);
+    lv_obj_set_style_pad_all(s_scr, 0, 0);
+    lv_obj_set_style_radius(s_scr, 0, 0);
+
+    /* 顶部一层很淡的"天光"，给纯色底一点纵深（一次画、不随圆环重绘） */
+    lv_obj_t *band = lv_obj_create(s_scr);
+    lv_obj_remove_flag(band, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_pos(band, 0, 0);
+    lv_obj_set_size(band, 240, 132);
+    lv_obj_set_style_bg_color(band, lv_color_hex(SC_BAND), 0);
+    lv_obj_set_style_bg_opa(band, LV_OPA_50, 0);
+    lv_obj_set_style_border_width(band, 0, 0);
+    lv_obj_set_style_radius(band, 0, 0);
+
+    /* 状态行：左边节点名 / 右边电量 */
+    /* 2026-10-31 实测报「wifi 前面有个 0x1f，看不懂」——那是个残留调试占位。
+       现在直接写中文：已联网 / 未联网（1 秒刷新，开机没连上也会自己变）。 */
+    s_net_l = ui_pixel_label(s_scr, net_online() ? "已联网" : "未联网",
+                             &fusion_ui12, CY_MID);
+    lv_obj_set_size(s_net_l, 150, 14);
+    lv_obj_set_pos(s_net_l, 12, 7);
+    lv_obj_set_style_text_letter_space(s_net_l, 1, 0);
+
+    s_stat_r = ui_pixel_label(s_scr, "--", &fusion_ui12, CY_MID);
+    lv_obj_set_size(s_stat_r, 60, 14);
+    lv_obj_set_pos(s_stat_r, 168, 7);
+    lv_obj_set_style_text_align(s_stat_r, LV_TEXT_ALIGN_RIGHT, 0);
+
+    /* 圆环：外层描边（很暗）+ 两条反向电流 */
+    lv_obj_t *ghost = make_arc(s_scr, CY, 1, LV_OPA_30);
+    lv_arc_set_angles(ghost, 0, 360);                    /* 整圈做底 */
+    lv_obj_set_style_arc_opa(ghost, LV_OPA_20, LV_PART_INDICATOR);
+
+    s_arc_f = make_arc(s_scr, CY, 2, LV_OPA_TRANSP);
+    s_arc_r = make_arc(s_scr, 0xBFF2FF, 2, LV_OPA_TRANSP);
+
+    /* 时钟与日期 */
+    s_clock = ui_pixel_label(s_scr, "--:--", &clock48, INK);
+    lv_obj_set_size(s_clock, 216, 52);
+    lv_obj_set_pos(s_clock, 12, 52);
+
+    s_date = ui_pixel_label(s_scr, "", &fusion_ui12, CY_MID);
+    lv_obj_set_size(s_date, 216, 16);
+    lv_obj_set_pos(s_date, 12, 112);
+    lv_obj_set_style_text_letter_space(s_date, 2, 0);
+
+    /* 五个入口：细线分隔 + 选中方块（行高仍 30，起点从 182 提到 170 —— 顶上让 12 px） */
+    for (int i = 0; i < HOME_ROWS; i++) {
+        const int y = 170 + i * 30;
+        lv_obj_t *row = lv_obj_create(s_scr);
+        lv_obj_remove_flag(row, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_pos(row, 12, y);
+        lv_obj_set_size(row, 216, 30);
+        lv_obj_set_style_bg_opa(row, LV_OPA_TRANSP, 0);
+        lv_obj_set_style_pad_all(row, 0, 0);
+        lv_obj_set_style_radius(row, 0, 0);
+        lv_obj_set_style_border_width(row, 1, 0);
+        lv_obj_set_style_border_side(row, LV_BORDER_SIDE_TOP, 0);
+        lv_obj_set_style_border_color(row, lv_color_hex(HAIR), 0);
+        s_row[i] = row;
+
+        lv_obj_t *mk = lv_obj_create(row);
+        lv_obj_remove_flag(mk, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_pos(mk, 0, 12);
+        lv_obj_set_size(mk, 5, 5);
+        lv_obj_set_style_bg_color(mk, lv_color_hex(CY), 0);
+        lv_obj_set_style_border_width(mk, 0, 0);
+        lv_obj_set_style_radius(mk, 0, 0);
+        lv_obj_set_style_shadow_width(mk, 8, 0);          /* 一点点辉光（C3 上代价很小） */
+        lv_obj_set_style_shadow_color(mk, lv_color_hex(CY), 0);
+        lv_obj_set_style_shadow_opa(mk, LV_OPA_60, 0);
+        s_mark[i] = mk;
+
+        lv_obj_t *idx = ui_pixel_label(row, "", &fusion_ui12, CY_MID);
+        lv_obj_set_size(idx, 22, 16);
+        lv_obj_set_pos(idx, 12, 7);
+        lv_label_set_text_fmt(idx, "%02d", i + 1);
+
+        lv_obj_t *txt = ui_pixel_label(row, ROW_NAME[i], &fusion_ui16,
+                                       (i == 0) ? INK : MUTED);
+        lv_obj_set_size(txt, 170, 22);
+        lv_obj_set_pos(txt, 36, 3);
+        lv_obj_set_style_text_letter_space(txt, 1, 0);
+        lv_obj_set_user_data(row, txt);                   /* 记着文字对象，改色时用 */
+        lv_obj_add_flag(mk, LV_OBJ_FLAG_HIDDEN);
+    }
+    lv_obj_clear_flag(s_mark[s_sel], LV_OBJ_FLAG_HIDDEN);
+
+
+    clock_refresh();
+    status_refresh(true);
+
+    s_timer_ring = lv_timer_create((lv_timer_cb_t)ring_tick, RING_MS, NULL);
+    s_timer_1s = lv_timer_create((lv_timer_cb_t)tick_1s, 1000, NULL);
+    lv_screen_load(s_scr);
+
+    ESP_LOGI(TAG, "主页(I-3)就绪 ｜ %s ｜ 时间%s ｜ 环 %dms/步",
+             net_online() ? "已联网" : "未联网",
+             time_sync_valid() ? (time_sync_synced() ? "已对时" : "NVS缓存≈") : "无效", RING_MS);
+}
+
+void demo_home_exit(void)
+{
+    if (s_timer_ring) { lv_timer_delete(s_timer_ring); s_timer_ring = NULL; }
+    if (s_timer_1s) { lv_timer_delete(s_timer_1s); s_timer_1s = NULL; }
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; }
+    s_clock = NULL; s_date = NULL; s_stat_r = NULL;
+    s_arc_f = NULL; s_arc_r = NULL;
+    memset(s_row, 0, sizeof(s_row));
+    memset(s_mark, 0, sizeof(s_mark));
+}
+
+void demo_home_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    if (ev == BSP_BTN_LONG) return;          /* 主页是顶层：长按 ● 不做动作，避免误触 */
+    if (ev != BSP_BTN_CLICK) return;
+
+    if (btn == BSP_BTN_DOWN && s_sel < HOME_ROWS - 1) s_sel++;
+    else if (btn == BSP_BTN_UP && s_sel > 0) s_sel--;
+    else if (btn == BSP_BTN_OK) {
+        ESP_LOGW(TAG, "进入：%s", ROW_NAME[s_sel]);
+        app_request_enter_name(ROW_TARGET[s_sel]);
+        return;
+    } else return;
+
+    for (int i = 0; i < HOME_ROWS; i++) {
+        if (!s_row[i]) continue;
+        lv_obj_t *txt = (lv_obj_t *)lv_obj_get_user_data(s_row[i]);
+        if (txt) lv_obj_set_style_text_color(txt, lv_color_hex(i == s_sel ? INK : MUTED), 0);
+        if (!s_mark[i]) continue;
+        if (i == s_sel) lv_obj_clear_flag(s_mark[i], LV_OBJ_FLAG_HIDDEN);
+        else lv_obj_add_flag(s_mark[i], LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+esp_err_t demo_home_start(void) { return ESP_OK; }
+esp_err_t demo_home_stop(void)  { return ESP_OK; }
diff --git a/main/demo_lab.c b/main/demo_lab.c
new file mode 100644
index 0000000..ab018ce
--- /dev/null
+++ b/main/demo_lab.c
@@ -0,0 +1,98 @@
+// main/demo_lab.c —— 「实验室」（D3 起点）：把开发/测试页收进一个**简单列表**，不再用 3×4 网格
+//
+// 为什么不复用旧网格菜单：12 个面板一次建出来会把 LVGL 池吃穿（真机直接重启，2026-10-27 踩到）。
+// 这里 5 行/页、翻页省内存；所有 label 固定尺寸 + fusion_ui16（N11/N15）。
+#include <string.h>
+#include <stdio.h>
+
+#include "demo.h"
+#include "ui_pixel.h"
+#include "lvgl.h"
+#include "esp_log.h"
+
+LV_FONT_DECLARE(fusion_ui16);
+
+static const char *TAG = "lab";
+
+void app_request_enter(int idx);
+
+#define LAB_ROWS 5
+#define LAB_MAX  16
+static lv_obj_t *s_scr;
+static lv_obj_t *s_row[LAB_ROWS];
+static int s_n, s_first, s_sel;
+static const char *s_name[LAB_MAX];
+static int s_target[LAB_MAX];
+
+/* main.c 启动时把"要收进实验室的页面"（名字 + DEMOS 下标）递进来 */
+void demo_lab_set_items(const char **names, const int *targets, int n)
+{
+    s_n = (n > LAB_MAX) ? LAB_MAX : n;
+    for (int i = 0; i < s_n; i++) { s_name[i] = names[i]; s_target[i] = targets[i]; }
+}
+
+static void render(void)
+{
+    for (int i = 0; i < LAB_ROWS; i++) {
+        int e = s_first + i;
+        if (!s_row[i]) continue;
+        if (e >= s_n) { lv_obj_add_flag(s_row[i], LV_OBJ_FLAG_HIDDEN); continue; }
+        lv_obj_clear_flag(s_row[i], LV_OBJ_FLAG_HIDDEN);
+        lv_obj_t *t = lv_obj_get_child(s_row[i], 0);
+        if (t) { lv_label_set_text(t, s_name[e]); }
+        lv_obj_set_style_bg_color(s_row[i], lv_color_hex(e == s_sel ? UI_PANEL_SEL : UI_PANEL), 0);
+        lv_obj_set_style_border_color(s_row[i], lv_color_hex(e == s_sel ? UI_CY : UI_PANEL_EDGE), 0);
+    }
+}
+
+void demo_lab_enter(void)
+{
+    s_scr = ui_pixel_screen_create("实验室");
+    lv_obj_t *panel = ui_pixel_panel_dark(s_scr, 10, 46, 220, 240, false);
+    for (int i = 0; i < LAB_ROWS; i++) {
+        s_row[i] = lv_obj_create(panel);
+        lv_obj_remove_flag(s_row[i], LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_pos(s_row[i], 6, 6 + i * 44);
+        lv_obj_set_size(s_row[i], 194, 38);
+        lv_obj_set_style_radius(s_row[i], 0, 0);
+        lv_obj_set_style_border_width(s_row[i], 1, 0);
+        lv_obj_set_style_border_color(s_row[i], lv_color_hex(i == s_sel ? UI_CY : UI_PANEL_EDGE), 0);
+        lv_obj_set_style_pad_all(s_row[i], 6, 0);
+        lv_obj_set_style_bg_color(s_row[i], lv_color_hex(i == s_sel ? UI_PANEL_SEL : UI_PANEL), 0);
+        lv_obj_set_style_bg_opa(s_row[i], LV_OPA_COVER, 0);
+        lv_obj_t *t = ui_pixel_label(s_row[i], "", &fusion_ui16, UI_SC_INK);
+        lv_obj_set_size(t, 176, 24);
+        lv_obj_set_pos(t, 2, 4);
+    }
+    if (s_sel >= s_n) s_sel = 0;
+    s_first = (s_sel / LAB_ROWS) * LAB_ROWS;
+    render();
+    ESP_LOGI(TAG, "实验室打开：%d 项（本页 %d..%d）", s_n, s_first + 1, s_first + LAB_ROWS);
+    lv_screen_load(s_scr);
+}
+
+void demo_lab_exit(void)
+{
+    if (s_scr) { lv_obj_delete(s_scr); s_scr = NULL; }
+    memset(s_row, 0, sizeof(s_row));
+}
+
+void demo_lab_key(bsp_btn_t btn, bsp_btn_ev_t ev)
+{
+    if (ev != BSP_BTN_CLICK) return;
+    if (btn == BSP_BTN_DOWN && s_sel < s_n - 1) {
+        s_sel++;
+        if (s_sel >= s_first + LAB_ROWS) s_first += LAB_ROWS;
+        render();
+    } else if (btn == BSP_BTN_UP && s_sel > 0) {
+        s_sel--;
+        if (s_sel < s_first) s_first = (s_sel / LAB_ROWS) * LAB_ROWS;
+        render();
+    } else if (btn == BSP_BTN_OK && s_n > 0) {
+        ESP_LOGW(TAG, "实验室进入：%s（DEMOS[%d]）", s_name[s_sel], s_target[s_sel]);
+        app_request_enter(s_target[s_sel]);
+    }
+}
+
+esp_err_t demo_lab_start(void) { return ESP_OK; }
+esp_err_t demo_lab_stop(void)  { return ESP_OK; }
