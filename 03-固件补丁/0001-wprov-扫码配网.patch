+static uint32_t now_ms(void)
+{
+    return (uint32_t)(xTaskGetTickCount() * portTICK_PERIOD_MS);
+}
+
+/* 换脸：**调用方必须已持 LVGL 锁**。
+   只换 dsc 指针 —— 不 decode、不 malloc、不动缓存（本工程 LV_CACHE_DEF_SIZE=0）。 */
+static void face_set_locked(int id, const char *why)
+{
+    if (!s_img || !faces_ready()) return;
+    if (id < 0 || id >= faces_count()) return;
+    const lv_image_dsc_t *d = faces_dsc(id);
+    if (!d) return;
+    const face_ent_t *e = faces_ent(id);
+    lv_image_set_src(s_img, d);
+    s_face = id;
+    ESP_LOGI(TAG, "表情 %d/%d：%s（%s）", id + 1, faces_count(), e ? e->name : "?", why);
+}
+
+/* 屏上那行小字：L{等级} · {亲密度}（调试/测试用；v1 不带台词，这是唯一的数字口子） */
