@@ -42,5 +42,23 @@ esp_err_t bsp_audio_wake(void);
 esp_err_t bsp_audio_write(const void *pcm, size_t bytes);
 esp_err_t bsp_audio_read(void *pcm, size_t bytes);
 
+/* 播放侧 I2S DMA 队列一共能缓多少毫秒（= 能扛多久的网络抖动）。
+   调用方用它决定"最后一个字节写完后还要等多久才收尾"（嘴别比声音早闭）。 */
+int bsp_audio_tx_buffer_ms(void);
+
+/* 立刻把**还没播出来**的声音丢掉（2026-10-29 M2 打断用）：
+   `i2s_channel_disable` + `enable` 一关一开，DMA 队列里最多 bsp_audio_tx_buffer_ms()
+   的残留整批作废。codec 不掉电 ⇒ 没有"咔"的断电声，但会有一声很轻的爆音。
+   ⚠ 会等 I2S（毫秒级）⇒ **不许在 LVGL 锁里/按键回调里调**，要在搬运音频的那个任务里调。
+   ⚠ 只停播放侧；录音（RX）不动。 */
+esp_err_t bsp_audio_flush_tx(void);
+
+/* 麦克风增益（dB，0..42）。**运行中也能改**（不用重开 codec），下一次 bsp_audio_read 生效。
+   为什么不是"直接写寄存器"：ES8311 的 PGA 只有 0/6/12/…/42 七档，±2 dB 这种细调硬件做不了 ——
+   这里取**就近**的 6 dB 硬件档，剩下的尾数在 bsp_audio_read() 里按 Q8 整数补上，
+   所以 set(32) 相对 set(30) 是**真的**响 2 dB（2026-10-29 M2 查驱动后定的口径）。 */
+void  bsp_audio_set_in_gain(float db);
+float bsp_audio_get_in_gain(void);
+
 // 输出音量 0..100(%)。
 void bsp_audio_set_volume(uint8_t percent);
