+/* ---------------------------------------------------------------- 页面生命周期 */
+void demo_card_enter(void)
+{
+    pgb2_err_t me = pgb2_esp_mount();
+    if (me != PGB2_OK && me != PGB2_ERR_CRC) {
+        ESP_LOGE(TAG, "存储不可用：%s", pgb2_err_str(me));
+    }
+    s_day = nvs_day_load();
+    ev_sync_init();                 /* 事件日志（已挂载就直接返回） */
+    s_sess_t0 = now_ms();
+    s_shown_qi = -1;
+    s_flip_t0 = 0;
+    s_grade_cnt = 0;
+    s_since_sync = 0;
+    s_qi = 0;
+    s_revealed = false;
+    s_touch_n = 0;
+    queue_build();
+
+    /* v0.126.1（使用侧 11:5x：「背单词的背景能不能全黑」）：纯黑底、去掉顶部那层淡光。
+       标题牌和底部发丝线是前景元素，先留着；嫌多再撤。 */
+    s_scr = ui_pixel_screen_create2("背单词", false);
+    lv_obj_set_style_bg_color(s_scr, lv_color_hex(0x000000), 0);
