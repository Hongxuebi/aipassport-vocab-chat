+        return;
+    }
+
+    /* 她出声时 voice_talk 会回调这个（只写标志；换图在 pet_task 的锁里做） */
+    voice_talk_set_level_cb(on_voice_level);
+    /* M2：回话前面的 8 字节元数据帧（标签/回显）也走回调，同样只写标志 */
+    voice_talk_set_meta_cb(on_voice_meta);
+
+
+    /* 进页把所有"瞬时状态"清干净（上一轮的道别/抖动/连戳不能带过来） */
+    s_armed = false; s_press_talk = false; s_ignore_click = false;
+    s_tap_n = 0; s_tap_settle = 0; s_tap_back_until = 0;
+    s_leave_pending = false; s_shake_until = 0; s_shake_dy = 0;
+    s_dx = 0; s_dy = 0; s_skeleton = F_NEUTRAL; s_mouth_tier = 0;
+
+    s_img = lv_image_create(s_scr);
+    lv_image_set_src(s_img, faces_dsc(F_NEUTRAL));
+    lv_obj_set_pos(s_img, FACE_X, FACE_Y);
+    /* 关系账 + 重逢：上次走的时候存了 last_seen，回来按隔了多久给事件 */
+    pet_store_load(&s_store);
+    pm_init(&s_mood, pm_level_of(s_store.int家用电脑y), now_ms());
+    s_face = PM_NEUTRAL;
+    {
+        const uint32_t now_s = (uint32_t)time(NULL);
+        pm_event_t ev;
+        if (pm_reunion(now_s, s_store.last_seen, &ev)) {
+            apply_pm_locked(pm_event(&s_mood, ev, now_ms()),
+                            ev == PM_EV_REUNION_24H ? "一天多没见" : "好久不见");
+        }
+        ESP_LOGI(TAG, "关系账：亲密度 %u（L%u），上次见面 %u，现在 %u",
+                 (unsigned)s_store.int家用电脑y, (unsigned)s_mood.level,
+                 (unsigned)s_store.last_seen, (unsigned)now_s);
+    }
+
+    /* 番茄页到点时记的那一笔：进页补发 +2 亲密度，演"得意 → 1.8 s → 开心" */
+    if (pet_store_take_tomato()) {
+        const int old_level = s_mood.level;
+        uint32_t v = (uint32_t)s_store.int家用电脑y + 2u;
+        s_store.int家用电脑y = (uint16_t)(v > PM_INTIMACY_MAX ? PM_INTIMACY_MAX : v);
+        s_mood.level = pm_level_of(s_store.int家用电脑y);
+        apply_pm_locked(pm_event(&s_mood, PM_EV_TOMATO, now_ms()), "番茄完成（补发）");
+        ESP_LOGI(TAG, "番茄完成补发：亲密度 %u → L%u（+2）", (unsigned)s_store.int家用电脑y,
+                 (unsigned)s_mood.level);
+        pet_store_save(&s_store);
