+// 目的：证明"设备屏能出中文"，并把字号/行距定下来，后面照这套换全站。
+// 字库：main/fonts/fusion_ui12.c / fusion_ui16.c（lv_font_conv --size 12|16 --bpp 1）
+// 字符集：只含界面用到的字，176 字 + 全 ASCII（≈26 字节/字）
+#include "lvgl.h"
+#include "demo.h"
+#include "ui_pixel.h"
+
+LV_FONT_DECLARE(fusion_ui12);
+LV_FONT_DECLARE(fusion_ui16);
+
+static lv_obj_t *s_scr;
+
+static lv_obj_t *mk(const char *txt, const lv_font_t *f, uint32_t color, int y)
+{
+    lv_obj_t *l = lv_label_create(s_scr);
+    lv_obj_set_width(l, 228);
+    lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_font(l, f, 0);
+    lv_obj_set_style_text_color(l, lv_color_hex(color), 0);
+    lv_label_set_text(l, txt);
+    lv_obj_align(l, LV_ALIGN_TOP_MID, 0, y);
+    return l;
+}
+
+void demo_zh_enter(void)
+{
+    s_scr = lv_obj_create(NULL);
+    lv_obj_set_style_bg_color(s_scr, lv_color_hex(UI_PAPER), 0);
+    lv_obj_set_style_border_width(s_scr, 0, 0);
+    lv_obj_set_style_radius(s_scr, 0, 0);
+    lv_obj_clear_flag(s_scr, LV_OBJ_FLAG_SCROLLABLE);
+
+    mk("点阵中文字体", &fusion_ui16, UI_SKY_DARK, 8);
+    mk("Fusion Pixel 16px", &fusion_ui12, 0x6B757D, 30);
