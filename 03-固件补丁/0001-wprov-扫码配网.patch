diff --git a/main/demo_card.c b/main/demo_card.c
new file mode 100644
index 0000000..fe175c0
--- /dev/null
+++ b/main/demo_card.c
@@ -0,0 +1,753 @@
+// main/demo_card.c —— 卡片页（C1-B）：真单词 + 四档打分 + 进度落 PGB2
+//
+// 设计要点
+//   · **队列不存盘**（19 §Q11）：每次进入由 PGB2 里的 (S, D, 上次复习日) 现算 ——
+//     到期 = 距上次复习 ≥ min(FSRS 间隔, 14 天上限)；新词按词表顺序补到 20 个/天；总数封顶 90
+//   · **对象不重建**（19 §Q6）：页面只建一次 8 个 label，翻卡片只改文字，不 create/delete
+//   · 按键（本机只有三键，且"长按 OK"被框架占用返回菜单）：
+//         ▲ 单击 = 熟知(Easy)   ● 单击 = 认识(Good)
+//         ● 双击 = 模糊(Hard)   ▼ 单击 = 忘记(Again)
+//   · 每 3 张落一次盘，离开页面再落一次（8KB/次，够省 Flash）
+//
+// ⚠️ "今天"怎么算（过渡实现，D 阶段换成 SNTP 对时）：
+//   设备没有 RTC 电池，断网时拿不到真实日期。本版规则：
+//   **上一次"有打分"的会话结束 = 过了一天**（NVS 里一个 dirty 标志）。
+//   一天开一次就没问题；一天开多次会让天数走得偏快 —— 屏上有 `D<n>` 可以核对。
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+
+#include "lvgl.h"
+#include "demo.h"
+#include "ui_pixel.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "esp_heap_caps.h"
+#include "esp_system.h"
+#include "nvs.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#include "pgb2.h"
+#include "pgb2_esp.h"
+#include "srs.h"
+#include "words_bashang.h"
+#include "net_client.h"
+#include "ev_sync.h"
+
+LV_FONT_DECLARE(fusion_ui12);
+LV_FONT_DECLARE(fusion_ui16);
+LV_FONT_DECLARE(fusion_ui24);
+LV_FONT_DECLARE(latin28);
+LV_FONT_DECLARE(latin20);
+LV_FONT_DECLARE(latin16);
+
+static const char *TAG = "card";
+
+#define NEW_PER_DAY  20
+#define CARD_CAP     90
+#define DESIRED      0.95f     /* 考试档阈值（16 §9.3） */
+#define MAX_IVL      14        /* 考试档间隔上限 */
+#define SYNC_EVERY   3
+#define REPEAT_GAP   8       /* 忘记/模糊的卡：隔 8 张再出现（墨墨的"当日巩固"） */
+#define MAX_REPEAT   2       /* 每张卡一个会话最多重来 2 次，防死循环 */
+#define QCAP         200     /* 队列数组上限（90 张 + 重来） */
+
+#define NVS_NS       "card"
+#define K_DAY        "day"
+#define K_DIRTY      "dirty"
+
+typedef struct {
+    uint16_t id;        /* = 词表下标（0..N-1，N 现查 WORDS_BASHANG_N） */
+    uint8_t  is_new;
+    uint8_t  is_repeat; /* = 当日重来那次（事件里打 EV_FLAG_REPEAT） */
+} qitem_t;
+
+static lv_obj_t *s_scr, *s_word, *s_ipa, *s_cn, *s_prog, *s_hint, *s_dbg, *s_done, *s_chunk;
+static lv_timer_t *s_timer;
+
+static qitem_t  s_q[QCAP];
+static int      s_qn, s_qi;
+static uint8_t  s_rep[PGB2_MAX_CARDS];   /* 每张卡本会话重来次数 */
+static bool     s_revealed;              /* 两段式：false=问题面，true=答案面 */
+static net_queue_t s_netq;               /* 从服务端机拿到的队列（含词条内容） */
+
+/* 取词（2026-10-31 v0.112）：词表可能比内置 453 条大 —— 先看队列文本，再退回内置表，绝不越界读 */
+static const char *safe_word(uint16_t id)
+{
+    for (int i = 0; i < s_netq.n; i++)
+        if (s_netq.items[i].id == id && s_netq.items[i].word && s_netq.items[i].word[0])
+            return s_netq.items[i].word;
+    if (id < WORDS_BASHANG_N) return WORDS_BASHANG[id].word;
+    return "?";
+}
+static bool     s_online;                /* 本次是否成功从服务端机拿到队列 */
+static uint16_t s_touched[CARD_CAP];     /* 本次改过状态的卡（退出时回传） */
+static int      s_touch_n;
+static volatile int  s_fetch_state;   /* 0=无 1=进行中 2=成功 3=失败 */
+static volatile bool s_sync_cancel;
+static volatile bool s_defer_sync;   /* 抓队列还在跑 → 回传推迟到它收尾（别两个 6KB 任务并存） */
+static uint32_t s_day;
+static uint32_t s_sess_t0;      /* 本场开始（ms）：事件里的相对时刻用它对齐 */
+static uint32_t s_card_t0;      /* 当前这张卡"出现"的时刻（ms）：反应时的起点 */
+static uint32_t s_flip_t0;      /* 当前这张卡**第一次翻面**的时刻（ms）；0 = 还没翻 */
+static int      s_shown_qi = -1;/* 上一次显示的是第几张（翻面不重开计时） */
+static int      s_grade_cnt;    /* 本次会话打了多少张 */
+static int      s_since_sync;
+static bool     s_inited;
+
+/* ---------------------------------------------------------------- 计时 */
+/* 单调毫秒。设备没有 RTC，反应时/相对时刻只需要"两次之间差多少"，用 esp_timer 够了。 */
+static uint32_t now_ms(void)
+{
+    return (uint32_t)(esp_timer_get_time() / 1000);
+}
+
+/* ---------------------------------------------------------------- 天数 */
+static uint32_t nvs_day_load(void)
+{
+    nvs_handle_t h;
+    uint32_t d = 0; uint8_t dirty = 0;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return 0;
+    if (nvs_get_u32(h, K_DAY, &d) != ESP_OK) d = 0;
+    if (nvs_get_u8(h, K_DIRTY, &dirty) == ESP_OK && dirty) {
+        d += 1;
+        nvs_set_u32(h, K_DAY, d);
+        nvs_set_u8(h, K_DIRTY, 0);
+    }
+    nvs_commit(h);
+    nvs_close(h);
+    return d;
+}
+
+static void nvs_day_mark_active(void)
+{
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READWRITE, &h) != ESP_OK) return;
+    nvs_set_u8(h, K_DIRTY, 1);
+    nvs_commit(h);
+    nvs_close(h);
+}
+
+static void show_current(void);      /* 前置声明：sync_tick 里要用 */
+
+/* ---------------------------------------------------------------- 后台同步
+   🔴 2026-10-25 卡死教训：HTTP（4 秒超时）绝不能放在 enter/exit 里 ——
+   那是**持 LVGL 锁**的上下文，一卡就是整个界面卡住。网络一律进独立任务，
+   界面用 300ms 定时器去"取结果"。 */
+
+static void fetch_task(void *arg)
+{
+    const int day = (int)(intptr_t)arg;
+    int due = 0, cnt = 0;
+    net_queue_t q;
+    char *json = net_client_queue(day, &due, &cnt);
+    net_err_t pe = json ? net_queue_parse(json, &q) : NET_ERR_HTTP;
+    if (json) free(json);
+    if (s_sync_cancel) {
+        if (pe == NET_OK) net_queue_free(&q);
+        s_fetch_state = 0;
+        goto out;
+    }
+    if (pe == NET_OK) {
+        net_queue_free(&s_netq);
+        s_netq = q;
+        /* v0.124.1：学习日以**服务端日历**为准（K48：设备自己数会把刷机当新一天，
+           曾把 73 张到期卡全算成没到期；今天还因为断网复习把 last_day 记成设备日 18）。 */
+        if (q.day > 0 && q.day != (int)s_day) {
+            ESP_LOGI(TAG, "学习日对齐服务端：%u → %d（设备自己数的那个不再用）", (unsigned)s_day, q.day);
+            s_day = (uint32_t)q.day;
+        }
+        ESP_LOGI(TAG, "服务端机队列到手：%d 张（到期 %d）", q.n, due);
+        s_fetch_state = 2;
+    } else {
+        s_fetch_state = 3;
+    }
+out:
+    /* 退出时如果这个任务还在跑，回传就被推迟到这里 —— 保证同一时刻只有一个 6KB 栈的后台任务 */
+    if (s_defer_sync) {
+        s_defer_sync = false;
+        ev_sync_request();
+    }
+    vTaskDelete(NULL);
+}
+
+/* 卡片状态回传：**不再自己起任务**（2026-10-27 内存债）。
+   以前 exit 里 xTaskCreate("card_post", 6144)，和"事件补传"那个 6144 撞在一起时，
+   退页后首页显示「堆 0 KB」。现在只在本任务里拼 JSON（几百字节、不碰网络、几毫秒），
+   然后把所有权交给 ev_sync 的后台线程，和事件补传串行发。 */
+static void handoff_state(void)
+{
+    if (s_touch_n <= 0) return;
+    net_state_t *st = calloc((size_t)s_touch_n, sizeof(net_state_t));
+    if (!st) {
+        ESP_LOGE(TAG, "状态回传缓冲分配失败（%d 张，空闲堆 %u）—— 进度已落 PGB2，不影响背单词",
+                 s_touch_n, (unsigned)esp_get_free_heap_size());
+        return;
+    }
+    int n = 0;
+    for (int i = 0; i < s_touch_n; i++) {
+        pgb2_card_t c;
+        if (pgb2_get(s_touched[i], &c) != PGB2_OK) continue;
+        net_state_t *d = &st[n++];
+        d->id = c.id; d->S = c.S; d->D = c.D;
+        d->reps = c.reps; d->lapses = c.lapses;
+        d->last_day = (int)c.due_day;         /* 这个字段=上次复习日 */
+    }
+    char *json = (n > 0) ? net_client_build_state_json((int)s_day, st, n) : NULL;
+    free(st);
+    if (!json) {
+        ESP_LOGW(TAG, "状态 JSON 没拼出来（%d 张）—— PGB2 里有真数据，下次还能回传", n);
+        return;
+    }
+    ev_sync_attach_state(json);               /* 所有权转移，由补传线程发完 free */
+}
+
+/* 界面侧：取结果。只在 LVGL 上下文里跑（定时器回调），只改 label，不碰网络。 */
+static void sync_tick(lv_timer_t *t)
+{
+    (void)t;
+    if (s_fetch_state == 2) {
+        s_fetch_state = 0;
+        if (s_netq.n > 0 && s_qi == 0 && s_grade_cnt == 0) {
+            s_qn = 0;
+            for (int i = 0; i < s_netq.n && s_qn < QCAP; i++) {
+                s_q[s_qn].id = s_netq.items[i].id;
+                s_q[s_qn].is_new = s_netq.items[i].is_new;
+                s_q[s_qn].is_repeat = 0;
+                s_qn++;
+            }
+            s_online = true;
+            s_revealed = false;
+            show_current();
+            ESP_LOGI(TAG, "已切到服务端机队列：%d 张，首张=%s（id %u）", s_qn, safe_word(s_q[0].id), (unsigned)s_q[0].id);
+        } else if (s_netq.n > 0) {
+            /* 🔴 v0.126.2（使用侧 11:5x 问「词组呢？」）：队列到了，但已经开始打分 ⇒ 不换队列表（怕打断），
+               以前顺手把 s_online 也留在 false ⇒ 后面每张卡都不去 s_netq 里查词块，**整轮看不到词组**。
+               现在：照样算在线，当前这张卡重新画一次（词/音标/释义/词块都从网络队列取）。 */
+            s_online = true;
+            show_current();
+            ESP_LOGW(TAG, "队列到了但已开始打分（%d 张）→ 不换队列表，只把词条内容切到网络版（词块能显示了）",
+                     s_grade_cnt);
+        }
+    } else if (s_fetch_state == 3) {
+        s_fetch_state = 0;
+        s_online = false;
+        show_current();                 /* 底栏会显示"离线" */
+    }
+}
+
+/* ---------------------------------------------------------------- 队列 */
+static int due_of(const pgb2_card_t *c)
+{
+    /* 距上次复习多少天了 —— pgb2 的 due_day 字段当 last_day 用（间隔可由 S 现算，不必存） */
+    int since = (int)s_day - (int)c->due_day;
+    if (since < 0) since = 0;
+    int ivl = srs_interval_days(c->S, DESIRED);
+    if (ivl > MAX_IVL) ivl = MAX_IVL;
+    if (ivl < 1) ivl = 1;
+    return since - ivl;          /* >0 = 已逾期几天 */
+}
+
+static void queue_build(void)
+{
+    s_qn = 0;
+    memset(s_rep, 0, sizeof(s_rep));
+
+    /* 先按本地规则出队列（**不等网络**）；服务端机那边回来后再整队替换（见 sync_tick）。 */
+    int new_today = 0;
+    static int due_idx[PGB2_MAX_CARDS];
+    static int due_key[PGB2_MAX_CARDS];
+    int dn = 0;
+
+    for (uint16_t i = 0; i < (uint16_t)WORDS_BASHANG_N; i++) {
+        pgb2_card_t c;
+        if (pgb2_get(i, &c) != PGB2_OK) continue;              /* 还没学过 */
+        if (!(c.flags & PGB2_FLAG_INTRODUCED)) continue;
+        if ((int)c.due_day == (int)s_day) new_today++;         /* 今天刚引入的 */
+        int over = due_of(&c);
+        if (over > 0) { due_idx[dn] = i; due_key[dn] = over; dn++; }
+    }
+
+    /* 逾期最久的最先（简单插入排序：最多 453 个，够快且无额外内存） */
+    for (int a = 1; a < dn; a++) {
+        int ki = due_key[a], ii = due_idx[a], b = a - 1;
+        while (b >= 0 && due_key[b] < ki) { due_key[b + 1] = due_key[b]; due_idx[b + 1] = due_idx[b]; b--; }
+        due_key[b + 1] = ki; due_idx[b + 1] = ii;
+    }
+    for (int a = 0; a < dn && s_qn < CARD_CAP; a++) {
+        s_q[s_qn].id = (uint16_t)due_idx[a]; s_q[s_qn].is_new = 0;
+        s_q[s_qn].is_repeat = 0; s_qn++;
+    }
+
+    /* 补新词：按词表顺序，补到今天 20 个为止（卡到总上限就停） */
+    int room_new = NEW_PER_DAY - new_today;
+    for (int a = 0; a < WORDS_BASHANG_N && room_new > 0 && s_qn < CARD_CAP; a++) {
+        pgb2_card_t c;
+        if (pgb2_get((uint16_t)a, &c) == PGB2_OK && (c.flags & PGB2_FLAG_INTRODUCED)) continue;
+        s_q[s_qn].id = (uint16_t)a; s_q[s_qn].is_new = 1;
+        s_q[s_qn].is_repeat = 0; s_qn++;
+        room_new--;
+    }
+    ESP_LOGI(TAG, "队列 %d 张（到期 %d + 新词 %d），第 %u 天，库里已学 %u",
+             s_qn, dn, NEW_PER_DAY - new_today > 0 ? NEW_PER_DAY - new_today : 0,
+             (unsigned)(s_day + 1), (unsigned)pgb2_count());
+}
+
+/* UTF-8 字符数（不是字节数）：中文一个字 3 字节，直接 strlen 会算成三倍 */
+static int utf8_len(const char *s)
+{
+    int n = 0;
+    while (s && *s) {
+        unsigned char c = (unsigned char)*s;
+        s += (c < 0x80) ? 1 : (c < 0xE0) ? 2 : (c < 0xF0) ? 3 : 4;
+        n++;
+    }
+    return n;
+}
+
+/* ---------------------------------------------------------------- 显示 */
+/* 两段式重排：问题面只给单词+音标，答案面才出释义与四档提示 */
+static void layout_phase(void)
+{
+    if (!s_word) return;
+    const int wlen = (int)strlen(lv_label_get_text(s_word));
+    if (s_revealed) {
+        const lv_font_t *wf = (wlen <= 10) ? &latin28 : (wlen <= 18) ? &latin20 : &latin16;
+        lv_obj_set_style_text_font(s_word, wf, 0);
+        lv_obj_align(s_word, LV_ALIGN_TOP_MID, 0, (wlen <= 10) ? 44 : 50);
+        if (s_ipa)  lv_obj_align(s_ipa, LV_ALIGN_TOP_MID, 0, 86);
+        if (s_chunk) {                             /* v0.126：词块 16px（使用侧 11:5x：12px 看着眼睛疼） */
+            if (lv_label_get_text(s_chunk)[0]) {
+                lv_obj_clear_flag(s_chunk, LV_OBJ_FLAG_HIDDEN);
+                lv_obj_align(s_chunk, LV_ALIGN_TOP_MID, 0, 176);
+            } else {
+                lv_obj_add_flag(s_chunk, LV_OBJ_FLAG_HIDDEN);
+            }
+        }
+        if (s_hint) {
+            lv_obj_align(s_hint, LV_ALIGN_TOP_MID, 0, 250);
+            lv_label_set_text(s_hint, "▲熟知 ●认识 ▼模糊 长▼忘记");
+        }
+        if (s_done) lv_obj_clear_flag(s_done, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        if (s_word) {
+            const lv_font_t *wf = (wlen <= 10) ? &latin28 : (wlen <= 18) ? &latin20 : &latin16;
+            lv_obj_set_style_text_font(s_word, wf, 0);
+            lv_obj_align(s_word, LV_ALIGN_TOP_MID, 0, 88);
+        }
+        if (s_ipa)  lv_obj_align(s_ipa, LV_ALIGN_TOP_MID, 0, 126);
+        if (s_chunk) lv_obj_add_flag(s_chunk, LV_OBJ_FLAG_HIDDEN);   /* 问题面不给词块（那是给答案的） */
+        if (s_hint) {
+            lv_obj_align(s_hint, LV_ALIGN_TOP_MID, 0, 232);
+            lv_label_set_text(s_hint, "按任意键看释义");
+        }
+        if (s_done) lv_obj_add_flag(s_done, LV_OBJ_FLAG_HIDDEN);
+    }
+}
