+    }
+    s_face = s_mood.face;
+
+    /* 关系账读数（v0.95 挪到**顶栏右侧**）：标题牌 10..161 右边正好空着 79 px，
+       它原来贴在最下面 296 白占正文 16 px。暗色不抢戏，有它才能"用眼睛"验升级。 */
+    s_lvl = lv_label_create(s_scr);
+    lv_obj_set_style_text_font(s_lvl, &fusion_ui12, 0);      /* v0.96：montserrat_14 缺「·」⇒ 方块 */
+    lv_obj_set_style_text_color(s_lvl, lv_color_hex(0x5C7FA6), 0);
+    lv_obj_set_pos(s_lvl, LVL_X, LVL_Y);
+    lv_obj_set_size(s_lvl, LVL_W, 16);                       /* N11：固定 w/h，不许 LV_SIZE_CONTENT */
+    lv_obj_set_style_text_align(s_lvl, LV_TEXT_ALIGN_RIGHT, 0);
+    lvl_paint_locked();
+
+    /* v0.93：**她说的**放进气泡（v0.95：3 行，184..246），我说的放下面（250..304，暗一档）。
+       两级信息：她的话是主角（亮 + 底板），我的话是"我刚说了啥"（暗、不抢戏）。
+       底板用 `lv_obj_create` 自己画，**不用 `ui_pixel_panel_create`** —— 那个会额外建一块影子兄弟对象（N14），
+       以后要显隐/删除就得连影子一起管，容易漏。 */
+    s_bubble_box = lv_obj_create(s_scr);
+    lv_obj_remove_flag(s_bubble_box, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_pos(s_bubble_box, BUB_X, BUB_Y);
+    lv_obj_set_size(s_bubble_box, BUB_W, BUB_H);
+    lv_obj_set_style_bg_color(s_bubble_box, lv_color_hex(0x0E1A24), 0);
+    lv_obj_set_style_bg_opa(s_bubble_box, LV_OPA_COVER, 0);
+    lv_obj_set_style_radius(s_bubble_box, 6, 0);
+    lv_obj_set_style_border_width(s_bubble_box, 1, 0);
+    lv_obj_set_style_border_color(s_bubble_box, lv_color_hex(0x1E3A4A), 0);
+    lv_obj_set_style_pad_all(s_bubble_box, 0, 0);            /* 自己摆位，padding 会让 14 字放不下 */
+    lv_obj_add_flag(s_bubble_box, LV_OBJ_FLAG_HIDDEN);       /* 没话就不占地方 */
+    s_bubble = lv_label_create(s_bubble_box);
+    lv_obj_set_style_text_font(s_bubble, &fusion_ui16, 0);
+    lv_obj_set_style_text_color(s_bubble, lv_color_hex(0xE6F9FF), 0);   /* 比"我说的"亮 */
+    lv_obj_set_pos(s_bubble, BUB_TX, BUB_TY);
+    lv_obj_set_size(s_bubble, TEXT_W, 3 * 18);               /* 3 行（line_height 17，留 1 px 余量） */
+    lv_label_set_long_mode(s_bubble, LV_LABEL_LONG_CLIP);
+    lv_label_set_text(s_bubble, "");
+
+    /* 我说的（v0.95：气泡长大到 3 行，它跟着往下让）：
+       固定 w/h（N11：中文标签不许用 LV_SIZE_CONTENT）+ CLIP（不许 LVGL 自己折，它会把 14 字挤成 13 字）。 */
+    s_echo = lv_label_create(s_scr);
+    lv_obj_set_style_text_font(s_echo, &fusion_ui16, 0);
+    lv_obj_set_style_text_color(s_echo, lv_color_hex(0x7C93A8), 0);
+    lv_obj_set_pos(s_echo, ECHO_X, ECHO_Y);
+    lv_obj_set_size(s_echo, TEXT_W, 3 * 18);
+    lv_label_set_long_mode(s_echo, LV_LABEL_LONG_CLIP);
+    lv_label_set_text(s_echo, "");
+    s_echo_src[0] = '\0';
+    s_echo_show[0] = '\0';
+    s_her_src[0]  = '\0';
+    s_her_show[0] = '\0';
+    s_echo_dirty = false;
+    s_her_dirty  = false;
+
+    /* W3 开场（2026-10-30）：开机后台取到的 /greet 在这里上屏 —— 脸 + 一句，**默认不出声**。
+       取一次就用掉（第二次进页走平常的重逢/情绪逻辑），拿不到就什么都不做。 */
+    {
+        int gf = -1;
+        char gl[64] = { 0 };
+        if (app_greet_take(&gf, gl, sizeof(gl))) {
+            snprintf(s_her_src, sizeof(s_her_src), "%s", gl);
+            s_her_dirty = true;
+            if (gf >= 0) face_set_locked(gf, "开场");
+            ESP_LOGI(TAG, "开场上屏：face=%d ｜「%s」", gf, gl);
+        }
+    }
+
+    lv_screen_load(s_scr);
+
+    ESP_LOGI(TAG, "表情页就绪：%d 张 %dx%d，mmap 直读 0 字节堆；空闲堆 %u B，最大块 %u B",
+             faces_count(), FACE_W, FACE_H,
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+}
