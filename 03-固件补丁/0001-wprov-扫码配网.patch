+}
+void voice_diag_start(void) { xTaskCreate(voice_diag_fn, "voice_diag", 4096, NULL, 3, NULL); }
+#endif
+
+#if APP_VOL_PROBE
+/* 【临时】音量自检：走真按键路径
+   进设置 → 选到「音量」→ ● 进调节 → ▲×3（80→95）→ ● 保存 → 长按 ● 回主页 → 再进设置看值（验 NVS）。 */
+static void vol_probe_task(void *arg)
+{
+    (void)arg;
+    for (int i = 0; i < 80; i++) {                    /* 等 LVGL 与主页起来，别在开机动画里按 */
+        if (bsp_lvgl_lock(100)) { bsp_lvgl_unlock(); break; }
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+    vTaskDelay(pdMS_TO_TICKS(1200));
