+/* ---------------------------------------------------------------- 自测（交付版关） */
+#if APP_ECHO_DIAG
+#include "esp_system.h"
+
+/* 屏上回显自测：进 AI对话页 → 喂一句短文本 → 再喂一句长的（应折两行并截断）。
+   判据（串口）：`回显上屏：… ｜「…」`（第二句里应该有换行前的 14 字 + 省略号），无 Guru/task_wdt。 */
+static void echo_diag_task(void *arg)
+{
+    (void)arg;
+    vTaskDelay(pdMS_TO_TICKS(6000));
+    ESP_LOGI(TAG, "【自测】进 AI对话页");
+    app_sim_enter("AI对话");                      /* 点单 + 补键，见 demo.h 的说明 */
+    vTaskDelay(pdMS_TO_TICKS(800));
+    ESP_LOGI(TAG, "【自测】① 我说的（一行）");
+    echo_set("你好呀");
+    vTaskDelay(pdMS_TO_TICKS(2000));
+    ESP_LOGI(TAG, "【自测】② 她说的 19 字（气泡，两行均分）—— 用使用侧真机那句");
+    her_set("总算来了呢，我还以为你把我忘了");
+    vTaskDelay(pdMS_TO_TICKS(3000));
+    ESP_LOGI(TAG, "【自测】③ 她说的 30 字（v0.95：3 行均分，不再截断）");
+    her_set("今天的番茄你做了三个啦，比昨天多一个，要不要歇一会儿再背单词");
+    vTaskDelay(pdMS_TO_TICKS(3000));
+    ESP_LOGI(TAG, "【自测】④ 她说的 40 字（服务端上限 120 B：3 行刚好装满，无「…」）");
+    her_set("昨天的番茄你做了三个，比前天多一个，累不累？我这儿还有热水要不要热一下呀");
+    vTaskDelay(pdMS_TO_TICKS(3000));
+    ESP_LOGI(TAG, "【自测】⑤ 她说的 48 字（>42 ⇒ 截断 + 「…」）");
+    her_set("昨天的番茄你做了三个，比前天多一个，累不累？我这儿还有热水要不要热一下呀，吃完再背单词吧");
+    vTaskDelay(pdMS_TO_TICKS(3000));
+    ESP_LOGI(TAG, "【自测】⑤b 她说的英文 58 字符（v0.109 按像素折：3 行、不再只占左半块）");
+    her_set("I had a long day today. You should rest and drink some water.");
+    vTaskDelay(pdMS_TO_TICKS(3000));
+    ESP_LOGI(TAG, "【自测】⑤c 她说的英文 41 字符（2 行，行宽应接近 224px）");
+    her_set("Yeah. You rest, I'll keep the rice warm.");
+    vTaskDelay(pdMS_TO_TICKS(3000));
+    ESP_LOGI(TAG, "【自测】⑥ 我说的 23 字（v0.97 起不再被 60 B 切掉）");
+    echo_set("排队等号的时候突然想起来这个词怎么拼");
+    vTaskDelay(pdMS_TO_TICKS(2500));
+    ESP_LOGI(TAG, "【自测】⑦ 我说的 40 字（服务端上限 120 B：3 行刚好装满）");
+    echo_set("排队等号的时候突然想起来这个词怎么拼，回来翻了翻书才确定是这么写的");
+    vTaskDelay(pdMS_TO_TICKS(2500));
+    /* ⑤ 走**真链路**：模拟"按住 ● 1.5 s 再松手" → 真录一段（没人说话，服务端按碎片回"我在，你说。"）
+          → 下行的两个帧（我说的 / 她说的）都由真服务端发来。这一步验的是协议 + 屏，不是合成文本。 */
+    ESP_LOGI(TAG, "【自测】⑧ 真链路：模拟按住 ● 1.5 s");
+    echo_clear();
+    app_sim_key(BSP_BTN_OK, BSP_BTN_PRESS);
+    vTaskDelay(pdMS_TO_TICKS(1500));
+    app_sim_key(BSP_BTN_OK, BSP_BTN_RELEASE);
+    vTaskDelay(pdMS_TO_TICKS(9000));
+    ESP_LOGI(TAG, "【自测】真链路结果：我说的「%s」｜她说的「%s」",
+             s_echo_src, s_her_src);
+    vTaskDelay(pdMS_TO_TICKS(3000));
+    ESP_LOGI(TAG, "【自测】收尾：空闲堆 %u B ｜ 最大块 %u B",
+             (unsigned)esp_get_free_heap_size(),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    vTaskDelete(NULL);
+}
+
+void demo_pet_echo_diag_start(void)
+{
+    if (xTaskCreate(echo_diag_task, "echo_diag", 3072, NULL, 3, NULL) != pdPASS) {
+        ESP_LOGW(TAG, "【自测】任务建不起来");
+    }
+}
